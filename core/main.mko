fn db_report_kpi_json() -> string {
    let db = db_open()
    if sql_ok(db) == 0 {
        return "{}"
    }
    let total_invites = sql_query_int(db,
        "SELECT COUNT(*) FROM captures WHERE method = 'INVITE' AND kind = 'request'", [])
    let answered = sql_query_int(db,
        "SELECT COUNT(DISTINCT c1.call_id) FROM captures c1 " +
        "WHERE c1.method = 'INVITE' AND c1.kind = 'request' AND EXISTS " +
        "(SELECT 1 FROM captures c2 WHERE c2.call_id = c1.call_id AND c2.status >= 200 AND c2.status < 300)", [])
    let failed = sql_query_int(db,
        "SELECT COUNT(DISTINCT c1.call_id) FROM captures c1 " +
        "WHERE c1.method = 'INVITE' AND c1.kind = 'request' AND EXISTS " +
        "(SELECT 1 FROM captures c2 WHERE c2.call_id = c1.call_id AND c2.status >= 400)", [])
    let total_registers = sql_query_int(db,
        "SELECT COUNT(*) FROM captures WHERE method = 'REGISTER' AND kind = 'request'", [])
    let reg_ok = sql_query_int(db,
        "SELECT COUNT(*) FROM captures WHERE method LIKE '%REGISTER%' AND status >= 200 AND status < 300", [])
    let reg_fail = sql_query_int(db,
        "SELECT COUNT(*) FROM captures WHERE method LIKE '%REGISTER%' AND status >= 400", [])
    let total_calls = sql_query_int(db,
        "SELECT COUNT(DISTINCT call_id) FROM captures WHERE call_id IS NOT NULL AND call_id != ''", [])
    let total_messages = sql_query_int(db, "SELECT COUNT(*) FROM captures", [])
    // ASR = answered / total_invites * 100
    let mut asr = 0
    if total_invites > 0 {
        asr = answered * 100 / total_invites
    }
    // NER = (total_invites - failed) / total_invites * 100
    let mut ner = 0
    if total_invites > 0 {
        ner = (total_invites - failed) * 100 / total_invites
    }
    let _ = sql_close(db)
    return "{\"total_invites\":" + string(total_invites) +
        ",\"answered\":" + string(answered) +
        ",\"failed\":" + string(failed) +
        ",\"asr\":" + string(asr) +
        ",\"ner\":" + string(ner) +
        ",\"total_registers\":" + string(total_registers) +
        ",\"reg_ok\":" + string(reg_ok) +
        ",\"reg_fail\":" + string(reg_fail) +
        ",\"total_calls\":" + string(total_calls) +
        ",\"total_messages\":" + string(total_messages) +
        "}"
}

fn db_report_cps_json(minutes: int) -> string {
    let mut mins = minutes
    if mins <= 0 {
        mins = 60
    }
    if mins > 1440 {
        mins = 1440
    }
    let cutoff = now_ms() - mins * 60 * 1000
    let db = db_open()
    if sql_ok(db) == 0 {
        return "[]"
    }
    // Group by minute bucket
    let rows = sql_query_rows(db,
        "SELECT (ts_ms / 60000) AS minute_bucket, COUNT(*) AS c, " +
        "SUM(CASE WHEN method = 'INVITE' AND kind = 'request' THEN 1 ELSE 0 END) AS invites " +
        "FROM captures WHERE ts_ms > " + string(cutoff) + " " +
        "GROUP BY minute_bucket ORDER BY minute_bucket",
        [])
    let mut out = "["
    let mut first = 1
    if sql_rows_ok(rows) == 1 {
        while sql_rows_next(rows) == 1 {
            let bucket = sql_rows_int(rows, 0)
            let c = sql_rows_int(rows, 1)
            let inv = sql_rows_int(rows, 2)
            if first == 1 {
                first = 0
            } else {
                out = out + ","
            }
            out = out + "{\"ts\":" + string(bucket * 60000) + ",\"total\":" + string(c) +
                ",\"invites\":" + string(inv) + "}"
        }
        let _ = sql_rows_close(rows)
    }
    out = out + "]"
    let _ = sql_close(db)
    return out
}

