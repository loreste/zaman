    return out
}


// Real-time dashboard: windowed stats for the last N minutes.
fn db_realtime_json(window_min: int) -> string {
    let mut win = window_min
    if win <= 0 {
        win = 5
    }
    let cutoff = now_ms() - win * 60 * 1000
    let db = db_open()
    if sql_ok(db) == 0 {
        return "{}"
    }
    let cs = string(cutoff)
    let total = sql_query_int(db, "SELECT COUNT(*) FROM captures WHERE ts_ms > " + cs, [])
    let invite_msgs = sql_query_int(db, "SELECT COUNT(*) FROM captures WHERE ts_ms > " + cs + " AND method = 'INVITE' AND kind = 'request'", [])
    let invites = sql_query_int(db, "SELECT COUNT(DISTINCT call_id) FROM captures WHERE ts_ms > " + cs + " AND call_id IS NOT NULL AND call_id != '' AND method = 'INVITE' AND kind = 'request'", [])
    let byes = sql_query_int(db, "SELECT COUNT(DISTINCT call_id) FROM captures WHERE ts_ms > " + cs + " AND call_id IS NOT NULL AND call_id != '' AND method = 'BYE' AND kind = 'request'", [])
    let regs = sql_query_int(db, "SELECT COUNT(*) FROM captures WHERE ts_ms > " + cs + " AND method = 'REGISTER' AND kind = 'request'", [])
    let opts = sql_query_int(db, "SELECT COUNT(*) FROM captures WHERE ts_ms > " + cs + " AND method = 'OPTIONS' AND kind = 'request'", [])
    let resp_2xx = sql_query_int(db, "SELECT COUNT(*) FROM captures WHERE ts_ms > " + cs + " AND status >= 200 AND status < 300", [])
    let resp_4xx = sql_query_int(db, "SELECT COUNT(*) FROM captures WHERE ts_ms > " + cs + " AND status >= 400 AND status < 500", [])
    let resp_5xx = sql_query_int(db, "SELECT COUNT(*) FROM captures WHERE ts_ms > " + cs + " AND status >= 500", [])
    let err_401 = sql_query_int(db, "SELECT COUNT(*) FROM captures WHERE ts_ms > " + cs + " AND status = 401", [])
    let err_403 = sql_query_int(db, "SELECT COUNT(*) FROM captures WHERE ts_ms > " + cs + " AND status = 403", [])
    let err_404 = sql_query_int(db, "SELECT COUNT(*) FROM captures WHERE ts_ms > " + cs + " AND status = 404", [])
    let err_486 = sql_query_int(db, "SELECT COUNT(*) FROM captures WHERE ts_ms > " + cs + " AND status = 486", [])
    let err_503 = sql_query_int(db, "SELECT COUNT(*) FROM captures WHERE ts_ms > " + cs + " AND status = 503", [])
    // Live-window open dialogs: distinct INVITE Call-IDs in this realtime window
    // with no later BYE/CANCEL or final failed INVITE response.
    let active = sql_query_int(db,
        "SELECT COUNT(DISTINCT inv.call_id) FROM captures inv " +
        "WHERE inv.ts_ms > " + cs + " AND inv.call_id IS NOT NULL AND inv.call_id != '' " +
        "AND inv.method = 'INVITE' AND inv.kind = 'request' " +
        "AND NOT EXISTS (SELECT 1 FROM captures term WHERE term.call_id = inv.call_id AND term.ts_ms >= inv.ts_ms " +
        "AND ((term.method = 'BYE' AND term.kind = 'request') OR (term.method = 'CANCEL' AND term.kind = 'request') " +
        "OR (term.method = 'INVITE' AND term.kind = 'response' AND term.status >= 300)))", [])
    // Unique agents seen in window
    let agents_active = sql_query_int(db,
        "SELECT COUNT(DISTINCT agent) FROM captures WHERE ts_ms > " + cs, [])
    // Unique source IPs in window
    let sources = sql_query_int(db,
        "SELECT COUNT(DISTINCT src) FROM captures WHERE ts_ms > " + cs, [])
    // ASR for window
    let win_inv = sql_query_int(db,
        "SELECT COUNT(DISTINCT call_id) FROM captures WHERE ts_ms > " + cs + " AND method = 'INVITE' AND kind = 'request'", [])
    let win_ans = sql_query_int(db,
        "SELECT COUNT(DISTINCT c1.call_id) FROM captures c1 " +
        "WHERE c1.ts_ms > " + cs + " AND c1.method = 'INVITE' AND c1.kind = 'request' " +
        "AND EXISTS (SELECT 1 FROM captures c2 WHERE c2.call_id = c1.call_id AND c2.status >= 200 AND c2.status < 300)", [])
    let mut win_asr = 0
    if win_inv > 0 {
        win_asr = win_ans * 100 / win_inv
    }
    // Error rate
    let mut err_rate = 0
    let total_resp = resp_2xx + resp_4xx + resp_5xx
    if total_resp > 0 {
        err_rate = (resp_4xx + resp_5xx) * 100 / total_resp
    }
    let _ = sql_close(db)
    return "{\"window_min\":" + string(win) +
        ",\"total\":" + string(total) +
        ",\"invites\":" + string(invites) +
        ",\"invite_messages\":" + string(invite_msgs) +
        ",\"byes\":" + string(byes) +
        ",\"registers\":" + string(regs) +
        ",\"options\":" + string(opts) +
        ",\"resp_2xx\":" + string(resp_2xx) +
        ",\"resp_4xx\":" + string(resp_4xx) +
        ",\"resp_5xx\":" + string(resp_5xx) +
        ",\"err_401\":" + string(err_401) +
        ",\"err_403\":" + string(err_403) +
        ",\"err_404\":" + string(err_404) +
        ",\"err_486\":" + string(err_486) +
        ",\"err_503\":" + string(err_503) +
        ",\"active_calls\":" + string(active) +
        ",\"agents_active\":" + string(agents_active) +
        ",\"sources\":" + string(sources) +
        ",\"asr\":" + string(win_asr) +
        ",\"err_rate\":" + string(err_rate) +
        "}"
}

// Per-node health: each HEP agent with message rate and last-seen.
fn db_node_health_json() -> string {
    let db = db_open()
    if sql_ok(db) == 0 {
        return "[]"
    }
    let now = now_ms()
    let five_min = now - 300000
    let rows = sql_query_rows(db,
        "SELECT agent, COUNT(*) AS total, " +
        "SUM(CASE WHEN ts_ms > " + string(five_min) + " THEN 1 ELSE 0 END) AS recent, " +
        "MAX(ts_ms) AS last_seen, " +
        "COUNT(DISTINCT call_id) AS calls, " +
        "SUM(CASE WHEN status >= 400 THEN 1 ELSE 0 END) AS errors " +
        "FROM captures WHERE agent IS NOT NULL AND agent != '' " +
        "GROUP BY agent ORDER BY recent DESC, total DESC", [])
    let mut out = "["
    let mut first = 1
    if sql_rows_ok(rows) == 1 {
        while sql_rows_next(rows) == 1 {
            let agent = sql_rows_str(rows, 0)
            let total = sql_rows_int(rows, 1)
            let recent = sql_rows_int(rows, 2)
            let last = sql_rows_int(rows, 3)
            let calls = sql_rows_int(rows, 4)
            let errors = sql_rows_int(rows, 5)
            let age_sec = (now - last) / 1000
            // Status: green if seen in last 60s, yellow if last 5min, red if stale
            let mut status = "green"
            if age_sec > 300 {
                status = "red"
            } else if age_sec > 60 {
                status = "yellow"
            }
            if first == 1 {
                first = 0
            } else {
                out = out + ","
            }
            out = out + "{\"agent\":\"" + jesc(agent) + "\"" +
                ",\"total\":" + string(total) +
                ",\"recent\":" + string(recent) +
                ",\"last_seen\":" + string(last) +
                ",\"age_sec\":" + string(age_sec) +
                ",\"calls\":" + string(calls) +
                ",\"errors\":" + string(errors) +
                ",\"status\":\"" + status + "\"}"
        }
        let _ = sql_rows_close(rows)
    }
    out = out + "]"
    let _ = sql_close(db)
    return out
}

// Anomaly indicators: auth failures, 4xx spikes, reg storms.
fn db_anomalies_json() -> string {
    let db = db_open()
    if sql_ok(db) == 0 {
        return "[]"
    }
    let now = now_ms()
    let five_min = now - 300000
    let one_min = now - 60000
    let mut out = "["
    let mut first = 1
    // Auth failures in last 5 min
    let auth_fail = sql_query_int(db,
        "SELECT COUNT(*) FROM captures WHERE ts_ms > " + string(five_min) +
        " AND (status = 401 OR status = 403)", [])
    if auth_fail > 5 {
        out = out + "{\"type\":\"auth_failures\",\"severity\":\"warning\",\"count\":" + string(auth_fail) +
            ",\"message\":\"" + string(auth_fail) + " auth failures (401/403) in last 5 min\"}"
        first = 0
    }
    // Registration storm: >50 REGISTERs per minute
    let reg_storm = sql_query_int(db,
        "SELECT COUNT(*) FROM captures WHERE ts_ms > " + string(one_min) +
        " AND method = 'REGISTER' AND kind = 'request'", [])
    if reg_storm > 50 {
        if first == 0 {
            out = out + ","
        }
        out = out + "{\"type\":\"reg_storm\",\"severity\":\"critical\",\"count\":" + string(reg_storm) +
            ",\"message\":\"Registration storm: " + string(reg_storm) + " REGISTER/min\"}"
        first = 0
    }
    // 5xx errors in last 5 min
    let srv_err = sql_query_int(db,
        "SELECT COUNT(*) FROM captures WHERE ts_ms > " + string(five_min) + " AND status >= 500", [])
    if srv_err > 0 {
        if first == 0 {
            out = out + ","
        }
        out = out + "{\"type\":\"server_errors\",\"severity\":\"critical\",\"count\":" + string(srv_err) +
            ",\"message\":\"" + string(srv_err) + " server errors (5xx) in last 5 min\"}"
        first = 0
    }
    // SIP scanning: many INVITEs from single source to different Call-IDs
    let scan_rows = sql_query_rows(db,
        "SELECT src, COUNT(DISTINCT call_id) AS cids FROM captures " +
        "WHERE ts_ms > " + string(five_min) + " AND method = 'INVITE' AND kind = 'request' " +
        "GROUP BY src HAVING COUNT(DISTINCT call_id) > 20 LIMIT 5", [])
    if sql_rows_ok(scan_rows) == 1 {
        while sql_rows_next(scan_rows) == 1 {
            let scan_src = sql_rows_str(scan_rows, 0)
            let scan_cnt = sql_rows_int(scan_rows, 1)
            if first == 0 {
                out = out + ","
            }
            out = out + "{\"type\":\"sip_scan\",\"severity\":\"critical\",\"count\":" + string(scan_cnt) +
                ",\"message\":\"Possible SIP scan from " + jesc(scan_src) + ": " + string(scan_cnt) + " distinct Call-IDs in 5 min\"}"
            first = 0
        }
        let _ = sql_rows_close(scan_rows)
    }
    // 486 Busy spike
    let busy = sql_query_int(db,
        "SELECT COUNT(*) FROM captures WHERE ts_ms > " + string(five_min) + " AND status = 486", [])
    if busy > 10 {
        if first == 0 {
            out = out + ","
        }
        out = out + "{\"type\":\"busy_spike\",\"severity\":\"warning\",\"count\":" + string(busy) +
            ",\"message\":\"" + string(busy) + " busy (486) responses in last 5 min\"}"
        first = 0
    }
    out = out + "]"
    let _ = sql_close(db)
    return out
}

// ---- SLA per-dimension KPIs ----

fn db_sla_by_agent_json() -> string {
    let db = db_open()
    if sql_ok(db) == 0 {
        return "[]"
    }
    let rows = sql_query_rows(db,
        "SELECT agent, " +
        "COUNT(CASE WHEN method = 'INVITE' AND kind = 'request' THEN 1 END) AS invites, " +
        "COUNT(CASE WHEN status >= 200 AND status < 300 THEN 1 END) AS ok_2xx, " +
        "COUNT(CASE WHEN status >= 400 THEN 1 END) AS errors, " +
        "COUNT(*) AS total, " +
        "MIN(ts_ms) AS first_seen, MAX(ts_ms) AS last_seen " +
        "FROM captures WHERE agent IS NOT NULL AND agent != '' " +
        "GROUP BY agent ORDER BY total DESC", [])
    let mut out = "["
    let mut first = 1
    if sql_rows_ok(rows) == 1 {
        while sql_rows_next(rows) == 1 {
            let agent = sql_rows_str(rows, 0)
            let invites = sql_rows_int(rows, 1)
            let ok2 = sql_rows_int(rows, 2)
            let errors = sql_rows_int(rows, 3)
            let total = sql_rows_int(rows, 4)
            let t0 = sql_rows_int(rows, 5)
            let t1 = sql_rows_int(rows, 6)
            let mut asr = 0
            if invites > 0 {
                asr = ok2 * 100 / invites
            }
            let mut err_rate = 0
            if total > 0 {
                err_rate = errors * 100 / total
            }
            if first == 1 {
                first = 0
            } else {
                out = out + ","
            }
            out = out + "{\"agent\":\"" + jesc(agent) + "\",\"invites\":" + string(invites) +
                ",\"ok_2xx\":" + string(ok2) + ",\"errors\":" + string(errors) +
                ",\"total\":" + string(total) + ",\"asr\":" + string(asr) +
                ",\"err_rate\":" + string(err_rate) +
                ",\"first_seen\":" + string(t0) + ",\"last_seen\":" + string(t1) + "}"
        }
        let _ = sql_rows_close(rows)
    }
    out = out + "]"
    let _ = sql_close(db)
    return out
}

fn db_sla_by_dest_json() -> string {
    let db = db_open()
    if sql_ok(db) == 0 {
