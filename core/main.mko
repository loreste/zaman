// ---- RTCP / QoS / MOS scoring ----
// Parse RTCP Sender Report (SR) and Receiver Report (RR) payloads.
// Compute MOS from jitter + packet loss using the E-model (ITU-T G.107 simplified).
//
// RTCP RR block (24 bytes):
//   SSRC (4) + fraction_lost(1) + cumulative_lost(3) + highest_seq(4)
//   + jitter(4) + last_sr(4) + delay_since_sr(4)

fn rtcp_parse_qos(payload: string) -> string {
    if len(payload) < 12 {
        return ""
    }
    // RTCP header: V(2)|P(1)|RC(5)|PT(8)|Length(16)
    let pt = u8_at(payload, 1)
    let rc = u8_at(payload, 0) % 32  // lower 5 bits = report count

    // PT 200 = SR, PT 201 = RR
    if pt != 200 && pt != 201 {
        return ""
    }

    // For SR, report blocks start at offset 28 (after sender info)
    // For RR, report blocks start at offset 8
    let mut rr_offset = 8
    if pt == 200 {
        rr_offset = 28
    }

    if rc == 0 || len(payload) < rr_offset + 24 {
        return ""
    }

    // Parse first report block
    let fraction_lost = u8_at(payload, rr_offset + 4)
    let cumul_lost = u8_at(payload, rr_offset + 5) * 65536 + u8_at(payload, rr_offset + 6) * 256 + u8_at(payload, rr_offset + 7)
    let jitter = u32be_at(payload, rr_offset + 12)
    let dlsr = u32be_at(payload, rr_offset + 20)

    // Fraction lost is 0-255, convert to percentage
    let loss_pct = fraction_lost * 100 / 256

    // Jitter is in timestamp units (typically 8kHz for G.711), convert to ms
    let jitter_ms = jitter / 8

    // E-model simplified MOS calculation (ITU-T G.107)
    // R = 93.2 - Id - Ie_eff
    // Id = 0.024 * delay + 0.11 * (delay - 177.3) * H(delay - 177.3)
    // Ie_eff = function of codec + packet loss
    // Simplified: R = 93.2 - (jitter_ms * 0.1) - (loss_pct * 2.5)
    let mut r_factor = 93 - jitter_ms / 10 - loss_pct * 25 / 10
    if r_factor < 0 {
        r_factor = 0
    }
    if r_factor > 100 {
        r_factor = 100
    }

    // MOS = 1 + 0.035*R + R*(R-60)*(100-R)*7e-6
    // Simplified integer approximation: MOS*10 for one decimal
    let mut mos_x10 = 10
    if r_factor > 0 {
        mos_x10 = 10 + r_factor * 35 / 1000
        if r_factor > 60 {
            mos_x10 = mos_x10 + (r_factor - 60) * (100 - r_factor) * r_factor / 1400000
        }
    }
    if mos_x10 > 50 {
        mos_x10 = 50
    }
    if mos_x10 < 10 {
        mos_x10 = 10
    }

    return "{\"jitter_ms\":" + string(jitter_ms) +
        ",\"loss_pct\":" + string(loss_pct) +
        ",\"loss_cumulative\":" + string(cumul_lost) +
        ",\"r_factor\":" + string(r_factor) +
        ",\"mos_x10\":" + string(mos_x10) +
        ",\"mos\":\"" + string(mos_x10 / 10) + "." + string(mos_x10 % 10) + "\"" +
        ",\"dlsr\":" + string(dlsr) +
        "}"
}

// Enrich RTCP captures with parsed QoS metrics.
fn enrich_rtcp_record(record_json: string, payload: string) -> string {
    let qos = rtcp_parse_qos(payload)
    if str_eq(qos, "") {
        return record_json
    }
    // Inject qos object into record JSON before the closing }
    if len(record_json) > 2 {
        return record_json[0:len(record_json) - 1] + ",\"qos\":" + qos + "}"
    }
    return record_json
}

// ---- B2BUA leg correlation ----
// Links related Call-IDs: same HEP correlation ID, or overlapping From/To within a time window.
fn db_related_calls_json(call_id: string) -> string {
    let db = db_open()
    if sql_ok(db) == 0 {
        return "[]"
    }
    // Strategy 1: same HEP correlation ID (set by B2BUA agents like Kamailio)
    let mut out = "["
    let mut first = 1
    let rows = sql_query_rows(db,
        "SELECT DISTINCT c2.call_id, COUNT(*) AS msgs, MIN(c2.ts_ms) AS t0, MAX(c2.ts_ms) AS t1 " +
        "FROM captures c1 JOIN captures c2 ON c1.hep_cid = c2.hep_cid " +
        "WHERE c1.call_id = " + sql_quote(call_id) + " AND c2.call_id != " + sql_quote(call_id) +
        " AND c1.hep_cid != '' " +
        "GROUP BY c2.call_id ORDER BY t0 LIMIT 20", [])
    if sql_rows_ok(rows) == 1 {
        while sql_rows_next(rows) == 1 {
            let cid = sql_rows_str(rows, 0)
            let msgs = sql_rows_int(rows, 1)
            let t0 = sql_rows_int(rows, 2)
            let t1 = sql_rows_int(rows, 3)
            if first == 1 {
                first = 0
            } else {
                out = out + ","
            }
            out = out + "{\"call_id\":\"" + jesc(cid) + "\",\"messages\":" + string(msgs) +
                ",\"reason\":\"hep_correlation\",\"ts_first\":" + string(t0) + ",\"ts_last\":" + string(t1) + "}"
        }
        let _ = sql_rows_close(rows)
    }
    // Strategy 2: same From+To within 30s window (catches B2BUA re-INVITE with new Call-ID)
    let rows2 = sql_query_rows(db,
        "SELECT DISTINCT c2.call_id, COUNT(*) AS msgs, MIN(c2.ts_ms) AS t0 " +
        "FROM captures c1 JOIN captures c2 " +
        "ON c1.from_h = c2.from_h AND c1.to_h = c2.to_h " +
        "AND ABS(c1.ts_ms - c2.ts_ms) < 30000 " +
        "WHERE c1.call_id = " + sql_quote(call_id) + " AND c2.call_id != " + sql_quote(call_id) +
        " AND c1.method = 'INVITE' AND c2.method = 'INVITE' " +
        "GROUP BY c2.call_id ORDER BY t0 LIMIT 10", [])
    if sql_rows_ok(rows2) == 1 {
        while sql_rows_next(rows2) == 1 {
            let cid = sql_rows_str(rows2, 0)
            let msgs = sql_rows_int(rows2, 1)
            let t0 = sql_rows_int(rows2, 2)
            if first == 1 {
                first = 0
            } else {
                out = out + ","
            }
            out = out + "{\"call_id\":\"" + jesc(cid) + "\",\"messages\":" + string(msgs) +
                ",\"reason\":\"from_to_match\",\"ts_first\":" + string(t0) + "}"
        }
        let _ = sql_rows_close(rows2)
    }
    out = out + "]"
    let _ = sql_close(db)
    return out
}

// ---- ring store (shared via CMap) ----

fn cap_push(ring: CMap, metrics: CMap, rec: string) {
    let idx = cmap_i(ring, "idx")
    let slot = idx % RING
    cmap_set(ring, "msg_" + string(slot), rec)
    cmap_set_i(ring, "idx", idx + 1)
    let _ = cmap_incr(metrics, "msgs_total", 1)
}

fn cap_get(ring: CMap, id: int) -> string {
    if id < 0 {
        return ""
    }
    let idx = cmap_i(ring, "idx")
    if id >= idx {
        return ""
    }
    if idx - id > RING {
        return ""
    }
    return cmap_get(ring, "msg_" + string(id % RING))
}

// ---- SIP field extract / record ----

fn sip_dir_label(is_req: int) -> string {
    if is_req == 1 {
        return "request"
    }
    return "response"
}

fn make_record(
    db_ch: chan[string],
    metrics: CMap,
    src: string,
    transport: string,
    msg: string,
    agent: string
) -> string {
    return make_record_ex(db_ch, metrics, src, "", transport, msg, agent, "sip", now_ms(), 0, "", "")
}

// Full capture record — used for native SIP and HEPv3.
// Parses + builds JSON on the capture path; durable insert is kicked via db_ch.
fn make_record_ex(
    db_ch: chan[string],
    metrics: CMap,
    src: string,
    dst: string,
    transport: string,
    msg: string,
    agent: string,
    proto: string,
    ts_ms: int,
    hep_node_id: int,
    hep_node_name: string,
    hep_correlation: string
) -> string {
    let is_sip = if str_eq(proto, "sip") || str_eq(proto, "") || str_eq(proto, "unknown") {
        1
    } else {
        0
    }
    let safe = if is_sip == 1 {
        redact_sip(msg)
    } else {
        msg
    }
    let mut ts = ts_ms
    if ts <= 0 {
        ts = now_ms()
    }
    let mut method = ""
    let mut status = 0
    let mut ruri = ""
    let mut cid = ""
    let mut from_h = ""
    let mut to_h = ""
    let mut cseq = ""
    let mut kind = "payload"
    if is_sip == 1 && sip_ok(safe) == 1 {
        let is_req = sip_is_request(safe)
        kind = sip_dir_label(is_req)
        if is_req == 1 {
            method = sip_method(safe)
            ruri = sip_request_uri(safe)
        } else {
            status = sip_status_code(safe)
            method = sip_header(safe, "CSeq")
        }
        cid = sip_header(safe, "Call-ID")
        if str_eq(cid, "") {
            cid = sip_header(safe, "i")
        }
        from_h = sip_header(safe, "From")
        if str_eq(from_h, "") {
            from_h = sip_header(safe, "f")
        }
        to_h = sip_header(safe, "To")
        if str_eq(to_h, "") {
            to_h = sip_header(safe, "t")
        }
        cseq = sip_header(safe, "CSeq")
    } else {
        kind = proto
        method = str_to_upper(proto)
    }
    // HEP correlation ID (chunk 0x0011) can fill Call-ID for non-SIP or missing CID
    if str_eq(cid, "") && not str_eq(hep_correlation, "") {
        cid = hep_correlation
    }
    let raw_b64 = base64_encode(safe)

    // Hot path: str_builder avoids O(n^2) string concat (makori 0.6+).
    let buf = str_builder()
    builder_write(buf, "{\"ts_ms\":")
    builder_write(buf, string(ts))
    builder_write(buf, ",\"src\":\"")
    builder_write(buf, jesc(src))
    builder_write(buf, "\",\"dst\":\"")
    builder_write(buf, jesc(dst))
    builder_write(buf, "\",\"transport\":\"")
    builder_write(buf, jesc(transport))
    builder_write(buf, "\",\"proto\":\"")
    builder_write(buf, jesc(proto))
    builder_write(buf, "\",\"agent\":\"")
    builder_write(buf, jesc(agent))
    builder_write(buf, "\",\"kind\":\"")
    builder_write(buf, jesc(kind))
    builder_write(buf, "\",\"method\":\"")
    builder_write(buf, jesc(method))
    builder_write(buf, "\",\"status\":")
    builder_write(buf, string(status))
    builder_write(buf, ",\"ruri\":\"")
    builder_write(buf, jesc(ruri))
    builder_write(buf, "\",\"call_id\":\"")
    builder_write(buf, jesc(cid))
    builder_write(buf, "\",\"from\":\"")
    builder_write(buf, jesc(from_h))
    builder_write(buf, "\",\"to\":\"")
    builder_write(buf, jesc(to_h))
    builder_write(buf, "\",\"cseq\":\"")
    builder_write(buf, jesc(cseq))
    builder_write(buf, "\",\"hep_node_id\":")
    builder_write(buf, string(hep_node_id))
    builder_write(buf, ",\"hep_node\":\"")
    builder_write(buf, jesc(hep_node_name))
    builder_write(buf, "\",\"hep_cid\":\"")
    builder_write(buf, jesc(hep_correlation))
    builder_write(buf, "\",\"size\":")
    builder_write(buf, string(len(safe)))
    builder_write(buf, ",\"raw_b64\":\"")
    builder_write(buf, raw_b64)
    builder_write(buf, "\"}")
    let j = builder_string(buf)
    // Durable store: enqueue JSON to single kicked writer (serialized SQLite).
    // Ring still used for live UI via cap_push at the call site.
    if db_enqueue(db_ch, j) != 1 {
        let _ = cmap_incr(metrics, "db_drop", 1)
    }
    return j
}

fn bump_method(metrics: CMap, method: string) {
    if str_eq(method, "") {
        let _ = cmap_incr(metrics, "m_UNKNOWN", 1)
        return
    }
    let key = "m_" + str_to_upper(method)
    let _ = cmap_incr(metrics, key, 1)
}

// ---- echo replies ----

// Echo policy (security):
//   default: OPTIONS only (monitoring ping)
//   ZAMAN_ECHO_METHODS=OPTIONS,REGISTER,... or "ALL" with ZAMAN_ECHO_ALL=1
// Never return 200 OK + Expires for REGISTER without real auth — that lied.
fn method_echo_allowed(method: string, echo_all: int) -> int {
    if echo_all == 1 {
        return 1
    }
    let allow = env_get_or("ZAMAN_ECHO_METHODS", "OPTIONS")
    if str_eq(allow, "ALL") || str_eq(allow, "all") {
        return 1
    }
    let parts = str_split(str_to_upper(allow), ",")
    let want = str_to_upper(method)
    let mut i = 0
    while i < len(parts) {
        let p = str_trim_space(parts[i])
        if str_eq(p, want) {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn should_echo(msg: string, echo_all: int) -> int {
    if sip_is_request(msg) == 0 {
        return 0
    }
    return method_echo_allowed(sip_method(msg), echo_all)
}

fn build_echo(msg: string, local_host: string, local_port: int) -> string {
    let contact = sip_contact_value(sip_uri_build("zaman", local_host, local_port))
    let extra = sip_headers_append("", "Contact", contact)
    let extra2 = sip_headers_append(extra, "Server", "Zaman/" + VERSION)
    let extra3 = sip_headers_append(extra2, "Allow", "OPTIONS")
    // REGISTER must not look like a real registrar (white-hat H5).
    if sip_method_eq(msg, "REGISTER") == 1 {
        let wa = sip_www_authenticate("zaman.local", sip_tag())
        let e = sip_headers_append(extra3, "WWW-Authenticate", wa)
        return sip_reply(msg, 401, "Unauthorized", e, "")
    }
    if sip_method_eq(msg, "OPTIONS") == 1 {
        return sip_reply(msg, 200, "OK", extra3, "")
    }
    // Lab methods if explicitly allowed: still 200 without faking registration.
    return sip_reply(msg, 200, "OK", extra3, "")
}

// ---- HEPv3 / EEP (Homer Extensible Encapsulation) ----
// Chunk layout: vendor_id(2) type_id(2) length(2) value(length-6)
// Compatible with heplify / kamailio sipcapture / OpenSIPS HEP agents.
// Types (vendor 0): 1 version, 2 IP proto, 3/4 IPv4, 5/6 IPv6, 7/8 ports,
// 9/10 timestamps, 11 proto type (1=SIP), 12 node id, 14 password, 15 payload,
// 17 correlation id, 18 vlan, 19 node name.

struct HepInfo {
    ok: int
    version: int
    ip_proto: int
    src_ip: string
    dst_ip: string
    src_port: int
    dst_port: int
    tsec: int
    tusec: int
    proto_type: int
    node_id: int
    node_pw: string
    node_name: string
    correlation_id: string
    vlan: int
    payload: string
}

fn hep_empty() -> HepInfo {
    return HepInfo {
        ok: 0,
        version: 0,
        ip_proto: 0,
        src_ip: "",
        dst_ip: "",
        src_port: 0,
        dst_port: 0,
        tsec: 0,
        tusec: 0,
        proto_type: 0,
        node_id: 0,
        node_pw: "",
        node_name: "",
        correlation_id: "",
        vlan: 0,
        payload: "",
    }
}

fn hep_decode(pkt: string) -> HepInfo {
    let empty = hep_empty()
    if len(pkt) < 6 {
        return empty
    }
    if not str_eq(pkt[0:4], "HEP3") {
        return empty
    }
    let total = u16be_at(pkt, 4)
    // Strict agents set total == len(pkt). Accept total <= len for trailing noise.
    if total < 6 || total > len(pkt) {
        return empty
    }
    let end = total
    let mut off = 6
    let mut info = hep_empty()

    while off + 6 <= end {
        // vendor ignored for matching (heplify does the same) — standard is 0
        let typ = u16be_at(pkt, off + 2)
        let clen = u16be_at(pkt, off + 4)
        if clen < 6 || off + clen > end {
            break
        }
        let voff = off + 6
        let vlen = clen - 6
        if typ == 1 && vlen >= 1 {
            info.version = u8_at(pkt, voff)
        } else if typ == 2 && vlen >= 1 {
            info.ip_proto = u8_at(pkt, voff)
        } else if typ == 3 && vlen >= 4 {
            info.src_ip = ipv4_at(pkt, voff)
        } else if typ == 4 && vlen >= 4 {
            info.dst_ip = ipv4_at(pkt, voff)
        } else if typ == 5 && vlen >= 16 {
            info.src_ip = ipv6_at(pkt, voff)
        } else if typ == 6 && vlen >= 16 {
            info.dst_ip = ipv6_at(pkt, voff)
        } else if typ == 7 && vlen >= 2 {
            info.src_port = u16be_at(pkt, voff)
        } else if typ == 8 && vlen >= 2 {
            info.dst_port = u16be_at(pkt, voff)
        } else if typ == 9 && vlen >= 4 {
            info.tsec = u32be_at(pkt, voff)
        } else if typ == 10 && vlen >= 4 {
            info.tusec = u32be_at(pkt, voff)
        } else if typ == 11 && vlen >= 1 {
            info.proto_type = u8_at(pkt, voff)
        } else if typ == 12 && vlen >= 4 {
            info.node_id = u32be_at(pkt, voff)
        } else if typ == 14 && vlen > 0 {
            info.node_pw = pkt[voff:voff + vlen]
        } else if typ == 15 && vlen > 0 {
            info.payload = pkt[voff:voff + vlen]
        } else if typ == 17 && vlen > 0 {
            info.correlation_id = pkt[voff:voff + vlen]
        } else if typ == 18 && vlen >= 2 {
            info.vlan = u16be_at(pkt, voff)
        } else if typ == 19 && vlen > 0 {
            info.node_name = pkt[voff:voff + vlen]
        }
        off = off + clen
    }

    if str_eq(info.payload, "") {
        return empty
    }
    info.ok = 1
    return info
}

fn hep_ts_ms(info: HepInfo) -> int {
    if info.tsec <= 0 {
        return now_ms()
    }
    // tsec is UNIX seconds; tusec is microseconds (not milliseconds)
    return info.tsec * 1000 + info.tusec / 1000
}

fn hep_password_ok(info: HepInfo) -> int {
    let want = env_get_or("ZAMAN_HEP_PASSWORD", "")
    if str_eq(want, "") {
        return 1
    }
    return ct_str_eq(info.node_pw, want)
}

fn hep_endpoint(ip: string, port: int) -> string {
    if str_eq(ip, "") {
        if port > 0 {
            return ":" + string(port)
        }
        return ""
    }
    // bracket IPv6
    if str_contains(ip, ":") {
        return "[" + ip + "]:" + string(port)
    }
    return ip + ":" + string(port)
}

fn hep_agent_label(info: HepInfo) -> string {
    if not str_eq(info.node_name, "") {
        return info.node_name
    }
    return "hep-" + string(info.node_id)
}

// ---- process one SIP message ----

fn handle_sip_packet(
    store: CMap,
    metrics: CMap,
    db_ch: chan[string],
    fd: int,
    msg: string,
    transport: string,
    echo_all: int,
    local_host: string,
    local_port: int
) {
    if sip_ok(msg) == 0 {
        let _ = cmap_incr(metrics, "parse_err", 1)
        return
    }
    let src = udp_last_sender()
    let rec = make_record(db_ch, metrics, src, transport, msg, "zaman")
    cap_push(store, metrics, rec)

    if sip_is_request(msg) == 1 {
        bump_method(metrics, sip_method(msg))
        let _ = cmap_incr(metrics, "requests", 1)
        if should_echo(msg, echo_all) == 1 {
            let reply = build_echo(msg, local_host, local_port)
            let host = udp_last_sender_host()
            let port = udp_last_sender_port()
            if not str_eq(host, "") && port > 0 {
                let _ = sip_udp_send(fd, host, port, reply)
                let rrec = make_record(db_ch, metrics, local_host + ":" + string(local_port), transport, reply, "zaman-echo")
                cap_push(store, metrics, rrec)
                let _ = cmap_incr(metrics, "echoes", 1)
            }
        }
    } else {
        let _ = cmap_incr(metrics, "responses", 1)
        let code = sip_status_code(msg)
        if code >= 200 && code < 300 {
            let _ = cmap_incr(metrics, "status_2xx", 1)
        } else if code >= 400 {
            let _ = cmap_incr(metrics, "status_4xx_5xx", 1)
        }
    }
}

fn handle_hep_packet(store: CMap, metrics: CMap, db_ch: chan[string], pkt: string) {
    handle_hep_packet_via(store, metrics, db_ch, pkt, "HEP3")
}

fn handle_hep_packet_via(store: CMap, metrics: CMap, db_ch: chan[string], pkt: string, transport: string) {
    let info = hep_decode(pkt)
    if info.ok == 0 {
        let _ = cmap_incr(metrics, "hep_err", 1)
        return
    }
    if hep_password_ok(info) == 0 {
        let _ = cmap_incr(metrics, "hep_auth_fail", 1)
        return
    }
    let _ = cmap_incr(metrics, "hep_total", 1)
    if str_eq(transport, "HEP3/TCP") {
        let _ = cmap_incr(metrics, "hep_tcp", 1)
    } else if str_eq(transport, "HEP3/TLS") {
        let _ = cmap_incr(metrics, "hep_tls", 1)
    } else {
        let _ = cmap_incr(metrics, "hep_udp", 1)
    }

    let mut ptype = info.proto_type
    if ptype == 0 {
        if sip_ok(info.payload) == 1 {
            ptype = 1
        }
    }
    let pname = proto_type_name(ptype)
    if ptype == 1 {
        let _ = cmap_incr(metrics, "hep_sip", 1)
    } else if ptype == 5 {
        let _ = cmap_incr(metrics, "hep_rtcp", 1)
    } else {
        let _ = cmap_incr(metrics, "hep_other", 1)
    }

    let src = hep_endpoint(info.src_ip, info.src_port)
    let dst = hep_endpoint(info.dst_ip, info.dst_port)
    let agent = hep_agent_label(info)
    let ts = hep_ts_ms(info)
    let mut rec = make_record_ex(
        db_ch,
        metrics,
        src,
        dst,
        transport,
        info.payload,
        agent,
        pname,
        ts,
        info.node_id,
        info.node_name,
        info.correlation_id
    )
    // Enrich RTCP records with QoS metrics (jitter, loss, MOS)
    if ptype == 5 {
        rec = enrich_rtcp_record(rec, info.payload)
    }
    cap_push(store, metrics, rec)

    if ptype == 1 && sip_ok(info.payload) == 1 {
        if sip_is_request(info.payload) == 1 {
            bump_method(metrics, sip_method(info.payload))
            let _ = cmap_incr(metrics, "requests", 1)
        } else {
            let _ = cmap_incr(metrics, "responses", 1)
            let code = sip_status_code(info.payload)
            if code >= 200 && code < 300 {
                let _ = cmap_incr(metrics, "status_2xx", 1)
            } else if code >= 400 {
                let _ = cmap_incr(metrics, "status_4xx_5xx", 1)
            }
        }
    } else if ptype == 1 {
        let _ = cmap_incr(metrics, "parse_err", 1)
    }
}

// Drain complete HEP3 frames from a stream buffer; return remainder.
fn hep_buffer_drain(store: CMap, metrics: CMap, db_ch: chan[string], buf: string, transport: string) -> string {
    let mut b = buf
    // Cap buffer to limit memory DoS on a single TCP/TLS session
    if len(b) > 2097152 {
        let _ = cmap_incr(metrics, "hep_err", 1)
        return ""
    }
    while len(b) >= 6 {
        if not str_eq(b[0:4], "HEP3") {
            let idx = str_index(b, "HEP3")
            if idx < 0 {
                return ""
            }
            b = b[idx:]
            continue
        }
        let total = u16be_at(b, 4)
        if total < 6 || total > 65535 {
            // corrupt length — skip one byte and resync
            b = b[1:]
            let _ = cmap_incr(metrics, "hep_err", 1)
            continue
        }
        if len(b) < total {
            return b
        }
        // Own the frame before decode (especially important for TLS-sourced buf).
        let pkt = "" + b[0:total]
        b = b[total:]
        handle_hep_packet_via(store, metrics, db_ch, pkt, transport)
    }
    return b
}

// Returns int so it can be kicked as a per-connection crew job.
fn hep_tcp_session(store: CMap, metrics: CMap, db_ch: chan[string], fd: int) -> int {
    let peer = tcp_peer_addr(fd)
    if hep_peer_allowed(peer) == 0 {
        let _ = cmap_incr(metrics, "hep_deny", 1)
        let _ = tcp_close(fd)
        return 0
    }
    let mut buf = ""
    while 1 == 1 {
        let chunk = tcp_read(fd)
        if str_eq(chunk, "") {
            break
        }
        buf = buf + chunk
        buf = hep_buffer_drain(store, metrics, db_ch, buf, "HEP3/TCP")
        if str_eq(buf, "") && len(chunk) == 0 {
            break
        }
    }
    let _ = tcp_close(fd)
    return 0
}

// TLS session: read all data, close TLS, then parse/enqueue.
// The conn is already accepted (handshake serialized in the accept loop).
// Kicked on a nested crew so the accept loop stays responsive.
fn hep_tls_session(store: CMap, metrics: CMap, db_ch: chan[string], conn: TlsConn) -> int {
    let mut buf = ""
    while 1 == 1 {
        let chunk = tls_read(conn, 65536)
        if str_eq(chunk, "") {
            break
        }
        // Force-own TLS bytes before any later slice/parse.
        buf = buf + ("" + chunk)
        // Cap buffer to limit memory DoS on a single TLS session
        if len(buf) > 2097152 {
            let _ = cmap_incr(metrics, "hep_err", 1)
            buf = ""
            break
        }
    }
    // Close TLS BEFORE parse — avoids malloc free-of-unallocated under crew.
    let _ = tls_conn_close(conn)
    if len(buf) >= 6 {
        let owned = "" + buf
        let _ = hep_buffer_drain(store, metrics, db_ch, owned, "HEP3/TLS")
    }
    return 0
}


fn metrics_json(metrics: CMap, store: CMap) -> string {
    let started = cmap_i(metrics, "started_ms")
    let uptime = now_ms() - started
    let msgs = cmap_i(metrics, "msgs_total")
    let reqs = cmap_i(metrics, "requests")
    let resps = cmap_i(metrics, "responses")
    let echoes = cmap_i(metrics, "echoes")
    let hep_total = cmap_i(metrics, "hep_total")
    let hep_udp = cmap_i(metrics, "hep_udp")
    let hep_tcp = cmap_i(metrics, "hep_tcp")
    let hep_tls = cmap_i(metrics, "hep_tls")
    let hep_err = cmap_i(metrics, "hep_err")
    let hep_auth_fail = cmap_i(metrics, "hep_auth_fail")
    let hep_deny = cmap_i(metrics, "hep_deny")
    let hep_sip = cmap_i(metrics, "hep_sip")
    let hep_rtcp = cmap_i(metrics, "hep_rtcp")
    let hep_other = cmap_i(metrics, "hep_other")
    let parse_err = cmap_i(metrics, "parse_err")
    let probes_ok = cmap_i(metrics, "probes_ok")
    let probes_fail = cmap_i(metrics, "probes_fail")
    let probe_rtt_ms = cmap_i(metrics, "probe_rtt_ms")
    let m_invite = cmap_i(metrics, "m_INVITE")
    let m_options = cmap_i(metrics, "m_OPTIONS")
    let m_register = cmap_i(metrics, "m_REGISTER")
    let m_bye = cmap_i(metrics, "m_BYE")
    let m_ack = cmap_i(metrics, "m_ACK")
    let m_info = cmap_i(metrics, "m_INFO")
    let m_message = cmap_i(metrics, "m_MESSAGE")
    let m_unknown = cmap_i(metrics, "m_UNKNOWN")
    let status_2xx = cmap_i(metrics, "status_2xx")
    let status_4xx_5xx = cmap_i(metrics, "status_4xx_5xx")
    let db_ok = cmap_i(metrics, "db_ok")
    let db_err = cmap_i(metrics, "db_err")
    let db_drop = cmap_i(metrics, "db_drop")
    let buf = str_builder()
    builder_write(buf, "{\"service\":\"zaman-core\",\"version\":\"" + VERSION + "\"")
    builder_write(buf, ",\"uptime_ms\":" + string(uptime))
    builder_write(buf, ",\"msgs_total\":" + string(msgs))
    builder_write(buf, ",\"db_ok\":" + string(db_ok) + ",\"db_err\":" + string(db_err) + ",\"db_drop\":" + string(db_drop))
    builder_write(buf, ",\"requests\":" + string(reqs) + ",\"responses\":" + string(resps))
    builder_write(buf, ",\"echoes\":" + string(echoes))
    builder_write(buf, ",\"hep_total\":" + string(hep_total))
    builder_write(buf, ",\"hep_udp\":" + string(hep_udp) + ",\"hep_tcp\":" + string(hep_tcp) + ",\"hep_tls\":" + string(hep_tls))
    builder_write(buf, ",\"hep_err\":" + string(hep_err) + ",\"hep_auth_fail\":" + string(hep_auth_fail) + ",\"hep_deny\":" + string(hep_deny))
    builder_write(buf, ",\"hep_sip\":" + string(hep_sip) + ",\"hep_rtcp\":" + string(hep_rtcp) + ",\"hep_other\":" + string(hep_other))
    builder_write(buf, ",\"parse_err\":" + string(parse_err))
    builder_write(buf, ",\"probes_ok\":" + string(probes_ok) + ",\"probes_fail\":" + string(probes_fail) + ",\"probe_rtt_ms\":" + string(probe_rtt_ms))
    builder_write(buf, ",\"ring_size\":" + string(RING) + ",\"ring_idx\":" + string(msgs))
    builder_write(buf, ",\"methods\":{\"INVITE\":" + string(m_invite) + ",\"OPTIONS\":" + string(m_options))
    builder_write(buf, ",\"REGISTER\":" + string(m_register) + ",\"BYE\":" + string(m_bye))
    builder_write(buf, ",\"ACK\":" + string(m_ack) + ",\"INFO\":" + string(m_info))
    builder_write(buf, ",\"MESSAGE\":" + string(m_message) + ",\"UNKNOWN\":" + string(m_unknown) + "}")
    builder_write(buf, ",\"status_2xx\":" + string(status_2xx))
    builder_write(buf, ",\"status_4xx_5xx\":" + string(status_4xx_5xx) + "}")
    return builder_string(buf)
}

fn metrics_prom(metrics: CMap, store: CMap) -> string {
    let uptime = now_ms() - cmap_i(metrics, "started_ms")
    let mut o = ""
    o = o + "# HELP zaman_up Zaman core up flag\n"
    o = o + "# TYPE zaman_up gauge\n"
    o = o + "zaman_up 1\n"
    o = o + "# HELP zaman_uptime_ms Process uptime\n"
    o = o + "# TYPE zaman_uptime_ms gauge\n"
    o = o + "zaman_uptime_ms " + string(uptime) + "\n"
    o = o + "# HELP zaman_messages_total Captured SIP messages\n"
    o = o + "# TYPE zaman_messages_total counter\n"
    o = o + "zaman_messages_total " + string(cmap_i(metrics, "msgs_total")) + "\n"
    o = o + "# HELP zaman_db_dropped_total Capture records dropped after DB writer queue timeout\n"
    o = o + "# TYPE zaman_db_dropped_total counter\n"
    o = o + "zaman_db_dropped_total " + string(cmap_i(metrics, "db_drop")) + "\n"
    o = o + "# HELP zaman_requests_total SIP requests\n"
    o = o + "# TYPE zaman_requests_total counter\n"
    o = o + "zaman_requests_total " + string(cmap_i(metrics, "requests")) + "\n"
    o = o + "# HELP zaman_responses_total SIP responses\n"
    o = o + "# TYPE zaman_responses_total counter\n"
    o = o + "zaman_responses_total " + string(cmap_i(metrics, "responses")) + "\n"
    o = o + "# HELP zaman_echoes_total Auto-echo replies\n"
    o = o + "# TYPE zaman_echoes_total counter\n"
    o = o + "zaman_echoes_total " + string(cmap_i(metrics, "echoes")) + "\n"
    o = o + "# HELP zaman_hep_total HEP packets accepted\n"
    o = o + "# TYPE zaman_hep_total counter\n"
    o = o + "zaman_hep_total " + string(cmap_i(metrics, "hep_total")) + "\n"
    o = o + "# HELP zaman_hep_transport_total HEP by transport\n"
    o = o + "# TYPE zaman_hep_transport_total counter\n"
    o = o + "zaman_hep_transport_total{transport=\"udp\"} " + string(cmap_i(metrics, "hep_udp")) + "\n"
    o = o + "zaman_hep_transport_total{transport=\"tcp\"} " + string(cmap_i(metrics, "hep_tcp")) + "\n"
    o = o + "zaman_hep_transport_total{transport=\"tls\"} " + string(cmap_i(metrics, "hep_tls")) + "\n"
    o = o + "# HELP zaman_hep_auth_fail_total HEP packets rejected by password\n"
    o = o + "# TYPE zaman_hep_auth_fail_total counter\n"
    o = o + "zaman_hep_auth_fail_total " + string(cmap_i(metrics, "hep_auth_fail")) + "\n"
    o = o + "# HELP zaman_hep_deny_total HEP peers denied by allowlist\n"
    o = o + "# TYPE zaman_hep_deny_total counter\n"
    o = o + "zaman_hep_deny_total " + string(cmap_i(metrics, "hep_deny")) + "\n"
    o = o + "# HELP zaman_hep_proto_total HEP by payload protocol type\n"
    o = o + "# TYPE zaman_hep_proto_total counter\n"
    o = o + "zaman_hep_proto_total{proto=\"sip\"} " + string(cmap_i(metrics, "hep_sip")) + "\n"
    o = o + "zaman_hep_proto_total{proto=\"rtcp\"} " + string(cmap_i(metrics, "hep_rtcp")) + "\n"
    o = o + "zaman_hep_proto_total{proto=\"other\"} " + string(cmap_i(metrics, "hep_other")) + "\n"
    o = o + "# HELP zaman_probe_rtt_ms Last successful OPTIONS probe RTT\n"
    o = o + "# TYPE zaman_probe_rtt_ms gauge\n"
    o = o + "zaman_probe_rtt_ms " + string(cmap_i(metrics, "probe_rtt_ms")) + "\n"
    o = o + "# HELP zaman_sip_method_total SIP requests by method\n"
    o = o + "# TYPE zaman_sip_method_total counter\n"
    o = o + "zaman_sip_method_total{method=\"INVITE\"} " + string(cmap_i(metrics, "m_INVITE")) + "\n"
    o = o + "zaman_sip_method_total{method=\"OPTIONS\"} " + string(cmap_i(metrics, "m_OPTIONS")) + "\n"
    o = o + "zaman_sip_method_total{method=\"REGISTER\"} " + string(cmap_i(metrics, "m_REGISTER")) + "\n"
    o = o + "zaman_sip_method_total{method=\"BYE\"} " + string(cmap_i(metrics, "m_BYE")) + "\n"
    o = o + "zaman_sip_method_total{method=\"ACK\"} " + string(cmap_i(metrics, "m_ACK")) + "\n"
    o = o + "zaman_sip_method_total{method=\"INFO\"} " + string(cmap_i(metrics, "m_INFO")) + "\n"
    o = o + "zaman_sip_method_total{method=\"MESSAGE\"} " + string(cmap_i(metrics, "m_MESSAGE")) + "\n"
    o = o + "# HELP zaman_ring_idx Capture ring write index\n"
    o = o + "# TYPE zaman_ring_idx gauge\n"
    o = o + "zaman_ring_idx " + string(cmap_i(store, "idx")) + "\n"
    return o
}

// ---- messages list / filter (prefer SQLite; fall back to ring) ----

fn messages_json(store: CMap, limit: int, call_id_filter: string) -> string {
    return messages_json_ex(store, limit, call_id_filter, "", "", "", "", "", "", "", 0, 0)
}

fn messages_json_ex(store: CMap, limit: int, call_id_filter: string, transport_filter: string, agent_filter: string, method_filter: string, src_filter: string, from_filter: string, to_filter: string, status_filter: string, since_ms: int, until_ms: int) -> string {
    // ClickHouse path
    if db_is_clickhouse() == 1 {
        let from_ch = ch_messages_json(limit, call_id_filter, transport_filter, agent_filter, method_filter, src_filter, from_filter, to_filter, status_filter, since_ms, until_ms)
        if not str_eq(from_ch, "[]") {
            return from_ch
        }
    }
    // Prefer durable DB when available
    let from_db = db_messages_json_full(limit, call_id_filter, transport_filter, agent_filter, method_filter, src_filter, from_filter, to_filter, status_filter, since_ms, until_ms)
    if not str_eq(from_db, "[]") {
        return from_db
    }
    // Fallback: in-memory ring (startup / empty DB)
    let idx = cmap_i(store, "idx")
    let mut lim = limit
    if lim <= 0 {
        lim = 50
    }
    if lim > 200 {
        lim = 200
    }
    let mut out = "["
    let mut first = 1
    let mut added = 0
    let mut i = idx - 1
    while i >= 0 && added < lim {
        let rec = cap_get(store, i)
        if not str_eq(rec, "") {
            let mut keep = 1
            if not str_eq(call_id_filter, "") {
                if not str_contains(rec, "\"call_id\":\"" + jesc(call_id_filter) + "\"") {
                    keep = 0
                }
            }
            if keep == 1 && not str_eq(transport_filter, "") {
                if not str_contains(rec, "\"transport\":\"" + jesc(transport_filter) + "\"") {
                    keep = 0
                }
            }
            if keep == 1 && not str_eq(agent_filter, "") {
                if not str_contains(rec, "\"agent\":\"" + jesc(agent_filter) + "\"") {
                    keep = 0
                }
            }
            if keep == 1 && not str_eq(method_filter, "") {
                if not str_contains(rec, "\"method\":\"" + jesc(method_filter) + "\"") {
                    keep = 0
                }
            }
            if keep == 1 && not str_eq(src_filter, "") {
                if not str_contains(rec, src_filter) {
                    keep = 0
                }
            }
            if keep == 1 && not str_eq(from_filter, "") {
                if not str_contains(rec, "\"from\":\"") || not str_contains(rec, from_filter) {
                    keep = 0
                }
            }
            if keep == 1 && not str_eq(to_filter, "") {
                if not str_contains(rec, "\"to\":\"") || not str_contains(rec, to_filter) {
                    keep = 0
                }
            }
            if keep == 1 && not str_eq(status_filter, "") {
                if not str_contains(rec, "\"status\":" + status_filter) {
                    keep = 0
                }
            }
            if keep == 1 && since_ms > 0 {
                if json_get_int(rec, "ts_ms") < since_ms {
                    keep = 0
                }
            }
            if keep == 1 && until_ms > 0 {
                if json_get_int(rec, "ts_ms") > until_ms {
                    keep = 0
                }
            }
            if keep == 1 {
                let with_id = "{\"id\":" + string(i) + "," + rec[1:]
                if first == 1 {
                    first = 0
                } else {
                    out = out + ","
                }
                out = out + with_id
                added = added + 1
            }
        }
        i = i - 1
    }
    out = out + "]"
    return out
}

fn message_one_json(store: CMap, id: int) -> string {
    let from_db = db_message_one_json(id)
    if not str_eq(from_db, "") {
        return from_db
    }
    let rec = cap_get(store, id)
    if str_eq(rec, "") {
        return ""
    }
    return "{\"id\":" + string(id) + "," + rec[1:]
}

// ---- OPTIONS probe ----

fn do_probe(metrics: CMap, host: string, port: int, wait_ms: int) -> string {
    if probe_enabled() == 0 {
        let _ = cmap_incr(metrics, "probes_fail", 1)
        return "{\"ok\":false,\"error\":\"probe disabled (set ZAMAN_PROBE=1)\"}"
    }
    if host_is_blocked_for_probe(host) == 1 {
        let _ = cmap_incr(metrics, "probes_fail", 1)
        return "{\"ok\":false,\"error\":\"host blocked by probe policy\"}"
    }
    if port <= 0 || port > 65535 {
        let _ = cmap_incr(metrics, "probes_fail", 1)
        return "{\"ok\":false,\"error\":\"invalid port\"}"
    }
    // Cap wait — unbounded timeout freezes the single HTTP worker (H4).
    let mut cap = wait_ms
    if cap <= 0 {
        cap = 2000
    }
    if cap > 5000 {
        cap = 5000
    }

    let fd = sip_udp_bind("0.0.0.0", 0)
    if fd < 0 {
        let _ = cmap_incr(metrics, "probes_fail", 1)
        return "{\"ok\":false,\"error\":\"bind failed\"}"
    }
    let branch = sip_branch()
    let tag = sip_tag()
    let call_id = sip_call_id_new("zaman.probe")
    let mut h = ""
    h = sip_headers_append(h, "Via", sip_via_value_rport("UDP", "127.0.0.1", 0, branch))
    h = sip_headers_append(h, "From", sip_from_value("Zaman Probe", "sip:probe@zaman.local", tag))
    h = sip_headers_append(h, "To", sip_to_value("", "sip:echo@" + host, ""))
    h = sip_headers_append(h, "Call-ID", call_id)
    h = sip_headers_append(h, "CSeq", sip_cseq_value(1, "OPTIONS"))
    h = sip_headers_append(h, "Max-Forwards", "70")
    h = sip_headers_append(h, "User-Agent", "Zaman-Probe/" + VERSION)
    h = sip_headers_append(h, "Content-Length", "0")
    let opts = sip_request("OPTIONS", "sip:echo@" + host + ":" + string(port), h, "")

    let t0 = now_ms()
    let sent = sip_udp_send(fd, host, port, opts)
    if sent < 0 {
        let _ = udp_close(fd)
        let _ = cmap_incr(metrics, "probes_fail", 1)
        return "{\"ok\":false,\"error\":\"send failed\"}"
    }

    let _ = io_set_nonblocking(fd, 1)
    let mut waited = 0
    let mut status = 0
    let mut rtt = 0 - 1
    while waited < cap {
        let resp = sip_udp_recv(fd, 65535)
        if not str_eq(resp, "") {
            if sip_is_response(resp) == 1 {
                status = sip_status_code(resp)
                rtt = now_ms() - t0
                break
            }
        }
        sleep_ms(5)
        waited = waited + 5
    }
    let _ = udp_close(fd)

    if rtt < 0 {
        let _ = cmap_incr(metrics, "probes_fail", 1)
        return "{\"ok\":false,\"error\":\"timeout\",\"host\":\"" + jesc(host) + "\",\"port\":" + string(port) + ",\"timeout_ms\":" + string(cap) + "}"
    }
    cmap_set_i(metrics, "probe_rtt_ms", rtt)
    let _ = cmap_incr(metrics, "probes_ok", 1)
    return "{\"ok\":true,\"host\":\"" + jesc(host) + "\",\"port\":" + string(port) + ",\"status\":" + string(status) + ",\"rtt_ms\":" + string(rtt) + ",\"call_id\":\"" + jesc(call_id) + "\"}"
}

// ---- workers ----

fn sip_worker(
    store: CMap,
    metrics: CMap,
    db_ch: chan[string],
    host: string,
    port: int,
    echo_all: int
) -> int {
    let fd = sip_udp_bind(host, port)
    if fd < 0 {
        print("sip bind failed on " + host + ":" + string(port))
        return 1
    }
    print("sip  udp  " + host + ":" + string(port) + "  (echo policy: ZAMAN_ECHO_METHODS, default OPTIONS)")
    let _ = io_set_nonblocking(fd, 1)
    while 1 == 1 {
        let msg = sip_udp_recv(fd, 65535)
        if not str_eq(msg, "") {
            handle_sip_packet(store, metrics, db_ch, fd, msg, "UDP", echo_all, host, port)
        } else {
            sleep_ms(2)
        }
    }
    return 0
}

fn hep_worker(store: CMap, metrics: CMap, db_ch: chan[string], host: string, port: int) -> int {
    let fd = sip_udp_bind(host, port)
    if fd < 0 {
        print("hep bind failed on " + host + ":" + string(port))
        return 1
    }
    let pw = env_get_or("ZAMAN_HEP_PASSWORD", "")
    if str_eq(pw, "") {
        print("hep  udp  " + host + ":" + string(port) + "  (HEPv3, no password)")
    } else {
        print("hep  udp  " + host + ":" + string(port) + "  (HEPv3, password required)")
    }
    let _ = io_set_nonblocking(fd, 1)
    while 1 == 1 {
        let pkt = sip_udp_recv(fd, 65535)
        if not str_eq(pkt, "") {
            let peer = udp_last_sender()
            if hep_peer_allowed(peer) == 0 {
                let _ = cmap_incr(metrics, "hep_deny", 1)
            } else {
                handle_hep_packet_via(store, metrics, db_ch, pkt, "HEP3")
            }
        } else {
            sleep_ms(2)
        }
    }
    return 0
}

// HEP/TCP accept loop — kicked from main crew. Each accepted peer is itself
// kicked on a nested crew (Mako structured concurrency — never free `go`).
// drain(0) detaches the session job so the accept loop keeps running.
fn hep_tcp_worker(store: CMap, metrics: CMap, db_ch: chan[string], host: string, port: int) -> int {
    let fd = tcp_listen_addr(host, port)
    if fd < 0 {
        print("hep tcp bind failed on " + host + ":" + string(port))
        return 1
    }
    print("hep  tcp  " + host + ":" + string(port) + "  (HEPv3, crew.kick/session)")
    while 1 == 1 {
        let c = tcp_accept(fd)
        if c < 0 {
            sleep_ms(5)
            continue
        }
        crew sess {
            let _ = sess.kick(hep_tcp_session(store, metrics, db_ch, c))
            let _ = sess.drain(0)
        }
    }
    return 0
}

// HEP/TLS accept loop — kicked from main crew.
// All TLS I/O is inline (no nested kick): OpenSSL is not safe across
// concurrent kicked handshakes, and drain(0) cancels mid-read.
// HEP agents batch-send then close, so inline is fast enough.
fn hep_tls_worker(
    store: CMap,
    metrics: CMap,
    db_ch: chan[string],
    host: string,
    port: int,
    cert: string,
    key: string
) -> int {
    if tls_server_available() == 0 {
        print("hep  tls  skipped (OpenSSL / tls_server_available=0)")
        return idle_worker()
    }
    let srv = tls_server_new(cert, key)
    let fd = tcp_listen_addr(host, port)
    if fd < 0 {
        print("hep tls bind failed on " + host + ":" + string(port))
        return 1
    }
    print("hep  tls  " + host + ":" + string(port) + "  cert=" + cert + "  (inline session)")
    while 1 == 1 {
        let c = tcp_accept(fd)
        if c < 0 {
            sleep_ms(5)
            continue
        }
        let peer = tcp_peer_addr(c)
        if hep_peer_allowed(peer) == 0 {
            let _ = cmap_incr(metrics, "hep_deny", 1)
            let _ = tcp_close(c)
            continue
        }
        let _ = hep_tls_session(store, metrics, db_ch, tls_accept(srv, c))
    }
    return 0
}

fn idle_worker() -> int {
    while 1 == 1 {
        sleep_ms(1000)
    }
    return 0
}

fn query_get(q: string, key: string) -> string {
    // very small query parser: key=value pairs joined by &
    let parts = str_split(q, "&")
    let mut i = 0
    while i < len(parts) {
        let p = parts[i]
        let kv = str_cut(p, "=")
        if len(kv) >= 2 {
            if str_eq(kv[0], key) {
                return kv[1]
            }
        }
        i = i + 1
    }
    return ""
}

fn path_only(path: string) -> string {
    let cut = str_cut(path, "?")
    if len(cut) >= 1 {
        return cut[0]
    }
    return path
}

fn path_query(path: string) -> string {
    let cut = str_cut(path, "?")
    if len(cut) >= 2 {
        return cut[1]
    }
    return ""
}

// Rate limiting: per-IP request counter, resets every second.
// ZAMAN_RATE_LIMIT: max requests/sec per IP (default 100, 0 = disabled).
fn rate_limit_max() -> int {
    return parse_int_or(env_get_or("ZAMAN_RATE_LIMIT", "100"), 100)
}

fn rate_check(rl: CMap, ip: string) -> int {
    let max = rate_limit_max()
    if max <= 0 {
        return 1
    }
    let sec = now_ms() / 1000
    let sec_key = "s_" + string(sec)
    let ip_key = sec_key + "_" + ip
    // Reset counters from previous seconds (lazy cleanup)
    let prev_sec = "s_" + string(sec - 1)
    let prev_key = prev_sec + "_" + ip
    if cmap_i(rl, prev_key) > 0 {
        cmap_set_i(rl, prev_key, 0)
    }
    let count = cmap_i(rl, ip_key)
    if count >= max {
        return 0
    }
    let _ = cmap_incr(rl, ip_key, 1)
    return 1
}

// Validate federation record has required fields, inject "federated":true tag.
// Returns tagged JSON string or "" if invalid.
fn fed_validate_and_tag(rec: string) -> string {
    let ts = json_get_int(rec, "ts_ms")
    let src = json_get_string(rec, "src")
    let cid = json_get_string(rec, "call_id")
    let m = json_get_string(rec, "method")
    if ts <= 0 || str_eq(src, "") || str_eq(cid, "") || str_eq(m, "") {
        return ""
    }
    // Inject "federated":true if not already present
    if str_contains(rec, "\"federated\"") {
        return rec
    }
    // Insert before final '}'
    let rlen = len(rec)
    return rec[0:rlen - 1] + ",\"federated\":true}"
}

fn http_worker(store: CMap, metrics: CMap, db_ch: chan[string], port: int) -> int {
    let fd = http_bind(port)
    if fd < 0 {
        print("http bind failed on :" + string(port))
        return 1
    }
    let key = api_key_configured()
    let rate_limiter = cmap_new()
    let max_rps = rate_limit_max()
    if str_eq(key, "") {
        print("api  http 0.0.0.0:" + string(port) + "  (NO AUTH — set ZAMAN_API_KEY)  rate=" + string(max_rps) + "/s")
    } else {
        print("api  http 0.0.0.0:" + string(port) + "  (X-API-Key / Bearer)  rate=" + string(max_rps) + "/s")
    }
    while 1 == 1 {
        let c = http_accept(fd)
        if c < 0 {
            sleep_ms(5)
            continue
        }
        // Rate limiting — only trust XFF if TCP peer matches ZAMAN_TRUSTED_PROXY
        let mut rip = "direct"
        let trusted_proxy = env_get_or("ZAMAN_TRUSTED_PROXY", "")
        let peer_addr = http_header(c, "X-Real-IP")
        if not str_eq(trusted_proxy, "") {
            if str_eq(peer_addr, trusted_proxy) {
                let xff = http_header(c, "X-Forwarded-For")
                if not str_eq(xff, "") {
                    rip = xff
                }
            }
        } else {
            let xff = http_header(c, "X-Forwarded-For")
            if not str_eq(xff, "") {
                rip = xff
            }
        }
        if rate_check(rate_limiter, rip) == 0 {
            let _ = http_respond_json(c, 429, "{\"error\":\"rate limit exceeded\"}")
            let _ = http_close(c)
            let _ = cmap_incr(metrics, "rate_limited", 1)
            continue
        }

        let method = http_method(c)
        let raw_path = http_path(c)
        let path = path_only(raw_path)
        let q = path_query(raw_path)

        // Health check: minimal for unauthenticated, detailed for authenticated.
        if str_eq(path, "/health") || str_eq(path, "/api/health") {
            if api_request_authorized(c) == 1 {
                // Authenticated: full detail
                let db_ok = cmap_i(metrics, "db_ok")
                let db_err = cmap_i(metrics, "db_err")
                let db_drop = cmap_i(metrics, "db_drop")
                let msgs = cmap_i(metrics, "msgs_total")
                let uptime = now_ms() - cmap_i(metrics, "started_ms")
                let mut db_status = "sqlite"
                if db_is_clickhouse() == 1 {
                    db_status = "clickhouse"
                } else if db_is_postgres() == 1 {
                    db_status = "postgres"
                }
                let body = "{\"ok\":true,\"service\":\"zaman-core\",\"version\":\"" + VERSION + "\"" +
                    ",\"uptime_ms\":" + string(uptime) +
                    ",\"db\":{\"driver\":\"" + db_status + "\",\"writes_ok\":" + string(db_ok) + ",\"writes_err\":" + string(db_err) + ",\"writes_dropped\":" + string(db_drop) + "}" +
                    ",\"captures\":" + string(msgs) +
                    "}"
                let _ = http_respond_json(c, 200, body)
            } else {
                // Unauthenticated: liveness only
                let _ = http_respond_json(c, 200, "{\"ok\":true}")
            }
        } else if api_request_authorized(c) == 0 {
            let _ = http_respond_json(c, 401, "{\"error\":\"unauthorized\",\"hint\":\"X-API-Key or Authorization: Bearer\"}")
        } else if str_eq(path, "/api/metrics") {
            let body = metrics_json(metrics, store)
            let _ = http_respond_json(c, 200, body)
        } else if str_eq(path, "/metrics") {
            let body = metrics_prom(metrics, store)
            let _ = http_respond_ct(c, 200, "text/plain", body)
        } else if str_eq(path, "/api/messages") {
            let lim = parse_int_or(query_get(q, "limit"), 50)
            let cid = query_get(q, "call_id")
            let tr = query_get(q, "transport")
            let agent = query_get(q, "agent")
            let method = query_get(q, "method")
            let mut src = query_get(q, "ip")
            if str_eq(src, "") {
                src = query_get(q, "src")
            }
            let fromq = query_get(q, "from_number")
            let toq = query_get(q, "to_number")
            let status_i = parse_int_or(query_get(q, "status"), 0)
            let statusq = if status_i > 0 { string(status_i) } else { "" }
            let since_ms = parse_int_or(query_get(q, "since_ms"), 0)
            let until_ms = parse_int_or(query_get(q, "until_ms"), 0)
            let body = if db_is_clickhouse() == 1 {
                ch_messages_json(lim, cid, tr, agent, method, src, fromq, toq, statusq, since_ms, until_ms)
            } else if str_eq(agent, "") && str_eq(method, "") && str_eq(src, "") && str_eq(fromq, "") && str_eq(toq, "") && str_eq(statusq, "") && since_ms <= 0 && until_ms <= 0 {
                messages_json_ex(store, lim, cid, tr, "", "", "", "", "", "", 0, 0)
            } else {
                db_messages_json_full(lim, cid, tr, agent, method, src, fromq, toq, statusq, since_ms, until_ms)
            }
            let _ = http_respond_json(c, 200, body)
        } else if str_has_prefix(path, "/api/messages/") {
            let id_s = path[14:]
            let id = parse_int_or(id_s, 0 - 1)
            let one = message_one_json(store, id)
            if str_eq(one, "") {
                let _ = http_respond_json(c, 404, "{\"error\":\"not found\"}")
            } else {
                let _ = http_respond_json(c, 200, one)
            }
        } else if str_eq(path, "/api/report") || str_eq(path, "/api/report/summary") {
            let _ = http_respond_json(c, 200, db_report_summary_json())
        } else if str_eq(path, "/api/report/daily") {
            let lim = parse_int_or(query_get(q, "limit"), 30)
            let _ = http_respond_json(c, 200, db_report_daily_json(lim))
        } else if str_eq(path, "/api/report/top-calls") {
            let lim = parse_int_or(query_get(q, "limit"), 20)
            let _ = http_respond_json(c, 200, db_report_top_calls_json(lim))
        } else if str_eq(path, "/api/report/response-codes") {
            let _ = http_respond_json(c, 200, db_report_response_codes_json())
        } else if str_eq(path, "/api/report/top-talkers") {
            let lim = parse_int_or(query_get(q, "limit"), 20)
            let _ = http_respond_json(c, 200, db_report_top_talkers_json(lim))
        } else if str_eq(path, "/api/report/kpi") {
            let _ = http_respond_json(c, 200, db_report_kpi_json())
        } else if str_eq(path, "/api/report/cps") {
            let mins = parse_int_or(query_get(q, "minutes"), 60)
            let _ = http_respond_json(c, 200, db_report_cps_json(mins))
        } else if str_eq(path, "/api/report/agents") {
            let _ = http_respond_json(c, 200, db_report_agents_json())
        } else if str_eq(path, "/api/realtime") {
            let win = parse_int_or(query_get(q, "window"), 5)
            let _ = http_respond_json(c, 200, db_realtime_json(win))
        } else if str_eq(path, "/api/nodes") {
            let _ = http_respond_json(c, 200, db_node_health_json())
        } else if str_eq(path, "/api/sla/agents") {
            let _ = http_respond_json(c, 200, db_sla_by_agent_json())
        } else if str_eq(path, "/api/sla/destinations") {
            let _ = http_respond_json(c, 200, db_sla_by_dest_json())
        } else if str_eq(path, "/api/anomalies") {
            let _ = http_respond_json(c, 200, db_anomalies_json())
        } else if str_eq(path, "/api/delete") && str_eq(method, "POST") {
            let body = http_body(c)
            let del_cid = json_get_string(body, "call_id")
            let del_before = json_get_int(body, "before_ts")
            if not str_eq(del_cid, "") {
                let deldb = db_open()
                if sql_ok(deldb) == 1 {
                    let _ = sql_exec_plain(deldb, "DELETE FROM captures WHERE call_id = " + sql_quote(del_cid))
                    let _ = sql_close(deldb)
                }
                let _ = http_respond_json(c, 200, "{\"ok\":true,\"deleted_call_id\":\"" + jesc(del_cid) + "\"}")
            } else if del_before > 0 {
                let deldb = db_open()
                if sql_ok(deldb) == 1 {
                    let _ = sql_exec_plain(deldb, "DELETE FROM captures WHERE ts_ms < " + string(del_before))
                    let _ = sql_close(deldb)
                }
                let _ = http_respond_json(c, 200, "{\"ok\":true,\"deleted_before\":" + string(del_before) + "}")
            } else {
                let _ = http_respond_json(c, 400, "{\"error\":\"provide call_id or before_ts\"}")
            }
        } else if str_eq(path, "/api/related") {
            let rel_cid = query_get(q, "call_id")
            if str_eq(rel_cid, "") {
                let _ = http_respond_json(c, 400, "{\"error\":\"call_id required\"}")
            } else {
                let _ = http_respond_json(c, 200, db_related_calls_json(rel_cid))
            }
        // Grafana JSON datasource compatibility (/api/grafana/*)
        } else if str_eq(path, "/api/grafana/") || str_eq(path, "/api/grafana") {
            // Test endpoint — Grafana datasource health check
            let _ = http_respond_json(c, 200, "{\"status\":\"ok\"}")
        } else if str_eq(path, "/api/grafana/search") {
            // Available metrics
            let _ = http_respond_json(c, 200, "[\"messages_total\",\"requests\",\"responses\",\"echoes\",\"hep_total\",\"asr\",\"ner\",\"active_calls\",\"err_rate\"]")
        } else if str_eq(path, "/api/grafana/query") && str_eq(method, "POST") {
            // Return current metric values as Grafana SimpleJSON time-series
            let _ = http_body(c)
            let ts = string(now_ms())
            let msgs = string(cmap_i(metrics, "msgs_total"))
            let reqs = string(cmap_i(metrics, "requests"))
            let resps = string(cmap_i(metrics, "responses"))
            let echs = string(cmap_i(metrics, "echoes"))
            let htot = string(cmap_i(metrics, "hep_total"))
            // Fetch KPI + realtime for ASR/NER/active_calls/err_rate
            let kpi = db_report_kpi_json()
            let rt = db_realtime_json(5)
            let asr_v = string(json_get_int(kpi, "asr"))
            let ner_v = string(json_get_int(kpi, "ner"))
            let active = string(json_get_int(rt, "active_calls"))
            let errr = string(json_get_int(rt, "err_rate"))
            let _ = http_respond_json(c, 200,
                "[{\"target\":\"messages_total\",\"datapoints\":[[" + msgs + "," + ts + "]]}," +
                "{\"target\":\"requests\",\"datapoints\":[[" + reqs + "," + ts + "]]}," +
                "{\"target\":\"responses\",\"datapoints\":[[" + resps + "," + ts + "]]}," +
                "{\"target\":\"echoes\",\"datapoints\":[[" + echs + "," + ts + "]]}," +
                "{\"target\":\"hep_total\",\"datapoints\":[[" + htot + "," + ts + "]]}," +
                "{\"target\":\"asr\",\"datapoints\":[[" + asr_v + "," + ts + "]]}," +
                "{\"target\":\"ner\",\"datapoints\":[[" + ner_v + "," + ts + "]]}," +
                "{\"target\":\"active_calls\",\"datapoints\":[[" + active + "," + ts + "]]}," +
                "{\"target\":\"err_rate\",\"datapoints\":[[" + errr + "," + ts + "]]}]")
        // ── Federation: remote Zaman instances push captures here ──
        // ── QoS / MOS for a call ──
        } else if str_eq(path, "/api/qos") {
            let qos_cid = query_get(q, "call_id")
            if str_eq(qos_cid, "") {
                let _ = http_respond_json(c, 400, "{\"error\":\"call_id required\"}")
            } else {
                // Find RTCP records for this call and extract QoS
                let qos_db = db_open()
                let mut qos_out = "["
                let mut qos_first = 1
                if sql_ok(qos_db) == 1 {
                    let qos_rows = sql_query_rows(qos_db,
                        "SELECT record_json FROM captures WHERE call_id = " + sql_quote(qos_cid) +
                        " AND proto = 'rtcp' ORDER BY ts_ms", [])
                    if sql_rows_ok(qos_rows) == 1 {
                        while sql_rows_next(qos_rows) == 1 {
                            let qrec = sql_rows_str(qos_rows, 0)
                            let qos_val = json_get_string(qrec, "qos")
                            if not str_eq(qos_val, "") {
                                if qos_first == 1 {
                                    qos_first = 0
                                } else {
                                    qos_out = qos_out + ","
                                }
                                qos_out = qos_out + qos_val
                            }
                        }
                        let _ = sql_rows_close(qos_rows)
                    }
                    let _ = sql_close(qos_db)
                }
                let _ = http_respond_json(c, 200, qos_out + "]")
            }
        // ── Federation ──
        } else if str_eq(path, "/api/federation/push") && str_eq(method, "POST") {
            let body = http_body(c)
            // Body is a JSON array of capture records
            if len(body) > 2 && str_has_prefix(body, "[") {
                // Parse array and enqueue each record
                // Simple approach: split on },{ boundaries
                let mut count = 0
                let mut rejected = 0
                let mut pos = 0
                let blen = len(body)
                while pos < blen {
                    // Find next {
                    if u8_at(body, pos) == 123 {
                        // Find matching }
                        let mut depth = 0
                        let mut end = pos
                        while end < blen {
                            let ch = u8_at(body, end)
                            if ch == 123 {
                                depth = depth + 1
                            } else if ch == 125 {
                                depth = depth - 1
                                if depth == 0 {
                                    break
                                }
                            }
                            end = end + 1
                        }
                        if depth == 0 && end < blen {
                            let rec = body[pos:end + 1]
                            if len(rec) > 10 {
                                let validated = fed_validate_and_tag(rec)
                                if not str_eq(validated, "") {
                                    if db_enqueue(db_ch, validated) != 1 {
                                        let _ = cmap_incr(metrics, "db_drop", 1)
                                    }
                                    cap_push(store, metrics, validated)
                                    count = count + 1
                                } else {
                                    rejected = rejected + 1
                                }
                            }
                        }
                        pos = end + 1
                    } else {
                        pos = pos + 1
                    }
                }
                let _ = http_respond_json(c, 200, "{\"ok\":true,\"accepted\":" + string(count) + ",\"rejected\":" + string(rejected) + "}")
            } else if len(body) > 2 && str_has_prefix(body, "{") {
                // Single record
                let validated = fed_validate_and_tag(body)
                if not str_eq(validated, "") {
                    if db_enqueue(db_ch, validated) != 1 {
                        let _ = cmap_incr(metrics, "db_drop", 1)
                    }
                    cap_push(store, metrics, validated)
                    let _ = http_respond_json(c, 200, "{\"ok\":true,\"accepted\":1}")
                } else {
                    let _ = http_respond_json(c, 400, "{\"error\":\"invalid record: missing required fields (ts_ms, src, call_id, method)\"}")
                }
            } else {
                let _ = http_respond_json(c, 400, "{\"error\":\"expected JSON array or object\"}")
            }
        } else if str_eq(path, "/api/federation/health") {
            let _ = http_respond_json(c, 200, "{\"ok\":true,\"service\":\"zaman-core\",\"version\":\"" + VERSION + "\",\"federation\":true}")
        } else if str_eq(path, "/api/export") {
            let lim = parse_int_or(query_get(q, "limit"), 100)
            let cid = query_get(q, "call_id")
            let tr = query_get(q, "transport")
            let body = messages_json_ex(store, lim, cid, tr, "", "", "", "", "", "", 0, 0)
            let _ = http_respond_ct(c, 200, "application/json", body)
        } else if str_eq(path, "/api/probe") && str_eq(method, "POST") {
            let body = http_body(c)
            let mut host = json_get_string(body, "host")
            let mut port_p = json_get_int(body, "port")
            let mut wait_ms = json_get_int(body, "timeout_ms")
            if str_eq(host, "") {
                host = "127.0.0.1"
            }
            if port_p <= 0 {
                port_p = 5060
            }
            if wait_ms <= 0 {
                wait_ms = 2000
            }
            if wait_ms > 5000 {
                wait_ms = 5000
            }
            let result = do_probe(metrics, host, port_p, wait_ms)
            if str_contains(result, "probe disabled") || str_contains(result, "host blocked") {
                let _ = http_respond_json(c, 403, result)
            } else {
                let _ = http_respond_json(c, 200, result)
            }
        } else if str_eq(path, "/api/stats") {
            let _ = http_respond_json(c, 200, metrics_json(metrics, store))
        } else {
            let _ = http_respond_json(c, 404, "{\"error\":\"not found\",\"hint\":\"/api/health /api/metrics /api/messages /api/report /api/probe /metrics\"}")
        }
        let _ = http_close(c)
    }
    return 0
}

// ---- main ----

fn main() {
    let mut sip_host = env_get_or("ZAMAN_SIP_HOST", "0.0.0.0")
    let mut sip_port = parse_int_or(env_get_or("ZAMAN_SIP_PORT", "5060"), 5060)
    let mut hep_port = parse_int_or(env_get_or("ZAMAN_HEP_PORT", "9060"), 9060)
    // Separate default from UDP: some runtimes abort when UDP+TCP share a port.
    let mut hep_tcp_port = parse_int_or(env_get_or("ZAMAN_HEP_TCP_PORT", "9062"), 9062)
    let mut hep_tls_port = parse_int_or(env_get_or("ZAMAN_HEP_TLS_PORT", "9061"), 9061)
    let mut api_port = parse_int_or(env_get_or("ZAMAN_API_PORT", "9090"), 9090)
    let echo_all = parse_int_or(env_get_or("ZAMAN_ECHO_ALL", "0"), 0)
    // HEP/TCP opt-in (default off): some multi-worker layouts abort under
    // concurrent HTTP+TCP on current Mako; enable explicitly for production agents.
    let hep_tcp_on = parse_int_or(env_get_or("ZAMAN_HEP_TCP", "0"), 0)
    let hep_tls_on = parse_int_or(env_get_or("ZAMAN_HEP_TLS", "0"), 0)
    let tls_cert = env_get_or("ZAMAN_HEP_TLS_CERT", "")
    let tls_key = env_get_or("ZAMAN_HEP_TLS_KEY", "")

    // CLI overrides: zaman-core [sip_port] [hep_port] [api_port]
    if argc() > 1 {
        sip_port = parse_int_or(arg_get(1), sip_port)
    }
    if argc() > 2 {
        hep_port = parse_int_or(arg_get(2), hep_port)
    }
    if argc() > 3 {
        api_port = parse_int_or(arg_get(3), api_port)
    }
    // Optional: share UDP port for TCP when set to 0
    if hep_tcp_port <= 0 {
        hep_tcp_port = hep_port
    }

    print("zaman-core " + VERSION)
    if db_is_postgres() == 1 {
        print("integrated SIP capture + echo + HEP (UDP/TCP/TLS) + metrics + PostgreSQL reporting")
    } else {
        print("integrated SIP capture + echo + HEP (UDP/TCP/TLS) + metrics + SQLite reporting")
    }
    let fed_target = env_get_or("ZAMAN_FEDERATION_TARGET", "")
    if not str_eq(fed_target, "") {
        print("federation: forwarding to " + fed_target)
    }
    print("security: ZAMAN_API_KEY · ZAMAN_HEP_PASSWORD · ZAMAN_HEP_ALLOW · ZAMAN_PROBE")

    let _ = db_init()

    let metrics = cmap_new()
    let store = cmap_new()
    cmap_set_i(metrics, "started_ms", now_ms())
    cmap_set_i(store, "idx", 0)
    cmap_set_i(metrics, "db_ok", 0)
    cmap_set_i(metrics, "db_err", 0)
    cmap_set_i(metrics, "db_drop", 0)

    // Capture path: kicked workers enqueue JSON → kicked db_writer owns SQLite.
    let db_ch = chan_open[string](DB_CH_CAP)

    // One structured crew per process. Only kick enabled collectors (no idle
    // filler jobs — extra always-on kicks have aborted HTTP accept on some layouts).
    let want_tcp = hep_tcp_on
    let mut want_tls = 0
    if hep_tls_on == 1 && not str_eq(tls_cert, "") && not str_eq(tls_key, "") {
        want_tls = 1
    } else if hep_tls_on == 1 {
        print("hep  tls  disabled (set ZAMAN_HEP_TLS_CERT and ZAMAN_HEP_TLS_KEY)")
    }

    if want_tcp == 0 && want_tls == 0 {
        crew t {
            let w = t.kick(db_writer(db_ch, metrics))
            let s = t.kick(sip_worker(store, metrics, db_ch, sip_host, sip_port, echo_all))
            let h = t.kick(hep_worker(store, metrics, db_ch, sip_host, hep_port))
            let a = t.kick(http_worker(store, metrics, db_ch, api_port))
            let _ = w.join()
            let _ = s.join()
            let _ = h.join()
            let _ = a.join()
        }
    } else if want_tcp == 1 && want_tls == 0 {
        crew t {
            let w = t.kick(db_writer(db_ch, metrics))
            let s = t.kick(sip_worker(store, metrics, db_ch, sip_host, sip_port, echo_all))
            let h = t.kick(hep_worker(store, metrics, db_ch, sip_host, hep_port))
            let a = t.kick(http_worker(store, metrics, db_ch, api_port))
            let ht = t.kick(hep_tcp_worker(store, metrics, db_ch, sip_host, hep_tcp_port))
            let _ = w.join()
            let _ = s.join()
            let _ = h.join()
            let _ = a.join()
            let _ = ht.join()
        }
    } else if want_tcp == 0 && want_tls == 1 {
        crew t {
            let w = t.kick(db_writer(db_ch, metrics))
            let s = t.kick(sip_worker(store, metrics, db_ch, sip_host, sip_port, echo_all))
            let h = t.kick(hep_worker(store, metrics, db_ch, sip_host, hep_port))
            let a = t.kick(http_worker(store, metrics, db_ch, api_port))
            let hl = t.kick(hep_tls_worker(store, metrics, db_ch, sip_host, hep_tls_port, tls_cert, tls_key))
            let _ = w.join()
            let _ = s.join()
            let _ = h.join()
            let _ = a.join()
            let _ = hl.join()
        }
    } else {
        crew t {
            let w = t.kick(db_writer(db_ch, metrics))
            let s = t.kick(sip_worker(store, metrics, db_ch, sip_host, sip_port, echo_all))
            let h = t.kick(hep_worker(store, metrics, db_ch, sip_host, hep_port))
            let a = t.kick(http_worker(store, metrics, db_ch, api_port))
            let ht = t.kick(hep_tcp_worker(store, metrics, db_ch, sip_host, hep_tcp_port))
            let hl = t.kick(hep_tls_worker(store, metrics, db_ch, sip_host, hep_tls_port, tls_cert, tls_key))
            let _ = w.join()
            let _ = s.join()
            let _ = h.join()
            let _ = a.join()
            let _ = ht.join()
            let _ = hl.join()
        }
    }
}
