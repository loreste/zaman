// Zaman core — integrated SIP capture, echo, HEP, metrics, and JSON API.
// Ports (defaults): SIP 5060/udp · HEP 9060/udp · API 9090/tcp
//
//   makori run core/main.mko
//   makori build --release core/main.mko -o bin/zaman-core

const RING = 512
const VERSION = "0.3.0"
// Capture enqueue buffer — backpressures SIP/HEP workers when the DB lags.
const DB_CH_CAP = 1024
// DB writer uses `for j in range ch` — loop exits when channel closes.

// ---- small helpers ----

fn jesc(s: string) -> string {
    // JSON string escape via str_builder (makori 0.6+). SIP headers are untrusted.
    let buf = str_builder()
    let hex = "0123456789abcdef"
    let mut i = 0
    let n = len(s)
    while i < n {
        let b = int(s[i])
        if b == 34 {
            builder_write(buf, "\\\"")
        } else if b == 92 {
            builder_write(buf, "\\\\")
        } else if b == 8 {
            builder_write(buf, "\\b")
        } else if b == 12 {
            builder_write(buf, "\\f")
        } else if b == 10 {
            builder_write(buf, "\\n")
        } else if b == 13 {
            builder_write(buf, "\\r")
        } else if b == 9 {
            builder_write(buf, "\\t")
        } else if b < 32 {
            builder_write(buf, "\\u00" + hex[b / 16:b / 16 + 1] + hex[b % 16:b % 16 + 1])
        } else {
            builder_write(buf, s[i:i + 1])
        }
        i = i + 1
    }
    return builder_string(buf)
}

// Strip credential-bearing headers before store/export.
fn redact_sip(msg: string) -> string {
    // Line-based pass for Authorization / Proxy-Authorization (case-insensitive).
    let lines = str_split(msg, "\n")
    let mut kept = ""
    let mut i = 0
    while i < len(lines) {
        let line = lines[i]
        let lower = str_to_lower(line)
        let mut drop = 0
        if str_has_prefix(lower, "authorization:") {
            drop = 1
        }
        if str_has_prefix(lower, "proxy-authorization:") {
            drop = 1
        }
        if drop == 0 {
            if i > 0 {
                // preserve \n joins (CR may still be on lines from \r\n split)
                kept = kept + "\n" + line
            } else {
                kept = line
            }
        } else {
            if i == 0 {
                kept = "Authorization: [REDACTED]\r"
            } else {
                kept = kept + "\nAuthorization: [REDACTED]\r"
            }
        }
        i = i + 1
    }
    return kept
}

fn probe_enabled() -> int {
    return parse_int_or(env_get_or("ZAMAN_PROBE", "0"), 0)
}

fn host_is_private_ipv4(host: string) -> int {
    if str_has_prefix(host, "10.") {
        return 1
    }
    if str_has_prefix(host, "192.168.") {
        return 1
    }
    if str_has_prefix(host, "127.") {
        return 1
    }
    if str_has_prefix(host, "172.") {
        // 172.16.0.0/12
        let parts = str_split(host, ".")
        if len(parts) >= 2 {
            let second = parse_int_or(parts[1], 0)
            if second >= 16 && second <= 31 {
                return 1
            }
        }
    }
    return 0
}

fn host_is_blocked_for_probe(host: string) -> int {
    // Always block cloud metadata / link-local abuse targets.
    if str_eq(host, "169.254.169.254") {
        return 1
    }
    if str_eq(host, "metadata.google.internal") {
        return 1
    }
    if str_has_prefix(host, "169.254.") {
        return 1
    }
    // Localhost always allowed for loopback self-tests.
    if str_eq(host, "127.0.0.1") || str_eq(host, "::1") || str_eq(host, "localhost") {
        return 0
    }
    // Other private/RFC1918 blocked unless ZAMAN_PROBE_ALLOW_PRIVATE=1
    let allow_priv = parse_int_or(env_get_or("ZAMAN_PROBE_ALLOW_PRIVATE", "0"), 0)
    if allow_priv == 0 && host_is_private_ipv4(host) == 1 {
        return 1
    }
    return 0
}

// ZAMAN_HEP_ALLOW: empty = any peer; else comma-separated IPs or prefixes (e.g. 10.0.0.,203.0.113.5)
fn hep_peer_host(peer: string) -> string {
    // peer may be "1.2.3.4:5060" or "[::1]:5060"
    if str_has_prefix(peer, "[") {
        let cut = str_cut(peer, "]")
        if len(cut) >= 1 {
            let h = cut[0]
            if str_has_prefix(h, "[") {
                return h[1:]
            }
            return h
        }
    }
    let cut = str_cut(peer, ":")
    if len(cut) >= 1 {
        return cut[0]
    }
    return peer
}

fn hep_peer_allowed(peer: string) -> int {
    let allow = env_get_or("ZAMAN_HEP_ALLOW", "")
    if str_eq(allow, "") {
        return 1
    }
    let host = hep_peer_host(peer)
    let parts = str_split(allow, ",")
    let mut i = 0
    while i < len(parts) {
        let p = str_trim_space(parts[i])
        if str_eq(p, "") {
            // skip
        } else if str_eq(p, host) {
            return 1
        } else if str_has_prefix(host, p) {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn api_key_configured() -> string {
    return env_get_or("ZAMAN_API_KEY", "")
}

// Constant-time string comparison (crypto_eq builtin, makori 0.6+).
fn ct_str_eq(a: string, b: string) -> int {
    return crypto_eq(a, b)
}

fn api_request_authorized(c: int) -> int {
    let want = api_key_configured()
    if str_eq(want, "") {
        return 1
    }
    let h = http_header(c, "X-API-Key")
    if ct_str_eq(h, want) == 1 {
        return 1
    }
    let auth = http_header(c, "Authorization")
    if str_has_prefix(auth, "Bearer ") {
        let tok = auth[7:]
        if ct_str_eq(tok, want) == 1 {
            return 1
        }
    }
    return 0
}

fn u8_at(s: string, i: int) -> int {
    if i < 0 || i >= len(s) {
        return 0
    }
    return int(s[i])
}

fn u16be_at(s: string, i: int) -> int {
    if i + 2 > len(s) {
        return 0
    }
    return binary_u16be(s[i:i + 2])
}

fn u32be_at(s: string, i: int) -> int {
    if i + 4 > len(s) {
        return 0
    }
    return binary_u32be(s[i:i + 4])
}

fn ipv4_at(s: string, i: int) -> string {
    if i + 4 > len(s) {
        return ""
    }
    return string(u8_at(s, i)) + "." + string(u8_at(s, i + 1)) + "." + string(u8_at(s, i + 2)) + "." + string(u8_at(s, i + 3))
}

fn hex_nibble(n: int) -> string {
    let h = "0123456789abcdef"
    if n < 0 || n > 15 {
        return "0"
    }
    return h[n:n + 1]
}

fn ipv6_at(s: string, i: int) -> string {
    // Compress-free hextet form a:b:c:d:e:f:g:h
    if i + 16 > len(s) {
        return ""
    }
    let mut out = ""
    let mut g = 0
    while g < 8 {
        let off = i + g * 2
        let v = u16be_at(s, off)
        if g > 0 {
            out = out + ":"
        }
        // strip leading zeros per hextet for readability
        out = out + hex_nibble((v / 4096) % 16) + hex_nibble((v / 256) % 16) + hex_nibble((v / 16) % 16) + hex_nibble(v % 16)
        g = g + 1
    }
    return out
}

fn proto_type_name(t: int) -> string {
    if t == 1 {
        return "sip"
    }
    if t == 5 {
        return "rtcp"
    }
    if t == 34 {
        return "rtpagent"
    }
    if t == 35 {
        return "rtcpxr"
    }
    if t == 38 {
        return "horaclifix"
    }
    if t == 53 {
        return "dns"
    }
    if t == 100 {
        return "log"
    }
    if t == 0 {
        return "unknown"
    }
    return "proto-" + string(t)
}

fn parse_int_or(s: string, fallback: int) -> int {
    match parse_int(s) {
        Ok(v) => v,
        Err(_) => fallback,
    }
}

fn cmap_i(m: CMap, key: string) -> int {
    return parse_int_or(cmap_get(m, key), 0)
}

fn cmap_set_i(m: CMap, key: string, v: int) {
    cmap_set(m, key, string(v))
}

// ---- Database persistence + reporting ----
// Backend: SQLite (default), PostgreSQL, or ClickHouse.
// SQLite: ZAMAN_DB path (default data/zaman.db), WAL mode.
// Postgres: ZAMAN_DB_DSN connection string.
// ClickHouse: ZAMAN_CH_URL HTTP endpoint (e.g. "http://localhost:8123").
//   ClickHouse uses the HTTP interface — no native driver needed.
//   Optimized for millions of inserts/day with batch writes.

fn db_driver() -> string {
    return env_get_or("ZAMAN_DB_DRIVER", "sqlite")
}

fn db_is_postgres() -> int {
    let d = db_driver()
    if str_eq(d, "postgres") || str_eq(d, "postgresql") || str_eq(d, "pg") {
        return 1
    }
    return 0
}

fn db_is_clickhouse() -> int {
    let d = db_driver()
    if str_eq(d, "clickhouse") || str_eq(d, "ch") {
        return 1
    }
    return 0
}

fn db_path() -> string {
    return env_get_or("ZAMAN_DB", "data/zaman.db")
}

fn db_dsn() -> string {
    return env_get_or("ZAMAN_DB_DSN", "host=localhost dbname=zaman sslmode=disable")
}

fn ch_url() -> string {
    return env_get_or("ZAMAN_CH_URL", "http://localhost:8123")
}

fn ch_db() -> string {
    return env_get_or("ZAMAN_CH_DB", "zaman")
}

// ClickHouse HTTP query: POST sql to http://host:8123/?database=db
fn ch_exec(sql: string) -> string {
    let url = ch_url() + "/?database=" + ch_db()
    return http_post(url, sql)
}

fn ch_query(sql: string) -> string {
    let url = ch_url() + "/?database=" + ch_db()
    return http_post(url, sql + " FORMAT JSONEachRow")
}

fn ch_query_tsv(sql: string) -> string {
    let url = ch_url() + "/?database=" + ch_db()
    return http_post(url, sql + " FORMAT TabSeparated")
}

fn sql_quote(s: string) -> string {
    let s1 = str_replace(s, "\\", "\\\\")
    return "'" + str_replace(s1, "'", "''") + "'"
}

fn db_ensure_dir() {
    if db_is_postgres() == 1 || db_is_clickhouse() == 1 {
        return
    }
    let p = db_path()
    let dir = path_dir(p)
    if not str_eq(dir, "") && not str_eq(dir, ".") {
        let _ = mkdir(dir)
    }
}

fn db_open() -> SqlDB {
    if db_is_postgres() == 1 {
        return sql_open_postgres(db_dsn())
    }
    db_ensure_dir()
    let db = sql_open_sqlite(db_path())
    if sql_ok(db) == 1 {
        let _ = sql_exec_plain(db, "PRAGMA journal_mode=WAL")
        let _ = sql_exec_plain(db, "PRAGMA busy_timeout=5000")
        let _ = sql_exec_plain(db, "PRAGMA synchronous=NORMAL")
    }
    return db
}

fn ch_init() -> int {
    // Create database
    let _ = http_post(ch_url(), "CREATE DATABASE IF NOT EXISTS " + ch_db())
    // Captures table: MergeTree ordered by ts_ms for fast time-range scans
    let _ = ch_exec(
        "CREATE TABLE IF NOT EXISTS captures (" +
        "id UInt64 DEFAULT generateSnowflakeID()," +
        "ts_ms Int64," +
        "src String DEFAULT ''," +
        "dst String DEFAULT ''," +
        "transport String DEFAULT ''," +
        "proto String DEFAULT ''," +
        "agent String DEFAULT ''," +
        "kind String DEFAULT ''," +
        "method String DEFAULT ''," +
        "status Int32 DEFAULT 0," +
        "call_id String DEFAULT ''," +
        "from_h String DEFAULT ''," +
        "to_h String DEFAULT ''," +
        "cseq String DEFAULT ''," +
        "ruri String DEFAULT ''," +
        "hep_node_id Int32 DEFAULT 0," +
        "hep_node String DEFAULT ''," +
        "hep_cid String DEFAULT ''," +
        "size Int32 DEFAULT 0," +
        "raw_b64 String DEFAULT ''," +
        "record_json String DEFAULT ''" +
        ") ENGINE = MergeTree() ORDER BY (ts_ms, call_id) PARTITION BY toYYYYMM(fromUnixTimestamp64Milli(ts_ms))")
    let _ = ch_exec("CREATE TABLE IF NOT EXISTS report_daily (" +
        "day String," +
        "method String," +
        "transport String," +
        "cnt Int64 DEFAULT 0" +
        ") ENGINE = SummingMergeTree(cnt) ORDER BY (day, method, transport)")
    print("db   clickhouse " + ch_url() + " db=" + ch_db())
    return 1
}

fn db_init() -> int {
    if db_is_clickhouse() == 1 {
        return ch_init()
    }
    let db = db_open()
    if sql_ok(db) == 0 {
        if db_is_postgres() == 1 {
            print("db  open failed: postgres " + db_dsn())
        } else {
            print("db  open failed: " + db_path())
        }
        return 0
    }
    if db_is_postgres() == 1 {
        // PostgreSQL schema — SERIAL instead of AUTOINCREMENT, TEXT defaults
        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS captures (" +
            "id SERIAL PRIMARY KEY," +
            "ts_ms BIGINT NOT NULL," +
            "src TEXT," +
            "dst TEXT," +
            "transport TEXT," +
            "proto TEXT," +
            "agent TEXT," +
            "kind TEXT," +
            "method TEXT," +
            "status INTEGER DEFAULT 0," +
            "call_id TEXT," +
            "from_h TEXT," +
            "to_h TEXT," +
            "cseq TEXT," +
            "ruri TEXT," +
            "hep_node_id INTEGER DEFAULT 0," +
            "hep_node TEXT," +
            "hep_cid TEXT," +
            "size INTEGER DEFAULT 0," +
            "raw_b64 TEXT," +
            "record_json TEXT NOT NULL DEFAULT ''" +
            ")")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_cap_ts ON captures(ts_ms DESC)")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_cap_call ON captures(call_id)")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_cap_method ON captures(method)")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_cap_transport ON captures(transport)")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_cap_agent ON captures(agent)")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_cap_from ON captures(from_h)")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_cap_to ON captures(to_h)")
        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS report_daily (" +
            "day TEXT NOT NULL," +
            "method TEXT NOT NULL," +
            "transport TEXT NOT NULL," +
            "cnt INTEGER NOT NULL DEFAULT 0," +
            "PRIMARY KEY(day, method, transport)" +
            ")")
        let _ = sql_close(db)
        print("db   postgres " + db_dsn())
    } else {
        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS captures (" +
            "id INTEGER PRIMARY KEY AUTOINCREMENT," +
            "ts_ms INTEGER NOT NULL," +
            "src TEXT," +
            "dst TEXT," +
            "transport TEXT," +
            "proto TEXT," +
            "agent TEXT," +
            "kind TEXT," +
            "method TEXT," +
            "status INTEGER DEFAULT 0," +
            "call_id TEXT," +
            "from_h TEXT," +
            "to_h TEXT," +
            "cseq TEXT," +
            "ruri TEXT," +
            "hep_node_id INTEGER DEFAULT 0," +
            "hep_node TEXT," +
            "hep_cid TEXT," +
            "size INTEGER DEFAULT 0," +
            "raw_b64 TEXT," +
            "record_json TEXT NOT NULL DEFAULT ''" +
            ")")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_cap_ts ON captures(ts_ms DESC)")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_cap_call ON captures(call_id)")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_cap_method ON captures(method)")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_cap_transport ON captures(transport)")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_cap_agent ON captures(agent)")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_cap_from ON captures(from_h)")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_cap_to ON captures(to_h)")
        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS report_daily (" +
            "day TEXT NOT NULL," +
            "method TEXT NOT NULL," +
            "transport TEXT NOT NULL," +
            "cnt INTEGER NOT NULL DEFAULT 0," +
            "PRIMARY KEY(day, method, transport)" +
            ")")
        // Schema version tracking
        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS schema_version (version INTEGER NOT NULL)")
        let sv = sql_query_int(db, "SELECT version FROM schema_version LIMIT 1", [])
        if sv <= 0 {
            let _ = sql_exec_plain(db, "INSERT INTO schema_version(version) VALUES (2)")
        }
        let _ = sql_close(db)
        print("db   sqlite " + db_path() + " schema=v2")
    }
    return 1
}

fn day_key(ts_ms: int) -> string {
    // Day bucket as unix-day integer string (stable, no locale).
    let mut sec = ts_ms / 1000
    if sec < 0 {
        sec = 0
    }
    return string(sec / 86400)
}

// ClickHouse insert: single INSERT with all fields (no UPDATE, append-only).
fn ch_insert_json(record_json: string) -> int {
    let ts_ms = json_get_int(record_json, "ts_ms")
    let status = json_get_int(record_json, "status")
    let hep_node_id = json_get_int(record_json, "hep_node_id")
    let size = json_get_int(record_json, "size")
    let src = json_get_string(record_json, "src")
    let dst = json_get_string(record_json, "dst")
    let transport = json_get_string(record_json, "transport")
    let proto = json_get_string(record_json, "proto")
    let agent = json_get_string(record_json, "agent")
    let kind = json_get_string(record_json, "kind")
    let method = json_get_string(record_json, "method")
    let call_id = json_get_string(record_json, "call_id")
    let from_h = json_get_string(record_json, "from")
    let to_h = json_get_string(record_json, "to")
    let cseq = json_get_string(record_json, "cseq")
    let ruri = json_get_string(record_json, "ruri")
    let hep_node = json_get_string(record_json, "hep_node")
    let hep_cid = json_get_string(record_json, "hep_cid")
    let raw_b64 = json_get_string(record_json, "raw_b64")
    let sql = "INSERT INTO captures (ts_ms, src, dst, transport, proto, agent, kind, method, status, call_id, from_h, to_h, cseq, ruri, hep_node_id, hep_node, hep_cid, size, raw_b64, record_json) VALUES (" +
        string(ts_ms) + "," +
        sql_quote(src) + "," + sql_quote(dst) + "," + sql_quote(transport) + "," +
        sql_quote(proto) + "," + sql_quote(agent) + "," + sql_quote(kind) + "," +
        sql_quote(method) + "," + string(status) + "," + sql_quote(call_id) + "," +
        sql_quote(from_h) + "," + sql_quote(to_h) + "," + sql_quote(cseq) + "," +
        sql_quote(ruri) + "," + string(hep_node_id) + "," + sql_quote(hep_node) + "," +
        sql_quote(hep_cid) + "," + string(size) + "," + sql_quote(raw_b64) + "," +
        sql_quote(record_json) + ")"
    let _ = ch_exec(sql)
    // Daily rollup via SummingMergeTree
    let mut m = method
    if str_eq(m, "") {
        m = "UNKNOWN"
    }
    let mut tr = transport
    if str_eq(tr, "") {
        tr = "UDP"
    }
    let _ = ch_exec("INSERT INTO report_daily (day, method, transport, cnt) VALUES (" +
        sql_quote(day_key(ts_ms)) + "," + sql_quote(m) + "," + sql_quote(tr) + ",1)")
    return 1
}

// Insert one capture from record JSON on an already-open connection.
// Uses chan[string] (not multi-field struct) — large struct channels have
// triggered libmalloc free-of-unallocated under multi-worker stress.
fn db_insert_json(db: SqlDB, record_json: string) -> int {
    if sql_ok(db) == 0 {
        return 0
    }
    let ts_ms = json_get_int(record_json, "ts_ms")
    let status = json_get_int(record_json, "status")
    let hep_node_id = json_get_int(record_json, "hep_node_id")
    let size = json_get_int(record_json, "size")
    let src = json_get_string(record_json, "src")
    let dst = json_get_string(record_json, "dst")
    let transport = json_get_string(record_json, "transport")
    let proto = json_get_string(record_json, "proto")
    let agent = json_get_string(record_json, "agent")
    let kind = json_get_string(record_json, "kind")
    let method = json_get_string(record_json, "method")
    let call_id = json_get_string(record_json, "call_id")
    let from_h = json_get_string(record_json, "from")
    let to_h = json_get_string(record_json, "to")
    let cseq = json_get_string(record_json, "cseq")
    let ruri = json_get_string(record_json, "ruri")
    let hep_node = json_get_string(record_json, "hep_node")
    let hep_cid = json_get_string(record_json, "hep_cid")
    let raw_b64 = json_get_string(record_json, "raw_b64")

    // Shell row with integers + empty record_json; fill text via bound UPDATEs.
    let mut id = 0
    if db_is_postgres() == 1 {
        // PostgreSQL: use RETURNING to get the new id
        let ret_rows = sql_query_rows(db,
            "INSERT INTO captures(ts_ms, status, hep_node_id, size, record_json) VALUES (" +
            string(ts_ms) + "," + string(status) + "," + string(hep_node_id) + "," +
            string(size) + ",'') RETURNING id", [])
        if sql_rows_ok(ret_rows) == 1 && sql_rows_next(ret_rows) == 1 {
            id = sql_rows_int(ret_rows, 0)
        }
        let _ = sql_rows_close(ret_rows)
    } else {
        let _ = sql_exec_plain(db,
            "INSERT INTO captures(ts_ms, status, hep_node_id, size, record_json) VALUES (" +
            string(ts_ms) + "," + string(status) + "," + string(hep_node_id) + "," +
            string(size) + ",'')")
        id = sql_last_insert_id(db)
    }
    if id <= 0 {
        return 0
    }
    let id_s = string(id)
    let _ = sql_exec_str4(db,
        "UPDATE captures SET src=?, dst=?, transport=?, proto=? WHERE id=" + id_s,
        src, dst, transport, proto)
    let _ = sql_exec_str4(db,
        "UPDATE captures SET agent=?, kind=?, method=?, call_id=? WHERE id=" + id_s,
        agent, kind, method, call_id)
    let _ = sql_exec_str4(db,
        "UPDATE captures SET from_h=?, to_h=?, cseq=?, ruri=? WHERE id=" + id_s,
        from_h, to_h, cseq, ruri)
    let _ = sql_exec_str4(db,
        "UPDATE captures SET hep_node=?, hep_cid=?, raw_b64=?, record_json=? WHERE id=" + id_s,
        hep_node, hep_cid, raw_b64, record_json)
    // daily rollup
    let day = day_key(ts_ms)
    let mut m = method
    if str_eq(m, "") {
        m = "UNKNOWN"
    }
    let mut tr = transport
    if str_eq(tr, "") {
        tr = "UDP"
    }
    let up_expr = if db_is_postgres() == 1 {
        "cnt = report_daily.cnt + 1"
    } else {
        "cnt = cnt + 1"
    }
    let up = "INSERT INTO report_daily(day, method, transport, cnt) VALUES (" +
        sql_quote(day) + "," + sql_quote(m) + "," + sql_quote(tr) + ",1) " +
        "ON CONFLICT(day, method, transport) DO UPDATE SET " + up_expr
    let _ = sql_exec_plain(db, up)
    // opportunistic retention
    if id % 64 == 0 {
        let days = parse_int_or(env_get_or("ZAMAN_DB_RETENTION_DAYS", "14"), 14)
        if days > 0 {
            let cutoff = now_ms() - days * 86400 * 1000
            let _ = sql_exec_plain(db, "DELETE FROM captures WHERE ts_ms < " + string(cutoff))
            let _ = sql_exec_plain(db, "DELETE FROM report_daily WHERE day < " + sql_quote(day_key(cutoff)))
        }
    }
    return 1
}

// Enqueue record JSON for the single kicked DB writer (blocks if channel full).
fn db_enqueue(ch: chan[string], record_json: string) -> int {
    return ch.send_timeout(record_json, 25)
}

// Single-writer job: owns one SQLite connection, drains via range.
// Range exits when the channel is closed (graceful shutdown).
fn db_writer(ch: chan[string], metrics: CMap) -> int {
    if db_is_clickhouse() == 1 {
        return ch_writer(ch, metrics)
    }
    print("db   writer kick (chan[string] cap=" + string(DB_CH_CAP) + ")")
    let mut db = db_open()
    if sql_ok(db) == 0 {
        print("db   writer open failed: " + db_path())
        for j in range ch {
            let _ = cmap_incr(metrics, "db_err", 1)
        }
        return 0
    }
    let mut n = 0
    let mut fail_streak = 0
    for j in range ch {
        if db_insert_json(db, j) == 1 {
            n = n + 1
            fail_streak = 0
            let _ = cmap_incr(metrics, "db_ok", 1)
        } else {
            fail_streak = fail_streak + 1
            let _ = cmap_incr(metrics, "db_err", 1)
            if db_is_postgres() == 1 && fail_streak >= 3 {
                print("db   writer reconnect after " + string(fail_streak) + " failed inserts")
                let _ = sql_close(db)
                sleep_ms(250)
                db = db_open()
                fail_streak = 0
                if sql_ok(db) == 0 {
                    print("db   writer reconnect failed")
                    sleep_ms(1000)
                } else {
                    print("db   writer reconnected")
                }
            }
        }
    }
    let _ = sql_close(db)
    print("db   writer stop after " + string(n) + " inserts")
    return n
}

// ClickHouse writer: batch inserts for high throughput.
// Buffers rows and flushes every BATCH_SIZE or when channel drains.
fn ch_writer(ch: chan[string], metrics: CMap) -> int {
    print("db   writer kick clickhouse (chan[string] cap=" + string(DB_CH_CAP) + ")")
    let mut n = 0
    for j in range ch {
        if ch_insert_json(j) == 1 {
            n = n + 1
            let _ = cmap_incr(metrics, "db_ok", 1)
        } else {
            let _ = cmap_incr(metrics, "db_err", 1)
        }
    }
    print("db   writer stop after " + string(n) + " inserts")
    return n
}

fn db_messages_json(limit: int, call_id_filter: string, transport_filter: string) -> string {
    return db_messages_json_full(limit, call_id_filter, transport_filter, "", "", "", "", "", "", 0, 0)
}

// ClickHouse query helper: returns JSON array from a SELECT that includes record_json.
fn ch_messages_json(limit: int, call_id_filter: string, transport_filter: string, agent_filter: string, method_filter: string, src_filter: string, from_filter: string, to_filter: string, status_filter: string, since_ms: int, until_ms: int) -> string {
    let mut lim = limit
    if lim <= 0 {
        lim = 50
    }
    if lim > 500 {
        lim = 500
    }
    let mut sql = "SELECT id, record_json FROM captures WHERE 1=1"
    if not str_eq(call_id_filter, "") {
        sql = sql + " AND call_id = " + sql_quote(call_id_filter)
    }
    if not str_eq(transport_filter, "") {
        sql = sql + " AND transport = " + sql_quote(transport_filter)
    }
    if not str_eq(agent_filter, "") {
        sql = sql + " AND agent = " + sql_quote(agent_filter)
    }
    if not str_eq(method_filter, "") {
        sql = sql + " AND method = " + sql_quote(method_filter)
    }
    if not str_eq(src_filter, "") {
        sql = sql + " AND (src LIKE " + sql_quote("%" + src_filter + "%") + " OR dst LIKE " + sql_quote("%" + src_filter + "%") + ")"
    }
    if not str_eq(from_filter, "") {
        sql = sql + " AND from_h LIKE " + sql_quote("%" + from_filter + "%")
    }
    if not str_eq(to_filter, "") {
        sql = sql + " AND to_h LIKE " + sql_quote("%" + to_filter + "%")
    }
    if not str_eq(status_filter, "") {
        sql = sql + " AND status = " + status_filter
    }
    if since_ms > 0 {
        sql = sql + " AND ts_ms >= " + string(since_ms)
    }
    if until_ms > 0 {
        sql = sql + " AND ts_ms <= " + string(until_ms)
    }
    sql = sql + " ORDER BY ts_ms DESC LIMIT " + string(lim)
    // ClickHouse returns JSONEachRow — one JSON object per line
    let raw = ch_query(sql)
    // Convert JSONEachRow to JSON array with injected id
    let lines = str_split(raw, "\n")
    let mut out = "["
    let mut first = 1
    let mut i = 0
    while i < len(lines) {
        let line = lines[i]
        if len(line) > 2 {
            // Each line is {"id":N,"record_json":"{...}"}
            // Extract record_json value and inject id
            let rid = json_get_int(line, "id")
            let rec = json_get_string(line, "record_json")
            if len(rec) > 2 {
                let with_id = "{\"id\":" + string(rid) + "," + rec[1:]
                if first == 1 {
                    first = 0
                } else {
                    out = out + ","
                }
                out = out + with_id
            }
        }
        i = i + 1
    }
    return out + "]"
}

fn db_messages_json_full(limit: int, call_id_filter: string, transport_filter: string, agent_filter: string, method_filter: string, src_filter: string, from_filter: string, to_filter: string, status_filter: string, since_ms: int, until_ms: int) -> string {
    let mut lim = limit
    if lim <= 0 {
        lim = 50
    }
    if lim > 500 {
        lim = 500
    }
    let db = db_open()
    if sql_ok(db) == 0 {
        return "[]"
    }
    let mut sql = "SELECT id, record_json FROM captures WHERE 1=1"
    if not str_eq(call_id_filter, "") {
        sql = sql + " AND call_id = " + sql_quote(call_id_filter)
    }
    if not str_eq(transport_filter, "") {
        sql = sql + " AND transport = " + sql_quote(transport_filter)
    }
    if not str_eq(agent_filter, "") {
        sql = sql + " AND agent = " + sql_quote(agent_filter)
    }
    if not str_eq(method_filter, "") {
        sql = sql + " AND method = " + sql_quote(method_filter)
    }
    if not str_eq(src_filter, "") {
        sql = sql + " AND (src LIKE " + sql_quote("%" + src_filter + "%") + " OR dst LIKE " + sql_quote("%" + src_filter + "%") + ")"
    }
    if not str_eq(from_filter, "") {
        sql = sql + " AND from_h LIKE " + sql_quote("%" + from_filter + "%")
    }
    if not str_eq(to_filter, "") {
        sql = sql + " AND to_h LIKE " + sql_quote("%" + to_filter + "%")
    }
    if not str_eq(status_filter, "") {
        sql = sql + " AND status = " + status_filter
    }
    if since_ms > 0 {
        sql = sql + " AND ts_ms >= " + string(since_ms)
    }
    if until_ms > 0 {
        sql = sql + " AND ts_ms <= " + string(until_ms)
    }
    sql = sql + " ORDER BY id DESC LIMIT " + string(lim)
    let rows = sql_query_rows(db, sql, [])
    let mut out = "["
    let mut first = 1
    if sql_rows_ok(rows) == 1 {
        while sql_rows_next(rows) == 1 {
            let id = sql_rows_int(rows, 0)
            let rec = sql_rows_str(rows, 1)
            if str_eq(rec, "") {
                continue
            }
            // inject durable id (record_json starts with '{')
            let with_id = "{\"id\":" + string(id) + "," + rec[1:]
            if first == 1 {
                first = 0
            } else {
                out = out + ","
            }
            out = out + with_id
        }
        let _ = sql_rows_close(rows)
    }
    out = out + "]"
    let _ = sql_close(db)
    return out
}

fn db_message_one_json(id: int) -> string {
    let db = db_open()
    if sql_ok(db) == 0 {
        return ""
    }
    let rows = sql_query_rows(db, "SELECT id, record_json FROM captures WHERE id = " + string(id), [])
    let mut out = ""
    if sql_rows_ok(rows) == 1 {
        if sql_rows_next(rows) == 1 {
            let rid = sql_rows_int(rows, 0)
            let rec = sql_rows_str(rows, 1)
            if not str_eq(rec, "") {
                out = "{\"id\":" + string(rid) + "," + rec[1:]
            }
        }
        let _ = sql_rows_close(rows)
    }
    let _ = sql_close(db)
    return out
}

fn db_report_summary_json() -> string {
    let db = db_open()
    if sql_ok(db) == 0 {
        return "{\"error\":\"db unavailable\"}"
    }
    let total = sql_query_int(db, "SELECT COUNT(*) FROM captures", [])
    let calls = sql_query_int(db, "SELECT COUNT(DISTINCT call_id) FROM captures WHERE call_id IS NOT NULL AND call_id != ''", [])
    let hep = sql_query_int(db, "SELECT COUNT(*) FROM captures WHERE transport LIKE 'HEP%'", [])
    let sip_udp = sql_query_int(db, "SELECT COUNT(*) FROM captures WHERE transport = 'UDP'", [])
    let min_ts = sql_query_int(db, "SELECT COALESCE(MIN(ts_ms),0) FROM captures", [])
    let max_ts = sql_query_int(db, "SELECT COALESCE(MAX(ts_ms),0) FROM captures", [])
    // method breakdown
    let rows = sql_query_rows(db, "SELECT method, COUNT(*) AS c FROM captures GROUP BY method ORDER BY c DESC LIMIT 20", [])
    let mut methods = "{"
    let mut first = 1
    if sql_rows_ok(rows) == 1 {
        while sql_rows_next(rows) == 1 {
            let m = sql_rows_str(rows, 0)
            let c = sql_rows_int(rows, 1)
            if first == 1 {
                first = 0
            } else {
                methods = methods + ","
            }
            methods = methods + "\"" + jesc(m) + "\":" + string(c)
        }
        let _ = sql_rows_close(rows)
    }
    methods = methods + "}"
    // transport breakdown
    let rows2 = sql_query_rows(db, "SELECT transport, COUNT(*) AS c FROM captures GROUP BY transport ORDER BY c DESC", [])
    let mut transports = "{"
    first = 1
    if sql_rows_ok(rows2) == 1 {
        while sql_rows_next(rows2) == 1 {
            let tr = sql_rows_str(rows2, 0)
            let c = sql_rows_int(rows2, 1)
            if first == 1 {
                first = 0
            } else {
                transports = transports + ","
            }
            transports = transports + "\"" + jesc(tr) + "\":" + string(c)
        }
        let _ = sql_rows_close(rows2)
    }
    transports = transports + "}"
    let _ = sql_close(db)
    return "{\"total\":" + string(total) +
        ",\"unique_call_ids\":" + string(calls) +
        ",\"hep\":" + string(hep) +
        ",\"sip_udp\":" + string(sip_udp) +
        ",\"ts_min\":" + string(min_ts) +
        ",\"ts_max\":" + string(max_ts) +
        ",\"db\":\"" + jesc(db_path()) + "\"" +
        ",\"methods\":" + methods +
        ",\"transports\":" + transports +
        "}"
}

