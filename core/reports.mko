// Zaman core — Reporting, KPIs, SLAs, realtime stats, and message queries.

fn db_messages_json(limit: int, call_id_filter: string, transport_filter: string) -> string {
    return db_messages_json_full(limit, call_id_filter, transport_filter, "", "", "", "", "", "", 0, 0, "")
}

// ClickHouse query helper: returns JSON array from a SELECT that includes record_json.
fn ch_messages_json(limit: int, call_id_filter: string, transport_filter: string, agent_filter: string, method_filter: string, src_filter: string, from_filter: string, to_filter: string, status_filter: string, since_ms: int, until_ms: int, state_filter: string) -> string {
    let mut lim = limit
    if lim <= 0 {
        lim = 50
    }
    let max_lim = if not str_eq(call_id_filter, "") { 5000 } else { 500 }
    if lim > max_lim {
        lim = max_lim
    }
    let mut sql = "SELECT id, record_json FROM captures WHERE 1=1"
    if not str_eq(call_id_filter, "") {
        sql = sql + " AND call_id = " + sql_quote(call_id_filter)
    }
    if not str_eq(transport_filter, "") {
        sql = sql + " AND transport = " + sql_quote(transport_filter)
    }
    if not str_eq(agent_filter, "") {
        sql = sql + " AND agent = " + sql_quote(agent_filter)
    }
    if not str_eq(method_filter, "") {
        sql = sql + " AND method = " + sql_quote(method_filter)
    }
    if not str_eq(src_filter, "") {
        sql = sql + " AND (src LIKE " + sql_quote("%" + src_filter + "%") + " OR dst LIKE " + sql_quote("%" + src_filter + "%") + ")"
    }
    if not str_eq(from_filter, "") {
        sql = sql + " AND from_h LIKE " + sql_quote("%" + from_filter + "%")
    }
    if not str_eq(to_filter, "") {
        sql = sql + " AND to_h LIKE " + sql_quote("%" + to_filter + "%")
    }
    if not str_eq(status_filter, "") {
        sql = sql + " AND status = " + status_filter
    }
    if since_ms > 0 {
        sql = sql + " AND ts_ms >= " + string(since_ms)
    }
    if until_ms > 0 {
        sql = sql + " AND ts_ms <= " + string(until_ms)
    }
    sql = sql + " ORDER BY ts_ms DESC LIMIT " + string(lim)
    // ClickHouse returns JSONEachRow — one JSON object per line
    let raw = ch_query(sql)
    // Convert JSONEachRow to JSON array with injected id
    let lines = str_split(raw, "\n")
    let mut out = "["
    let mut first = 1
    let mut i = 0
    while i < len(lines) {
        let line = lines[i]
        if len(line) > 2 {
            // Each line is {"id":N,"record_json":"{...}"}
            // Extract record_json value and inject id
            let rid = json_get_int(line, "id")
            let rec = json_get_string(line, "record_json")
            if len(rec) > 2 {
                let with_id = "{\"id\":" + string(rid) + "," + rec[1:]
                if first == 1 {
                    first = 0
                } else {
                    out = out + ","
                }
                out = out + with_id
            }
        }
        i = i + 1
    }
    return out + "]"
}

fn db_messages_json_full(limit: int, call_id_filter: string, transport_filter: string, agent_filter: string, method_filter: string, src_filter: string, from_filter: string, to_filter: string, status_filter: string, since_ms: int, until_ms: int, state_filter: string) -> string {
    let mut lim = limit
    if lim <= 0 {
        lim = 50
    }
    let max_lim = if not str_eq(call_id_filter, "") { 5000 } else { 500 }
    if lim > max_lim {
        lim = max_lim
    }
    let db = db_open()
    if sql_ok(db) == 0 {
        return "[]"
    }
    let mut sql = "SELECT id, record_json FROM captures WHERE 1=1"
    if not str_eq(call_id_filter, "") {
        sql = sql + " AND call_id = " + sql_quote(call_id_filter)
    }
    if not str_eq(transport_filter, "") {
        sql = sql + " AND transport = " + sql_quote(transport_filter)
    }
    if not str_eq(agent_filter, "") {
        sql = sql + " AND agent = " + sql_quote(agent_filter)
    }
    if not str_eq(method_filter, "") {
        sql = sql + " AND method = " + sql_quote(method_filter)
    }
    if not str_eq(src_filter, "") {
        sql = sql + " AND (src LIKE " + sql_quote("%" + src_filter + "%") + " OR dst LIKE " + sql_quote("%" + src_filter + "%") + ")"
    }
    if not str_eq(from_filter, "") {
        sql = sql + " AND from_h LIKE " + sql_quote("%" + from_filter + "%")
    }
    if not str_eq(to_filter, "") {
        sql = sql + " AND to_h LIKE " + sql_quote("%" + to_filter + "%")
    }
    if not str_eq(status_filter, "") {
        sql = sql + " AND status = " + status_filter
    }
    if since_ms > 0 {
        sql = sql + " AND ts_ms >= " + string(since_ms)
    }
    if until_ms > 0 {
        sql = sql + " AND ts_ms <= " + string(until_ms)
    }
    sql = sql + call_state_filter_sql(state_filter)
    if since_ms > 0 || until_ms > 0 {
        sql = sql + " ORDER BY ts_ms DESC, id DESC LIMIT " + string(lim)
    } else {
        sql = sql + " ORDER BY id DESC LIMIT " + string(lim)
    }
    let rows = sql_query_rows(db, sql, [])
    let mut out = "["
    let mut first = 1
    if sql_rows_ok(rows) == 1 {
        while sql_rows_next(rows) == 1 {
            let id = sql_rows_int(rows, 0)
            let rec = sql_rows_str(rows, 1)
            if str_eq(rec, "") {
                continue
            }
            // inject durable id (record_json starts with '{')
            let with_id = "{\"id\":" + string(id) + "," + rec[1:]
            if first == 1 {
                first = 0
            } else {
                out = out + ","
            }
            out = out + with_id
        }
        let _ = sql_rows_close(rows)
    }
    out = out + "]"
    let _ = sql_close(db)
    return out
}

fn db_message_one_json(id: int) -> string {
    let db = db_open()
    if sql_ok(db) == 0 {
        return ""
    }
    let rows = sql_query_rows(db, "SELECT id, record_json FROM captures WHERE id = " + string(id), [])
    let mut out = ""
    if sql_rows_ok(rows) == 1 {
        if sql_rows_next(rows) == 1 {
            let rid = sql_rows_int(rows, 0)
            let rec = sql_rows_str(rows, 1)
            if not str_eq(rec, "") {
                out = "{\"id\":" + string(rid) + "," + rec[1:]
            }
        }
        let _ = sql_rows_close(rows)
    }
    let _ = sql_close(db)
    return out
}

fn db_report_summary_json() -> string {
    let db = db_open()
    if sql_ok(db) == 0 {
        return "{\"error\":\"db unavailable\"}"
    }
    let total = sql_query_int(db, "SELECT COUNT(*) FROM captures", [])
    let calls = sql_query_int(db, "SELECT COUNT(DISTINCT call_id) FROM captures WHERE call_id IS NOT NULL AND call_id != ''", [])
    let hep = sql_query_int(db, "SELECT COUNT(*) FROM captures WHERE transport LIKE 'HEP%'", [])
    let sip_udp = sql_query_int(db, "SELECT COUNT(*) FROM captures WHERE transport = 'UDP'", [])
    let min_ts = sql_query_int(db, "SELECT COALESCE(MIN(ts_ms),0) FROM captures", [])
    let max_ts = sql_query_int(db, "SELECT COALESCE(MAX(ts_ms),0) FROM captures", [])
    // method breakdown
    let rows = sql_query_rows(db, "SELECT method, COUNT(*) AS c FROM captures GROUP BY method ORDER BY c DESC LIMIT 20", [])
    let mut methods = "{"
    let mut first = 1
    if sql_rows_ok(rows) == 1 {
        while sql_rows_next(rows) == 1 {
            let m = sql_rows_str(rows, 0)
            let c = sql_rows_int(rows, 1)
            if first == 1 {
                first = 0
            } else {
                methods = methods + ","
            }
            methods = methods + "\"" + jesc(m) + "\":" + string(c)
        }
        let _ = sql_rows_close(rows)
    }
    methods = methods + "}"
    // transport breakdown
    let rows2 = sql_query_rows(db, "SELECT transport, COUNT(*) AS c FROM captures GROUP BY transport ORDER BY c DESC", [])
    let mut transports = "{"
    first = 1
    if sql_rows_ok(rows2) == 1 {
        while sql_rows_next(rows2) == 1 {
            let tr = sql_rows_str(rows2, 0)
            let c = sql_rows_int(rows2, 1)
            if first == 1 {
                first = 0
            } else {
                transports = transports + ","
            }
            transports = transports + "\"" + jesc(tr) + "\":" + string(c)
        }
        let _ = sql_rows_close(rows2)
    }
    transports = transports + "}"
    let _ = sql_close(db)
    return "{\"total\":" + string(total) +
        ",\"unique_call_ids\":" + string(calls) +
        ",\"hep\":" + string(hep) +
        ",\"sip_udp\":" + string(sip_udp) +
        ",\"ts_min\":" + string(min_ts) +
        ",\"ts_max\":" + string(max_ts) +
        ",\"db\":\"" + jesc(db_path()) + "\"" +
        ",\"methods\":" + methods +
        ",\"transports\":" + transports +
        "}"
}

fn db_report_daily_json(limit: int) -> string {
    let mut lim = limit
    if lim <= 0 {
        lim = 30
    }
    if lim > 365 {
        lim = 365
    }
    let db = db_open()
    if sql_ok(db) == 0 {
        return "[]"
    }
    let rows = sql_query_rows(db,
        "SELECT day, method, transport, cnt FROM report_daily ORDER BY day DESC, cnt DESC LIMIT " + string(lim * 10),
        [])
    let mut out = "["
    let mut first = 1
    if sql_rows_ok(rows) == 1 {
        while sql_rows_next(rows) == 1 {
            let day = sql_rows_str(rows, 0)
            let method = sql_rows_str(rows, 1)
            let tr = sql_rows_str(rows, 2)
            let cnt = sql_rows_int(rows, 3)
            if first == 1 {
                first = 0
            } else {
                out = out + ","
            }
            out = out + "{\"day\":\"" + jesc(day) + "\",\"method\":\"" + jesc(method) +
                "\",\"transport\":\"" + jesc(tr) + "\",\"count\":" + string(cnt) + "}"
        }
        let _ = sql_rows_close(rows)
    }
    out = out + "]"
    let _ = sql_close(db)
    return out
}

fn db_report_top_calls_json(limit: int, agent_filter: string, state_filter: string, src_filter: string, dst_filter: string, from_filter: string, to_filter: string) -> string {
    let mut lim = limit
    if lim <= 0 {
        lim = 20
    }
    if lim > 100 {
        lim = 100
    }
    let db = db_open()
    if sql_ok(db) == 0 {
        return "[]"
    }
    let mut where_sql = " WHERE call_id IS NOT NULL AND call_id != ''"
    if not str_eq(agent_filter, "") {
        where_sql = where_sql + " AND agent = " + sql_quote(agent_filter)
    }
    where_sql = where_sql + call_state_where_sql(state_filter)
    if not str_eq(src_filter, "") {
        where_sql = where_sql + " AND src LIKE " + sql_quote(src_filter + "%")
    }
    if not str_eq(dst_filter, "") {
        where_sql = where_sql + " AND dst LIKE " + sql_quote(dst_filter + "%")
    }
    if not str_eq(from_filter, "") {
        where_sql = where_sql + " AND from_h LIKE " + sql_quote("%" + from_filter + "%")
    }
    if not str_eq(to_filter, "") {
        where_sql = where_sql + " AND to_h LIKE " + sql_quote("%" + to_filter + "%")
    }
    let rows = sql_query_rows(db,
        "SELECT call_id, (SELECT COUNT(*) FROM captures c WHERE c.call_id = call_state.call_id) AS c, first_ts_ms, last_ts_ms, open, answered, last_status, last_method, invite_id, from_h, to_h " +
        "FROM call_state" + where_sql + " ORDER BY last_ts_ms DESC LIMIT " + string(lim),
        [])
    let mut out = "["
    let mut first = 1
    if sql_rows_ok(rows) == 1 {
        while sql_rows_next(rows) == 1 {
            let cid = sql_rows_str(rows, 0)
            let c = sql_rows_int(rows, 1)
            let t0 = sql_rows_int(rows, 2)
            let t1 = sql_rows_int(rows, 3)
            let open_v = sql_rows_int(rows, 4)
            let answered_v = sql_rows_int(rows, 5)
            let last_status = sql_rows_int(rows, 6)
            let last_method = sql_rows_str(rows, 7)
            let invite_id = sql_rows_int(rows, 8)
            let from_h = sql_rows_str(rows, 9)
            let to_h = sql_rows_str(rows, 10)
            let state = if open_v == 1 && answered_v == 0 && invite_id > 0 { "ringing" } else if open_v == 1 && answered_v == 1 { "answered" } else if str_eq(last_method, "CANCEL") { "canceled" } else if answered_v == 1 { "ended" } else if last_status >= 300 { "failed" } else { "active" }
            if first == 1 {
                first = 0
            } else {
                out = out + ","
            }
            out = out + "{\"call_id\":\"" + jesc(cid) + "\",\"messages\":" + string(c) +
                ",\"ts_first\":" + string(t0) + ",\"ts_last\":" + string(t1) + ",\"state\":\"" + state + "\"" +
                ",\"from\":\"" + jesc(from_h) + "\",\"to\":\"" + jesc(to_h) + "\"}"
        }
        let _ = sql_rows_close(rows)
    }
    out = out + "]"
    let _ = sql_close(db)
    return out
}

