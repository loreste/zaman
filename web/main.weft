// Zaman dashboard — HTMX + Tailwind 4 over zaman-core.
//   ZAMAN_CORE=http://127.0.0.1:9090 weft run web/main.weft
//
// RBAC: admin / operator / viewer.  Disable with ZAMAN_AUTH=0 for lab use.
// On first run with auth enabled, a default admin account is created and
// the password is printed to stdout once.

fn core_base() {
    env.get("ZAMAN_CORE") ?? "http://127.0.0.1:9090"
}

fn api_headers() {
    key := env.get("ZAMAN_API_KEY") ?? ""
    if key == "" {
        {}
    } else {
        {"headers": {"X-API-Key": key}}
    }
}

fn h(s) {
    html.escape(("" + (s ?? "")))
}

fn q(s) {
    mut v := "" + (s ?? "")
    v = str.replace(v, " ", "%20")
    v = str.replace(v, "&", "%26")
    v = str.replace(v, "=", "%3D")
    v = str.replace(v, "?", "%3F")
    v = str.replace(v, "#", "%23")
    v = str.replace(v, ";", "%3B")
    v
}

fn ladder_url(call_id) {
    "/ladder?call_id=" + q(call_id)
}

fn ladder_nav_attrs(call_id) {
    url := ladder_url(call_id)
    "href=\"" + url + "\" hx-get=\"" + url + "\" hx-target=\"main\" hx-select=\"main\" hx-push-url=\"true\""
}

// ---- RBAC (JSON file + signed cookie tokens) ----
// Users: data/zaman-users.json   Sessions: stateless HMAC-signed cookies
// ponytail: Weft closures can't mutate captured state; signed tokens avoid server-side sessions entirely.

fn auth_enabled() {
    e := env.get("ZAMAN_AUTH") ?? ""
    e != "0"
}

fn users_path() {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    dir + "/zaman-users.json"
}

fn password_hash_rounds() {
    25000
}

fn hash_pw_rounds(salt, password, rounds) {
    mut h := crypto.hmac_sha256(salt, password)
    mut i := 0
    target := if rounds > 1 { rounds - 1 } else { 0 }
    while i < target {
        h = crypto.hmac_sha256(salt, h)
        i = i + 1
    }
    h
}

fn hash_pw(salt, password) {
    hash_pw_rounds(salt, password, password_hash_rounds())
}

fn verify_pw(user, password) {
    salt := user["salt"] ?? ""
    stored := user["pw_hash"] ?? ""
    rounds := user["pw_rounds"] ?? 1000
    if salt == "" || stored == "" { return false }
    expected := hash_pw_rounds(salt, password, rounds)
    if crypto.equal(expected, stored) { return true }
    // Backward compatibility for legacy users that predate pw_rounds.
    if (user["pw_rounds"] ?? 0) == 0 {
        legacy := hash_pw_rounds(salt, password, 1000)
        return crypto.equal(legacy, stored)
    }
    false
}

fn password_needs_upgrade(user) {
    (user["pw_rounds"] ?? 0) < password_hash_rounds()
}

fn upgrade_user_password(user_id, password) {
    users := load_users()
    old := find_user_by_id(users, user_id)
    if old == null { return }
    salt := secrets.token_hex(16)
    hp := hash_pw(salt, password)
    without := list_remove(users, "id", user_id)
    updated_user := {"id": user_id, "username": old["username"], "pw_hash": hp, "salt": salt, "pw_algo": "hmac-sha256", "pw_rounds": password_hash_rounds(), "role": old["role"]}
    save_users(list_append(without, updated_user))
}

fn load_users() {
    r := fs.read(users_path())
    if !r.ok { return [] }
    p := json.parse(r.value)
    if !p.ok { return [] }
    p.value
}

fn save_users(users) {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    if !fs.exists(dir) { fs.mkdir(dir) }
    fs.write_atomic(users_path(), json.stringify(users))
    fs.chmod(users_path(), 384)
}

fn next_user_id(users) {
    mut max_id := 0
    for u in users {
        uid := u["id"] ?? 0
        if uid > max_id { max_id = uid }
    }
    max_id + 1
}

fn find_user_by_name(users, username) {
    for u in users {
        if (u["username"] ?? "") == username { return u }
    }
    null
}

fn find_user_by_id(users, id) {
    for u in users {
        if (u["id"] ?? 0) == id { return u }
    }
    null
}

fn list_append(lst, item) {
    s := json.stringify(lst)
    item_s := json.stringify(item)
    if s == "[]" { return json.parse("[" + item_s + "]").value }
    json.parse(str.slice(s, 0, len(s) - 1) + "," + item_s + "]").value
}

fn list_remove(lst, pred_key, pred_val) {
    mut s := "["
    mut first := true
    for item in lst {
        if (item[pred_key] ?? null) != pred_val {
            if !first { s = s + "," }
            s = s + json.stringify(item)
            first = false
        }
    }
    json.parse(s + "]").value
}

fn auth_init(token_secret) {
    users := load_users()
    if len(users) == 0 {
        pw := secrets.token_hex(8)
        salt := secrets.token_hex(16)
        hp := hash_pw(salt, pw)
        admin := {"id": 1, "username": "admin", "pw_hash": hp, "salt": salt, "pw_algo": "hmac-sha256", "pw_rounds": password_hash_rounds(), "role": "admin"}
        save_users([admin])
        say("")
        say("  ┌──────────────────────────────────────────────┐")
        say("  │  Default admin account created                │")
        say("  │  username: admin                              │")
        say("  │  password: " + pw + "                  │")
        say("  │  Change this immediately.                     │")
        say("  └──────────────────────────────────────────────┘")
        say("")
    }
}

// Signed token: base64(id:username:role:expires:hmac)
fn make_token(token_secret, user) {
    uid := user["id"] ?? 0
    uname := user["username"] ?? ""
    role := user["role"] ?? "viewer"
    expires := time.unix() + 86400
    payload := ("" + (uid)) + ":" + uname + ":" + role + ":" + ("" + (expires))
    sig := crypto.hmac_sha256(token_secret, payload)
    base64.encode(payload + ":" + sig)
}

fn verify_token(token_secret, token) {
    dec := base64.decode(token)
    if !dec.ok { return null }
    raw := dec.value
    // Signature is last 64 hex chars after final ':'
    if len(raw) < 66 { return null }
    sig_start := len(raw) - 64
    sep := str.slice(raw, sig_start - 1, sig_start)
    if sep != ":" { return null }
    payload := str.slice(raw, 0, sig_start - 1)
    got_sig := str.slice(raw, sig_start, len(raw))
    expected := crypto.hmac_sha256(token_secret, payload)
    if !crypto.equal(got_sig, expected) { return null }
    // Parse payload: id:username:role:expires
    parts := str.split(payload, ":")
    if len(parts) < 4 { return null }
    expires := int.parse(parts[len(parts) - 1]).unwrap_or(0)
    if expires < time.unix() { return null }
    role := parts[len(parts) - 2]
    uid := int.parse(parts[0]).unwrap_or(0)
    // Username may contain colons (unlikely but safe): rejoin middle parts
    mut uname := parts[1]
    mut i := 2
    while i < len(parts) - 2 {
        uname = uname + ":" + parts[i]
        i = i + 1
    }
    {"id": uid, "username": uname, "role": role}
}

fn get_user(req, token_secret) {
    if !auth_enabled() { return {"id": 0, "username": "anonymous", "role": "admin"} }
    // Check API token in Authorization header first (for automation)
    auth_hdr := req.headers["Authorization"] ?? ""
    if str.starts_with(auth_hdr, "Bearer ") {
        api_tok := str.slice(auth_hdr, 7, len(auth_hdr))
        api_user := verify_api_token(api_tok)
        if api_user != null { return api_user }
    }
    // Fall back to session cookie
    cookie := web.cookie_get(req, "zaman_sid")
    if cookie == null || cookie == "" { return null }
    verify_token(token_secret, cookie)
}

fn login_redirect() {
    {"status": 302, "headers": {"Location": "/login"}, "body": ""}
}

// CSRF: derive token from hmac(token_secret, session_cookie) — stateless, tied to session.
fn csrf_token(req, token_secret) {
    cookie := web.cookie_get(req, "zaman_sid") ?? ""
    if cookie == "" { return secrets.token_hex(16) }
    crypto.hmac_sha256(token_secret, "csrf:" + cookie)
}

fn csrf_field(req, token_secret) {
    "<input type=\"hidden\" name=\"_csrf\" value=\"" + csrf_token(req, token_secret) + "\"/>"
}

fn csrf_valid(req, token_secret) {
    submitted := web.form_get(req, "_csrf", "")
    if submitted == "" { return false }
    expected := csrf_token(req, token_secret)
    crypto.equal(submitted, expected)
}

fn csrf_reject() {
    {"status": 403, "body": "CSRF token invalid or missing."}
}

fn set_session_cookie(token) {
    // Secure flag added — browsers will only send over HTTPS (except localhost for dev)
    {"status": 302, "headers": {"Location": "/", "Set-Cookie": "zaman_sid=" + token + "; Path=/; HttpOnly; Max-Age=86400; SameSite=Lax; Secure"}, "body": ""}
}

fn clear_session_cookie() {
    {"status": 302, "headers": {"Location": "/login", "Set-Cookie": "zaman_sid=; Path=/; Max-Age=0; HttpOnly; SameSite=Lax"}, "body": ""}
}

fn has_role(user, min_role) {
    role := user["role"] ?? "viewer"
    if min_role == "viewer" { return true }
    if min_role == "operator" { return role == "operator" || role == "admin" }
    if min_role == "admin" { return role == "admin" }
    false
}

fn role_badge(role) {
    if role == "admin" {
        "<span class=\"px-2 py-0.5 rounded-full text-[11px] font-semibold border bg-[rgba(248,113,113,.12)] text-[#f87171] border-[rgba(248,113,113,.3)]\">admin</span>"
    } else if role == "operator" {
        "<span class=\"px-2 py-0.5 rounded-full text-[11px] font-semibold border bg-[rgba(167,139,250,.15)] text-[#a78bfa] border-[rgba(167,139,250,.3)]\">operator</span>"
    } else {
        "<span class=\"px-2 py-0.5 rounded-full text-[11px] font-semibold border bg-[rgba(161,161,170,.15)] text-[#a1a1aa] border-[rgba(161,161,170,.3)]\">viewer</span>"
    }
}

fn login_page(error_msg) {
    mut err := ""
    if error_msg != "" {
        err = "<div class=\"flex items-center gap-2 rounded-xl border border-[rgba(248,113,113,.3)] bg-[rgba(248,113,113,.06)] px-4 py-3 text-sm text-[#f87171] mb-5\">" +
            "<svg class=\"w-4 h-4 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z\"/></svg>" +
            h(error_msg) + "</div>"
    }
    "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"/>" +
    "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/>" +
    "<link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\"/>" +
    "<title>Login · Zaman</title>" +
    "<script src=\"https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4\"></script>" +
    "<style type=\"text/tailwindcss\">" +
    "@theme{--color-ink:#fafafa;--color-bg:#09090b;--color-panel:#18181b;--color-line:#27272a;--color-accent:#a78bfa;}" +
    "input:focus{border-color:#a78bfa!important;box-shadow:0 0 0 3px rgba(167,139,250,.15)!important}" +
    ".login-card{background:rgba(24,24,27,.85);backdrop-filter:blur(20px)}" +
    "@keyframes fadein{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}" +
    ".fade-in{animation:fadein .4s ease-out}" +
    "</style></head>" +
    "<body class=\"min-h-screen bg-[#0a0a0c] text-[#e4e4e7] flex items-center justify-center\" style=\"background:radial-gradient(ellipse at 50% 0%,rgba(167,139,250,.06) 0%,transparent 60%),#09090b\">" +
    "<div class=\"w-full max-w-[380px] px-5 fade-in\">" +
    "<div class=\"flex flex-col items-center mb-10\">" +
    "<div class=\"w-14 h-14 rounded-2xl bg-gradient-to-br from-[#a78bfa] to-[#6d28d9] grid place-items-center font-black text-xl text-[#09090b] mb-4 shadow-lg shadow-[rgba(167,139,250,.2)]\">Z</div>" +
    "<h1 class=\"text-2xl font-bold tracking-tight\">Zaman</h1>" +
    "<p class=\"text-sm text-[#71717a] mt-1\">SIP monitoring · echo · metrics</p></div>" +
    err +
    "<form method=\"post\" action=\"/login\" class=\"login-card rounded-2xl border border-[#1e1e22] p-7 space-y-5 shadow-2xl shadow-black/30\">" +
    "<div><label class=\"block text-[11px] font-medium text-[#71717a] uppercase tracking-wider mb-2\">Username</label>" +
    "<input name=\"username\" required autofocus autocomplete=\"username\" class=\"w-full rounded-xl bg-[#111114] border border-[#1e1e22] px-4 py-2.5 text-sm transition-all duration-200 outline-none placeholder:text-[#3f3f46]\" placeholder=\"admin\"/></div>" +
    "<div><label class=\"block text-[11px] font-medium text-[#71717a] uppercase tracking-wider mb-2\">Password</label>" +
    "<input name=\"password\" type=\"password\" required autocomplete=\"current-password\" class=\"w-full rounded-xl bg-[#111114] border border-[#1e1e22] px-4 py-2.5 text-sm transition-all duration-200 outline-none placeholder:text-[#3f3f46]\" placeholder=\"········\"/></div>" +
    "<button type=\"submit\" class=\"w-full rounded-xl px-4 py-3 text-sm font-semibold bg-gradient-to-r from-[#a78bfa] to-[#7c3aed] text-white shadow-lg shadow-[rgba(124,58,237,.25)] hover:shadow-[rgba(124,58,237,.4)] hover:brightness-110 transition-all duration-200 cursor-pointer\">Sign in</button></form>" +
    "<p class=\"text-center text-xs text-[#52525b] mt-6\">Integrated SIP monitoring + echo system</p>" +
    "</div></body></html>"
}

// LDAP/HTTP auth: ZAMAN_LDAP_URL + ZAMAN_LDAP_BIND_DN
// If set, authenticates against LDAP via HTTP bind proxy (e.g. ldap-http-proxy, GLAuth HTTP).
// Falls back to local users if LDAP is not configured or bind fails.
fn ldap_auth(username, password) {
    ldap_url := env.get("ZAMAN_LDAP_URL") ?? ""
    if ldap_url == "" { return null }
    // POST to LDAP HTTP proxy: {"username":"...","password":"..."}
    payload := json.stringify({"username": username, "password": password})
    r := http.post(ldap_url, payload, {"headers": {"Content-Type": "application/json"}})
    if !r.ok { return null }
    p := json.parse(r.value.body)
    if !p.ok { return null }
    result := p.value
    if (result["ok"] ?? false) != true && (result["authenticated"] ?? false) != true { return null }
    // Map LDAP groups to Zaman roles
    ldap_role := result["role"] ?? result["group"] ?? "viewer"
    mut role := "viewer"
    if ldap_role == "admin" || str.contains(ldap_role, "admin") { role = "admin" }
    else if ldap_role == "operator" || str.contains(ldap_role, "operator") { role = "operator" }
    {"id": 0, "username": username, "role": role}
}

// Brute-force protection: track failed login attempts per IP
fn login_attempts_path() {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    dir + "/zaman-login-attempts.json"
}

fn load_login_attempts() {
    r := fs.read(login_attempts_path())
    if !r.ok { return [] }
    p := json.parse(r.value)
    if p.ok { p.value } else { [] }
}

fn save_login_attempts(attempts) {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    if !fs.exists(dir) { fs.mkdir(dir) }
    fs.write_atomic(login_attempts_path(), json.stringify(attempts))
}

fn record_failed_login(ip) {
    attempts := load_login_attempts()
    entry := {"ip": ip, "ts": time.unix()}
    save_login_attempts(list_append(attempts, entry))
}

fn check_login_rate(ip) {
    attempts := load_login_attempts()
    cutoff := time.unix() - 60
    mut count := 0
    mut kept := "["
    mut first := true
    for a in attempts {
        ts := a["ts"] ?? 0
        if ts >= cutoff {
            if !first { kept = kept + "," }
            kept = kept + json.stringify(a)
            first = false
            if (a["ip"] ?? "") == ip { count = count + 1 }
        }
    }
    // Prune old entries while we're at it
    pruned := json.parse(kept + "]").value
    save_login_attempts(pruned)
    count < 5
}

fn do_login(token_secret, username, password) {
    // Try LDAP first if configured
    ldap_user := ldap_auth(username, password)
    if ldap_user != null {
        return make_token(token_secret, ldap_user)
    }
    // Fall back to local users
    users := load_users()
    user := find_user_by_name(users, username)
    if user == null { return null }
    if !verify_pw(user, password) { return null }
    if password_needs_upgrade(user) {
        upgrade_user_password(user["id"] ?? 0, password)
    }
    make_token(token_secret, user)
}

fn list_users() {
    load_users()
}

fn create_user(username, password, role) {
    if username == "" { return "username required" }
    if password == "" { return "password required" }
    pw_err := validate_password(password)
    if pw_err != "" { return pw_err }
    if role != "admin" && role != "operator" && role != "viewer" { return "invalid role" }
    users := load_users()
    if find_user_by_name(users, username) != null { return "username already exists" }
    salt := secrets.token_hex(16)
    hp := hash_pw(salt, password)
    new_user := {"id": next_user_id(users), "username": username, "pw_hash": hp, "salt": salt, "pw_algo": "hmac-sha256", "pw_rounds": password_hash_rounds(), "role": role}
    save_users(list_append(users, new_user))
    ""
}

fn delete_user_by_id(id) {
    users := load_users()
    save_users(list_remove(users, "id", id))
}

fn change_password(user_id, new_password) {
    if new_password == "" { return "password required" }
    pw_err := validate_password(new_password)
    if pw_err != "" { return pw_err }
    users := load_users()
    salt := secrets.token_hex(16)
    hp := hash_pw(salt, new_password)
    // Remove old, add updated
    old := find_user_by_id(users, user_id)
    if old == null { return "user not found" }
    without := list_remove(users, "id", user_id)
    updated_user := {"id": user_id, "username": old["username"], "pw_hash": hp, "salt": salt, "pw_algo": "hmac-sha256", "pw_rounds": password_hash_rounds(), "role": old["role"]}
    save_users(list_append(without, updated_user))
    ""
}

// ---- layout ----

fn layout_with_csrf(title, body, user, csrf) {
    layout_inner(title, body, user, csrf)
}

fn layout(title, body, user) {
    layout_inner(title, body, user, "")
}

fn layout_inner(title, body, user, csrf) {
    cdn := web.htmx_cdn()
    base := h(core_base())
    mut user_info := ""
    if user != null && auth_enabled() {
        uname := h(user["username"] ?? "")
        urole := user["role"] ?? "viewer"
        user_info = "<div class=\"mt-auto pt-4 border-t border-[#1e1e22] text-xs space-y-2\">" +
            "<div class=\"flex items-center gap-2\">" + role_badge(urole) + " <span class=\"text-[#e4e4e7]\">" + uname + "</span></div>" +
            "<a href=\"/logout\" class=\"block text-[#a1a1aa] hover:text-[#f87171]\">Sign out</a></div>"
    }
    mut admin_link := ""
    if user != null && has_role(user, "admin") && auth_enabled() {
        admin_link = nav_link("/admin/users", "Users", "M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z") +
            nav_link("/admin/tokens", "API Tokens", "M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z") +
            nav_link("/admin/audit", "Audit Log", "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2") +
            nav_link("/sla", "SLA Report", "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z")
    }
    "<!doctype html><html lang=\"en\" class=\"h-full\"><head><meta charset=\"utf-8\"/>" +
    "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/>" +
    "<link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\"/>" +
    "<title>" + h(title) + " · " + brand_name() + "</title>" + cdn +
    "<script src=\"https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4\"></script>" +
    "<style type=\"text/tailwindcss\">" +
    "@theme{--color-ink:#e4e4e7;--color-muted:#a1a1aa;--color-panel:#131316;--color-line:#1e1e22;--color-bg:#0a0a0c;--color-accent:#a78bfa;--color-ok:#34d399;--color-warn:#fbbf24;--color-bad:#f87171;}" +
    ".mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:0.8125rem}" +
    "@media(max-width:768px){table{font-size:0.75rem}th,td{padding:0.375rem 0.5rem!important}.hide-mobile{display:none}}" +
    ".ladder-line{border-left:2px dashed #1e1e22;margin-left:1rem;padding-left:1rem}" +
    ".card{background:#131316;border:1px solid #1e1e22;border-radius:0.75rem}" +
    "input:focus,select:focus{border-color:#a78bfa!important;box-shadow:0 0 0 2px rgba(167,139,250,.1)!important;outline:none}" +
    "tr:hover td{background:rgba(255,255,255,.015)}" +
    ".section{margin-bottom:1.75rem}" +
    ".section-title{font-size:0.6875rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:#52525b;margin-bottom:0.75rem}" +
    "</style></head>" +
    "<body class=\"min-h-full bg-[#0a0a0c] text-[#e4e4e7] font-sans antialiased\">" +
    "<div class=\"min-h-screen grid grid-cols-1 lg:grid-cols-[220px_1fr]\">" +
    // Sidebar — slim, grouped
    "<aside class=\"border-b lg:border-b-0 lg:border-r border-[#1e1e22] bg-[#0e0e11] px-3 py-4 lg:sticky lg:top-0 lg:h-screen flex flex-col overflow-y-auto\">" +
    "<div class=\"flex items-center gap-2.5 mb-6 px-2\">" +
    "<div class=\"w-8 h-8 rounded-lg bg-gradient-to-br from-[#a78bfa] to-[#6d28d9] grid place-items-center font-bold text-sm text-white\">" + str.slice(brand_name(), 0, 1) + "</div>" +
    "<span class=\"font-semibold text-sm\">" + h(brand_name()) + "</span></div>" +
    // Nav — grouped with labels
    "<div class=\"section-title px-2\">Monitor</div>" +
    "<nav class=\"flex flex-col gap-px text-[13px] mb-4\">" +
    nav_link("/", "Overview", "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4") +
    nav_link("/noc", "NOC", "M5.636 18.364a9 9 0 010-12.728m12.728 0a9 9 0 010 12.728m-9.9-2.829a5 5 0 010-7.07m7.072 0a5 5 0 010 7.07M13 12a1 1 0 11-2 0 1 1 0 012 0z") +
    nav_link("/messages", "Messages", "M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4") +
    nav_link("/ip", "IP History", "M12 11c1.657 0 3-1.343 3-3S13.657 5 12 5 9 6.343 9 8s1.343 3 3 3zm0 0v8m0-8c-2.667 0-8 1.333-8 4v2h16v-2c0-2.667-5.333-4-8-4z") +
    nav_link("/calls", "Calls", "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01") +
    nav_link("/probe", "Probe", "M13 10V3L4 14h7v7l9-11h-7z") +
    "</nav>" +
    "<div class=\"section-title px-2\">Analyze</div>" +
    "<nav class=\"flex flex-col gap-px text-[13px] mb-4\">" +
    nav_link("/metrics", "Metrics", "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z") +
    nav_link("/report", "Reports", "M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z") +
    nav_link("/sla", "SLA", "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z") +
    nav_link("/alerts", "Alerts", "M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9") +
    "</nav>" +
    (if admin_link != "" { "<div class=\"section-title px-2\">Admin</div><nav class=\"flex flex-col gap-px text-[13px] mb-4\">" + admin_link + "</nav>" } else { "" }) +
    // Footer
    "<div class=\"mt-auto pt-3 border-t border-[#1e1e22] px-2 text-[10px] text-[#3f3f46] space-y-1\">" +
    "<div id=\"core-status\" hx-get=\"/partials/status\" hx-trigger=\"load, every 5s\" hx-swap=\"innerHTML\">…</div>" +
    "<button onclick=\"document.getElementById('zaman-cmd').classList.remove('hidden');document.getElementById('zaman-cmd').querySelector('input').focus()\" class=\"flex items-center justify-between w-full rounded-md px-2 py-1.5 mt-1.5 text-[#3f3f46] hover:text-[#71717a] hover:bg-[#131316] transition-colors cursor-pointer\">" +
    "<span>Search…</span><kbd class=\"text-[9px] border border-[#27272a] rounded px-1 py-0.5\">⌘K</kbd></button>" +
    "</div>" +
    (if user_info != "" { user_info } else { "" }) +
    "</aside>" +
    "<main class=\"p-5 md:p-7 lg:p-8 w-full\">" + body + "</main></div>" +
    (if csrf != "" { "<script>document.querySelectorAll('form[method=\"post\"]').forEach(function(f){if(!f.querySelector('[name=_csrf]')){var i=document.createElement('input');i.type='hidden';i.name='_csrf';i.value='" + csrf + "';f.appendChild(i)}})</script>" } else { "" }) +
    // Active nav highlighting + Command palette (Cmd+K) + Desktop notifications
    "<script>" +
    // Active nav: highlight current page link
    "(function(){var p=location.pathname;document.querySelectorAll('aside nav a').forEach(function(a){" +
    "var h=a.getAttribute('href');if(h===p||(h!=='/'&&p.startsWith(h))){" +
    "a.classList.remove('text-[#71717a]');a.classList.add('bg-[#131316]','text-[#e4e4e7]','font-medium')}" +
    "})})();" +
    // Command palette
    "var zcp=document.getElementById('zaman-cmd');if(zcp){" +
    "document.addEventListener('keydown',function(e){" +
    "if((e.metaKey||e.ctrlKey)&&e.key==='k'){e.preventDefault();zcp.classList.toggle('hidden');var si=zcp.querySelector('input');if(si)si.focus()}" +
    "if(e.key==='Escape')zcp.classList.add('hidden')});" +
    "zcp.addEventListener('click',function(e){if(e.target===zcp)zcp.classList.add('hidden')});" +
    "var csi=zcp.querySelector('input');if(csi){csi.addEventListener('input',function(){" +
    "var q=this.value.toLowerCase();zcp.querySelectorAll('[data-cmd]').forEach(function(el){" +
    "el.style.display=el.dataset.cmd.toLowerCase().includes(q)?'':'none'})})}}" +
    // Desktop notifications for critical alerts
    ";document.body.addEventListener('htmx:afterSwap',function(e){" +
    "if(e.detail.target&&e.detail.target.id==='alert-bar'){" +
    "var html=e.detail.target.innerHTML;" +
    "if(html.indexOf('critical')>-1&&Notification&&Notification.permission==='granted'){" +
    "new Notification('Zaman Alert',{body:'Critical alert detected',icon:'/favicon.svg'})}" +
    "else if(html.indexOf('critical')>-1&&Notification&&Notification.permission==='default'){" +
    "Notification.requestPermission()}}})" +
    "</script>" +
    // Command palette overlay
    "<div id=\"zaman-cmd\" class=\"hidden fixed inset-0 z-50 flex items-start justify-center pt-[15vh]\" style=\"background:rgba(0,0,0,.6);backdrop-filter:blur(4px)\">" +
    "<div class=\"w-full max-w-md rounded-2xl border border-[#27272a] bg-[#131316] shadow-2xl overflow-hidden\">" +
    "<div class=\"flex items-center gap-2 px-4 py-3 border-b border-[#1e1e22]\">" +
    "<svg class=\"w-4 h-4 text-[#52525b]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\"/></svg>" +
    "<input placeholder=\"Search pages or enter Call-ID…\" class=\"flex-1 bg-transparent text-sm outline-none placeholder:text-[#3f3f46]\"/>" +
    "<kbd class=\"text-[10px] text-[#3f3f46] border border-[#27272a] rounded px-1.5 py-0.5\">esc</kbd></div>" +
    "<div class=\"max-h-[320px] overflow-y-auto p-2 space-y-0.5\">" +
    "<a data-cmd=\"Overview home dashboard\" href=\"/\" class=\"flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-[#a1a1aa] hover:bg-[#27272a] hover:text-[#e4e4e7]\">Overview</a>" +
    "<a data-cmd=\"NOC nodes network\" href=\"/noc\" class=\"flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-[#a1a1aa] hover:bg-[#27272a] hover:text-[#e4e4e7]\">NOC</a>" +
    "<a data-cmd=\"Messages search SIP HEP\" href=\"/messages\" class=\"flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-[#a1a1aa] hover:bg-[#27272a] hover:text-[#e4e4e7]\">Messages</a>" +
    "<a data-cmd=\"IP History site label caller address\" href=\"/ip\" class=\"flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-[#a1a1aa] hover:bg-[#27272a] hover:text-[#e4e4e7]\">IP History</a>" +
    "<a data-cmd=\"Calls ladder Call-ID\" href=\"/ladder\" class=\"flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-[#a1a1aa] hover:bg-[#27272a] hover:text-[#e4e4e7]\">Call ladder</a>" +
    "<a data-cmd=\"Probe OPTIONS RTT\" href=\"/probe\" class=\"flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-[#a1a1aa] hover:bg-[#27272a] hover:text-[#e4e4e7]\">Probe</a>" +
    "<a data-cmd=\"Metrics counters Prometheus\" href=\"/metrics\" class=\"flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-[#a1a1aa] hover:bg-[#27272a] hover:text-[#e4e4e7]\">Metrics</a>" +
    "<a data-cmd=\"Reports ASR NER top talkers\" href=\"/report\" class=\"flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-[#a1a1aa] hover:bg-[#27272a] hover:text-[#e4e4e7]\">Reports</a>" +
    "<a data-cmd=\"SLA availability targets\" href=\"/sla\" class=\"flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-[#a1a1aa] hover:bg-[#27272a] hover:text-[#e4e4e7]\">SLA</a>" +
    "<a data-cmd=\"Alerts rules notifications\" href=\"/alerts\" class=\"flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-[#a1a1aa] hover:bg-[#27272a] hover:text-[#e4e4e7]\">Alerts</a>" +
    "<div class=\"border-t border-[#1e1e22] my-1\"></div>" +
    "<form data-cmd=\"Call-ID trace lookup\" action=\"/ladder\" method=\"get\" hx-boost=\"true\" hx-target=\"main\" hx-select=\"main\" hx-push-url=\"true\" class=\"flex items-center gap-2 px-3 py-2\">" +
    "<input name=\"call_id\" placeholder=\"Jump to Call-ID…\" class=\"flex-1 bg-[#0a0a0c] border border-[#1e1e22] rounded-lg px-2.5 py-1.5 text-xs mono\"/>" +
    "<button class=\"rounded-lg px-2.5 py-1.5 text-xs bg-[#a78bfa] text-[#0a0a0c] font-medium\">Go</button></form>" +
    "</div>" +
    "<div class=\"px-4 py-2 border-t border-[#1e1e22] text-[10px] text-[#3f3f46]\">⌘K to open · type to filter · Enter to select</div>" +
    "</div></div>" +
    "</body></html>"
}

fn nav_link(href, label, icon) {
    "<a href=\"" + href + "\" class=\"flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[#71717a] hover:bg-[#131316] hover:text-[#e4e4e7] transition-colors\">" +
    "<svg class=\"w-3.5 h-3.5 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"" + icon + "\"/></svg>" +
    label + "</a>"
}

fn stat_card(label, value, sub) {
    "<div class=\"card p-4\">" +
    "<div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold\">" + h(label) + "</div>" +
    "<div class=\"text-xl font-bold mono mt-1\">" + h(value) + "</div>" +
    "<div class=\"text-[10px] text-[#3f3f46] mt-1\">" + h(sub) + "</div></div>"
}

fn method_badge(method, status, kind) {
    mut label := ("" + (method ?? ""))
    mut cls := "bg-[rgba(167,139,250,.15)] text-[#a78bfa] border-[rgba(167,139,250,.3)]"
    if kind == "response" {
        label = ("" + (status ?? 0))
        st := int.parse(status ?? 0).unwrap_or(0)
        if st >= 200 && st < 300 {
            cls = "bg-[rgba(52,211,153,.12)] text-[#34d399] border-[rgba(52,211,153,.3)]"
        } else if st >= 400 {
            cls = "bg-[rgba(248,113,113,.12)] text-[#f87171] border-[rgba(248,113,113,.3)]"
        } else {
            cls = "bg-[rgba(251,191,36,.12)] text-[#fbbf24] border-[rgba(251,191,36,.3)]"
        }
    } else if method == "INVITE" {
        cls = "bg-[rgba(167,139,250,.15)] text-[#c084fc] border-[rgba(167,139,250,.3)]"
    } else if method == "BYE" || method == "CANCEL" {
        cls = "bg-[rgba(248,113,113,.12)] text-[#f87171] border-[rgba(248,113,113,.3)]"
    } else if method == "OPTIONS" || method == "REGISTER" {
        cls = "bg-[rgba(52,211,153,.12)] text-[#34d399] border-[rgba(52,211,153,.3)]"
    }
    "<span class=\"inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold border " + cls + " mono\">" + h(label) + "</span>"
}

fn is_call_method(method) {
    method == "INVITE" || method == "ACK" || method == "BYE" || method == "CANCEL" || method == "UPDATE" || method == "PRACK" || method == "REFER" || method == "INFO"
}

fn call_method_from_cseq(method, cseq) {
    if is_call_method(method) { return method }
    if str.contains(cseq, "INVITE") { return "INVITE" }
    if str.contains(cseq, "ACK") { return "ACK" }
    if str.contains(cseq, "BYE") { return "BYE" }
    if str.contains(cseq, "CANCEL") { return "CANCEL" }
    if str.contains(cseq, "UPDATE") { return "UPDATE" }
    if str.contains(cseq, "PRACK") { return "PRACK" }
    if str.contains(cseq, "REFER") { return "REFER" }
    if str.contains(cseq, "INFO") { return "INFO" }
    method
}

fn is_call_message(m) {
    is_call_method(call_method_from_cseq(m["method"] ?? "", m["cseq"] ?? ""))
}

fn msg_row(m, site_labels) {
    id := m["id"] ?? 0
    method := m["method"] ?? ""
    status := m["status"] ?? 0
    kind := m["kind"] ?? ""
    call_id := m["call_id"] ?? ""
    src := m["src"] ?? ""
    dst := m["dst"] ?? ""
    transport := m["transport"] ?? ""
    proto := m["proto"] ?? ""
    agent := m["agent"] ?? ""
    from := m["from"] ?? ""
    ts_ms := m["ts_ms"] ?? 0
    ts_sec := if ts_ms > 0 { ts_ms / 1000 } else { 0 }
    badge := method_badge(method, status, kind)
    cid := h(call_id)
    mut xport := h(transport)
    if proto != "" && proto != "sip" && proto != "unknown" {
        xport = xport + "/" + h(proto)
    }
    src_ip := endpoint_ip(src)
    dst_ip := endpoint_ip(dst)
    src_s := endpoint_display(src, site_labels)
    dst_s := endpoint_display(dst, site_labels)
    "<tr class=\"hover:bg-white/[0.02]\">" +
    "<td class=\"py-2 px-3 mono text-xs text-[#a1a1aa]\">" + ("" + (id)) + "</td>" +
    "<td class=\"py-2 px-3\">" + badge + "</td>" +
    "<td class=\"py-2 px-3 mono text-xs max-w-[14rem] truncate\" title=\"" + cid + "\">" + cid +
    " <button onclick=\"navigator.clipboard.writeText(this.dataset.v).then(()=>{this.textContent='\\u2713';setTimeout(()=>this.textContent='\\u2398',1000)})\" data-v=\"" + cid + "\" class=\"text-[#3f3f46] hover:text-[#a1a1aa] cursor-pointer\" title=\"Copy Call-ID\">&#x2398;</button></td>" +
    "<td class=\"py-2 px-3 text-xs text-[#a1a1aa] max-w-[12rem] truncate\" title=\"" + h(src) + "\">" +
    "<a class=\"hover:text-[#e4e4e7] hover:underline\" href=\"/ip?addr=" + h(src_ip) + "\">" + src_s + "</a></td>" +
    "<td class=\"py-2 px-3 text-xs text-[#a1a1aa] max-w-[12rem] truncate\" title=\"" + h(dst) + "\">" +
    (if dst != "" { "<a class=\"hover:text-[#e4e4e7] hover:underline\" href=\"/ip?addr=" + h(dst_ip) + "\">" + dst_s + "</a>" } else { "<span class=\"text-[#52525b]\">unknown</span>" }) + "</td>" +
    "<td class=\"py-2 px-3 text-xs\"><span class=\"px-1.5 py-0.5 rounded border border-[#1e1e22] text-[#a1a1aa]\">" + xport + "</span>" +
    (if agent != "" { " <span class=\"text-[10px] text-[#a1a1aa]\">" + h(agent) + "</span>" } else { "" }) +
    "</td>" +
    "<td class=\"py-2 px-3 text-[10px] text-[#52525b] hide-mobile\">" + time_ago(ts_sec) + "</td>" +
    "<td class=\"py-2 px-3 text-xs\">" +
    "<a class=\"text-[#a78bfa] hover:underline\" href=\"/messages/" + ("" + (id)) + "\">view</a> · " +
    "<a class=\"text-[#a78bfa] hover:underline\" " + ladder_nav_attrs(call_id) + ">ladder</a>" +
    "</td></tr>"
}

fn messages_table(items) {
    site_labels := load_site_labels()
    mut rows := ""
    if items != null {
        for m in items {
            rows = rows + msg_row(m, site_labels)
        }
    }
    if rows == "" {
        rows = "<tr><td colspan=\"8\" class=\"py-8 text-center text-[#a1a1aa] text-sm\">No messages yet — send SIP to the core or run a probe.</td></tr>"
    }
    "<div class=\"overflow-x-auto card\">" +
    "<table class=\"w-full text-left text-sm\"><thead><tr class=\"text-[11px] uppercase tracking-wide text-[#a1a1aa] border-b border-[#1e1e22]\">" +
    "<th class=\"py-2 px-3 font-semibold hide-mobile\">ID</th><th class=\"py-2 px-3 font-semibold\">Method</th>" +
    "<th class=\"py-2 px-3 font-semibold\">Call-ID</th><th class=\"py-2 px-3 font-semibold hide-mobile\">Source IP</th><th class=\"py-2 px-3 font-semibold hide-mobile\">Destination IP</th>" +
    "<th class=\"py-2 px-3 font-semibold hide-mobile\">Transport</th><th class=\"py-2 px-3 font-semibold hide-mobile\">Time</th>" +
    "<th class=\"py-2 px-3 font-semibold\"></th></tr></thead>" +
    "<tbody class=\"divide-y divide-[#27272a]\">" + rows + "</tbody></table></div>"
}

fn call_groups_table(items) {
    site_labels := load_site_labels()
    mut rows := ""
    mut seen := []
    if items != null {
        for m in items {
            if !is_call_message(m) { continue }
            call_id := m["call_id"] ?? ""
            if call_id == "" { continue }

            mut exists := false
            for s in seen {
                if s == call_id { exists = true }
            }
            if exists { continue }
            seen = list_append(seen, call_id)

            mut count := 0
            mut requests := 0
            mut responses := 0
            mut last_ts := 0
            mut first_ts := 0
            mut src := ""
            mut dst := ""
            mut transport := ""
            mut last_method := ""
            mut last_status := 0
            mut invite_seen := false
            mut bye_seen := false
            mut cancel_seen := false

            for x in items {
                if (x["call_id"] ?? "") == call_id {
                    if !is_call_message(x) { continue }
                    count = count + 1
                    kind := x["kind"] ?? ""
                    method := x["method"] ?? ""
                    status := x["status"] ?? 0
                    ts_ms := x["ts_ms"] ?? 0
                    if kind == "response" { responses = responses + 1 } else { requests = requests + 1 }
                    if method == "INVITE" { invite_seen = true }
                    if method == "BYE" { bye_seen = true }
                    if method == "CANCEL" { cancel_seen = true }
                    if first_ts == 0 || ts_ms < first_ts { first_ts = ts_ms }
                    if ts_ms > last_ts {
                        last_ts = ts_ms
                        src = x["src"] ?? ""
                        dst = x["dst"] ?? ""
                        transport = x["transport"] ?? ""
                        last_method = method
                        last_status = status
                    }
                }
            }

            cid := h(call_id)
            mut state := "active"
            mut state_cls := "text-[#34d399] border-[rgba(52,211,153,.25)] bg-[rgba(52,211,153,.08)]"
            if bye_seen {
                state = "ended"
                state_cls = "text-[#a1a1aa] border-[#27272a] bg-[#18181b]"
            } else if cancel_seen {
                state = "canceled"
                state_cls = "text-[#f87171] border-[rgba(248,113,113,.25)] bg-[rgba(248,113,113,.08)]"
            } else if invite_seen {
                state = "ringing"
                state_cls = "text-[#fbbf24] border-[rgba(251,191,36,.25)] bg-[rgba(251,191,36,.08)]"
            }

            origin_ip := call_origin_ip(call_id, items)
            if origin_ip != "" { src = origin_ip }
            src_ip := endpoint_ip(src)
            dst_ip := endpoint_ip(dst)
            src_s := endpoint_display(src, site_labels)
            dst_s := endpoint_display(dst, site_labels)
            age := if last_ts > 0 { time_ago(last_ts / 1000) } else { "unknown" }
            last_label := if last_status > 0 { "" + (last_status) } else { last_method }

            rows = rows + "<tr class=\"hover:bg-white/[0.02]\">" +
                "<td class=\"py-2 px-3 mono text-xs max-w-[22rem] truncate\" title=\"" + cid + "\">" +
                "<a href=\"/messages?call_id=" + q(call_id) + "\" class=\"text-[#a78bfa] hover:underline\">" + cid + "</a>" +
                " <button onclick=\"navigator.clipboard.writeText(this.dataset.v).then(()=>{this.textContent='\\u2713';setTimeout(()=>this.textContent='\\u2398',1000)})\" data-v=\"" + cid + "\" class=\"text-[#3f3f46] hover:text-[#a1a1aa] cursor-pointer\" title=\"Copy Call-ID\">&#x2398;</button></td>" +
                "<td class=\"py-2 px-3 text-xs\"><span class=\"px-1.5 py-0.5 rounded border " + state_cls + "\">" + state + "</span></td>" +
                "<td class=\"py-2 px-3 mono text-xs text-right\">" + ("" + (count)) + "</td>" +
                "<td class=\"py-2 px-3 mono text-xs text-right hide-mobile\">" + ("" + (requests)) + " / " + ("" + (responses)) + "</td>" +
                "<td class=\"py-2 px-3 text-xs hide-mobile\">" + method_badge(last_method, last_status, if last_status > 0 { "response" } else { "" }) + "</td>" +
                "<td class=\"py-2 px-3 text-xs text-[#a1a1aa] max-w-[12rem] truncate hide-mobile\" title=\"" + h(src) + "\">" +
                "<a class=\"hover:text-[#e4e4e7] hover:underline\" href=\"/ip?addr=" + h(src_ip) + "\">" + src_s + "</a></td>" +
                "<td class=\"py-2 px-3 text-xs text-[#a1a1aa] max-w-[12rem] truncate hide-mobile\" title=\"" + h(dst) + "\">" +
                (if dst != "" { "<a class=\"hover:text-[#e4e4e7] hover:underline\" href=\"/ip?addr=" + h(dst_ip) + "\">" + dst_s + "</a>" } else { "<span class=\"text-[#52525b]\">unknown</span>" }) + "</td>" +
                "<td class=\"py-2 px-3 text-xs hide-mobile\"><span class=\"px-1.5 py-0.5 rounded border border-[#1e1e22] text-[#a1a1aa]\">" + h(transport) + "</span></td>" +
                "<td class=\"py-2 px-3 text-[10px] text-[#52525b]\">" + age + "</td>" +
                "<td class=\"py-2 px-3 text-xs\"><a class=\"text-[#a78bfa] hover:underline\" href=\"/messages?call_id=" + q(call_id) + "\">messages</a> · " +
                "<a class=\"text-[#a78bfa] hover:underline\" " + ladder_nav_attrs(call_id) + ">ladder</a></td></tr>"
        }
    }
    if rows == "" {
        rows = "<tr><td colspan=\"10\" class=\"py-8 text-center text-[#a1a1aa] text-sm\">No calls yet — send SIP to the core or wait for HEP captures.</td></tr>"
    }
    "<div class=\"overflow-x-auto card\">" +
    "<table class=\"w-full text-left text-sm\"><thead><tr class=\"text-[11px] uppercase tracking-wide text-[#a1a1aa] border-b border-[#1e1e22]\">" +
    "<th class=\"py-2 px-3 font-semibold\">Call-ID</th><th class=\"py-2 px-3 font-semibold\">State</th>" +
    "<th class=\"py-2 px-3 font-semibold text-right\">Msgs</th><th class=\"py-2 px-3 font-semibold text-right hide-mobile\">Req / Resp</th>" +
    "<th class=\"py-2 px-3 font-semibold hide-mobile\">Last</th><th class=\"py-2 px-3 font-semibold hide-mobile\">Origin IP</th><th class=\"py-2 px-3 font-semibold hide-mobile\">Destination IP</th>" +
    "<th class=\"py-2 px-3 font-semibold hide-mobile\">Transport</th><th class=\"py-2 px-3 font-semibold\">Last Seen</th>" +
    "<th class=\"py-2 px-3 font-semibold\"></th></tr></thead>" +
    "<tbody class=\"divide-y divide-[#27272a]\">" + rows + "</tbody></table></div>"
}

fn empty_metrics() {
    {
        "msgs_total": 0, "requests": 0, "responses": 0, "echoes": 0, "hep_total": 0,
        "probe_rtt_ms": 0, "probes_ok": 0, "probes_fail": 0, "uptime_ms": 0, "ring_idx": 0,
        "methods": {"INVITE": 0, "OPTIONS": 0, "REGISTER": 0, "BYE": 0, "ACK": 0, "INFO": 0, "MESSAGE": 0, "UNKNOWN": 0}
    }
}

fn fetch_metrics() {
    r := http.get(core_base() + "/api/metrics", api_headers())
    if !r.ok { return empty_metrics() }
    p := json.parse(r.value.body)
    if p.ok { p.value } else { empty_metrics() }
}

fn fetch_messages(limit, call_id) {
    fetch_messages_ex(limit, call_id, "", "", "", "", "", "", "")
}

fn fetch_messages_ex(limit, call_id, transport, agent, method, src, from_number, to_number, status) {
    fetch_messages_time(limit, call_id, transport, agent, method, src, from_number, to_number, status, "", "")
}

fn fetch_messages_time(limit, call_id, transport, agent, method, src, from_number, to_number, status, since_ms, until_ms) {
    mut path := core_base() + "/api/messages?limit=" + ("" + (limit))
    if call_id != "" { path = path + "&call_id=" + q(call_id) }
    if transport != "" { path = path + "&transport=" + q(transport) }
    if agent != "" { path = path + "&agent=" + q(agent) }
    if method != "" { path = path + "&method=" + q(method) }
    if src != "" { path = path + "&ip=" + q(src) }
    if from_number != "" { path = path + "&from_number=" + q(from_number) }
    if to_number != "" { path = path + "&to_number=" + q(to_number) }
    if status != "" { path = path + "&status=" + q(status) }
    if since_ms != "" { path = path + "&since_ms=" + q(since_ms) }
    if until_ms != "" { path = path + "&until_ms=" + q(until_ms) }
    r := http.get(path, api_headers())
    if !r.ok { return [] }
    p := json.parse(r.value.body)
    if p.ok { p.value } else { [] }
}

