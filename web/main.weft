// ---- share links ----
// Generates a time-limited HMAC token for read-only call ladder access without login.

fn make_share_token(token_secret, call_id) {
    expires := time.unix() + 86400 * 7
    payload := "share:" + call_id + ":" + ("" + (expires))
    sig := crypto.hmac_sha256(token_secret, payload)
    base64.encode(payload + ":" + sig)
}

fn verify_share_token(token_secret, token) {
    dec := base64.decode(token)
    if !dec.ok { return null }
    raw := dec.value
    if len(raw) < 66 { return null }
    sig_start := len(raw) - 64
    sep := str.slice(raw, sig_start - 1, sig_start)
    if sep != ":" { return null }
    payload := str.slice(raw, 0, sig_start - 1)
    got_sig := str.slice(raw, sig_start, len(raw))
    expected := crypto.hmac_sha256(token_secret, payload)
    if !crypto.equal(got_sig, expected) { return null }
    // Parse: share:call_id:expires
    if !str.starts_with(payload, "share:") { return null }
    rest := str.slice(payload, 6, len(payload))
    // Last segment is expires
    parts := str.split(rest, ":")
    if len(parts) < 2 { return null }
    expires := int.parse(parts[len(parts) - 1]).unwrap_or(0)
    if expires < time.unix() { return null }
    // Rejoin call_id (may contain colons)
    mut cid := parts[0]
    mut i := 1
    while i < len(parts) - 1 {
        cid = cid + ":" + parts[i]
        i = i + 1
    }
    cid
}

// ---- user preferences ----

fn prefs_path() {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    dir + "/zaman-prefs.json"
}

fn load_prefs() {
    r := fs.read(prefs_path())
    if !r.ok { return {} }
    p := json.parse(r.value)
    if p.ok { p.value } else { {} }
}

fn save_prefs(prefs) {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    if !fs.exists(dir) { fs.mkdir(dir) }
    fs.write_atomic(prefs_path(), json.stringify(prefs))
}

fn get_user_pref(username, key, default_val) {
    prefs := load_prefs()
    uprefs := prefs[username]
    if uprefs == null { return default_val }
    uprefs[key] ?? default_val
}

fn set_user_pref(username, key, value) {
    mut prefs := load_prefs()
    if prefs[username] == null {
        prefs[username] = {}
    }
    prefs[username][key] = value
    save_prefs(prefs)
}

// ---- API tokens ----
// Per-user long-lived tokens for automation (separate from session cookies).

fn api_tokens_path() {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    dir + "/zaman-api-tokens.json"
}

fn load_api_tokens() {
    r := fs.read(api_tokens_path())
    if !r.ok { return [] }
    p := json.parse(r.value)
    if p.ok { p.value } else { [] }
}

fn save_api_tokens(tokens) {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    if !fs.exists(dir) { fs.mkdir(dir) }
    fs.write_atomic(api_tokens_path(), json.stringify(tokens))
    fs.chmod(api_tokens_path(), 384)
}

fn create_api_token(username, role, label) {
    tokens := load_api_tokens()
    token := secrets.token_hex(32)
    hash := crypto.sha256(token)
    new_tok := {"hash": hash, "prefix": str.slice(token, 0, 8), "username": username, "role": role, "label": label, "created": time.unix()}
    save_api_tokens(list_append(tokens, new_tok))
    token
}

fn verify_api_token(token) {
    if token == "" { return null }
    hash := crypto.sha256(token)
    tokens := load_api_tokens()
    for t in tokens {
        if (t["hash"] ?? "") == hash {
            return {"username": t["username"], "role": t["role"], "id": 0}
        }
    }
    null
}

fn delete_api_token(prefix) {
    tokens := load_api_tokens()
    mut kept := "["
    mut first := true
    for t in tokens {
        if (t["prefix"] ?? "") != prefix {
            if !first { kept = kept + "," }
            kept = kept + json.stringify(t)
            first = false
        }
    }
    save_api_tokens(json.parse(kept + "]").value)
}

// ---- password policy ----

fn validate_password(pw) {
    if len(pw) < 12 { return "password must be at least 12 characters" }
    mut has_digit := false
    mut has_upper := false
    mut has_special := false
    mut i := 0
    while i < len(pw) {
        c := str.slice(pw, i, i + 1)
        if c >= "0" && c <= "9" { has_digit = true }
        if c >= "A" && c <= "Z" { has_upper = true }
        if !has_special {
            if (c < "0" || c > "9") && (c < "a" || c > "z") && (c < "A" || c > "Z") { has_special = true }
        }
        i = i + 1
    }
    if !has_digit { return "password must contain at least one digit" }
    if !has_upper { return "password must contain at least one uppercase letter" }
    if !has_special { return "password must contain at least one special character" }
    ""
}

// ---- IP allowlisting ----
// ZAMAN_DASHBOARD_ALLOW_IPS: comma-separated IPs/prefixes. Empty = allow all.

fn get_client_ip(req) {
    direct := req.headers["Remote-Addr"] ?? "unknown"
    trusted := env.get("ZAMAN_TRUSTED_PROXY") ?? ""
    // Only trust XFF/X-Real-Ip when TCP peer matches the trusted proxy
    if trusted != "" && direct != trusted {
        return direct
    }
    xff := req.headers["X-Forwarded-For"] ?? ""
    if xff != "" {
        parts := str.split(xff, ",")
        return str.trim(parts[0])
    }
    xri := req.headers["X-Real-Ip"] ?? ""
    if xri != "" { return str.trim(xri) }
    direct
}

fn ip_allowed(req) {
    allow := env.get("ZAMAN_DASHBOARD_ALLOW_IPS") ?? ""
    if allow == "" { return true }
    ip := get_client_ip(req)
    if ip == "unknown" || ip == "" { return true }
    parts := str.split(allow, ",")
    for p in parts {
        prefix := str.trim(p)
        if prefix == "" { continue }
        if ip == prefix { return true }
        if str.starts_with(ip, prefix) { return true }
    }
    false
}

fn ip_denied_page() {
    "<!doctype html><html><head><title>Access Denied</title></head>" +
    "<body style=\"background:#09090b;color:#f87171;font-family:system-ui;display:flex;align-items:center;justify-content:center;min-height:100vh\">" +
    "<div style=\"text-align:center\"><h1>403 Forbidden</h1><p>Your IP is not in the dashboard allowlist.</p></div></body></html>"
}

// ---- CSV export ----

fn messages_to_csv(messages) {
    mut csv := "id,ts_ms,src,dst,transport,proto,agent,kind,method,status,call_id,from,to,cseq,ruri\n"
    for m in messages {
        csv = csv +
            ("" + (m["id"] ?? "")) + "," +
            ("" + (m["ts_ms"] ?? "")) + "," +
            csv_field(m["src"] ?? "") + "," +
            csv_field(m["dst"] ?? "") + "," +
            csv_field(m["transport"] ?? "") + "," +
            csv_field(m["proto"] ?? "") + "," +
            csv_field(m["agent"] ?? "") + "," +
            csv_field(m["kind"] ?? "") + "," +
            csv_field(m["method"] ?? "") + "," +
            ("" + (m["status"] ?? 0)) + "," +
            csv_field(m["call_id"] ?? "") + "," +
            csv_field(m["from"] ?? "") + "," +
            csv_field(m["to"] ?? "") + "," +
            csv_field(m["cseq"] ?? "") + "," +
            csv_field(m["ruri"] ?? "") + "\n"
    }
    csv
}

fn csv_field(s) {
    if str.contains(s, ",") || str.contains(s, "\"") || str.contains(s, "\n") {
        return "\"" + str.replace(s, "\"", "\"\"") + "\""
    }
    s
}

// ---- config backup/restore ----

fn export_config() {
    users := load_users()
    alert_config := load_alert_config()
    searches := load_searches()
    api_tokens := load_api_tokens()
    // Scrub sensitive fields from users
    mut safe_users := "["
    mut first := true
    for u in users {
        if !first { safe_users = safe_users + "," }
        safe_users = safe_users + json.stringify({"id": u["id"], "username": u["username"], "role": u["role"]})
        first = false
    }
    safe_users = safe_users + "]"
    json.stringify({
        "version": "1.0",
        "exported_at": time.unix(),
        "users": json.parse(safe_users).value,
        "alerts": alert_config,
        "searches": searches,
        "api_token_count": len(api_tokens)
    })
}

// ---- SLA reporting ----

fn fetch_sla() {
    // SLA = percentage of time ASR was above threshold (default 45%)
    // Computed from daily rollups: if any INVITE traffic existed that day, check if failed > 55%
    r := http.get(core_base() + "/api/report/kpi", api_headers())
    if !r.ok { return {} }
    p := json.parse(r.value.body)
    if !p.ok { return {} }
    kpi := p.value
    total_inv := kpi["total_invites"] ?? 0
    answered := kpi["answered"] ?? 0
    failed := kpi["failed"] ?? 0
    asr := kpi["asr"] ?? 0
    // Simple SLA: asr-based availability
    mut sla_status := "healthy"
    if asr < 45 { sla_status = "degraded" }
    if asr < 35 { sla_status = "critical" }
    {
        "asr": asr,
        "total_invites": total_inv,
        "answered": answered,
        "failed": failed,
        "status": sla_status,
        "total_messages": kpi["total_messages"] ?? 0
    }
}

// ---- alerting engine ----
// Channels: Slack webhook, generic webhook (PagerDuty/Teams/Opsgenie), email.
// Rules: JSON file with thresholds. Evaluation runs on HTMX poll.
// History: last 100 fired alerts kept in memory (JSON file for persistence).

fn alerts_config_path() {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    dir + "/zaman-alerts.json"
}

fn alerts_history_path() {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    dir + "/zaman-alert-history.json"
}

fn load_alert_config() {
    r := fs.read(alerts_config_path())
    if !r.ok {
        return {
            "channels": [],
            "rules": [
                {"id": 1, "name": "Low ASR", "metric": "asr", "op": "<", "threshold": 40, "severity": "critical", "enabled": true},
                {"id": 2, "name": "High error rate", "metric": "err_rate", "op": ">", "threshold": 15, "severity": "critical", "enabled": true},
                {"id": 3, "name": "5xx spike", "metric": "resp_5xx", "op": ">", "threshold": 5, "severity": "critical", "enabled": true},
                {"id": 4, "name": "Auth failures", "metric": "err_401", "op": ">", "threshold": 10, "severity": "warning", "enabled": true},
                {"id": 5, "name": "Service unavailable", "metric": "err_503", "op": ">", "threshold": 3, "severity": "critical", "enabled": true}
            ]
        }
    }
    p := json.parse(r.value)
    if p.ok { p.value } else { {"channels": [], "rules": []} }
}

fn save_alert_config(config) {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    if !fs.exists(dir) { fs.mkdir(dir) }
    fs.write_atomic(alerts_config_path(), json.stringify(config))
}

fn load_alert_history() {
    r := fs.read(alerts_history_path())
    if !r.ok { return [] }
    p := json.parse(r.value)
    if p.ok { p.value } else { [] }
}

fn save_alert_history(history) {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    if !fs.exists(dir) { fs.mkdir(dir) }
    fs.write_atomic(alerts_history_path(), json.stringify(history))
}

fn add_alert_history(alert) {
    hist := load_alert_history()
    // Keep last 100
    mut trimmed := hist
    if len(trimmed) >= 100 {
        // Drop oldest (first element) — rebuild via JSON
        mut s := "["
        mut i := len(trimmed) - 99
        mut first := true
        while i < len(trimmed) {
            if !first { s = s + "," }
            s = s + json.stringify(trimmed[i])
            first = false
            i = i + 1
        }
        trimmed = json.parse(s + "]").value
    }
    save_alert_history(list_append(trimmed, alert))
}

// Fire alert to all configured channels
// Webhook with retry (3 attempts, 1s backoff)
fn post_with_retry(url, body) {
    mut attempt := 0
    while attempt < 3 {
        r := http.post(url, body, {"headers": {"Content-Type": "application/json"}})
        if r.ok { return }
        attempt = attempt + 1
        if attempt < 3 { time.sleep(1) }
    }
}

fn fire_alert(config, rule_name, severity, message) {
    channels := config["channels"] ?? []
    ts := time.unix()
    payload := {
        "rule": rule_name,
        "severity": severity,
        "message": message,
        "timestamp": ts,
        "source": "zaman"
    }
    // Record history
    add_alert_history(payload)

    for ch in channels {
        ch_type := ch["type"] ?? ""
        if ch_type == "slack" {
            url := ch["webhook_url"] ?? ""
            if url != "" {
                icon := if severity == "critical" { ":rotating_light:" } else { ":warning:" }
                slack_payload := json.stringify({
                    "text": icon + " *Zaman Alert — " + severity + "*\n" + message,
                    "username": "Zaman",
                    "icon_emoji": ":telephone:"
                })
                post_with_retry(url, slack_payload)
            }
        } else if ch_type == "webhook" {
            url := ch["url"] ?? ""
            if url != "" {
                post_with_retry(url, json.stringify(payload))
            }
        } else if ch_type == "email" {
            to_addr := ch["to"] ?? ""
            smtp_host := ch["smtp_host"] ?? "localhost"
            smtp_port := int.parse(ch["smtp_port"] ?? "25").unwrap_or(25)
            from_addr := ch["from"] ?? "zaman@localhost"
            if to_addr != "" {
                email.send({
                    "to": to_addr,
                    "from": from_addr,
                    "subject": "[Zaman " + severity + "] " + rule_name,
                    "body": message + "\n\nTimestamp: " + ("" + (ts)) + "\nSource: zaman-web",
                    "host": smtp_host,
                    "port": smtp_port
                })
            }
        }
    }
}

// Evaluate alert rules against real-time data. Called by HTMX poll.
// Returns HTML for the alerts bar + fires notifications.
fn evaluate_alerts(rt) {
    config := load_alert_config()
    rules := config["rules"] ?? []
    mut fired := []
    for rule in rules {
        enabled := rule["enabled"] ?? false
        if !enabled { continue }
        metric_name := rule["metric"] ?? ""
        op := rule["op"] ?? ">"
        threshold := rule["threshold"] ?? 0
        value := rt[metric_name] ?? 0
        mut triggered := false
        if op == ">" && value > threshold { triggered = true }
        if op == "<" && value < threshold && value > 0 { triggered = true }
        if op == ">=" && value >= threshold { triggered = true }
        if op == "==" && value == threshold { triggered = true }
        if triggered {
            name := rule["name"] ?? metric_name
            sev := rule["severity"] ?? "warning"
            msg := name + ": " + metric_name + "=" + ("" + (value)) + " (threshold " + op + " " + ("" + (threshold)) + ")"
            fire_alert(config, name, sev, msg)
            fired = list_append(fired, {"name": name, "severity": sev, "message": msg, "value": value})
        }
    }
    fired
}

// ---- report helpers ----

fn gauge_card(label, value, unit, color, sub) {
    crd := "card"
    "<div class=\"" + crd + " p-5\">" +
    "<div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold mb-3\">" + label + "</div>" +
    "<div class=\"flex items-end gap-1 mb-2\">" +
    "<span class=\"text-3xl font-bold mono\" style=\"color:" + color + "\">" + ("" + (value)) + "</span>" +
    "<span class=\"text-sm text-[#52525b] mb-0.5\">" + unit + "</span></div>" +
    "<div class=\"w-full h-1.5 rounded-full bg-[#27272a] overflow-hidden\">" +
    "<div class=\"h-full rounded-full transition-all duration-500\" style=\"width:" + ("" + (value)) + "%;background:" + color + "\"></div></div>" +
    "<div class=\"text-[11px] text-[#52525b] mt-2\">" + sub + "</div></div>"
}

fn rcode_bar(label, count, total, color) {
    pct := if total > 0 { count * 100 / total } else { 0 }
    "<div class=\"flex items-center gap-3 py-1.5\">" +
    "<span class=\"text-xs font-semibold w-8 mono\" style=\"color:" + color + "\">" + label + "</span>" +
    "<div class=\"flex-1 h-2 rounded-full bg-[#27272a] overflow-hidden\">" +
    "<div class=\"h-full rounded-full\" style=\"width:" + ("" + (pct)) + "%;background:" + color + "\"></div></div>" +
    "<span class=\"text-xs mono text-[#a1a1aa] w-12 text-right\">" + ("" + (count)) + "</span>" +
    "<span class=\"text-[10px] text-[#52525b] w-10 text-right\">" + ("" + (pct)) + "%</span></div>"
}

// ---- main ----

fn load_or_create_token_secret() {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    if !fs.exists(dir) { fs.mkdir(dir) }
    path := dir + "/zaman-token-secret"
    r := fs.read(path)
    if r.ok && len(r.value) >= 32 {
        return str.trim(r.value)
    }
    s := secrets.token_hex(32)
    fs.write_atomic(path, s)
    fs.chmod(path, 384)
    s
}

fn main {
    // HMAC secret — persisted to disk so sessions survive restarts.
    token_secret := load_or_create_token_secret()

    if auth_enabled() {
        auth_init(token_secret)
    }

    app := web.app()

    // ---- auth routes ----

    app.get("/favicon.svg", fn(req) {
        svg := "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\">" +
            "<defs><linearGradient id=\"g\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">" +
            "<stop offset=\"0%\" stop-color=\"#a78bfa\"/><stop offset=\"100%\" stop-color=\"#6d28d9\"/>" +
            "</linearGradient></defs>" +
            "<rect width=\"32\" height=\"32\" rx=\"7\" fill=\"url(#g)\"/>" +
            "<text x=\"16\" y=\"23\" text-anchor=\"middle\" font-family=\"system-ui,sans-serif\" font-weight=\"900\" font-size=\"20\" fill=\"#fff\">Z</text></svg>"
        {"status": 200, "headers": {"Content-Type": "image/svg+xml", "Cache-Control": "public, max-age=86400"}, "body": svg}
    })

    app.get("/login", fn(req) {
        if !ip_allowed(req) { return web.html(ip_denied_page()) }
        if !auth_enabled() { return {"status": 302, "headers": {"Location": "/"}, "body": ""} }
        user := get_user(req, token_secret)
        if user != null { return {"status": 302, "headers": {"Location": "/"}, "body": ""} }
        web.html(login_page(""))
    })

    app.post("/login", fn(req) {
        if !auth_enabled() { return {"status": 302, "headers": {"Location": "/"}, "body": ""} }
        client_ip := get_client_ip(req)
        if !check_login_rate(client_ip) {
            return web.html(login_page("Too many login attempts. Please wait 60 seconds."))
        }
        username := web.form_get(req, "username", "")
        password := web.form_get(req, "password", "")
        token := do_login(token_secret, username, password)
        if token == null {
            record_failed_login(client_ip)
            audit(username, "login_failed", "bad credentials")
            return web.html(login_page("Invalid username or password."))
        }
        audit(username, "login", "success")
        set_session_cookie(token)
    })

    app.get("/logout", fn(req) {
        clear_session_cookie()
    })

    // ---- dashboard routes (auth-wrapped) ----

    app.get("/", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        web.html(layout("Overview", overview_body(user), user))
    })

    app.get("/noc", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        nodes := fetch_nodes()
        rt := fetch_realtime(5)
        anomalies := fetch_anomalies()

        // Alerts
        mut alerts := ""
        for a in anomalies {
            sev := a["severity"] ?? "warning"
            cls := if sev == "critical" { "border-[#f87171]/20 bg-[#f87171]/5 text-[#f87171]" } else { "border-[#fbbf24]/20 bg-[#fbbf24]/5 text-[#fbbf24]" }
            alerts = alerts + "<div class=\"flex items-center gap-2 rounded-lg border " + cls + " px-3 py-2 text-xs\">" +
                "<span>&#x26A0;</span> " + h(a["message"] ?? "") + "</div>"
        }
        if alerts != "" { alerts = "<div class=\"space-y-1.5 mb-5\">" + alerts + "</div>" }

        // Summary bar
        mut green := 0
        mut yellow := 0
        mut red := 0
        for nd in nodes {
            st := nd["status"] ?? "red"
            if st == "green" { green = green + 1 }
            else if st == "yellow" { yellow = yellow + 1 }
            else { red = red + 1 }
        }
        summary := "<div class=\"flex items-center gap-6 mb-5 text-sm\">" +
            "<span class=\"flex items-center gap-1.5\"><span class=\"w-2.5 h-2.5 rounded-full bg-[#34d399]\"></span><span class=\"mono font-semibold\">" + ("" + (green)) + "</span> healthy</span>" +
            "<span class=\"flex items-center gap-1.5\"><span class=\"w-2.5 h-2.5 rounded-full bg-[#fbbf24]\"></span><span class=\"mono font-semibold\">" + ("" + (yellow)) + "</span> degraded</span>" +
            "<span class=\"flex items-center gap-1.5\"><span class=\"w-2.5 h-2.5 rounded-full bg-[#f87171]\"></span><span class=\"mono font-semibold\">" + ("" + (red)) + "</span> offline</span>" +
            "<span class=\"text-[#3f3f46]\">·</span>" +
            "<span class=\"text-[#52525b]\">Total: " + ("" + (len(nodes))) + " nodes</span>" +
            "<span class=\"text-[#52525b]\">·</span>" +
            "<span class=\"text-[#52525b]\">Active calls: <span class=\"mono text-[#a78bfa]\">" + ("" + (rt["active_calls"] ?? 0)) + "</span></span></div>"

        // Node table — not cards, a proper dense table
        th := "text-[10px] uppercase tracking-wider text-[#52525b] font-semibold"
        mut rows := ""
        for nd in nodes {
            nname := h(nd["agent"] ?? "")
            nstatus := nd["status"] ?? "red"
            nrecent := nd["recent"] ?? 0
            ntotal := nd["total"] ?? 0
            nerrors := nd["errors"] ?? 0
            ncalls := nd["calls"] ?? 0
            nage := nd["age_sec"] ?? 9999
            dot := if nstatus == "green" { "bg-[#34d399]" } else if nstatus == "yellow" { "bg-[#fbbf24]" } else { "bg-[#f87171]" }
            age_txt := if nage < 60 { ("" + (nage)) + "s" } else if nage < 3600 { ("" + (nage / 60)) + "m" } else { ("" + (nage / 3600)) + "h" }
            rows = rows + "<tr>" +
                "<td class=\"py-2 px-3\"><div class=\"flex items-center gap-2\"><span class=\"w-2 h-2 rounded-full " + dot + "\"></span>" +
                "<span class=\"text-sm font-medium\">" + nname + "</span></div></td>" +
                "<td class=\"py-2 px-3 mono text-xs text-right\">" + ("" + (nrecent)) + "</td>" +
                "<td class=\"py-2 px-3 mono text-xs text-right\">" + ("" + (ntotal)) + "</td>" +
                "<td class=\"py-2 px-3 mono text-xs text-right\">" + ("" + (ncalls)) + "</td>" +
                "<td class=\"py-2 px-3 mono text-xs text-right " + (if nerrors > 0 { "text-[#f87171] font-semibold" } else { "text-[#3f3f46]" }) + "\">" + ("" + (nerrors)) + "</td>" +
                "<td class=\"py-2 px-3 text-xs text-right text-[#52525b]\">" + age_txt + " ago</td>" +
                "<td class=\"py-2 px-3 text-xs\"><a class=\"text-[#a78bfa] hover:underline\" href=\"/messages?agent=" + nname + "\" hx-boost=\"true\">messages</a></td></tr>"
        }
        if rows == "" { rows = "<tr><td colspan=\"7\" class=\"py-8 text-center text-[#52525b] text-sm\">No nodes reporting.</td></tr>" }

        body := "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
            "<div><h1 class=\"text-xl font-semibold\">Network Operations</h1>" +
            "<p class=\"text-sm text-[#52525b] mt-0.5\">All HEP agents and network nodes · auto-refresh</p></div></div>" +
            alerts + summary +
            "<div class=\"card overflow-x-auto\" hx-get=\"/partials/noc-table\" hx-trigger=\"every 5s\" hx-swap=\"innerHTML\">" +
            "<table class=\"w-full text-left text-sm\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\">" +
            "<th class=\"py-2 px-3\">Node</th><th class=\"py-2 px-3 text-right\">5m</th><th class=\"py-2 px-3 text-right\">Total</th>" +
            "<th class=\"py-2 px-3 text-right\">Calls</th><th class=\"py-2 px-3 text-right\">Errors</th><th class=\"py-2 px-3 text-right\">Last seen</th><th class=\"py-2 px-3\"></th></tr></thead>" +
            "<tbody class=\"divide-y divide-[#1e1e22]/50\">" + rows + "</tbody></table></div>"
        web.html(layout("NOC", body, user))
    })

    app.get("/partials/status", fn(req) {
        m := fetch_health()
        if m["ok"] == true {
            web.htmx("<span class=\"text-[#34d399]\">● core up</span>")
        } else {
            web.htmx("<span class=\"text-[#f87171]\">● core down</span>")
        }
    })

    app.get("/partials/charts", fn(req) {
        win := int.parse(req.query_map["window"] ?? "5").unwrap_or(5)
        web.htmx(build_traffic_charts(win))
    })

    app.get("/partials/nodes", fn(req) {
        nodes := fetch_nodes()
        crd := "card"
        mut ncards := ""
        for nd in nodes {
            nname := h(nd["agent"] ?? "")
            nstatus := nd["status"] ?? "red"
            nrecent := nd["recent"] ?? 0
            nerrors := nd["errors"] ?? 0
            ncalls := nd["calls"] ?? 0
            nage := nd["age_sec"] ?? 9999
            dot := if nstatus == "green" { "bg-[#34d399]" } else if nstatus == "yellow" { "bg-[#fbbf24]" } else { "bg-[#f87171]" }
            age_txt := if nage < 60 { ("" + (nage)) + "s ago" } else if nage < 3600 { ("" + (nage / 60)) + "m ago" } else { ("" + (nage / 3600)) + "h ago" }
            ncards = ncards +
                "<a href=\"/messages?agent=" + nname + "\" class=\"" + crd + " p-4 hover:border-[#3f3f46] transition-colors block\" hx-boost=\"true\">" +
                "<div class=\"flex items-center gap-2 mb-2\">" +
                "<div class=\"w-2 h-2 rounded-full " + dot + " shrink-0\"></div>" +
                "<span class=\"text-sm font-medium truncate\">" + nname + "</span></div>" +
                "<div class=\"grid grid-cols-3 gap-2 text-[11px]\">" +
                "<div><span class=\"text-[#52525b]\">5m</span> <span class=\"mono\">" + ("" + (nrecent)) + "</span></div>" +
                "<div><span class=\"text-[#52525b]\">calls</span> <span class=\"mono\">" + ("" + (ncalls)) + "</span></div>" +
                "<div><span class=\"text-[#52525b]\">errs</span> <span class=\"mono " + (if nerrors > 0 { "text-[#f87171]" } else { "" }) + "\">" + ("" + (nerrors)) + "</span></div></div>" +
                "<div class=\"text-[10px] text-[#52525b] mt-1.5\">" + age_txt + "</div></a>"
        }
        if ncards == "" { ncards = "<div class=\"text-sm text-[#52525b] py-4\">No nodes reporting.</div>" }
        web.htmx("<div class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3\">" + ncards + "</div>")
    })

    app.get("/partials/messages", fn(req) {
        if auth_enabled() && get_user(req, token_secret) == null { return web.htmx("") }
        mut lim := int.parse(req.query_map["limit"] ?? "20").unwrap_or(0)
        if lim <= 0 { lim = 20 }
        cid := req.query_map["call_id"] ?? ""
        agent := req.query_map["agent"] ?? ""
        method := req.query_map["method"] ?? ""
        transport := req.query_map["transport"] ?? ""
        src := req.query_map["src"] ?? ""
        web.htmx(messages_table(fetch_messages_ex(lim, cid, transport, agent, method, src)))
    })

    app.get("/messages", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        cid := req.query_map["call_id"] ?? ""
        agent := req.query_map["agent"] ?? ""
        method := req.query_map["method"] ?? ""
        transport := req.query_map["transport"] ?? ""
        src := req.query_map["src"] ?? ""
        items := fetch_messages_ex(50, cid, transport, agent, method, src)
        cid_h := h(cid)
        agent_h := h(agent)
        method_h := h(method)
        transport_h := h(transport)
        src_h := h(src)
        // Active filter summary
        mut active := ""
        if cid != "" || agent != "" || method != "" || transport != "" || src != "" {
            mut tags := ""
            if cid != "" { tags = tags + "<span class=\"inline-flex items-center gap-1 rounded-md bg-[#27272a] px-2 py-1 text-xs mono\">call-id: " + cid_h + "</span>" }
            if agent != "" { tags = tags + "<span class=\"inline-flex items-center gap-1 rounded-md bg-[#27272a] px-2 py-1 text-xs mono\">agent: " + agent_h + "</span>" }
            if method != "" { tags = tags + "<span class=\"inline-flex items-center gap-1 rounded-md bg-[#27272a] px-2 py-1 text-xs mono\">method: " + method_h + "</span>" }
            if transport != "" { tags = tags + "<span class=\"inline-flex items-center gap-1 rounded-md bg-[#27272a] px-2 py-1 text-xs mono\">transport: " + transport_h + "</span>" }
            if src != "" { tags = tags + "<span class=\"inline-flex items-center gap-1 rounded-md bg-[#27272a] px-2 py-1 text-xs mono\">endpoint: " + src_h + "</span>" }
            active = "<div class=\"flex flex-wrap items-center gap-2 mb-4\">" +
                "<span class=\"text-xs text-[#71717a]\">Filtering:</span>" + tags +
                "<a href=\"/messages\" class=\"text-xs text-[#a78bfa] hover:underline\" hx-boost=\"true\">clear all</a></div>"
        }
        // Build query string for HTMX polling
        mut qs := "limit=50"
        if cid != "" { qs = qs + "&call_id=" + cid_h }
        if agent != "" { qs = qs + "&agent=" + agent_h }
        if method != "" { qs = qs + "&method=" + method_h }
        if transport != "" { qs = qs + "&transport=" + transport_h }
        if src != "" { qs = qs + "&src=" + src_h }
        // Saved searches sidebar
        searches := load_searches()
        mut saved_html := ""
        if len(searches) > 0 {
            mut slinks := ""
            for ss in searches {
                sid := ss["id"] ?? 0
                sname := h(ss["name"] ?? "")
                sp := ss["params"] ?? {}
                mut sq := ""
                if (sp["call_id"] ?? "") != "" { sq = sq + "&call_id=" + h(sp["call_id"]) }
                if (sp["agent"] ?? "") != "" { sq = sq + "&agent=" + h(sp["agent"]) }
                if (sp["method"] ?? "") != "" { sq = sq + "&method=" + h(sp["method"]) }
                if (sp["transport"] ?? "") != "" { sq = sq + "&transport=" + h(sp["transport"]) }
                if (sp["src"] ?? "") != "" { sq = sq + "&src=" + h(sp["src"]) }
                slinks = slinks + "<div class=\"flex items-center justify-between gap-2 py-1.5\">" +
                    "<a href=\"/messages?" + str.slice(sq, 1, len(sq)) + "\" class=\"text-xs text-[#a1a1aa] hover:text-[#e4e4e7] truncate\" hx-boost=\"true\">" + sname + "</a>" +
                    "<form method=\"post\" action=\"/searches/" + ("" + (sid)) + "/delete\" class=\"shrink-0\">" +
                    "<button class=\"text-[10px] text-[#52525b] hover:text-[#f87171]\">&times;</button></form></div>"
            }
            saved_html = "<div class=\"card p-4 mb-4\">" +
                "<div class=\"text-[11px] text-[#71717a] uppercase tracking-wider font-medium mb-2\">Saved searches</div>" +
                slinks + "</div>"
        }
        // Save current search form (only show if filtering)
        mut save_form := ""
        if cid != "" || agent != "" || method != "" || transport != "" || src != "" {
            save_form = "<form method=\"post\" action=\"/searches/save\" class=\"flex gap-2 items-center mt-3\">" +
                "<input type=\"hidden\" name=\"call_id\" value=\"" + cid_h + "\"/>" +
                "<input type=\"hidden\" name=\"agent\" value=\"" + agent_h + "\"/>" +
                "<input type=\"hidden\" name=\"method\" value=\"" + method_h + "\"/>" +
                "<input type=\"hidden\" name=\"transport\" value=\"" + transport_h + "\"/>" +
                "<input type=\"hidden\" name=\"src\" value=\"" + src_h + "\"/>" +
                "<input name=\"name\" placeholder=\"Save this search as…\" required class=\"flex-1 rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-1.5 text-xs mono\"/>" +
                "<button class=\"rounded-lg px-3 py-1.5 text-xs border border-[#1e1e22] text-[#a1a1aa] hover:text-[#e4e4e7]\">Save</button></form>"
        }
        // Export buttons
        mut export_qs := ""
        if cid != "" { export_qs = export_qs + "&call_id=" + cid_h }
        if agent != "" { export_qs = export_qs + "&agent=" + agent_h }
        if method != "" { export_qs = export_qs + "&method=" + method_h }
        if transport != "" { export_qs = export_qs + "&transport=" + transport_h }
        if src != "" { export_qs = export_qs + "&src=" + src_h }
        export_btns := "<div class=\"flex gap-2\">" +
            "<a href=\"/export/json?" + str.slice("x" + export_qs, 2, len("x" + export_qs)) + "\" class=\"rounded-lg px-2.5 py-1.5 text-[11px] border border-[#1e1e22] text-[#71717a] hover:text-[#e4e4e7] transition-colors\">JSON</a>" +
            "<a href=\"/export/csv?" + str.slice("x" + export_qs, 2, len("x" + export_qs)) + "\" class=\"rounded-lg px-2.5 py-1.5 text-[11px] border border-[#1e1e22] text-[#71717a] hover:text-[#e4e4e7] transition-colors\">CSV</a>" +
            (if cid != "" { "<a href=\"/pcap?call_id=" + cid_h + "\" class=\"rounded-lg px-2.5 py-1.5 text-[11px] border border-[#1e1e22] text-[#71717a] hover:text-[#e4e4e7] transition-colors\">PCAP</a>" } else { "" }) +
            "</div>"

        inp := "rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 text-sm mono"
        body := "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
            "<div><h1 class=\"text-2xl font-bold\">Messages</h1>" +
            "<p class=\"text-sm text-[#71717a] mt-1\">SIP/HEP captures with full search across all fields.</p></div>" +
            export_btns + "</div>" +
            saved_html +
            "<form class=\"card p-4 mb-5\" method=\"get\" action=\"/messages\">" +
            "<div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3\">" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Call-ID</label>" +
            "<input name=\"call_id\" value=\"" + cid_h + "\" placeholder=\"any\" class=\"w-full " + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Agent / Server</label>" +
            "<input name=\"agent\" value=\"" + agent_h + "\" placeholder=\"kamailio\" class=\"w-full " + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Method</label>" +
            "<input name=\"method\" value=\"" + method_h + "\" placeholder=\"INVITE\" class=\"w-full " + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Transport</label>" +
            "<input name=\"transport\" value=\"" + transport_h + "\" placeholder=\"UDP\" class=\"w-full " + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Endpoint IP</label>" +
            "<input name=\"src\" value=\"" + src_h + "\" placeholder=\"10.0.1\" class=\"w-full " + inp + "\"/></div>" +
            "<div class=\"flex items-end gap-2\">" +
            "<button class=\"flex-1 rounded-lg px-3 py-2 text-sm bg-[#27272a] text-[#e4e4e7] hover:bg-[#3f3f46] transition-colors\">Search</button></div>" +
            "</div>" + save_form + "</form>" +
            active +
            "<div id=\"msg-table\" hx-get=\"/partials/messages?" + qs + "\" hx-trigger=\"every 4s\" hx-swap=\"innerHTML\">" +
            messages_table(items) + "</div>"
        web.html(layout("Messages", body, user))
    })

    app.get("/messages/:id", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        id := req.params["id"]
        m := fetch_message(id)
        if m == null {
            web.html(layout("Not found", "<h1 class=\"text-xl font-bold\">Message not found</h1><p class=\"text-[#a1a1aa] mt-2\">id=" + h(id) + "</p>", user))
        } else {
            badge := method_badge(m["method"] ?? "", m["status"] ?? 0, m["kind"] ?? "")
            mut raw_txt := ""
            dec := base64.decode(m["raw_b64"] ?? "")
            if dec.ok {
                raw_txt = h(dec.value)
            } else {
                raw_txt = h(m["raw_b64"] ?? "")
            }
            cid_h := h(m["call_id"] ?? "")
            body := "<a href=\"/messages\" class=\"text-sm text-[#a78bfa] hover:underline\" hx-boost=\"true\">← messages</a>" +
                "<div class=\"flex items-center gap-3 mt-3 mb-6\"><h1 class=\"text-2xl font-bold\">Message #" + h(id) + "</h1>" + badge + "</div>" +
                "<div class=\"grid md:grid-cols-2 gap-3 mb-4 text-sm\">" +
                "<div class=\"rounded-xl border border-[#1e1e22] bg-[#131316] p-4 space-y-1\">" +
                "<div><span class=\"text-[#a1a1aa]\">Call-ID</span> <span class=\"mono\">" + cid_h + "</span></div>" +
                "<div><span class=\"text-[#a1a1aa]\">Src</span> <span class=\"mono\">" + h(m["src"] ?? "") + "</span></div>" +
                "<div><span class=\"text-[#a1a1aa]\">Dst</span> <span class=\"mono\">" + h(m["dst"] ?? "") + "</span></div>" +
                "<div><span class=\"text-[#a1a1aa]\">Transport</span> " + h(m["transport"] ?? "") +
                " · " + h(m["proto"] ?? "sip") + "</div>" +
                "<div><span class=\"text-[#a1a1aa]\">Agent</span> " + h(m["agent"] ?? "") +
                " <span class=\"mono text-[10px] text-[#a1a1aa]\">#" + ("" + (m["hep_node_id"] ?? 0)) + "</span></div></div>" +
                "<div class=\"rounded-xl border border-[#1e1e22] bg-[#131316] p-4 space-y-1\">" +
                "<div><span class=\"text-[#a1a1aa]\">From</span> <span class=\"mono text-xs\">" + h(m["from"] ?? "") + "</span></div>" +
                "<div><span class=\"text-[#a1a1aa]\">To</span> <span class=\"mono text-xs\">" + h(m["to"] ?? "") + "</span></div>" +
                "<div><span class=\"text-[#a1a1aa]\">CSeq</span> <span class=\"mono\">" + h(m["cseq"] ?? "") + "</span></div>" +
                "<div><span class=\"text-[#a1a1aa]\">R-URI</span> <span class=\"mono text-xs\">" + h(m["ruri"] ?? "") + "</span></div></div></div>" +
                "<div class=\"rounded-2xl border border-[#1e1e22] bg-[#111114] p-4\">" +
                "<div class=\"text-xs text-[#a1a1aa] mb-2\">Raw SIP</div>" +
                "<pre class=\"mono text-xs whitespace-pre-wrap break-all text-[#d4d4d8]\">" + raw_txt + "</pre></div>" +
                "<div class=\"mt-4\"><a class=\"text-[#a78bfa] text-sm hover:underline\" href=\"/calls?call_id=" + cid_h + "\" hx-boost=\"true\">Open call ladder →</a></div>"
            web.html(layout("Message " + ("" + (id)), body, user))
        }
    })

    app.get("/calls", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        cid := req.query_map["call_id"] ?? ""
        mut ladder := ""
        if cid != "" {
            ladder = ladder_html(cid)
        }
        // Show recent call-IDs for quick access
        tops := fetch_top_calls()
        mut recent := ""
        if len(tops) > 0 {
            mut links := ""
            for row in tops {
                rc := row["call_id"] ?? ""
                rc_h := h(rc)
                cnt := row["messages"] ?? 0
                sel := if rc == cid { " bg-[#27272a] text-[#e4e4e7]" } else { " text-[#a1a1aa] hover:bg-[#27272a]/50 hover:text-[#e4e4e7]" }
                links = links + "<a href=\"/calls?call_id=" + rc_h + "\" class=\"flex items-center justify-between rounded-lg px-3 py-2 text-xs mono transition-colors" + sel + "\" hx-boost=\"true\">" +
                    "<span class=\"truncate max-w-[20rem]\">" + rc_h + "</span>" +
                    "<span class=\"text-[#52525b] shrink-0 ml-2\">" + ("" + (cnt)) + "</span></a>"
            }
            recent = "<div class=\"card overflow-hidden mb-6\">" +
                "<div class=\"px-4 py-3 border-b border-[#1e1e22] text-xs font-medium text-[#71717a] uppercase tracking-wider\">Recent calls</div>" +
                "<div class=\"p-2 max-h-[280px] overflow-y-auto space-y-0.5\">" + links + "</div></div>"
        }
        cid_h := h(cid)
        mut empty_hint := ""
        if cid == "" {
            empty_hint = "<div class=\"card p-8 text-center\">" +
                "<div class=\"text-[#52525b] mb-2\"><svg class=\"w-10 h-10 mx-auto\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1\" d=\"M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2\"/></svg></div>" +
                "<p class=\"text-sm text-[#71717a]\">Select a Call-ID from the list or search above to view the signaling ladder.</p></div>"
        }
        body := "<h1 class=\"text-2xl font-bold mb-1\">Call ladder</h1>" +
            "<p class=\"text-sm text-[#71717a] mb-5\">SIP signaling flow grouped by Call-ID — arrows show request/response direction between endpoints.</p>" +
            "<form class=\"flex flex-wrap gap-2 mb-6\" method=\"get\" action=\"/calls\">" +
            "<input name=\"call_id\" value=\"" + cid_h + "\" placeholder=\"Search Call-ID…\" class=\"flex-1 rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 text-sm mono min-w-[16rem]\"/>" +
            "<button class=\"rounded-lg px-4 py-2 text-sm bg-gradient-to-br from-[#a78bfa] to-[#7c3aed] text-white\">Show</button></form>" +
            "<div class=\"grid lg:grid-cols-[280px_1fr] gap-6\">" +
            "<div>" + recent + "</div>" +
            "<div>" + (if cid != "" { ladder } else { empty_hint }) + "</div></div>"
        web.html(layout("Calls", body, user))
    })

    app.get("/probe", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "operator") {
            body := "<h1 class=\"text-2xl font-bold mb-2\">Echo probe</h1>" +
                "<div class=\"rounded-2xl border border-[rgba(251,191,36,.35)] bg-[rgba(251,191,36,.08)] p-4 text-sm text-[#fbbf24]\">" +
                "Probe requires <strong>operator</strong> or <strong>admin</strong> role. Your role: " + role_badge(user["role"] ?? "viewer") + "</div>"
            return web.html(layout("Probe", body, user))
        }
        body := "<h1 class=\"text-2xl font-bold mb-1\">Echo probe</h1>" +
            "<p class=\"text-sm text-[#a1a1aa] mb-6\">Active OPTIONS RTT. Core must set <code class=\"mono\">ZAMAN_PROBE=1</code> (off by default).</p>" +
            "<form hx-post=\"/probe\" hx-target=\"#probe-result\" hx-swap=\"innerHTML\" class=\"card p-5 grid md:grid-cols-3 gap-3 max-w-3xl\">" +
            "<label class=\"text-sm block\"><span class=\"text-[#a1a1aa] text-xs\">Host</span>" +
            "<input name=\"host\" value=\"127.0.0.1\" class=\"mt-1 w-full rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 mono text-sm\"/></label>" +
            "<label class=\"text-sm block\"><span class=\"text-[#a1a1aa] text-xs\">Port</span>" +
            "<input name=\"port\" value=\"5060\" class=\"mt-1 w-full rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 mono text-sm\"/></label>" +
            "<label class=\"text-sm block\"><span class=\"text-[#a1a1aa] text-xs\">Timeout (ms)</span>" +
            "<input name=\"timeout_ms\" value=\"2000\" class=\"mt-1 w-full rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 mono text-sm\"/></label>" +
            "<div class=\"md:col-span-3\"><button type=\"submit\" class=\"rounded-lg px-4 py-2 text-sm bg-gradient-to-br from-[#a78bfa] to-[#7c3aed] text-white\">Probe OPTIONS</button></div></form>" +
            "<div id=\"probe-result\" class=\"mt-4 max-w-3xl\"></div>"
        web.html(layout("Probe", body, user))
    })

    app.post("/probe", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return web.htmx("<div class=\"text-[#f87171]\">Unauthorized</div>") }
        if !has_role(user, "operator") { return web.htmx("<div class=\"text-[#f87171]\">Requires operator role</div>") }
        host := web.form_get(req, "host", "127.0.0.1")
        port := int.parse(web.form_get(req, "port", "5060")).unwrap_or(0)
        wait_ms := int.parse(web.form_get(req, "timeout_ms", "2000")).unwrap_or(0)
        payload := json.stringify({"host": host, "port": port, "timeout_ms": wait_ms})
        mut hdrs := {"Content-Type": "application/json"}
        key := env.get("ZAMAN_API_KEY") ?? ""
        if key != "" { hdrs["X-API-Key"] = key }
        resp := http.post(core_base() + "/api/probe", payload, {"headers": hdrs})
        mut data := {"ok": false, "error": "request failed"}
        if resp.ok {
            parsed := json.parse(resp.value.body)
            if parsed.ok { data = parsed.value } else { data = {"ok": false, "error": ("" + (resp.value.body))} }
        } else {
            data = {"ok": false, "error": ("" + (resp.err.message ?? resp.err))}
        }
        if data["ok"] == true {
            st := data["status"] ?? 0
            rtt := data["rtt_ms"] ?? 0
            hp := h(("" + (data["host"] ?? host)))
            prt := data["port"] ?? port
            cid := h(("" + (data["call_id"] ?? "")))
            web.htmx(
                "<div class=\"rounded-2xl border border-[rgba(52,211,153,.35)] bg-[rgba(52,211,153,.08)] p-4\">" +
                "<div class=\"text-[#34d399] font-semibold mb-2\">Probe OK</div>" +
                "<div class=\"grid grid-cols-2 gap-2 text-sm mono\">" +
                "<div>status <span class=\"text-[#e4e4e7]\">" + ("" + (st)) + "</span></div>" +
                "<div>rtt <span class=\"text-[#e4e4e7]\">" + ("" + (rtt)) + " ms</span></div>" +
                "<div class=\"col-span-2 text-xs text-[#a1a1aa]\">" + hp + ":" + ("" + (prt)) + "</div>" +
                "<div class=\"col-span-2 text-xs break-all text-[#a1a1aa]\">" + cid + "</div></div></div>"
            )
        } else {
            err := h(("" + (data["error"] ?? "probe failed")))
            web.htmx(
                "<div class=\"rounded-2xl border border-[rgba(248,113,113,.35)] bg-[rgba(248,113,113,.08)] p-4\">" +
                "<div class=\"text-[#f87171] font-semibold mb-1\">Probe failed</div>" +
                "<div class=\"text-sm mono\">" + err + "</div></div>"
            )
        }
    })

    app.get("/metrics", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        m := fetch_metrics()
        rt := fetch_realtime(5)
        kpi := fetch_kpi()
        rcodes := fetch_response_codes()
        crd := "card"

        mut methods := m["methods"]
        if methods == null { methods = {} }

        up_ms := n(m, "uptime_ms")
        up_h := up_ms / 3600000
        up_m := (up_ms % 3600000) / 60000

        // ── Core health ──
        health := "<div class=\"section\">" +
            "<div class=\"section-title\">Core health</div>" +
            "<div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3\">" +
            stat_card("Uptime", ("" + (up_h)) + "h " + ("" + (up_m)) + "m", "process") +
            stat_card("DB writes", n(m, "db_ok"), "errors " + ("" + (n(m, "db_err")))) +
            stat_card("Ring", ("" + (n(m, "ring_idx"))) + " / " + ("" + (n(m, "ring_size"))), "capture buffer") +
            stat_card("Parse errors", n(m, "parse_err"), "malformed SIP") +
            stat_card("Rate limited", n(m, "rate_limited"), "429 responses") +
            stat_card("Probe RTT", ("" + (n(m, "probe_rtt_ms"))) + "ms", "ok " + ("" + (n(m, "probes_ok"))) + " fail " + ("" + (n(m, "probes_fail")))) +
            "</div></div>"

        // ── Capture counters ──
        captures := "<div class=\"section\">" +
            "<div class=\"section-title\">Capture counters</div>" +
            "<div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-3\">" +
            stat_card("Total messages", n(m, "msgs_total"), "all protocols") +
            stat_card("SIP requests", n(m, "requests"), "inbound") +
            stat_card("SIP responses", n(m, "responses"), "received") +
            stat_card("Echoes sent", n(m, "echoes"), "auto-reply") +
            stat_card("2xx", n(m, "status_2xx"), "success responses") +
            "</div></div>"

        // ── HEP counters ──
        hep := "<div class=\"section\">" +
            "<div class=\"section-title\">HEP ingest</div>" +
            "<div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3\">" +
            stat_card("HEP total", n(m, "hep_total"), "accepted packets") +
            stat_card("HEP/UDP", n(m, "hep_udp"), "standard") +
            stat_card("HEP/TCP", n(m, "hep_tcp"), "stream") +
            stat_card("HEP/TLS", n(m, "hep_tls"), "encrypted") +
            stat_card("HEP errors", n(m, "hep_err"), "decode failures") +
            stat_card("HEP denied", n(m, "hep_deny"), "ACL blocked") +
            "</div>" +
            "<div class=\"grid grid-cols-3 gap-3 mt-3\">" +
            stat_card("HEP auth fail", n(m, "hep_auth_fail"), "password mismatch") +
            stat_card("HEP SIP", n(m, "hep_sip"), "proto_type=1") +
            stat_card("HEP RTCP", n(m, "hep_rtcp"), "proto_type=5") +
            "</div></div>"

        // ── Method breakdown ──
        inv := methods["INVITE"] ?? 0
        opts := methods["OPTIONS"] ?? 0
        reg := methods["REGISTER"] ?? 0
        bye := methods["BYE"] ?? 0
        ack := methods["ACK"] ?? 0
        info := methods["INFO"] ?? 0
        msg := methods["MESSAGE"] ?? 0
        unk := methods["UNKNOWN"] ?? 0

        method_bar := viz.bar({
            "INVITE": inv, "OPTIONS": opts, "REGISTER": reg, "BYE": bye,
            "ACK": ack, "INFO": info, "MESSAGE": msg,
        }, {"title": "SIP methods (all time)", "width": 560, "height": 200, "colors": ["#a78bfa", "#34d399", "#f472b6", "#fb923c", "#facc15", "#94a3b8", "#22d3ee"]})

        // Method table
        mut method_rows := ""
        mut total_methods := inv + opts + reg + bye + ack + info + msg + unk
        if total_methods == 0 { total_methods = 1 }
        for pair in [["INVITE", inv], ["OPTIONS", opts], ["REGISTER", reg], ["BYE", bye], ["ACK", ack], ["INFO", info], ["MESSAGE", msg], ["UNKNOWN", unk]] {
            mname := pair[0]
            mcount := pair[1]
            pct := mcount * 100 / total_methods
            if mcount > 0 {
                method_rows = method_rows + "<tr><td class=\"py-1.5 px-3 text-sm\">" + ("" + (mname)) + "</td>" +
                    "<td class=\"py-1.5 px-3 mono text-sm text-right\">" + ("" + (mcount)) + "</td>" +
                    "<td class=\"py-1.5 px-3 text-right\">" +
                    "<div class=\"flex items-center gap-2 justify-end\"><span class=\"text-xs text-[#52525b]\">" + ("" + (pct)) + "%</span>" +
                    "<div class=\"w-16 h-1.5 rounded-full bg-[#1e1e22] overflow-hidden\"><div class=\"h-full rounded-full bg-[#a78bfa]\" style=\"width:" + ("" + (pct)) + "%\"></div></div></div></td></tr>"
            }
        }

        // Response code breakdown
        mut rcode_rows := ""
        for rc in rcodes {
            st := rc["status"] ?? 0
            cnt := rc["count"] ?? 0
            cls := if st >= 200 && st < 300 { "text-[#34d399]" } else if st >= 400 { "text-[#f87171]" } else { "text-[#fbbf24]" }
            rcode_rows = rcode_rows + "<tr><td class=\"py-1.5 px-3 mono text-sm " + cls + " font-medium\">" + ("" + (st)) + "</td>" +
                "<td class=\"py-1.5 px-3 mono text-sm text-right\">" + ("" + (cnt)) + "</td></tr>"
        }
        if rcode_rows == "" { rcode_rows = "<tr><td colspan=\"2\" class=\"py-4 text-center text-[#3f3f46] text-sm\">No responses</td></tr>" }

        th := "text-[10px] uppercase tracking-wider text-[#52525b] font-semibold"
        method_section := "<div class=\"section\">" +
            "<div class=\"section-title\">SIP methods &amp; response codes</div>" +
            "<div class=\"grid lg:grid-cols-3 gap-4\">" +
            "<div class=\"" + crd + " p-4 overflow-x-auto\">" + method_bar.html + "</div>" +
            "<div class=\"" + crd + " overflow-x-auto\">" +
            "<table class=\"w-full text-left\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\">" +
            "<th class=\"py-1.5 px-3\">Method</th><th class=\"py-1.5 px-3 text-right\">Count</th><th class=\"py-1.5 px-3 text-right\">Share</th></tr></thead>" +
            "<tbody class=\"divide-y divide-[#1e1e22]/50\">" + method_rows + "</tbody></table></div>" +
            "<div class=\"" + crd + " overflow-x-auto\">" +
            "<table class=\"w-full text-left\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\">" +
            "<th class=\"py-1.5 px-3\">Status</th><th class=\"py-1.5 px-3 text-right\">Count</th></tr></thead>" +
            "<tbody class=\"divide-y divide-[#1e1e22]/50\">" + rcode_rows + "</tbody></table></div>" +
            "</div></div>"

        // ── Real-time window ──
        realtime := "<div class=\"section\">" +
            "<div class=\"section-title\">Real-time (5 min window)</div>" +
            "<div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3\">" +
            stat_card("Messages", rt["total"] ?? 0, "5-min window") +
            stat_card("INVITEs", rt["invites"] ?? 0, "call attempts") +
            stat_card("Active calls", rt["active_calls"] ?? 0, "in progress") +
            stat_card("ASR", ("" + (rt["asr"] ?? 0)) + "%", "answer-seizure") +
            stat_card("4xx errors", rt["resp_4xx"] ?? 0, "client errors") +
            stat_card("5xx errors", rt["resp_5xx"] ?? 0, "server errors") +
            "</div></div>"

        // ── KPI section ──
        asr := kpi["asr"] ?? 0
        ner := kpi["ner"] ?? 0
        asr_c := if asr >= 70 { "#34d399" } else if asr >= 40 { "#fbbf24" } else { "#f87171" }
        ner_c := if ner >= 80 { "#34d399" } else if ner >= 50 { "#fbbf24" } else { "#f87171" }
        kpi_section := "<div class=\"section\">" +
            "<div class=\"section-title\">Telecom KPIs (all time)</div>" +
            "<div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3\">" +
            gauge_card("ASR", asr, "%", asr_c, "answer-seizure ratio") +
            gauge_card("NER", ner, "%", ner_c, "network effectiveness") +
            stat_card("INVITEs", kpi["total_invites"] ?? 0, "answered " + ("" + (kpi["answered"] ?? 0))) +
            stat_card("Failed", kpi["failed"] ?? 0, "4xx+ on INVITE") +
            stat_card("Registrations", kpi["total_registers"] ?? 0, "ok " + ("" + (kpi["reg_ok"] ?? 0))) +
            stat_card("Reg failures", kpi["reg_fail"] ?? 0, "auth/denied") +
            "</div></div>"

        // ── Prometheus ──
        prom_url := h(core_base() + "/metrics")
        grafana_url := h(core_base() + "/api/grafana/")
        prom := "<div class=\"section\">" +
            "<div class=\"section-title\">Integration</div>" +
            "<div class=\"grid lg:grid-cols-2 gap-4\">" +
            "<div class=\"" + crd + " p-4 text-sm space-y-3\">" +
            "<div class=\"font-semibold\">Prometheus</div>" +
            "<p class=\"text-[#71717a] text-xs\">Scrape the core's <code class=\"mono\">/metrics</code> endpoint for standard text exposition.</p>" +
            "<code class=\"block mono text-xs bg-[#0a0a0c] border border-[#1e1e22] rounded-lg p-3 break-all\">" + prom_url + "</code>" +
            "<pre class=\"mono text-[11px] text-[#52525b] bg-[#0a0a0c] border border-[#1e1e22] rounded-lg p-3 overflow-x-auto\">scrape_configs:\n  - job_name: zaman\n    static_configs:\n      - targets: ['" + h(core_base()) + "']</pre></div>" +
            "<div class=\"" + crd + " p-4 text-sm space-y-3\">" +
            "<div class=\"font-semibold\">Grafana</div>" +
            "<p class=\"text-[#71717a] text-xs\">Use the SimpleJSON datasource plugin. Point at the Grafana API endpoint.</p>" +
            "<code class=\"block mono text-xs bg-[#0a0a0c] border border-[#1e1e22] rounded-lg p-3 break-all\">" + grafana_url + "</code>" +
            "<div class=\"text-[11px] text-[#52525b]\">Available metrics: messages_total, requests, responses, echoes, hep_total, asr, ner, active_calls, err_rate</div></div>" +
            "</div></div>"

        body := "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
            "<h1 class=\"text-xl font-semibold\">Metrics</h1>" +
            "<div class=\"flex gap-2\">" +
            "<a href=\"" + prom_url + "\" target=\"_blank\" class=\"text-[11px] text-[#52525b] hover:text-[#a1a1aa] transition-colors\">Prometheus →</a>" +
            "<a href=\"" + h(core_base() + "/api/metrics") + "\" target=\"_blank\" class=\"text-[11px] text-[#52525b] hover:text-[#a1a1aa] transition-colors\">JSON →</a></div></div>" +
            health + captures + hep + realtime + kpi_section + method_section + prom
        web.html(layout("Metrics", body, user))
    })

    app.get("/report", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        rep := fetch_report()
        kpi := fetch_kpi()
        tops := fetch_top_calls()
        talkers := fetch_top_talkers()
        agents := fetch_agents()
        rcodes := fetch_response_codes()
        daily := fetch_daily()
        crd := "card"
        th := "text-[10px] uppercase tracking-wider text-[#52525b] font-semibold"

        // ── Section 1: Telecom KPIs with visual gauges ──
        asr := kpi["asr"] ?? 0
        ner := kpi["ner"] ?? 0
        asr_color := if asr >= 70 { "#34d399" } else if asr >= 40 { "#fbbf24" } else { "#f87171" }
        ner_color := if ner >= 80 { "#34d399" } else if ner >= 50 { "#fbbf24" } else { "#f87171" }
        total_inv := kpi["total_invites"] ?? 0
        answered := kpi["answered"] ?? 0
        failed := kpi["failed"] ?? 0
        reg_ok := kpi["reg_ok"] ?? 0
        reg_fail := kpi["reg_fail"] ?? 0
        total_reg := kpi["total_registers"] ?? 0

        sec_kpi := "<div class=\"mb-8\">" +
            "<div class=\"flex items-center gap-2 mb-4\"><h2 class=\"text-lg font-semibold\">Telecom KPIs</h2>" +
            "<span class=\"text-[10px] text-[#52525b] bg-[#27272a] rounded px-1.5 py-0.5\">REAL-TIME</span></div>" +
            "<div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3\">" +
            gauge_card("ASR", asr, "%", asr_color, "Answer-seizure ratio") +
            gauge_card("NER", ner, "%", ner_color, "Network effectiveness") +
            "<div class=\"" + crd + " p-5\">" +
            "<div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold mb-3\">INVITEs</div>" +
            "<div class=\"text-3xl font-bold mono text-[#e4e4e7] mb-2\">" + ("" + (total_inv)) + "</div>" +
            "<div class=\"flex gap-3 text-[11px]\">" +
            "<span class=\"text-[#34d399]\">&#x2713; " + ("" + (answered)) + " answered</span>" +
            "<span class=\"text-[#f87171]\">&#x2717; " + ("" + (failed)) + " failed</span></div></div>" +
            "<div class=\"" + crd + " p-5\">" +
            "<div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold mb-3\">Registrations</div>" +
            "<div class=\"text-3xl font-bold mono text-[#e4e4e7] mb-2\">" + ("" + (total_reg)) + "</div>" +
            "<div class=\"flex gap-3 text-[11px]\">" +
            "<span class=\"text-[#34d399]\">&#x2713; " + ("" + (reg_ok)) + " ok</span>" +
            "<span class=\"text-[#f87171]\">&#x2717; " + ("" + (reg_fail)) + " failed</span></div></div>" +
            stat_card("Messages", kpi["total_messages"] ?? 0, "total captures") +
            stat_card("Unique calls", kpi["total_calls"] ?? 0, "distinct Call-IDs") +
            "</div></div>"

        // ── Section 2: Traffic Distribution ──
        mut methods := rep["methods"]
        if methods == null { methods = {} }
        bar := viz.bar({
            "INVITE": methods["INVITE"] ?? 0,
            "OPTIONS": methods["OPTIONS"] ?? 0,
            "REGISTER": methods["REGISTER"] ?? 0,
            "BYE": methods["BYE"] ?? 0,
            "ACK": methods["ACK"] ?? 0,
        }, {"title": "SIP methods", "width": 520, "height": 220, "colors": ["#a78bfa", "#34d399", "#f472b6", "#fb923c", "#facc15"]})
        mut trs := rep["transports"]
        if trs == null { trs = {} }
        pie := viz.pie({
            "UDP": trs["UDP"] ?? 0,
            "HEP3": trs["HEP3"] ?? 0,
            "HEP3/TCP": trs["HEP3/TCP"] ?? 0,
            "HEP3/TLS": trs["HEP3/TLS"] ?? 0,
        }, {"title": "Capture transport", "width": 400, "height": 240})

        // Response code groups with color bars
        mut total_responses := 0
        mut rcode_1xx := 0
        mut rcode_2xx := 0
        mut rcode_3xx := 0
        mut rcode_4xx := 0
        mut rcode_5xx := 0
        for rc in rcodes {
            st := rc["status"] ?? 0
            cnt := rc["count"] ?? 0
            total_responses = total_responses + cnt
            if st >= 100 && st < 200 { rcode_1xx = rcode_1xx + cnt }
            else if st >= 200 && st < 300 { rcode_2xx = rcode_2xx + cnt }
            else if st >= 300 && st < 400 { rcode_3xx = rcode_3xx + cnt }
            else if st >= 400 && st < 500 { rcode_4xx = rcode_4xx + cnt }
            else if st >= 500 { rcode_5xx = rcode_5xx + cnt }
        }
        mut rcode_bars := "<div class=\"" + crd + " p-5\">" +
            "<div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold mb-4\">Response codes</div>" +
            rcode_bar("1xx", rcode_1xx, total_responses, "#a78bfa") +
            rcode_bar("2xx", rcode_2xx, total_responses, "#34d399") +
            rcode_bar("3xx", rcode_3xx, total_responses, "#22d3ee") +
            rcode_bar("4xx", rcode_4xx, total_responses, "#fb923c") +
            rcode_bar("5xx", rcode_5xx, total_responses, "#f87171") +
            "<div class=\"border-t border-[#1e1e22] mt-3 pt-3\">"
        // Individual status codes
        for rc in rcodes {
            st := rc["status"] ?? 0
            cnt := rc["count"] ?? 0
            sc := if st >= 200 && st < 300 { "text-[#34d399]" } else if st >= 400 { "text-[#f87171]" } else if st >= 300 { "text-[#22d3ee]" } else if st >= 500 { "text-[#f87171]" } else { "text-[#a78bfa]" }
            rcode_bars = rcode_bars + "<div class=\"flex justify-between py-0.5\">" +
                "<span class=\"mono text-xs font-medium " + sc + "\">" + ("" + (st)) + "</span>" +
                "<span class=\"mono text-xs text-[#71717a]\">" + ("" + (cnt)) + "</span></div>"
        }
        rcode_bars = rcode_bars + "</div></div>"

        sec_traffic := "<div class=\"mb-8\">" +
            "<h2 class=\"text-lg font-semibold mb-4\">Traffic distribution</h2>" +
            "<div class=\"grid lg:grid-cols-3 gap-4\">" +
            "<div class=\"" + crd + " p-5 overflow-x-auto\">" + bar.html + "</div>" +
            "<div class=\"" + crd + " p-5 overflow-x-auto\">" + pie.html + "</div>" +
            rcode_bars +
            "</div></div>"

        // ── Section 3: Network topology — agents + top talkers side by side ──
        mut agent_rows := ""
        mut rank := 1
        for a in agents {
            aname := h(a["agent"] ?? "")
            amsg := a["messages"] ?? 0
            acall := a["calls"] ?? 0
            // Bar relative to max
            max_msg := if len(agents) > 0 { (agents[0]["messages"] ?? 1) } else { 1 }
            bar_w := if max_msg > 0 { amsg * 100 / max_msg } else { 0 }
            agent_rows = agent_rows + "<tr>" +
                "<td class=\"py-2.5 px-4 text-[11px] text-[#52525b] mono\">" + ("" + (rank)) + "</td>" +
                "<td class=\"py-2.5 px-4\"><div class=\"text-sm font-medium\">" + aname + "</div>" +
                "<div class=\"w-full h-1 rounded-full bg-[#27272a] mt-1.5\"><div class=\"h-full rounded-full bg-[#a78bfa]/60\" style=\"width:" + ("" + (bar_w)) + "%\"></div></div></td>" +
                "<td class=\"py-2.5 px-4 mono text-sm text-right\">" + ("" + (amsg)) + "</td>" +
                "<td class=\"py-2.5 px-4 mono text-sm text-right text-[#71717a]\">" + ("" + (acall)) + "</td>" +
                "<td class=\"py-2.5 px-4\"><a class=\"text-[11px] text-[#a78bfa] hover:underline\" href=\"/messages?agent=" + aname + "\" hx-boost=\"true\">view</a></td></tr>"
            rank = rank + 1
        }
        if agent_rows == "" { agent_rows = "<tr><td colspan=\"5\" class=\"py-8 text-center text-[#52525b] text-sm\">No HEP agents reporting yet.</td></tr>" }

        mut talker_rows := ""
        rank = 1
        for t in talkers {
            tsrc := h(t["src"] ?? "")
            tmsg := t["messages"] ?? 0
            tcall := t["calls"] ?? 0
            max_t := if len(talkers) > 0 { (talkers[0]["messages"] ?? 1) } else { 1 }
            tw := if max_t > 0 { tmsg * 100 / max_t } else { 0 }
            talker_rows = talker_rows + "<tr>" +
                "<td class=\"py-2.5 px-4 text-[11px] text-[#52525b] mono\">" + ("" + (rank)) + "</td>" +
                "<td class=\"py-2.5 px-4\"><div class=\"mono text-xs\">" + tsrc + "</div>" +
                "<div class=\"w-full h-1 rounded-full bg-[#27272a] mt-1.5\"><div class=\"h-full rounded-full bg-[#34d399]/60\" style=\"width:" + ("" + (tw)) + "%\"></div></div></td>" +
                "<td class=\"py-2.5 px-4 mono text-sm text-right\">" + ("" + (tmsg)) + "</td>" +
                "<td class=\"py-2.5 px-4 mono text-sm text-right text-[#71717a]\">" + ("" + (tcall)) + "</td>" +
                "<td class=\"py-2.5 px-4\"><a class=\"text-[11px] text-[#a78bfa] hover:underline\" href=\"/messages?src=" + tsrc + "\" hx-boost=\"true\">view</a></td></tr>"
            rank = rank + 1
        }
        if talker_rows == "" { talker_rows = "<tr><td colspan=\"5\" class=\"py-8 text-center text-[#52525b] text-sm\">No endpoints seen yet.</td></tr>" }

        hdr5 := "<tr class=\"" + th + " border-b border-[#1e1e22]\"><th class=\"py-2 px-4 w-8\">#</th><th class=\"py-2 px-4\">Name</th><th class=\"py-2 px-4 text-right\">Msgs</th><th class=\"py-2 px-4 text-right\">Calls</th><th class=\"py-2 px-4 w-12\"></th></tr>"

        sec_network := "<div class=\"mb-8\">" +
            "<h2 class=\"text-lg font-semibold mb-4\">Network topology</h2>" +
            "<div class=\"grid lg:grid-cols-2 gap-4\">" +
            "<div class=\"" + crd + " overflow-x-auto\">" +
            "<div class=\"px-5 py-3 border-b border-[#1e1e22] flex items-center justify-between\">" +
            "<span class=\"text-sm font-semibold\">HEP agents</span>" +
            "<span class=\"text-[10px] text-[#52525b] mono\">" + ("" + (len(agents))) + " nodes</span></div>" +
            "<table class=\"w-full text-left\"><thead>" + hdr5 + "</thead>" +
            "<tbody class=\"divide-y divide-[#27272a]/40\">" + agent_rows + "</tbody></table></div>" +
            "<div class=\"" + crd + " overflow-x-auto\">" +
            "<div class=\"px-5 py-3 border-b border-[#1e1e22] flex items-center justify-between\">" +
            "<span class=\"text-sm font-semibold\">Top endpoints</span>" +
            "<span class=\"text-[10px] text-[#52525b] mono\">" + ("" + (len(talkers))) + " sources</span></div>" +
            "<table class=\"w-full text-left\"><thead>" + hdr5 + "</thead>" +
            "<tbody class=\"divide-y divide-[#27272a]/40\">" + talker_rows + "</tbody></table></div>" +
            "</div></div>"

        // ── Section 4: Call activity ──
        mut top_rows := ""
        for row in tops {
            cid := h(row["call_id"] ?? "")
            msgs := row["messages"] ?? 0
            top_rows = top_rows + "<tr>" +
                "<td class=\"py-2 px-4 mono text-xs max-w-[22rem] truncate\" title=\"" + cid + "\">" + cid + "</td>" +
                "<td class=\"py-2 px-4 mono text-sm text-right\">" + ("" + (msgs)) + "</td>" +
                "<td class=\"py-2 px-4 text-right\">" +
                "<a class=\"text-[11px] text-[#a78bfa] hover:underline\" href=\"/calls?call_id=" + cid + "\" hx-boost=\"true\">ladder</a>" +
                " <a class=\"text-[11px] text-[#52525b] hover:text-[#a1a1aa]\" href=\"/pcap?call_id=" + cid + "\">pcap</a></td></tr>"
        }
        if top_rows == "" { top_rows = "<tr><td colspan=\"3\" class=\"py-8 text-center text-[#52525b] text-sm\">No calls captured yet.</td></tr>" }

        mut day_rows := ""
        for row in daily {
            day_rows = day_rows + "<tr>" +
                "<td class=\"py-1.5 px-4 mono text-xs\">" + h(row["day"] ?? "") + "</td>" +
                "<td class=\"py-1.5 px-4 text-xs\">" + h(row["method"] ?? "") + "</td>" +
                "<td class=\"py-1.5 px-4 text-xs text-[#71717a]\">" + h(row["transport"] ?? "") + "</td>" +
                "<td class=\"py-1.5 px-4 mono text-sm text-right\">" + ("" + (row["count"] ?? 0)) + "</td></tr>"
        }
        if day_rows == "" { day_rows = "<tr><td colspan=\"4\" class=\"py-6 text-center text-[#52525b] text-sm\">No daily rollups yet.</td></tr>" }

        sec_calls := "<div class=\"mb-8\">" +
            "<h2 class=\"text-lg font-semibold mb-4\">Call activity</h2>" +
            "<div class=\"grid lg:grid-cols-2 gap-4\">" +
            "<div class=\"" + crd + " overflow-x-auto\">" +
            "<div class=\"px-5 py-3 border-b border-[#1e1e22] flex items-center justify-between\">" +
            "<span class=\"text-sm font-semibold\">Busiest Call-IDs</span>" +
            "<span class=\"text-[10px] text-[#52525b] mono\">" + ("" + (len(tops))) + " calls</span></div>" +
            "<table class=\"w-full text-left text-sm\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\">" +
            "<th class=\"py-2 px-4\">Call-ID</th><th class=\"py-2 px-4 text-right\">Msgs</th><th class=\"py-2 px-4 text-right\"></th></tr></thead>" +
            "<tbody class=\"divide-y divide-[#27272a]/40\">" + top_rows + "</tbody></table></div>" +
            "<div class=\"" + crd + " overflow-x-auto\">" +
            "<div class=\"px-5 py-3 border-b border-[#1e1e22] flex items-center justify-between\">" +
            "<span class=\"text-sm font-semibold\">Daily rollup</span>" +
            "<span class=\"text-[10px] text-[#52525b]\">method × transport per day</span></div>" +
            "<table class=\"w-full text-left text-sm\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\">" +
            "<th class=\"py-2 px-4\">Day</th><th class=\"py-2 px-4\">Method</th><th class=\"py-2 px-4\">Transport</th><th class=\"py-2 px-4 text-right\">Count</th></tr></thead>" +
            "<tbody class=\"divide-y divide-[#27272a]/40\">" + day_rows + "</tbody></table></div>" +
            "</div></div>"

        // ── Section 5: Database info ──
        ts_min := rep["ts_min"] ?? 0
        ts_max := rep["ts_max"] ?? 0
        span_h := if ts_max > ts_min { (ts_max - ts_min) / 3600000 } else { 0 }
        db_info := "<div class=\"" + crd + " p-5\">" +
            "<div class=\"flex items-center justify-between\">" +
            "<div class=\"text-sm\">" +
            "<span class=\"text-[#71717a]\">Storage:</span> <span class=\"mono text-xs\">" + h(rep["db"] ?? "data/zaman.db") + "</span>" +
            " · <span class=\"text-[#71717a]\">Span:</span> <span class=\"mono text-xs\">" + ("" + (span_h)) + "h</span>" +
            " · <span class=\"text-[#71717a]\">SIP/UDP:</span> <span class=\"mono text-xs\">" + ("" + (rep["sip_udp"] ?? 0)) + "</span>" +
            " · <span class=\"text-[#71717a]\">HEP:</span> <span class=\"mono text-xs\">" + ("" + (rep["hep"] ?? 0)) + "</span></div>" +
            "<a href=\"/export/json\" class=\"rounded-lg px-3 py-1.5 text-[11px] border border-[#1e1e22] text-[#71717a] hover:text-[#e4e4e7] transition-colors\">Export all JSON</a>" +
            "</div></div>"

        // Assemble
        body := "<div class=\"flex items-end justify-between gap-3 mb-6\">" +
            "<div><h1 class=\"text-2xl font-bold\">Reports</h1>" +
            "<p class=\"text-sm text-[#71717a] mt-1\">Telecom KPIs, traffic analysis, network topology, and capture history.</p></div></div>" +
            sec_kpi + sec_traffic + sec_network + sec_calls + db_info
        web.html(layout("Reports", body, user))
    })

    // ---- share link (public read-only ladder) ----

    app.get("/share", fn(req) {
        tok := req.query_map["token"] ?? ""
        if tok == "" { return web.status(400) }
        call_id := verify_share_token(token_secret, tok)
        if call_id == null { return web.html("<!doctype html><html><body style='background:#09090b;color:#f87171;font-family:system-ui;display:flex;align-items:center;justify-content:center;min-height:100vh'><div><h1>Link expired or invalid</h1><p>Share links are valid for 7 days.</p></div></body></html>") }
        // Render ladder without auth (read-only)
        anon := {"id": 0, "username": "shared", "role": "viewer"}
        web.html(layout("Shared: " + call_id, ladder_html(call_id), anon))
    })

    // Generate share link (requires login)
    app.post("/share/create", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        cid := web.form_get(req, "call_id", "")
        if cid == "" { return web.status(400) }
        tok := make_share_token(token_secret, cid)
        audit(user["username"] ?? "", "share_create", "call_id=" + cid)
        // Return the share URL as HTMX partial
        share_url := "/share?token=" + tok
        web.htmx("<div class=\"rounded-xl border border-[#34d399]/30 bg-[#34d399]/5 p-3 mt-3\">" +
            "<div class=\"text-xs text-[#34d399] font-semibold mb-1\">Share link created (valid 7 days)</div>" +
            "<input class=\"w-full mono text-xs bg-[#0a0a0c] border border-[#1e1e22] rounded-lg px-3 py-2 select-all\" value=\"" + h(share_url) + "\" readonly onclick=\"this.select()\"/></div>")
    })

    // ---- user preferences ----

    app.post("/preferences", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        uname := user["username"] ?? ""
        default_window := web.form_get(req, "default_window", "5")
        set_user_pref(uname, "default_window", default_window)
        {"status": 302, "headers": {"Location": "/"}, "body": ""}
    })

    // ---- PCAP export route ----

    app.get("/pcap", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        cid := req.query_map["call_id"] ?? ""
        if cid == "" { return web.status(400) }
        messages := fetch_messages(500, cid)
        // Sort chronological
        mut ordered := []
        mut i := len(messages) - 1
        while i >= 0 {
            ordered = list_append(ordered, messages[i])
            i = i - 1
        }
        if len(ordered) == 0 { return web.status(404) }
        pcap := build_pcap(ordered)
        fname := sanitize_cid(cid) + ".pcap"
        {"status": 200, "headers": {"Content-Type": "application/vnd.tcpdump.pcap", "Content-Disposition": "attachment; filename=\"" + fname + "\""}, "body": pcap}
    })

    // ---- JSON export route ----

    app.get("/export/json", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        cid := req.query_map["call_id"] ?? ""
        agent := req.query_map["agent"] ?? ""
        method := req.query_map["method"] ?? ""
        transport := req.query_map["transport"] ?? ""
        src := req.query_map["src"] ?? ""
        messages := fetch_messages_ex(500, cid, transport, agent, method, src)
        body := json.stringify(messages)
        {"status": 200, "headers": {"Content-Type": "application/json", "Content-Disposition": "attachment; filename=\"zaman-export.json\""}, "body": body}
    })

    // ---- saved search routes ----

    app.post("/searches/save", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        name := web.form_get(req, "name", "")
        if name == "" { return {"status": 302, "headers": {"Location": "/messages"}, "body": ""} }
        params := {
            "call_id": web.form_get(req, "call_id", ""),
            "agent": web.form_get(req, "agent", ""),
            "method": web.form_get(req, "method", ""),
            "transport": web.form_get(req, "transport", ""),
            "src": web.form_get(req, "src", "")
        }
        create_search(name, user["username"] ?? "", params)
        {"status": 302, "headers": {"Location": "/messages"}, "body": ""}
    })

    app.post("/searches/:id/delete", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        id := int.parse(req.params["id"]).unwrap_or(0)
        if id > 0 { delete_search(id) }
        {"status": 302, "headers": {"Location": "/messages"}, "body": ""}
    })

    // ---- recording routes ----

    app.get("/recordings/:cid", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return web.status(401) }
        cid := req.params["cid"]
        path := recording_path(cid)
        if !fs.exists(path) { return web.status(404) }
        data := fs.read_bytes(path)
        if !data.ok { return web.status(500) }
        {"status": 200, "headers": {"Content-Type": "audio/wav", "Cache-Control": "public, max-age=3600"}, "body": data.value}
    })

    app.post("/recordings/upload", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "operator") { return web.status(403) }
        cid := web.form_get(req, "call_id", "")
        if cid == "" { return web.html(layout("Error", "<p class=\"text-[#f87171]\">Missing call_id</p>", user)) }
        f := req.files["file"]
        if f == null { return web.html(layout("Error", "<p class=\"text-[#f87171]\">No file uploaded</p>", user)) }
        // F4: file size limit (50 MB)
        fsize := f["size"] ?? 0
        if fsize > 52428800 { return web.html(layout("Error", "<p class=\"text-[#f87171]\">File too large (max 50 MB)</p>", user)) }
        dir := recordings_dir()
        if !fs.exists(dir) { fs.mkdir(dir) }
        path := recording_path(cid)
        fs.write_bytes(path, f["body"])
        // Redirect back to ladder
        {"status": 302, "headers": {"Location": "/calls?call_id=" + cid}, "body": ""}
    })

    // ---- alert evaluation partial (HTMX polls this) ----

    app.get("/partials/alerts", fn(req) {
        rt := fetch_realtime(5)
        fired := evaluate_alerts(rt)
        if len(fired) == 0 {
            return web.htmx("")
        }
        mut html := ""
        for a in fired {
            sev := a["severity"] ?? "warning"
            msg := h(a["message"] ?? "")
            bg := if sev == "critical" { "border-[#f87171]/20 bg-[#f87171]/5" } else { "border-[#fbbf24]/20 bg-[#fbbf24]/5" }
            ic := if sev == "critical" { "text-[#f87171]" } else { "text-[#fbbf24]" }
            html = html + "<div class=\"flex items-center gap-2 rounded-lg border " + bg + " px-3 py-2 text-sm\">" +
                "<span class=\"" + ic + "\">&#x26A0;</span>" +
                "<span class=\"" + ic + " font-medium\">" + msg + "</span></div>"
        }
        web.htmx("<div class=\"space-y-2\">" + html + "</div>")
    })

    // ---- alerts config page ----

    app.get("/alerts", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "operator") {
            return web.html(layout("Forbidden", "<p class=\"text-[#71717a]\">Operator role required for alerts.</p>", user))
        }
        config := load_alert_config()
        history := load_alert_history()
        channels := config["channels"] ?? []
        rules := config["rules"] ?? []
        crd := "card"
        inp := "w-full rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 text-sm mono"

        // Channels list
        mut ch_rows := ""
        for ch in channels {
            ct := ch["type"] ?? ""
            label := if ct == "slack" { "Slack: " + h(ch["webhook_url"] ?? "") } else if ct == "webhook" { "Webhook: " + h(ch["url"] ?? "") } else if ct == "email" { "Email: " + h(ch["to"] ?? "") } else { h(ct) }
            ch_rows = ch_rows + "<div class=\"flex items-center justify-between py-2 border-b border-[#1e1e22]/50\">" +
                "<div class=\"flex items-center gap-2\">" +
                "<span class=\"px-1.5 py-0.5 rounded text-[10px] font-semibold uppercase bg-[#27272a] text-[#a1a1aa]\">" + h(ct) + "</span>" +
                "<span class=\"text-sm truncate max-w-[300px]\">" + label + "</span></div>" +
                "<form method=\"post\" action=\"/alerts/channel/delete\" class=\"shrink-0\">" +
                "<input type=\"hidden\" name=\"type\" value=\"" + h(ct) + "\"/>" +
                "<input type=\"hidden\" name=\"url\" value=\"" + h(ch["webhook_url"] ?? ch["url"] ?? ch["to"] ?? "") + "\"/>" +
                "<button class=\"text-[11px] text-[#52525b] hover:text-[#f87171]\">remove</button></form></div>"
        }
        if ch_rows == "" { ch_rows = "<p class=\"text-sm text-[#52525b] py-3\">No channels configured. Alerts will only show in the dashboard.</p>" }

        // Rules list
        mut rule_rows := ""
        for rule in rules {
            rid := rule["id"] ?? 0
            rname := h(rule["name"] ?? "")
            rmetric := h(rule["metric"] ?? "")
            rop := h(rule["op"] ?? ">")
            rthresh := rule["threshold"] ?? 0
            rsev := rule["severity"] ?? "warning"
            renabled := rule["enabled"] ?? false
            sev_cls := if rsev == "critical" { "text-[#f87171]" } else { "text-[#fbbf24]" }
            en_cls := if renabled { "text-[#34d399]" } else { "text-[#52525b]" }
            rule_rows = rule_rows + "<tr>" +
                "<td class=\"py-2 px-4 text-sm font-medium\">" + rname + "</td>" +
                "<td class=\"py-2 px-4 mono text-xs\">" + rmetric + " " + rop + " " + ("" + (rthresh)) + "</td>" +
                "<td class=\"py-2 px-4 text-xs " + sev_cls + "\">" + rsev + "</td>" +
                "<td class=\"py-2 px-4 text-xs " + en_cls + "\">" + (if renabled { "active" } else { "disabled" }) + "</td>" +
                "<td class=\"py-2 px-4 text-xs\">" +
                "<form method=\"post\" action=\"/alerts/rule/delete\" class=\"inline\">" +
                "<input type=\"hidden\" name=\"id\" value=\"" + ("" + (rid)) + "\"/>" +
                "<button class=\"text-[#52525b] hover:text-[#f87171]\">delete</button></form></td></tr>"
        }
        if rule_rows == "" { rule_rows = "<tr><td colspan=\"5\" class=\"py-6 text-center text-[#52525b] text-sm\">No rules configured.</td></tr>" }

        // Recent alert history
        mut hist_rows := ""
        mut hi := len(history) - 1
        mut hcount := 0
        while hi >= 0 && hcount < 20 {
            ha := history[hi]
            hsev := ha["severity"] ?? "warning"
            hmsg := h(ha["message"] ?? "")
            hname := h(ha["rule"] ?? "")
            hcls := if hsev == "critical" { "text-[#f87171]" } else { "text-[#fbbf24]" }
            hist_rows = hist_rows + "<tr>" +
                "<td class=\"py-1.5 px-4 text-xs " + hcls + "\">" + hsev + "</td>" +
                "<td class=\"py-1.5 px-4 text-sm\">" + hname + "</td>" +
                "<td class=\"py-1.5 px-4 text-xs text-[#71717a] truncate max-w-[24rem]\">" + hmsg + "</td></tr>"
            hi = hi - 1
            hcount = hcount + 1
        }
        if hist_rows == "" { hist_rows = "<tr><td colspan=\"3\" class=\"py-6 text-center text-[#52525b] text-sm\">No alerts fired yet.</td></tr>" }

        th := "text-[10px] uppercase tracking-wider text-[#52525b] font-semibold border-b border-[#1e1e22]"

        body := "<h1 class=\"text-2xl font-bold mb-1\">Alerts</h1>" +
            "<p class=\"text-sm text-[#71717a] mb-6\">Configure notification channels and threshold rules. Alerts evaluate every 30 seconds against the 5-minute traffic window.</p>" +
            // Channels
            "<div class=\"grid lg:grid-cols-2 gap-4 mb-6\">" +
            "<div class=\"" + crd + " p-5\">" +
            "<h2 class=\"text-sm font-semibold mb-4\">Notification channels</h2>" +
            ch_rows +
            "<h3 class=\"text-xs font-semibold text-[#71717a] mt-5 mb-3\">Add channel</h3>" +
            "<form method=\"post\" action=\"/alerts/channel\" class=\"space-y-3\">" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase tracking-wider mb-1\">Type</label>" +
            "<select name=\"type\" class=\"" + inp + "\">" +
            "<option value=\"slack\">Slack webhook</option>" +
            "<option value=\"webhook\">Generic webhook (PagerDuty/Teams/Opsgenie)</option>" +
            "<option value=\"email\">Email (SMTP)</option></select></div>" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase tracking-wider mb-1\">Slack webhook URL / Webhook URL / Email address</label>" +
            "<input name=\"url\" required placeholder=\"https://hooks.slack.com/...\" class=\"" + inp + "\"/></div>" +
            "<div class=\"grid grid-cols-2 gap-3\">" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase tracking-wider mb-1\">SMTP host (email only)</label>" +
            "<input name=\"smtp_host\" value=\"localhost\" class=\"" + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase tracking-wider mb-1\">SMTP port</label>" +
            "<input name=\"smtp_port\" value=\"25\" class=\"" + inp + "\"/></div></div>" +
            "<button class=\"rounded-lg px-4 py-2 text-sm bg-[#27272a] text-[#e4e4e7] hover:bg-[#3f3f46]\">Add channel</button></form></div>" +
            // Rules
            "<div class=\"" + crd + " overflow-x-auto\">" +
            "<div class=\"px-5 py-3 border-b border-[#1e1e22] text-sm font-semibold\">Alert rules</div>" +
            "<table class=\"w-full text-left\"><thead><tr class=\"" + th + "\">" +
            "<th class=\"py-2 px-4\">Name</th><th class=\"py-2 px-4\">Condition</th><th class=\"py-2 px-4\">Severity</th><th class=\"py-2 px-4\">Status</th><th class=\"py-2 px-4\"></th></tr></thead>" +
            "<tbody class=\"divide-y divide-[#27272a]/40\">" + rule_rows + "</tbody></table>" +
            "<div class=\"p-4 border-t border-[#1e1e22]\">" +
            "<h3 class=\"text-xs font-semibold text-[#71717a] mb-3\">Add rule</h3>" +
            "<form method=\"post\" action=\"/alerts/rule\" class=\"grid grid-cols-5 gap-2 items-end\">" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase mb-1\">Name</label>" +
            "<input name=\"name\" required placeholder=\"Low ASR\" class=\"" + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase mb-1\">Metric</label>" +
            "<select name=\"metric\" class=\"" + inp + "\">" +
            "<option value=\"asr\">ASR %</option>" +
            "<option value=\"err_rate\">Error rate %</option>" +
            "<option value=\"resp_5xx\">5xx count</option>" +
            "<option value=\"resp_4xx\">4xx count</option>" +
            "<option value=\"err_401\">401 Unauthorized</option>" +
            "<option value=\"err_403\">403 Forbidden</option>" +
            "<option value=\"err_503\">503 Unavailable</option>" +
            "<option value=\"invites\">INVITEs (5m)</option>" +
            "<option value=\"registers\">REGISTERs (5m)</option>" +
            "<option value=\"active_calls\">Active calls</option>" +
            "</select></div>" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase mb-1\">Condition</label>" +
            "<div class=\"flex gap-1\">" +
            "<select name=\"op\" class=\"rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-2 py-2 text-sm mono w-16\">" +
            "<option value=\">\">></option><option value=\"<\"><</option><option value=\">=\">>=</option></select>" +
            "<input name=\"threshold\" type=\"number\" required value=\"10\" class=\"flex-1 rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-2 py-2 text-sm mono\"/></div></div>" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase mb-1\">Severity</label>" +
            "<select name=\"severity\" class=\"" + inp + "\">" +
            "<option value=\"warning\">warning</option><option value=\"critical\">critical</option></select></div>" +
            "<button class=\"rounded-lg px-3 py-2 text-sm bg-[#27272a] text-[#e4e4e7] hover:bg-[#3f3f46]\">Add</button></form></div></div>" +
            "</div>" +
            // History
            "<div class=\"" + crd + " overflow-x-auto mt-6\">" +
            "<div class=\"px-5 py-3 border-b border-[#1e1e22] flex items-center justify-between\">" +
            "<span class=\"text-sm font-semibold\">Recent alerts</span>" +
            "<span class=\"text-[10px] text-[#52525b]\">last 20</span></div>" +
            "<table class=\"w-full text-left\"><thead><tr class=\"" + th + "\">" +
            "<th class=\"py-2 px-4\">Severity</th><th class=\"py-2 px-4\">Rule</th><th class=\"py-2 px-4\">Detail</th></tr></thead>" +
            "<tbody class=\"divide-y divide-[#27272a]/40\">" + hist_rows + "</tbody></table></div>"
        web.html(layout_with_csrf("Alerts", body, user, csrf_token(req, token_secret)))
    })

    // Alert channel CRUD
    app.post("/alerts/channel", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "operator") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        ch_type := web.form_get(req, "type", "webhook")
        url := web.form_get(req, "url", "")
        smtp_host := web.form_get(req, "smtp_host", "localhost")
        smtp_port := web.form_get(req, "smtp_port", "25")
        config := load_alert_config()
        channels := config["channels"] ?? []
        mut new_ch := {}
        if ch_type == "slack" {
            new_ch = {"type": "slack", "webhook_url": url}
        } else if ch_type == "email" {
            new_ch = {"type": "email", "to": url, "from": "zaman@localhost", "smtp_host": smtp_host, "smtp_port": smtp_port}
        } else {
            new_ch = {"type": "webhook", "url": url}
        }
        config["channels"] = list_append(channels, new_ch)
        save_alert_config(config)
        {"status": 302, "headers": {"Location": "/alerts"}, "body": ""}
    })

    app.post("/alerts/channel/delete", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "operator") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        del_type := web.form_get(req, "type", "")
        del_url := web.form_get(req, "url", "")
        config := load_alert_config()
        channels := config["channels"] ?? []
        // Remove matching channel
        mut kept := "["
        mut first := true
        for ch in channels {
            ct := ch["type"] ?? ""
            cu := ch["webhook_url"] ?? ch["url"] ?? ch["to"] ?? ""
            if ct == del_type && cu == del_url { continue }
            if !first { kept = kept + "," }
            kept = kept + json.stringify(ch)
            first = false
        }
        config["channels"] = json.parse(kept + "]").value
        save_alert_config(config)
        {"status": 302, "headers": {"Location": "/alerts"}, "body": ""}
    })

    // Alert rule CRUD
    app.post("/alerts/rule", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "operator") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        config := load_alert_config()
        rules := config["rules"] ?? []
        // Next ID
        mut max_id := 0
        for r in rules {
            rid := r["id"] ?? 0
            if rid > max_id { max_id = rid }
        }
        new_rule := {
            "id": max_id + 1,
            "name": web.form_get(req, "name", ""),
            "metric": web.form_get(req, "metric", "asr"),
            "op": web.form_get(req, "op", ">"),
            "threshold": int.parse(web.form_get(req, "threshold", "10")).unwrap_or(10),
            "severity": web.form_get(req, "severity", "warning"),
            "enabled": true
        }
        config["rules"] = list_append(rules, new_rule)
        save_alert_config(config)
        {"status": 302, "headers": {"Location": "/alerts"}, "body": ""}
    })

    app.post("/alerts/rule/delete", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "operator") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        del_id := int.parse(web.form_get(req, "id", "0")).unwrap_or(0)
        config := load_alert_config()
        config["rules"] = list_remove(config["rules"] ?? [], "id", del_id)
        save_alert_config(config)
        {"status": 302, "headers": {"Location": "/alerts"}, "body": ""}
    })

    // ---- CSV export ----

    app.get("/export/csv", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        cid := req.query_map["call_id"] ?? ""
        agent := req.query_map["agent"] ?? ""
        method := req.query_map["method"] ?? ""
        transport := req.query_map["transport"] ?? ""
        src := req.query_map["src"] ?? ""
        messages := fetch_messages_ex(500, cid, transport, agent, method, src)
        audit(user["username"] ?? "", "export_csv", ("" + (len(messages))) + " messages")
        csv := messages_to_csv(messages)
        {"status": 200, "headers": {"Content-Type": "text/csv", "Content-Disposition": "attachment; filename=\"zaman-export.csv\""}, "body": csv}
    })

    // ---- config backup/restore ----

    app.get("/admin/backup", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "admin") { return web.status(403) }
        audit(user["username"] ?? "", "config_export", "backup")
        cfg := export_config()
        {"status": 200, "headers": {"Content-Type": "application/json", "Content-Disposition": "attachment; filename=\"zaman-config-backup.json\""}, "body": cfg}
    })

    // ---- API tokens management ----

    app.get("/admin/tokens", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "admin") { return web.status(403) }
        tokens := load_api_tokens()
        inp := "w-full rounded-md bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 text-sm"
        lbl := "block text-[10px] text-[#52525b] uppercase tracking-wider mb-1.5"

        new_tok := req.query_map["new_token"] ?? ""
        mut flash := ""
        if new_tok != "" {
            flash = "<div class=\"card border-[#34d399]/20 bg-[#34d399]/5 p-4 mb-5\">" +
                "<div class=\"text-xs text-[#34d399] font-semibold mb-2\">Token created — copy it now, it won't be shown again</div>" +
                "<div class=\"flex gap-2\">" +
                "<code class=\"flex-1 mono text-xs bg-[#0a0a0c] rounded-md p-2.5 break-all select-all border border-[#1e1e22]\">" + h(new_tok) + "</code>" +
                "<button onclick=\"navigator.clipboard.writeText('" + h(new_tok) + "').then(()=>this.textContent='Copied')\" class=\"shrink-0 rounded-md px-3 py-1.5 text-xs bg-[#1e1e22] text-[#a1a1aa] hover:text-[#e4e4e7]\">Copy</button></div></div>"
        }

        // Token list as rows
        mut token_list := ""
        for t in tokens {
            tprefix := h(t["prefix"] ?? "")
            tlabel := h(t["label"] ?? "")
            tuser := h(t["username"] ?? "")
            trole := t["role"] ?? "viewer"
            tcreated := t["created"] ?? 0
            token_list = token_list +
                "<div class=\"flex items-center justify-between py-3 px-4 border-b border-[#1e1e22]/50 last:border-0\">" +
                "<div class=\"flex items-center gap-3\">" +
                "<div class=\"w-8 h-8 rounded-full bg-[#1e1e22] flex items-center justify-center\">" +
                "<svg class=\"w-3.5 h-3.5 text-[#52525b]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z\"/></svg></div>" +
                "<div><div class=\"text-sm font-medium\">" + tlabel + "</div>" +
                "<div class=\"text-[10px] text-[#3f3f46] mono\">" + tprefix + "… · " + tuser + " · " + time_ago(tcreated) + "</div></div>" +
                "<div class=\"ml-3\">" + role_badge(trole) + "</div></div>" +
                "<form method=\"post\" action=\"/admin/tokens/delete\">" +
                "<input type=\"hidden\" name=\"prefix\" value=\"" + tprefix + "\"/>" +
                "<button class=\"text-[11px] text-[#52525b] hover:text-[#f87171]\">revoke</button></form></div>"
        }
        if token_list == "" {
            token_list = "<div class=\"py-8 text-center text-[#3f3f46] text-sm\">No API tokens created yet.</div>"
        }

        // Usage hint
        usage := "<div class=\"card p-4 mb-5\">" +
            "<div class=\"text-xs text-[#52525b] space-y-1\">" +
            "<div>Use tokens as HTTP headers:</div>" +
            "<code class=\"block mono text-[11px] text-[#71717a] bg-[#0a0a0c] rounded-md p-2 mt-1\">curl -H \"Authorization: Bearer &lt;token&gt;\" " + h(core_base()) + "/api/messages</code></div></div>"

        body := "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
            "<h1 class=\"text-xl font-semibold\">API Tokens</h1>" +
            "<span class=\"text-[10px] text-[#3f3f46] mono\">" + ("" + (len(tokens))) + " active</span></div>" +
            flash + usage +
            // Token list
            "<div class=\"card overflow-hidden mb-5\">" + token_list + "</div>" +
            // Create form — single row
            "<div class=\"card p-4\">" +
            "<div class=\"section-title\">Generate token</div>" +
            "<form method=\"post\" action=\"/admin/tokens\" class=\"grid grid-cols-3 gap-3 items-end\">" +
            "<div><label class=\"" + lbl + "\">Label</label>" +
            "<input name=\"label\" required placeholder=\"CI pipeline\" class=\"" + inp + "\"/></div>" +
            "<div><label class=\"" + lbl + "\">Role</label>" +
            "<select name=\"role\" class=\"" + inp + "\">" +
            "<option value=\"viewer\">viewer</option><option value=\"operator\">operator</option><option value=\"admin\">admin</option></select></div>" +
            "<button type=\"submit\" class=\"rounded-md px-4 py-2 text-sm bg-[#a78bfa] text-[#0a0a0c] font-medium hover:bg-[#c4b5fd] transition-colors\">Generate</button>" +
            "</form></div>"
        web.html(layout_with_csrf("API Tokens", body, user, csrf_token(req, token_secret)))
    })

    app.post("/admin/tokens", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "admin") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        label := web.form_get(req, "label", "")
        role := web.form_get(req, "role", "viewer")
        uname := user["username"] ?? "admin"
        token := create_api_token(uname, role, label)
        audit(uname, "api_token_create", "label=" + label + " role=" + role)
        {"status": 302, "headers": {"Location": "/admin/tokens?new_token=" + token}, "body": ""}
    })

    app.post("/admin/tokens/delete", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "admin") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        prefix := web.form_get(req, "prefix", "")
        delete_api_token(prefix)
        audit(user["username"] ?? "", "api_token_revoke", "prefix=" + prefix)
        {"status": 302, "headers": {"Location": "/admin/tokens"}, "body": ""}
    })

    // ---- audit log page ----

    app.get("/admin/audit", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "admin") { return web.status(403) }
        entries := load_audit(100)
        th := "text-[10px] uppercase tracking-wider text-[#52525b] font-semibold"

        // Group by action type for summary
        mut login_ok := 0
        mut login_fail := 0
        mut creates := 0
        mut other := 0
        for e in entries {
            action := e["action"] ?? ""
            if action == "login" { login_ok = login_ok + 1 }
            else if str.contains(action, "fail") { login_fail = login_fail + 1 }
            else if str.contains(action, "create") { creates = creates + 1 }
            else { other = other + 1 }
        }

        summary := "<div class=\"flex items-center gap-6 text-xs mb-5\">" +
            "<span class=\"text-[#34d399] mono\">" + ("" + (login_ok)) + " logins</span>" +
            "<span class=\"text-[#f87171] mono\">" + ("" + (login_fail)) + " failed</span>" +
            "<span class=\"text-[#a78bfa] mono\">" + ("" + (creates)) + " creates</span>" +
            "<span class=\"text-[#52525b] mono\">" + ("" + (other)) + " other</span>" +
            "<span class=\"text-[#3f3f46]\">·</span>" +
            "<span class=\"text-[#3f3f46]\">" + ("" + (len(entries))) + " entries</span></div>"

        mut rows := ""
        for e in entries {
            action := e["action"] ?? ""
            ets := e["ts"] ?? 0
            acls := if str.contains(action, "fail") || str.contains(action, "revoke") || str.contains(action, "delete") { "text-[#f87171]" } else if action == "login" || str.contains(action, "create") { "text-[#34d399]" } else { "text-[#71717a]" }
            rows = rows + "<tr>" +
                "<td class=\"py-2 px-3 text-xs text-[#52525b]\">" + time_ago(ets) + "</td>" +
                "<td class=\"py-2 px-3 text-sm\">" + h(e["user"] ?? "") + "</td>" +
                "<td class=\"py-2 px-3 text-xs " + acls + " font-medium\">" + h(action) + "</td>" +
                "<td class=\"py-2 px-3 text-xs text-[#3f3f46] truncate max-w-[30rem]\">" + h(e["detail"] ?? "") + "</td></tr>"
        }
        if rows == "" { rows = "<tr><td colspan=\"4\" class=\"py-8 text-center text-[#3f3f46] text-sm\">No audit entries yet.</td></tr>" }
        body := "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
            "<h1 class=\"text-xl font-semibold\">Audit Log</h1></div>" +
            summary +
            "<div class=\"card overflow-x-auto\">" +
            "<table class=\"w-full text-left\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\">" +
            "<th class=\"py-2 px-3\">When</th><th class=\"py-2 px-3\">User</th><th class=\"py-2 px-3\">Action</th><th class=\"py-2 px-3\">Detail</th></tr></thead>" +
            "<tbody class=\"divide-y divide-[#1e1e22]/50\">" + rows + "</tbody></table></div>"
        web.html(layout("Audit Log", body, user))
    })

    // ---- SLA report page ----

    app.get("/sla", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        kpi := fetch_kpi()
        targets := load_sla_targets()
        sla_agents := fetch_sla_agents()
        sla_dests := fetch_sla_destinations()
        rt := fetch_realtime(5)
        crd := "card"
        th := "text-[10px] uppercase tracking-wider text-[#52525b] font-semibold"
        inp := "w-full rounded-md bg-[#0a0a0c] border border-[#1e1e22] px-2 py-1.5 text-xs mono text-center"

        // Targets
        asr_t := targets["asr_target"] ?? 45
        asr_w := targets["asr_warning"] ?? 40
        asr_cr := targets["asr_critical"] ?? 35
        ner_t := targets["ner_target"] ?? 98
        err_max := targets["err_rate_max"] ?? 5

        // Overall KPIs
        asr := kpi["asr"] ?? 0
        ner := kpi["ner"] ?? 0
        asr_st := sla_status_for(asr, asr_t, asr_w, asr_cr)
        ner_st := if ner >= ner_t { "pass" } else if ner >= 80 { "warning" } else { "fail" }

        win_asr := rt["asr"] ?? 0
        win_err := rt["err_rate"] ?? 0
        win_asr_st := sla_status_for(win_asr, asr_t, asr_w, asr_cr)
        win_err_st := if win_err <= err_max { "pass" } else if win_err <= 15 { "warning" } else { "fail" }

        // Count violations
        mut agent_violations := 0
        for a in sla_agents {
            a_asr := a["asr"] ?? 0
            if a_asr < asr_cr && (a["invites"] ?? 0) > 0 { agent_violations = agent_violations + 1 }
        }

        // ── Overall status ──
        overall_st := if asr_st == "fail" || win_err_st == "fail" { "fail" } else if asr_st == "warning" || win_err_st == "warning" { "warning" } else { "pass" }
        overall_label := if overall_st == "pass" { "All SLAs met" } else if overall_st == "warning" { "Degraded" } else { "SLA breach" }
        overall_color := sla_color(overall_st)

        hero := "<div class=\"flex items-center gap-4 card p-5 mb-5\">" +
            "<div class=\"w-14 h-14 rounded-full flex items-center justify-center shrink-0\" style=\"background:" + overall_color + "15;border:2px solid " + overall_color + "\">" +
            "<span class=\"text-lg font-black mono\" style=\"color:" + overall_color + "\">" + ("" + (asr)) + "%</span></div>" +
            "<div class=\"flex-1\">" +
            "<div class=\"text-lg font-semibold\" style=\"color:" + overall_color + "\">" + overall_label + "</div>" +
            "<div class=\"text-xs text-[#52525b] mt-0.5\">ASR " + ("" + (asr)) + "% · NER " + ("" + (ner)) + "% · " + ("" + (agent_violations)) + " agent violations · error rate " + ("" + (win_err)) + "%</div></div>" +
            "<div class=\"text-right text-xs text-[#3f3f46]\">targets: ASR &ge;" + ("" + (asr_t)) + "% · NER &ge;" + ("" + (ner_t)) + "% · err &le;" + ("" + (err_max)) + "%</div></div>"

        // ── KPI gauges ──
        gauges := "<div class=\"section\">" +
            "<div class=\"section-title\">Service indicators</div>" +
            "<div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3\">" +
            "<div class=\"card p-4\">" + sla_dot(asr_st) + " <span class=\"text-[10px] text-[#52525b] uppercase ml-1\">ASR (all)</span>" +
            "<div class=\"text-2xl font-bold mono mt-1\" style=\"color:" + sla_color(asr_st) + "\">" + ("" + (asr)) + "%</div></div>" +
            "<div class=\"card p-4\">" + sla_dot(win_asr_st) + " <span class=\"text-[10px] text-[#52525b] uppercase ml-1\">ASR (5m)</span>" +
            "<div class=\"text-2xl font-bold mono mt-1\" style=\"color:" + sla_color(win_asr_st) + "\">" + ("" + (win_asr)) + "%</div></div>" +
            "<div class=\"card p-4\">" + sla_dot(ner_st) + " <span class=\"text-[10px] text-[#52525b] uppercase ml-1\">NER</span>" +
            "<div class=\"text-2xl font-bold mono mt-1\" style=\"color:" + sla_color(ner_st) + "\">" + ("" + (ner)) + "%</div></div>" +
            "<div class=\"card p-4\">" + sla_dot(win_err_st) + " <span class=\"text-[10px] text-[#52525b] uppercase ml-1\">Error rate</span>" +
            "<div class=\"text-2xl font-bold mono mt-1\" style=\"color:" + sla_color(win_err_st) + "\">" + ("" + (win_err)) + "%</div></div>" +
            stat_card("INVITEs", kpi["total_invites"] ?? 0, "answered " + ("" + (kpi["answered"] ?? 0))) +
            stat_card("Reg failures", kpi["reg_fail"] ?? 0, "of " + ("" + (kpi["total_registers"] ?? 0))) +
            "</div></div>"

        // ── Per-agent SLA table ──
        mut agent_rows := ""
        for a in sla_agents {
            aname := h(a["agent"] ?? "")
            ainv := a["invites"] ?? 0
            a_asr := a["asr"] ?? 0
            aerr := a["err_rate"] ?? 0
            atotal := a["total"] ?? 0
            a_st := if ainv == 0 { "pass" } else { sla_status_for(a_asr, asr_t, asr_w, asr_cr) }
            a_err_st := if aerr <= err_max { "pass" } else { "fail" }
            agent_rows = agent_rows + "<tr>" +
                "<td class=\"py-2 px-3\"><div class=\"flex items-center gap-2\">" + sla_dot(a_st) +
                "<span class=\"text-sm\">" + aname + "</span></div></td>" +
                "<td class=\"py-2 px-3 mono text-xs text-right\">" + ("" + (atotal)) + "</td>" +
                "<td class=\"py-2 px-3 mono text-xs text-right\">" + ("" + (ainv)) + "</td>" +
                "<td class=\"py-2 px-3 mono text-xs text-right font-medium\" style=\"color:" + sla_color(a_st) + "\">" + ("" + (a_asr)) + "%</td>" +
                "<td class=\"py-2 px-3 mono text-xs text-right\" style=\"color:" + sla_color(a_err_st) + "\">" + ("" + (aerr)) + "%</td>" +
                "<td class=\"py-2 px-3\"><a class=\"text-[11px] text-[#a78bfa] hover:underline\" href=\"/messages?agent=" + aname + "\">messages</a></td></tr>"
        }
        if agent_rows == "" { agent_rows = "<tr><td colspan=\"6\" class=\"py-6 text-center text-[#3f3f46] text-sm\">No agents</td></tr>" }

        agent_section := "<div class=\"section\">" +
            "<div class=\"section-title\">SLA by agent</div>" +
            "<div class=\"card overflow-x-auto\">" +
            "<table class=\"w-full text-left text-sm\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\">" +
            "<th class=\"py-2 px-3\">Agent</th><th class=\"py-2 px-3 text-right\">Msgs</th><th class=\"py-2 px-3 text-right\">INVITEs</th>" +
            "<th class=\"py-2 px-3 text-right\">ASR</th><th class=\"py-2 px-3 text-right\">Err %</th><th class=\"py-2 px-3\"></th></tr></thead>" +
            "<tbody class=\"divide-y divide-[#1e1e22]/50\">" + agent_rows + "</tbody></table></div></div>"

        // ── Per-destination SLA table ──
        mut dest_rows := ""
        for d in sla_dests {
            dname := h(d["dst"] ?? "")
            dinv := d["invites"] ?? 0
            d_asr := d["asr"] ?? 0
            derr := d["err_rate"] ?? 0
            dtotal := d["total"] ?? 0
            d_st := if dinv == 0 { "pass" } else { sla_status_for(d_asr, asr_t, asr_w, asr_cr) }
            dest_rows = dest_rows + "<tr>" +
                "<td class=\"py-2 px-3\"><div class=\"flex items-center gap-2\">" + sla_dot(d_st) +
                "<span class=\"mono text-xs\">" + dname + "</span></div></td>" +
                "<td class=\"py-2 px-3 mono text-xs text-right\">" + ("" + (dtotal)) + "</td>" +
                "<td class=\"py-2 px-3 mono text-xs text-right\">" + ("" + (dinv)) + "</td>" +
                "<td class=\"py-2 px-3 mono text-xs text-right font-medium\" style=\"color:" + sla_color(d_st) + "\">" + ("" + (d_asr)) + "%</td>" +
                "<td class=\"py-2 px-3 mono text-xs text-right\">" + ("" + (derr)) + "%</td>" +
                "<td class=\"py-2 px-3\"><a class=\"text-[11px] text-[#a78bfa] hover:underline\" href=\"/messages?src=" + dname + "\">messages</a></td></tr>"
        }
        if dest_rows == "" { dest_rows = "<tr><td colspan=\"6\" class=\"py-6 text-center text-[#3f3f46] text-sm\">No destinations</td></tr>" }

        dest_section := "<div class=\"section\">" +
            "<div class=\"section-title\">SLA by destination</div>" +
            "<div class=\"card overflow-x-auto\">" +
            "<table class=\"w-full text-left text-sm\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\">" +
            "<th class=\"py-2 px-3\">Destination</th><th class=\"py-2 px-3 text-right\">Msgs</th><th class=\"py-2 px-3 text-right\">INVITEs</th>" +
            "<th class=\"py-2 px-3 text-right\">ASR</th><th class=\"py-2 px-3 text-right\">Err %</th><th class=\"py-2 px-3\"></th></tr></thead>" +
            "<tbody class=\"divide-y divide-[#1e1e22]/50\">" + dest_rows + "</tbody></table></div></div>"

        // ── Configurable targets ──
        targets_form := "<div class=\"section\">" +
            "<div class=\"section-title\">SLA targets</div>" +
            "<form method=\"post\" action=\"/sla/targets\" class=\"card p-4\">" +
            "<div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 mb-3\">" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase mb-1\">ASR target %</label>" +
            "<input name=\"asr_target\" type=\"number\" value=\"" + ("" + (asr_t)) + "\" class=\"" + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase mb-1\">ASR warning %</label>" +
            "<input name=\"asr_warning\" type=\"number\" value=\"" + ("" + (asr_w)) + "\" class=\"" + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase mb-1\">ASR critical %</label>" +
            "<input name=\"asr_critical\" type=\"number\" value=\"" + ("" + (asr_cr)) + "\" class=\"" + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase mb-1\">NER target %</label>" +
            "<input name=\"ner_target\" type=\"number\" value=\"" + ("" + (ner_t)) + "\" class=\"" + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase mb-1\">Max error rate %</label>" +
            "<input name=\"err_rate_max\" type=\"number\" value=\"" + ("" + (err_max)) + "\" class=\"" + inp + "\"/></div>" +
            "</div>" +
            "<button type=\"submit\" class=\"rounded-md px-3 py-1.5 text-xs bg-[#1e1e22] text-[#a1a1aa] hover:text-[#e4e4e7] transition-colors\">Save targets</button></form></div>"

        body := "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
            "<h1 class=\"text-xl font-semibold\">SLA</h1></div>" +
            hero + gauges + agent_section + dest_section + targets_form
        web.html(layout("SLA", body, user))
    })

    // SLA targets save
    app.post("/sla/targets", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "operator") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        targets := {
            "asr_target": int.parse(web.form_get(req, "asr_target", "45")).unwrap_or(45),
            "asr_warning": int.parse(web.form_get(req, "asr_warning", "40")).unwrap_or(40),
            "asr_critical": int.parse(web.form_get(req, "asr_critical", "35")).unwrap_or(35),
            "ner_target": int.parse(web.form_get(req, "ner_target", "98")).unwrap_or(98),
            "err_rate_max": int.parse(web.form_get(req, "err_rate_max", "5")).unwrap_or(5)
        }
        save_sla_targets(targets)
        audit(user["username"] ?? "", "sla_targets", "updated")
        {"status": 302, "headers": {"Location": "/sla"}, "body": ""}
    })

    // ---- admin routes ----

    app.get("/admin/users", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "admin") {
            return web.html(layout("Forbidden", "<h1 class=\"text-xl font-bold\">Forbidden</h1><p class=\"text-[#a1a1aa] mt-2\">Admin role required.</p>", user))
        }
        web.html(layout_with_csrf("Users", admin_users_page(user, ""), user, csrf_token(req, token_secret)))
    })

    app.post("/admin/users", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "admin") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        username := web.form_get(req, "username", "")
        password := web.form_get(req, "password", "")
        role := web.form_get(req, "role", "viewer")
        err := create_user(username, password, role)
        if err != "" {
            return web.html(layout_with_csrf("Users", admin_users_page(user, "Error: " + err), user, csrf_token(req, token_secret)))
        }
        web.html(layout_with_csrf("Users", admin_users_page(user, "User " + username + " created."), user, csrf_token(req, token_secret)))
    })

    app.post("/admin/users/password", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "admin") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        uid := web.form_get(req, "user_id", "")
        pw := web.form_get(req, "new_password", "")
        uid_int := int.parse(uid).unwrap_or(0)
        if uid_int <= 0 {
            return web.html(layout_with_csrf("Users", admin_users_page(user, "Error: invalid user ID"), user, csrf_token(req, token_secret)))
        }
        err := change_password(uid_int, pw)
        if err != "" {
            return web.html(layout_with_csrf("Users", admin_users_page(user, "Error: " + err), user, csrf_token(req, token_secret)))
        }
        web.html(layout_with_csrf("Users", admin_users_page(user, "Password updated for user #" + uid + "."), user, csrf_token(req, token_secret)))
    })

    app.post("/admin/users/:id/delete", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "admin") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        id := int.parse(req.params["id"]).unwrap_or(0)
        if id == (user["id"] ?? -1) {
            return web.html(layout_with_csrf("Users", admin_users_page(user, "Error: cannot delete yourself"), user, csrf_token(req, token_secret)))
        }
        if id > 0 { delete_user_by_id(id) }
        web.html(layout_with_csrf("Users", admin_users_page(user, "User deleted."), user, csrf_token(req, token_secret)))
    })

    say("zaman-web → http://127.0.0.1:3000  (core " + core_base() + ", auth " + (if auth_enabled() { "on" } else { "off (ZAMAN_AUTH=0)" }) + ")")
    app.listen(":3000")
}
