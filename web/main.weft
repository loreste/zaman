fn time_ago(unix_ts) {
    if unix_ts == 0 { return "never" }
    diff := time.unix() - unix_ts
    if diff < 0 { return "just now" }
    if diff < 60 { return ("" + (diff)) + "s ago" }
    if diff < 3600 { return ("" + (diff / 60)) + "m ago" }
    if diff < 86400 { return ("" + (diff / 3600)) + "h ago" }
    ("" + (diff / 86400)) + "d ago"
}

fn n(m, key) {
    v := m[key]
    if v == null { 0 } else { v }
}

fn build_traffic_charts(minutes) {
    cps := fetch_cps(minutes)
    rt := fetch_realtime(minutes)
    crd := "card"

    // Build line chart data from CPS buckets
    mut line_data := {}
    mut area_data := {}
    for bucket in cps {
        ts := bucket["ts"] ?? 0
        total := bucket["total"] ?? 0
        invites := bucket["invites"] ?? 0
        // Label as relative minutes ago
        mins_ago := (time.unix() * 1000 - ts) / 60000
        label := if mins_ago <= 1 { "now" } else { ("" + (mins_ago)) + "m" }
        line_data[label] = total
        area_data[label] = invites
    }

    mut line_html := "<div class=\"text-sm text-[#52525b] py-8 text-center\">No traffic in this window.</div>"
    mut area_html := ""
    if len(line_data) > 0 {
        line_chart := viz.line(line_data, {"title": "Messages / minute", "width": 700, "height": 200, "colors": ["#a78bfa"]})
        line_html = line_chart.html
        if len(area_data) > 0 {
            area_chart := viz.area(area_data, {"title": "INVITEs / minute", "width": 700, "height": 160, "colors": ["#34d399"]})
            area_html = "<div class=\"mt-4\">" + area_chart.html + "</div>"
        }
    }

    // Response breakdown for this window
    r2xx := rt["resp_2xx"] ?? 0
    r4xx := rt["resp_4xx"] ?? 0
    r5xx := rt["resp_5xx"] ?? 0
    total_resp := r2xx + r4xx + r5xx
    mut resp_pie_html := ""
    if total_resp > 0 {
        resp_pie := viz.pie({"2xx": r2xx, "4xx": r4xx, "5xx": r5xx}, {"title": "Responses", "width": 280, "height": 200, "colors": ["#34d399", "#fb923c", "#f87171"]})
        resp_pie_html = resp_pie.html
    }

    // Method mix for this window
    inv := rt["invites"] ?? 0
    bye := rt["byes"] ?? 0
    reg := rt["registers"] ?? 0
    opts := rt["options"] ?? 0
    mut method_bar_html := ""
    if inv + bye + reg + opts > 0 {
        method_bar := viz.bar({"INVITE": inv, "BYE": bye, "REGISTER": reg, "OPTIONS": opts}, {"title": "Methods", "width": 280, "height": 200, "colors": ["#a78bfa", "#f87171", "#f472b6", "#34d399"]})
        method_bar_html = method_bar.html
    }

    // Summary stats
    summary := "<div class=\"grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4\">" +
        "<div class=\"text-center\"><div class=\"text-2xl font-bold mono\">" + ("" + (rt["total"] ?? 0)) + "</div><div class=\"text-[10px] text-[#52525b] uppercase\">messages</div></div>" +
        "<div class=\"text-center\"><div class=\"text-2xl font-bold mono\" style=\"color:" + (if (rt["asr"] ?? 0) >= 70 { "#34d399" } else if (rt["asr"] ?? 0) >= 40 { "#fbbf24" } else { "#f87171" }) + "\">" + ("" + (rt["asr"] ?? 0)) + "%</div><div class=\"text-[10px] text-[#52525b] uppercase\">ASR</div></div>" +
        "<div class=\"text-center\"><div class=\"text-2xl font-bold mono\">" + ("" + (rt["active_calls"] ?? 0)) + "</div><div class=\"text-[10px] text-[#52525b] uppercase\">active calls</div></div>" +
        "<div class=\"text-center\"><div class=\"text-2xl font-bold mono\">" + ("" + (rt["agents_active"] ?? 0)) + "</div><div class=\"text-[10px] text-[#52525b] uppercase\">nodes</div></div>" +
        "</div>"

    summary +
    "<div class=\"grid lg:grid-cols-[1fr_300px] gap-4\">" +
    "<div class=\"" + crd + " p-5 overflow-x-auto\">" + line_html + area_html + "</div>" +
    "<div class=\"space-y-4\">" +
    (if resp_pie_html != "" { "<div class=\"" + crd + " p-4 overflow-x-auto\">" + resp_pie_html + "</div>" } else { "" }) +
    (if method_bar_html != "" { "<div class=\"" + crd + " p-4 overflow-x-auto\">" + method_bar_html + "</div>" } else { "" }) +
    "</div></div>"
}

fn overview_body(user) {
    m := fetch_metrics()
    rt := fetch_realtime(5)
    nodes := fetch_nodes()
    anomalies := fetch_anomalies()
    items := fetch_messages(8, "")
    up_s := n(m, "uptime_ms") / 1000

    // ── Alerts (only if problems) ──
    mut alerts := ""
    if len(anomalies) > 0 {
        mut aitems := ""
        for a in anomalies {
            sev := a["severity"] ?? "warning"
            cls := if sev == "critical" { "border-[#f87171]/20 bg-[#f87171]/5 text-[#f87171]" } else { "border-[#fbbf24]/20 bg-[#fbbf24]/5 text-[#fbbf24]" }
            aitems = aitems + "<div class=\"flex items-center gap-2 rounded-lg border " + cls + " px-3 py-2 text-xs\">" +
                "<span>&#x26A0;</span> " + h(a["message"] ?? "") + "</div>"
        }
        alerts = "<div class=\"space-y-1.5 mb-5\" id=\"alert-bar\" hx-get=\"/partials/alerts\" hx-trigger=\"every 30s\" hx-swap=\"innerHTML\">" + aitems + "</div>"
    } else {
        alerts = "<div id=\"alert-bar\" hx-get=\"/partials/alerts\" hx-trigger=\"every 30s\" hx-swap=\"innerHTML\"></div>"
    }

    // ── Hero KPIs: 4 metrics that matter at a glance ──
    win_asr := rt["asr"] ?? 0
    err_rate := rt["err_rate"] ?? 0
    active := rt["active_calls"] ?? 0
    asr_c := if win_asr >= 70 { "#34d399" } else if win_asr >= 40 { "#fbbf24" } else { "#f87171" }
    err_c := if err_rate <= 5 { "#34d399" } else if err_rate <= 15 { "#fbbf24" } else { "#f87171" }
    total_5m := rt["total"] ?? 0

    hero := "<div class=\"grid grid-cols-4 gap-3 mb-5\">" +
        "<div class=\"card p-4\"><div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold\">Active calls</div>" +
        "<div class=\"text-3xl font-bold mono mt-1 text-[#a78bfa]\">" + ("" + (active)) + "</div></div>" +
        "<div class=\"card p-4\"><div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold\">ASR</div>" +
        "<div class=\"text-3xl font-bold mono mt-1\" style=\"color:" + asr_c + "\">" + ("" + (win_asr)) + "<span class=\"text-lg\">%</span></div></div>" +
        "<div class=\"card p-4\"><div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold\">Errors</div>" +
        "<div class=\"text-3xl font-bold mono mt-1\" style=\"color:" + err_c + "\">" + ("" + (err_rate)) + "<span class=\"text-lg\">%</span></div></div>" +
        "<div class=\"card p-4\"><div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold\">Messages (5m)</div>" +
        "<div class=\"text-3xl font-bold mono mt-1\">" + ("" + (total_5m)) + "</div></div>" +
        "</div>"

    // ── Node status: compact summary bar, not a grid ──
    mut green := 0
    mut yellow := 0
    mut red := 0
    for nd in nodes {
        st := nd["status"] ?? "red"
        if st == "green" { green = green + 1 }
        else if st == "yellow" { yellow = yellow + 1 }
        else { red = red + 1 }
    }
    node_bar := "<div class=\"flex items-center justify-between card px-4 py-2.5 mb-5\">" +
        "<div class=\"flex items-center gap-4 text-xs\">" +
        "<span class=\"flex items-center gap-1.5\"><span class=\"w-2 h-2 rounded-full bg-[#34d399]\"></span><span class=\"mono\">" + ("" + (green)) + "</span> healthy</span>" +
        (if yellow > 0 { "<span class=\"flex items-center gap-1.5\"><span class=\"w-2 h-2 rounded-full bg-[#fbbf24]\"></span><span class=\"mono\">" + ("" + (yellow)) + "</span> degraded</span>" } else { "" }) +
        (if red > 0 { "<span class=\"flex items-center gap-1.5\"><span class=\"w-2 h-2 rounded-full bg-[#f87171]\"></span><span class=\"mono\">" + ("" + (red)) + "</span> offline</span>" } else { "" }) +
        "<span class=\"text-[#3f3f46]\">·</span>" +
        "<span class=\"text-[#52525b]\">" + ("" + (len(nodes))) + " nodes</span></div>" +
        "<a href=\"/noc\" class=\"text-[11px] text-[#a78bfa] hover:underline\" hx-boost=\"true\">View all →</a></div>"

    // ── Traffic charts ──
    btn := "rounded-md px-2.5 py-1 text-[11px] transition-colors cursor-pointer"
    btn_on := btn + " bg-[#1e1e22] text-[#e4e4e7]"
    btn_off := btn + " text-[#52525b] hover:text-[#a1a1aa]"
    traffic := "<div class=\"section\">" +
        "<div class=\"flex items-center justify-between mb-3\">" +
        "<div class=\"section-title mb-0\">Traffic</div>" +
        "<div class=\"flex items-center gap-0.5 rounded-md border border-[#1e1e22] p-0.5\">" +
        "<button class=\"" + btn_on + "\" hx-get=\"/partials/charts?window=5\" hx-target=\"#traffic-charts\" hx-swap=\"innerHTML\">5m</button>" +
        "<button class=\"" + btn_off + "\" hx-get=\"/partials/charts?window=15\" hx-target=\"#traffic-charts\" hx-swap=\"innerHTML\">15m</button>" +
        "<button class=\"" + btn_off + "\" hx-get=\"/partials/charts?window=60\" hx-target=\"#traffic-charts\" hx-swap=\"innerHTML\">1h</button>" +
        "<button class=\"" + btn_off + "\" hx-get=\"/partials/charts?window=360\" hx-target=\"#traffic-charts\" hx-swap=\"innerHTML\">6h</button>" +
        "<button class=\"" + btn_off + "\" hx-get=\"/partials/charts?window=1440\" hx-target=\"#traffic-charts\" hx-swap=\"innerHTML\">24h</button>" +
        "</div></div>" +
        "<div id=\"traffic-charts\" hx-get=\"/partials/charts?window=5\" hx-trigger=\"every 15s\" hx-swap=\"innerHTML\">" +
        build_traffic_charts(5) + "</div></div>"

    // ── Live feed (compact) ──
    live := "<div class=\"section\">" +
        "<div class=\"flex items-center justify-between mb-3\">" +
        "<div class=\"section-title mb-0\">Live feed</div>" +
        "<span class=\"flex items-center gap-1.5 text-[10px] text-[#34d399]\"><span class=\"w-1.5 h-1.5 rounded-full bg-[#34d399] animate-pulse\"></span>live</span></div>" +
        "<div id=\"live-msgs\" hx-get=\"/partials/messages?limit=8\" hx-trigger=\"every 3s\" hx-swap=\"innerHTML\">" +
        messages_table(items) + "</div></div>"

    // ── Assemble ──
    "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
    "<h1 class=\"text-xl font-semibold\">Overview</h1>" +
    "<div class=\"text-[10px] text-[#3f3f46] mono\">uptime " + ("" + (up_s)) + "s</div></div>" +
    alerts + hero + node_bar + traffic + live
}

// Collect unique endpoints from messages, return as JSON-encoded list string
fn ladder_endpoints(items) {
    // Gather unique src/dst, preserve order of first appearance
    mut seen := ""
    mut out := "["
    mut first := true
    for m in items {
        src := m["src"] ?? ""
        dst := m["dst"] ?? ""
        if src != "" && !str.contains(seen, "|" + src + "|") {
            seen = seen + "|" + src + "|"
            if !first { out = out + "," }
            out = out + "\"" + src + "\""
            first = false
        }
        if dst != "" && !str.contains(seen, "|" + dst + "|") {
            seen = seen + "|" + dst + "|"
            if !first { out = out + "," }
            out = out + "\"" + dst + "\""
            first = false
        }
    }
    r := json.parse(out + "]")
    if r.ok { r.value } else { [] }
}

fn endpoint_index(endpoints, addr) {
    mut i := 0
    while i < len(endpoints) {
        if endpoints[i] == addr { return i }
        i = i + 1
    }
    0
}

fn ladder_html(call_id) {
    items := fetch_messages(200, call_id)
    // Reverse to chronological
    mut ordered := []
    mut i := len(items) - 1
    while i >= 0 {
        ordered = list_append(ordered, items[i])
        i = i - 1
    }
    if len(ordered) == 0 {
        return "<div class=\"card p-6\">" +
            "<p class=\"text-sm text-[#71717a]\">No messages for this Call-ID.</p></div>"
    }

    endpoints := ladder_endpoints(ordered)
    ncols := len(endpoints)
    if ncols == 0 { return "<p class=\"text-sm text-[#71717a]\">No endpoints found.</p>" }

    // Column width as percentage
    col_pct := if ncols > 0 { 100 / ncols } else { 50 }

    // Header: endpoint columns
    mut hdr := "<div class=\"flex border-b border-[#1e1e22] pb-3 mb-2\">"
    mut ci := 0
    while ci < ncols {
        ep := endpoints[ci]
        // Shorten display: just host or last segment
        hdr = hdr + "<div class=\"flex-1 text-center\">" +
            "<div class=\"inline-block rounded-lg bg-[#27272a] px-3 py-1.5 text-[11px] mono text-[#e4e4e7] font-medium\">" + h(ep) + "</div>" +
            "</div>"
        ci = ci + 1
    }
    hdr = hdr + "</div>"

    // Rows: one per message
    mut rows := ""
    for m in ordered {
        id := m["id"] ?? 0
        src := m["src"] ?? ""
        dst := m["dst"] ?? ""
        kind := m["kind"] ?? ""
        method := m["method"] ?? ""
        status := m["status"] ?? 0
        cseq := m["cseq"] ?? ""
        transport := m["transport"] ?? ""

        src_i := endpoint_index(endpoints, src)
        // If dst empty (native SIP capture), point to self
        dst_i := if dst != "" { endpoint_index(endpoints, dst) } else { src_i }

        left_i := if src_i < dst_i { src_i } else { dst_i }
        right_i := if src_i < dst_i { dst_i } else { src_i }
        going_right := src_i <= dst_i

        // Arrow label
        mut label := method
        if kind == "response" {
            label = ("" + (status)) + " " + method
        }

        // Arrow color
        mut arrow_cls := "border-[#a78bfa] text-[#a78bfa]"
        if kind == "response" {
            st := int.parse(status).unwrap_or(0)
            if st >= 200 && st < 300 {
                arrow_cls = "border-[#34d399] text-[#34d399]"
            } else if st >= 400 {
                arrow_cls = "border-[#f87171] text-[#f87171]"
            } else {
                arrow_cls = "border-[#fbbf24] text-[#fbbf24]"
            }
        } else if method == "INVITE" {
            arrow_cls = "border-[#c084fc] text-[#c084fc]"
        } else if method == "BYE" || method == "CANCEL" {
            arrow_cls = "border-[#f87171] text-[#f87171]"
        } else if method == "ACK" {
            arrow_cls = "border-[#71717a] text-[#71717a]"
        }

        // Build the row using CSS grid
        // Each column gets a cell; the arrow spans from left_i to right_i
        mut cells := ""
        mut c := 0
        while c < ncols {
            if c == left_i && left_i == right_i {
                // Self-arrow (src == dst or no dst)
                cells = cells + "<div class=\"flex items-center justify-center\">" +
                    "<div class=\"text-[11px] mono font-medium " + arrow_cls + " px-2 py-0.5 rounded border border-current/30 bg-current/5\">" + h(label) + "</div></div>"
            } else if c == left_i {
                // Start of arrow span
                span := right_i - left_i + 1
                if going_right {
                    cells = cells + "<div class=\"flex items-center col-span-" + ("" + (span)) + "\">" +
                        "<div class=\"w-2 h-2 rounded-full bg-current " + arrow_cls + " shrink-0\"></div>" +
                        "<div class=\"flex-1 border-t-2 border-dashed " + arrow_cls + " relative\">" +
                        "<span class=\"absolute -top-5 left-1/2 -translate-x-1/2 text-[11px] mono font-medium " + arrow_cls + " whitespace-nowrap\">" + h(label) + "</span></div>" +
                        "<div class=\"" + arrow_cls + " shrink-0\" style=\"width:0;height:0;border-top:5px solid transparent;border-bottom:5px solid transparent;border-left:8px solid currentColor\"></div></div>"
                } else {
                    cells = cells + "<div class=\"flex items-center col-span-" + ("" + (span)) + "\">" +
                        "<div class=\"" + arrow_cls + " shrink-0\" style=\"width:0;height:0;border-top:5px solid transparent;border-bottom:5px solid transparent;border-right:8px solid currentColor\"></div>" +
                        "<div class=\"flex-1 border-t-2 border-dashed " + arrow_cls + " relative\">" +
                        "<span class=\"absolute -top-5 left-1/2 -translate-x-1/2 text-[11px] mono font-medium " + arrow_cls + " whitespace-nowrap\">" + h(label) + "</span></div>" +
                        "<div class=\"w-2 h-2 rounded-full bg-current " + arrow_cls + " shrink-0\"></div></div>"
                }
                c = right_i // skip spanned columns
            } else {
                cells = cells + "<div></div>"
            }
            c = c + 1
        }

        // Vertical lifeline guides
        mut guides := ""
        mut g := 0
        while g < ncols {
            pct := if ncols > 1 { (g * 100) / (ncols - 1) } else { 50 }
            guides = guides + "<div class=\"absolute top-0 bottom-0 border-l border-[#1e1e22]\" style=\"left:" + ("" + (((g * 2 + 1) * 50) / ncols)) + "%\"></div>"
            g = g + 1
        }

        rows = rows + "<a href=\"/messages/" + ("" + (id)) + "\" class=\"block group relative hover:bg-[#27272a]/30 rounded-lg transition-colors\" hx-boost=\"true\">" +
            guides +
            "<div class=\"relative grid gap-0 py-4 px-1\" style=\"grid-template-columns:repeat(" + ("" + (ncols)) + ",1fr)\">" + cells + "</div>" +
            "<div class=\"text-[10px] text-[#52525b] group-hover:text-[#71717a] px-3 pb-1 mono flex gap-3\">" +
            "<span>#" + ("" + (id)) + "</span>" +
            "<span>" + h(cseq) + "</span>" +
            "<span>" + h(transport) + "</span>" +
            "</div></a>"
    }

    // Related calls (B2BUA correlation)
    related := fetch_related(call_id)
    mut related_html := ""
    if len(related) > 0 {
        mut rlinks := ""
        for rel in related {
            rcid := h(rel["call_id"] ?? "")
            rmsgs := rel["messages"] ?? 0
            reason := rel["reason"] ?? ""
            reason_label := if reason == "hep_correlation" { "HEP correlation" } else { "From/To match" }
            rlinks = rlinks + "<a href=\"/calls?call_id=" + rcid + "\" class=\"flex items-center justify-between rounded-lg px-3 py-2 text-xs hover:bg-[#27272a]/50 transition-colors\" hx-boost=\"true\">" +
                "<span class=\"mono truncate max-w-[20rem]\">" + rcid + "</span>" +
                "<span class=\"text-[10px] text-[#52525b] shrink-0 ml-2\">" + reason_label + " · " + ("" + (rmsgs)) + " msgs</span></a>"
        }
        related_html = "<div class=\"card mt-4 overflow-hidden\">" +
            "<div class=\"px-5 py-3 border-b border-[#1e1e22] flex items-center gap-2\">" +
            "<svg class=\"w-4 h-4 text-[#a78bfa]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1\"/></svg>" +
            "<span class=\"text-sm font-semibold\">Related calls (B2BUA)</span>" +
            "<span class=\"text-[10px] text-[#52525b]\">" + ("" + (len(related))) + " legs</span></div>" +
            "<div class=\"p-2\">" + rlinks + "</div></div>"
    }

    // QoS panel — show RTCP data if any exists for this call
    rtcp_messages := fetch_messages_ex(50, call_id, "", "", "", "")
    mut qos_html := ""
    mut has_rtcp := false
    for rm in rtcp_messages {
        if (rm["proto"] ?? "") == "rtcp" { has_rtcp = true }
    }
    if has_rtcp {
        qos_html = "<div class=\"card p-5 mt-4\">" +
            "<div class=\"flex items-center gap-2 mb-3\">" +
            "<svg class=\"w-4 h-4 text-[#34d399]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z\"/></svg>" +
            "<span class=\"text-sm font-semibold\">QoS / RTCP</span></div>" +
            "<p class=\"text-xs text-[#71717a]\">RTCP data captured for this call. Raw RTCP payloads are available in the message detail view.</p></div>"
    }

    // Recording player + upload
    player := recording_player(call_id)
    upload := recording_upload_form(call_id)

    // Assemble
    "<div class=\"card overflow-hidden\">" +
    "<div class=\"p-5 border-b border-[#1e1e22]\">" +
    "<div class=\"flex items-start justify-between gap-4\">" +
    "<div><div class=\"text-[11px] text-[#71717a] uppercase tracking-wider font-medium mb-1\">Call-ID</div>" +
    "<div class=\"mono text-sm break-all text-[#e4e4e7]\">" + h(call_id) + "</div>" +
    "<div class=\"text-[11px] text-[#52525b] mt-1\">" + ("" + (len(ordered))) + " messages · " + ("" + (ncols)) + " endpoints</div></div>" +
    "<div class=\"flex gap-2 shrink-0\">" +
    "<a href=\"/pcap?call_id=" + h(call_id) + "\" class=\"rounded-lg px-3 py-1.5 text-[11px] border border-[#1e1e22] bg-[#131316] text-[#a1a1aa] hover:text-[#e4e4e7] transition-colors\" title=\"Download as Wireshark PCAP\">" +
    "<svg class=\"w-3.5 h-3.5 inline mr-1\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\"/></svg>PCAP</a>" +
    "<button onclick=\"navigator.clipboard.writeText(window.location.href).then(()=>this.textContent='Copied!')\" class=\"rounded-lg px-3 py-1.5 text-[11px] border border-[#1e1e22] bg-[#131316] text-[#a1a1aa] hover:text-[#e4e4e7] transition-colors\">Copy URL</button>" +
    "<form hx-post=\"/share/create\" hx-target=\"#share-result\" hx-swap=\"innerHTML\" class=\"inline\"><input type=\"hidden\" name=\"call_id\" value=\"" + h(call_id) + "\"/>" +
    "<button type=\"submit\" class=\"rounded-lg px-3 py-1.5 text-[11px] border border-[#1e1e22] bg-[#131316] text-[#a1a1aa] hover:text-[#e4e4e7] transition-colors\">Public link</button></form>" +
    "</div></div><div id=\"share-result\"></div></div>" +
    "<div class=\"p-5\">" + hdr +
    "<div class=\"divide-y divide-[#27272a]/50\">" + rows + "</div>" +
    "</div></div>" +
    related_html + qos_html + player + upload
}

// ---- recordings ----

fn recordings_dir() {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    dir + "/recordings"
}

fn sanitize_cid(cid) {
    // Replace dangerous path chars
    mut s := str.replace(cid, "/", "_")
    s = str.replace(s, "\\", "_")
    s = str.replace(s, "..", "_")
    s = str.replace(s, "\x00", "")
    s
}

fn recording_path(call_id) {
    recordings_dir() + "/" + sanitize_cid(call_id) + ".wav"
}

fn has_recording(call_id) {
    fs.exists(recording_path(call_id))
}

fn recording_player(call_id) {
    if !has_recording(call_id) { return "" }
    "<div class=\"card p-5 mt-4\">" +
    "<div class=\"flex items-center gap-3 mb-3\">" +
    "<svg class=\"w-5 h-5 text-[#34d399]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z\"/></svg>" +
    "<span class=\"text-sm font-medium\">Call recording</span></div>" +
    "<audio controls preload=\"metadata\" class=\"w-full rounded-lg\" style=\"height:40px\">" +
    "<source src=\"/recordings/" + h(sanitize_cid(call_id)) + "\" type=\"audio/wav\"/>" +
    "Your browser does not support audio playback.</audio></div>"
}

fn recording_upload_form(call_id) {
    "<div class=\"rounded-2xl border border-dashed border-[#3f3f46] bg-[#131316] p-5 mt-4\">" +
    "<form method=\"post\" action=\"/recordings/upload\" enctype=\"multipart/form-data\" class=\"flex flex-wrap items-end gap-3\">" +
    "<input type=\"hidden\" name=\"call_id\" value=\"" + h(call_id) + "\"/>" +
    "<div class=\"flex-1 min-w-[200px]\">" +
    "<label class=\"block text-[11px] text-[#71717a] uppercase tracking-wider font-medium mb-2\">Upload recording</label>" +
    "<input type=\"file\" name=\"file\" accept=\"audio/*,.wav,.mp3,.ogg\" required " +
    "class=\"w-full text-sm text-[#a1a1aa] file:mr-3 file:rounded-lg file:border-0 file:bg-[#27272a] file:px-3 file:py-1.5 file:text-sm file:text-[#e4e4e7] file:cursor-pointer hover:file:bg-[#3f3f46]\"/></div>" +
    "<button type=\"submit\" class=\"rounded-lg px-4 py-2 text-sm bg-[#27272a] text-[#e4e4e7] hover:bg-[#3f3f46] transition-colors\">Upload</button>" +
    "</form></div>"
}

// ---- PCAP generation (pure Weft, no Python) ----

fn pack_le32(v) { binstruct.pack("<I", v).value }
fn pack_le16(v) { binstruct.pack("<H", v).value }
fn pack_be16(v) { binstruct.pack(">H", v).value }
fn pack_be32(v) { binstruct.pack(">I", v).value }
fn pack_u8(v) { binstruct.pack("B", v).value }

fn ip_to_bytes(ip_str) {
    parts := str.split(ip_str, ".")
    if len(parts) != 4 { return pack_u8(0) + pack_u8(0) + pack_u8(0) + pack_u8(0) }
    pack_u8(int.parse(parts[0]).unwrap_or(0)) +
    pack_u8(int.parse(parts[1]).unwrap_or(0)) +
    pack_u8(int.parse(parts[2]).unwrap_or(0)) +
    pack_u8(int.parse(parts[3]).unwrap_or(0))
}

fn parse_endpoint(s) {
    if s == null || s == "" { return {"ip": "0.0.0.0", "port": 5060} }
    // Handle [ipv6]:port
    parts := str.split(s, ":")
    if len(parts) >= 2 {
        port := int.parse(parts[len(parts) - 1]).unwrap_or(5060)
        mut ip := parts[0]
        // Rejoin if more than 2 parts (but skip last which is port)
        if len(parts) > 2 {
            ip = str.slice(s, 0, len(s) - len(parts[len(parts) - 1]) - 1)
        }
        return {"ip": ip, "port": port}
    }
    {"ip": s, "port": 5060}
}

fn build_pcap(messages) {
    // PCAP global header: magic, v2.4, snaplen=65535, LINKTYPE_RAW(101)
    mut pcap := pack_le32(0xa1b2c3d4) + pack_le16(2) + pack_le16(4) +
                pack_le32(0) + pack_le32(0) + pack_le32(65535) + pack_le32(101)

    for m in messages {
        raw_b64 := m["raw_b64"] ?? ""
        if raw_b64 == "" { continue }
        dec := base64.decode(raw_b64)
        if !dec.ok { continue }
        payload := dec.value
        if len(payload) == 0 { continue }

        ts_ms := m["ts_ms"] ?? 0
        src_ep := parse_endpoint(m["src"] ?? "")
        dst_ep := parse_endpoint(m["dst"] ?? m["src"] ?? "")

        udp_len := 8 + len(payload)
        ip_total := 20 + udp_len

        // IPv4 header (20 bytes)
        ip_hdr := pack_u8(0x45) + pack_u8(0) + pack_be16(ip_total) +
                  pack_be16(0) + pack_be16(0x4000) +
                  pack_u8(64) + pack_u8(17) + pack_be16(0) +
                  ip_to_bytes(src_ep["ip"]) + ip_to_bytes(dst_ep["ip"])

        // UDP header (8 bytes)
        udp_hdr := pack_be16(src_ep["port"]) + pack_be16(dst_ep["port"]) +
                   pack_be16(udp_len) + pack_be16(0)

        pkt := ip_hdr + udp_hdr + payload
        pkt_len := len(pkt)

        // PCAP packet header
        ts_sec := ts_ms / 1000
        ts_usec := (ts_ms % 1000) * 1000
        pkt_hdr := pack_le32(ts_sec) + pack_le32(ts_usec) +
                   pack_le32(pkt_len) + pack_le32(pkt_len)

        pcap = pcap + pkt_hdr + pkt
    }
    pcap
}

// ---- saved searches ----

fn searches_path() {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    dir + "/zaman-searches.json"
}

fn load_searches() {
    r := fs.read(searches_path())
    if !r.ok { return [] }
    p := json.parse(r.value)
    if !p.ok { return [] }
    p.value
}

fn save_searches(searches) {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    if !fs.exists(dir) { fs.mkdir(dir) }
    fs.write_atomic(searches_path(), json.stringify(searches))
}

fn create_search(name, username, params) {
    searches := load_searches()
    new_search := {"id": len(searches) + 1, "name": name, "user": username, "params": params}
    save_searches(list_append(searches, new_search))
}

fn delete_search(id) {
    searches := load_searches()
    save_searches(list_remove(searches, "id", id))
}

// ---- admin page ----

fn admin_users_page(user, flash) {
    users := list_users()
    th := "text-[10px] uppercase tracking-wider text-[#52525b] font-semibold"
    inp := "w-full rounded-md bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 text-sm"
    lbl := "block text-[10px] text-[#52525b] uppercase tracking-wider mb-1.5"

    // Flash message
    mut flash_html := ""
    if flash != "" {
        is_err := str.starts_with(flash, "Error")
        cls := if is_err { "border-[#f87171]/20 bg-[#f87171]/5 text-[#f87171]" } else { "border-[#34d399]/20 bg-[#34d399]/5 text-[#34d399]" }
        flash_html = "<div class=\"rounded-lg border " + cls + " px-3 py-2 text-xs mb-4\">" + h(flash) + "</div>"
    }

    // User rows — each user is a card-like row with inline actions
    mut user_list := ""
    for u in users {
        uid := u["id"] ?? 0
        uname := h(u["username"] ?? "")
        urole := u["role"] ?? "viewer"
        is_self := (uid == (user["id"] ?? -1))

        mut actions := ""
        if !is_self {
            // Reset password inline
            actions = "<details class=\"inline\"><summary class=\"text-[11px] text-[#52525b] hover:text-[#a1a1aa] cursor-pointer\">reset pw</summary>" +
                "<form method=\"post\" action=\"/admin/users/password\" class=\"flex gap-2 mt-2\">" +
                "<input type=\"hidden\" name=\"user_id\" value=\"" + ("" + (uid)) + "\"/>" +
                "<input name=\"new_password\" type=\"password\" required placeholder=\"new password\" class=\"flex-1 rounded-md bg-[#0a0a0c] border border-[#1e1e22] px-2 py-1 text-xs mono\"/>" +
                "<button class=\"rounded-md px-2 py-1 text-[11px] bg-[#1e1e22] text-[#a1a1aa] hover:text-[#e4e4e7]\">Set</button></form></details>" +
                " <form method=\"post\" action=\"/admin/users/" + ("" + (uid)) + "/delete\" class=\"inline\" onsubmit=\"return confirm('Delete " + uname + "?')\">" +
                "<button class=\"text-[11px] text-[#52525b] hover:text-[#f87171] ml-2\">delete</button></form>"
        } else {
            actions = "<span class=\"text-[10px] text-[#3f3f46]\">current session</span>"
        }

        user_list = user_list +
            "<div class=\"flex items-center justify-between py-3 px-4 border-b border-[#1e1e22]/50 last:border-0\">" +
            "<div class=\"flex items-center gap-3\">" +
            "<div class=\"w-8 h-8 rounded-full bg-[#1e1e22] flex items-center justify-center text-xs font-semibold text-[#71717a]\">" + str.slice(uname, 0, 1) + "</div>" +
            "<div><div class=\"text-sm font-medium\">" + uname + "</div>" +
            "<div class=\"text-[10px] text-[#3f3f46]\">ID " + ("" + (uid)) + "</div></div>" +
            "<div class=\"ml-4\">" + role_badge(urole) + "</div></div>" +
            "<div class=\"flex items-center gap-1\">" + actions + "</div></div>"
    }

    // Role descriptions
    roles_info := "<div class=\"card p-4 mb-5\">" +
        "<div class=\"grid grid-cols-3 gap-4 text-xs\">" +
        "<div><div class=\"flex items-center gap-1.5 mb-1.5\">" + role_badge("viewer") + "</div>" +
        "<p class=\"text-[#52525b]\">Read-only. View dashboard, messages, calls, reports.</p></div>" +
        "<div><div class=\"flex items-center gap-1.5 mb-1.5\">" + role_badge("operator") + "</div>" +
        "<p class=\"text-[#52525b]\">+ Run probes, manage alerts, configure SLA targets.</p></div>" +
        "<div><div class=\"flex items-center gap-1.5 mb-1.5\">" + role_badge("admin") + "</div>" +
        "<p class=\"text-[#52525b]\">+ Create/delete users, API tokens, audit log, config.</p></div>" +
        "</div></div>"

    flash_html +
    "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
    "<h1 class=\"text-xl font-semibold\">Users</h1>" +
    "<span class=\"text-[10px] text-[#3f3f46] mono\">" + ("" + (len(users))) + " accounts</span></div>" +
    roles_info +
    // User list
    "<div class=\"card overflow-hidden mb-5\">" + user_list + "</div>" +
    // Create form — clean, single row
    "<div class=\"card p-4\">" +
    "<div class=\"section-title\">Add user</div>" +
    "<form method=\"post\" action=\"/admin/users\" class=\"grid grid-cols-4 gap-3 items-end\">" +
    "<div><label class=\"" + lbl + "\">Username</label>" +
    "<input name=\"username\" required placeholder=\"jdoe\" class=\"" + inp + "\"/></div>" +
    "<div><label class=\"" + lbl + "\">Password</label>" +
    "<input name=\"password\" type=\"password\" required placeholder=\"min 8 chars + digit\" class=\"" + inp + "\"/></div>" +
    "<div><label class=\"" + lbl + "\">Role</label>" +
    "<select name=\"role\" class=\"" + inp + "\">" +
    "<option value=\"viewer\">viewer</option>" +
    "<option value=\"operator\">operator</option>" +
    "<option value=\"admin\">admin</option></select></div>" +
    "<button type=\"submit\" class=\"rounded-md px-4 py-2 text-sm bg-[#a78bfa] text-[#0a0a0c] font-medium hover:bg-[#c4b5fd] transition-colors\">Create user</button>" +
    "</form></div>"
}

// ---- audit log ----
// Append-only log: who did what, when. Compliance requirement.

fn audit_path() {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    dir + "/zaman-audit.jsonl"
}

fn audit(user, action, detail) {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    if !fs.exists(dir) { fs.mkdir(dir) }
    entry := json.stringify({"ts": time.unix(), "user": user, "action": action, "detail": detail})
    fs.append(audit_path(), entry + "\n")
    // Rotate: keep last 10000 lines
    r := fs.read(audit_path())
    if r.ok {
        lines := str.split(r.value, "\n")
        if len(lines) > 10000 {
            mut kept := ""
            mut i := len(lines) - 10000
            while i < len(lines) {
                if lines[i] != "" { kept = kept + lines[i] + "\n" }
                i = i + 1
            }
            fs.write_atomic(audit_path(), kept)
        }
    }
}

// Syslog forwarding: if ZAMAN_SYSLOG_HOST is set, also ship audit + alerts there
fn syslog_send(msg) {
    host := env.get("ZAMAN_SYSLOG_HOST") ?? ""
    if host == "" { return }
    port := int.parse(env.get("ZAMAN_SYSLOG_PORT") ?? "514").unwrap_or(514)
    // UDP syslog: <priority>message
    // facility=local0 (16), severity=notice (5) → priority = 16*8+5 = 133
    syslog_msg := "<133>zaman: " + msg
    // Best-effort UDP send via HTTP — Weft doesn't have raw UDP, use audit file as fallback
    audit("syslog", "forward", msg)
}

fn load_audit(limit) {
    r := fs.read(audit_path())
    if !r.ok { return [] }
    lines := str.split(r.value, "\n")
    mut entries := []
    // Read from end (most recent first)
    mut i := len(lines) - 1
    mut count := 0
    while i >= 0 && count < limit {
        line := lines[i]
        if line != "" {
            p := json.parse(line)
            if p.ok { entries = list_append(entries, p.value) }
            count = count + 1
        }
        i = i - 1
    }
    entries
}

