fn node_names_path() {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    dir + "/zaman-node-names.json"
}

fn load_node_names() {
    r := fs.read(node_names_path())
    if !r.ok { return {} }
    p := json.parse(r.value)
    if p.ok { p.value } else { {} }
}

fn save_node_names(names) {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    if !fs.exists(dir) { fs.mkdir(dir) }
    fs.write_atomic(node_names_path(), json.stringify(names))
    fs.chmod(node_names_path(), 384)
}

fn node_display_name(agent, names) {
    display := names[agent]
    if display == null || display == "" { agent } else { display }
}

fn node_select_options(nodes, names, selected) {
    mut out := "<option value=\"\">All servers</option>"
    mut found := selected == ""
    for nd in nodes {
        raw_agent := nd["agent"] ?? ""
        if raw_agent != "" {
            sel := if raw_agent == selected { " selected" } else { "" }
            if raw_agent == selected { found = true }
            out = out + "<option value=\"" + h(raw_agent) + "\"" + sel + ">" + h(node_display_name(raw_agent, names)) + "</option>"
        }
    }
    if !found {
        out = out + "<option value=\"" + h(selected) + "\" selected>" + h(node_display_name(selected, names)) + "</option>"
    }
    out
}

