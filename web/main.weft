    "<div class=\"section-title px-2\">Analyze</div>" +
    "<nav class=\"flex flex-col gap-px text-[13px] mb-4\">" +
    nav_link("/metrics", "Metrics", "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z") +
    nav_link("/report", "Reports", "M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z") +
    nav_link("/sla", "SLA", "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z") +
    nav_link("/alerts", "Alerts", "M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9") +
    "</nav>" +
    (if admin_link != "" { "<div class=\"section-title px-2\">Admin</div><nav class=\"flex flex-col gap-px text-[13px] mb-4\">" + admin_link + "</nav>" } else { "" }) +
    // Footer
    "<div class=\"mt-auto pt-3 border-t border-[#1e1e22] px-2 text-[10px] text-[#3f3f46] space-y-1\">" +
    "<div id=\"core-status\" hx-get=\"/partials/status\" hx-trigger=\"load, every 5s\" hx-swap=\"innerHTML\">…</div>" +
    "</div>" +
    (if user_info != "" { user_info } else { "" }) +
    "</aside>" +
    "<main class=\"p-5 md:p-7 lg:p-8 w-full\">" + body + "</main></div>" +
    (if csrf != "" { "<script>document.querySelectorAll('form[method=\"post\"]').forEach(function(f){if(!f.querySelector('[name=_csrf]')){var i=document.createElement('input');i.type='hidden';i.name='_csrf';i.value='" + csrf + "';f.appendChild(i)}})</script>" } else { "" }) +
    "</body></html>"
}

fn nav_link(href, label, icon) {
    "<a href=\"" + href + "\" class=\"flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[#71717a] hover:bg-[#131316] hover:text-[#e4e4e7] transition-colors\" hx-boost=\"true\">" +
    "<svg class=\"w-3.5 h-3.5 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"" + icon + "\"/></svg>" +
    label + "</a>"
}

fn stat_card(label, value, sub) {
    "<div class=\"card p-4\">" +
    "<div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold\">" + h(label) + "</div>" +
    "<div class=\"text-xl font-bold mono mt-1\">" + h(value) + "</div>" +
    "<div class=\"text-[10px] text-[#3f3f46] mt-1\">" + h(sub) + "</div></div>"
}

fn method_badge(method, status, kind) {
    mut label := ("" + (method ?? ""))
    mut cls := "bg-[rgba(167,139,250,.15)] text-[#a78bfa] border-[rgba(167,139,250,.3)]"
    if kind == "response" {
        label = ("" + (status ?? 0))
        st := int.parse(status ?? 0).unwrap_or(0)
        if st >= 200 && st < 300 {
            cls = "bg-[rgba(52,211,153,.12)] text-[#34d399] border-[rgba(52,211,153,.3)]"
        } else if st >= 400 {
            cls = "bg-[rgba(248,113,113,.12)] text-[#f87171] border-[rgba(248,113,113,.3)]"
        } else {
            cls = "bg-[rgba(251,191,36,.12)] text-[#fbbf24] border-[rgba(251,191,36,.3)]"
        }
    } else if method == "INVITE" {
        cls = "bg-[rgba(167,139,250,.15)] text-[#c084fc] border-[rgba(167,139,250,.3)]"
    } else if method == "BYE" || method == "CANCEL" {
        cls = "bg-[rgba(248,113,113,.12)] text-[#f87171] border-[rgba(248,113,113,.3)]"
    } else if method == "OPTIONS" || method == "REGISTER" {
        cls = "bg-[rgba(52,211,153,.12)] text-[#34d399] border-[rgba(52,211,153,.3)]"
    }
    "<span class=\"inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold border " + cls + " mono\">" + h(label) + "</span>"
}

fn msg_row(m) {
    id := m["id"] ?? 0
    method := m["method"] ?? ""
    status := m["status"] ?? 0
    kind := m["kind"] ?? ""
    call_id := m["call_id"] ?? ""
    src := m["src"] ?? ""
    dst := m["dst"] ?? ""
    transport := m["transport"] ?? ""
    proto := m["proto"] ?? ""
    agent := m["agent"] ?? ""
    from := m["from"] ?? ""
    badge := method_badge(method, status, kind)
    cid := h(call_id)
    mut xport := h(transport)
    if proto != "" && proto != "sip" && proto != "unknown" {
        xport = xport + "/" + h(proto)
    }
    mut src_s := h(src)
    if dst != "" {
        src_s = src_s + " → " + h(dst)
    }
    "<tr class=\"hover:bg-white/[0.02]\">" +
    "<td class=\"py-2 px-3 mono text-xs text-[#a1a1aa]\">" + ("" + (id)) + "</td>" +
    "<td class=\"py-2 px-3\">" + badge + "</td>" +
    "<td class=\"py-2 px-3 mono text-xs max-w-[14rem] truncate\" title=\"" + cid + "\">" + cid + "</td>" +
    "<td class=\"py-2 px-3 mono text-xs text-[#a1a1aa] max-w-[12rem] truncate\" title=\"" + src_s + "\">" + src_s + "</td>" +
    "<td class=\"py-2 px-3 text-xs\"><span class=\"px-1.5 py-0.5 rounded border border-[#1e1e22] text-[#a1a1aa]\">" + xport + "</span>" +
    (if agent != "" { " <span class=\"text-[10px] text-[#a1a1aa]\">" + h(agent) + "</span>" } else { "" }) +
    "</td>" +
    "<td class=\"py-2 px-3 text-xs max-w-[12rem] truncate text-[#a1a1aa]\">" + h(from) + "</td>" +
    "<td class=\"py-2 px-3 text-xs\">" +
    "<a class=\"text-[#a78bfa] hover:underline\" href=\"/messages/" + ("" + (id)) + "\">view</a> · " +
    "<a class=\"text-[#a78bfa] hover:underline\" href=\"/calls?call_id=" + cid + "\">ladder</a>" +
    "</td></tr>"
}

fn messages_table(items) {
    mut rows := ""
    if items != null {
        for m in items {
            rows = rows + msg_row(m)
        }
    }
    if rows == "" {
        rows = "<tr><td colspan=\"7\" class=\"py-8 text-center text-[#a1a1aa] text-sm\">No messages yet — send SIP to the core or run a probe.</td></tr>"
    }
    "<div class=\"overflow-x-auto card\">" +
    "<table class=\"w-full text-left text-sm\"><thead><tr class=\"text-[11px] uppercase tracking-wide text-[#a1a1aa] border-b border-[#1e1e22]\">" +
    "<th class=\"py-2 px-3 font-semibold hide-mobile\">ID</th><th class=\"py-2 px-3 font-semibold\">Method</th>" +
    "<th class=\"py-2 px-3 font-semibold\">Call-ID</th><th class=\"py-2 px-3 font-semibold hide-mobile\">Src</th>" +
    "<th class=\"py-2 px-3 font-semibold hide-mobile\">Transport</th><th class=\"py-2 px-3 font-semibold hide-mobile\">From</th>" +
    "<th class=\"py-2 px-3 font-semibold\"></th></tr></thead>" +
    "<tbody class=\"divide-y divide-[#27272a]\">" + rows + "</tbody></table></div>"
}

fn empty_metrics() {
    {
        "msgs_total": 0, "requests": 0, "responses": 0, "echoes": 0, "hep_total": 0,
        "probe_rtt_ms": 0, "probes_ok": 0, "probes_fail": 0, "uptime_ms": 0, "ring_idx": 0,
        "methods": {"INVITE": 0, "OPTIONS": 0, "REGISTER": 0, "BYE": 0, "ACK": 0, "INFO": 0, "MESSAGE": 0, "UNKNOWN": 0}
    }
}

fn fetch_metrics() {
    r := http.get(core_base() + "/api/metrics", api_headers())
    if !r.ok { return empty_metrics() }
    p := json.parse(r.value.body)
    if p.ok { p.value } else { empty_metrics() }
}

fn fetch_messages(limit, call_id) {
    fetch_messages_ex(limit, call_id, "", "", "", "")
}

fn fetch_messages_ex(limit, call_id, transport, agent, method, src) {
    mut path := core_base() + "/api/messages?limit=" + ("" + (limit))
    if call_id != "" { path = path + "&call_id=" + call_id }
    if transport != "" { path = path + "&transport=" + transport }
    if agent != "" { path = path + "&agent=" + agent }
    if method != "" { path = path + "&method=" + method }
    if src != "" { path = path + "&src=" + src }
    r := http.get(path, api_headers())
    if !r.ok { return [] }
    p := json.parse(r.value.body)
    if p.ok { p.value } else { [] }
}

fn fetch_message(id) {
    r := http.get(core_base() + "/api/messages/" + ("" + (id)), api_headers())
