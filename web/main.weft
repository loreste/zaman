fn endpoint_ip(endpoint) {
    ep := parse_endpoint(endpoint)
    ep["ip"] ?? endpoint
}

fn site_label_for(endpoint, labels) {
    ip := endpoint_ip(endpoint)
    label := labels[ip]
    if label == null || label == "" { "" } else { label }
}

fn endpoint_display(endpoint, labels) {
    if endpoint == "" { return "" }
    ip := endpoint_ip(endpoint)
    label := labels[ip]
    if label == null || label == "" {
        return h(endpoint)
    }
    h(label) + " <span class=\"mono text-[10px] text-[#52525b]\">" + h(endpoint) + "</span>"
}

fn call_id_origin_ip(call_id) {
    if call_id == null || call_id == "" { return "" }
    parts := str.split(call_id, "@")
    if len(parts) < 2 { return "" }
    mut host := parts[len(parts) - 1]
    semi := str.split(host, ";")
    if len(semi) > 0 { host = semi[0] }
    gt := str.split(host, ">")
    if len(gt) > 0 { host = gt[0] }
    lt := str.split(host, "<")
    if len(lt) > 0 { host = lt[len(lt) - 1] }
    if str.contains(host, ".") || str.contains(host, ":") { return host }
    ""
}

fn call_origin_ip(call_id, items) {
    cid_ip := call_id_origin_ip(call_id)
    if cid_ip != "" { return cid_ip }
    mut origin := ""
    mut origin_ts := 0
    for m in items {
        if (m["call_id"] ?? "") != call_id { continue }
        if (m["method"] ?? "") != "INVITE" { continue }
        if (m["kind"] ?? "") == "response" { continue }
        ip := endpoint_ip(m["src"] ?? "")
        if ip == "" || ip == "0.0.0.0" { continue }
        ts_ms := m["ts_ms"] ?? 0
        if origin == "" || ts_ms < origin_ts {
            origin = ip
            origin_ts = ts_ms
        }
    }
    origin
}

fn node_age_label(age_sec) {
    if age_sec < 60 { return ("" + (age_sec)) + "s ago" }
    if age_sec < 3600 { return ("" + (age_sec / 60)) + "m ago" }
    ("" + (age_sec / 3600)) + "h ago"
}

fn node_status_label(status) {
    if status == "green" { return "healthy" }
    if status == "yellow" { return "degraded" }
    "offline"
}

fn node_status_classes(status) {
    if status == "green" { return "bg-[rgba(52,211,153,.10)] text-[#34d399] border-[rgba(52,211,153,.28)]" }
    if status == "yellow" { return "bg-[rgba(251,191,36,.10)] text-[#fbbf24] border-[rgba(251,191,36,.28)]" }
    "bg-[rgba(248,113,113,.10)] text-[#f87171] border-[rgba(248,113,113,.28)]"
}

fn noc_nodes_table(nodes, names, user, req, token_secret) {
    th := "text-[10px] uppercase tracking-wider text-[#52525b] font-semibold"
    can_edit := has_role(user, "operator")
    mut rows := ""
    for nd in nodes {
        raw_agent := nd["agent"] ?? ""
        nname := h(node_display_name(raw_agent, names))
        raw_label := h(raw_agent)
        nstatus := nd["status"] ?? "red"
        nrecent := nd["recent"] ?? 0
        ntotal := nd["total"] ?? 0
        nerrors := nd["errors"] ?? 0
        ncalls := nd["calls"] ?? 0
        nage := nd["age_sec"] ?? 9999
        dot := if nstatus == "green" { "bg-[#34d399]" } else if nstatus == "yellow" { "bg-[#fbbf24]" } else { "bg-[#f87171]" }
        age_txt := node_age_label(nage)
        status_pill := "<span class=\"inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 text-[11px] font-semibold " + node_status_classes(nstatus) + "\"><span class=\"w-1.5 h-1.5 rounded-full " + dot + "\"></span>" + node_status_label(nstatus) + "</span>"
        mut rename := ""
        if can_edit {
            rename = "<form method=\"post\" action=\"/noc/node-name\" class=\"mt-2 flex flex-wrap items-center gap-2\">" +
                csrf_field(req, token_secret) +
                "<input type=\"hidden\" name=\"agent\" value=\"" + raw_label + "\"/>" +
                "<input name=\"display_name\" value=\"" + nname + "\" placeholder=\"Display name\" class=\"w-48 rounded-md bg-[#09090b] border border-[#27272a] px-2 py-1 text-xs outline-none focus:border-[#a78bfa]\"/>" +
                "<button type=\"submit\" class=\"rounded-md border border-[#27272a] px-2 py-1 text-[11px] text-[#a1a1aa] hover:text-[#e4e4e7] hover:border-[#3f3f46]\">Save</button></form>"
        }
        rows = rows + "<tr class=\"hover:bg-white/[0.02] align-top\">" +
            "<td class=\"py-3 px-3\"><div class=\"flex items-start gap-2\"><span class=\"w-2 h-2 rounded-full " + dot + " mt-1.5 shrink-0\"></span>" +
            "<div><div class=\"text-sm font-medium\">" + nname + "</div><div class=\"mono text-[10px] text-[#52525b] mt-0.5\">" + raw_label + "</div>" + rename + "</div></div></td>" +
            "<td class=\"py-3 px-3\">" + status_pill + "</td>" +
            "<td class=\"py-3 px-3 mono text-xs text-right\"><div class=\"text-[#e4e4e7]\">" + ("" + (nrecent)) + "</div><div class=\"text-[10px] text-[#52525b]\">last 5m</div></td>" +
            "<td class=\"py-3 px-3 mono text-xs text-right\">" + ("" + (ntotal)) + "</td>" +
            "<td class=\"py-3 px-3 mono text-xs text-right\">" + ("" + (ncalls)) + "</td>" +
            "<td class=\"py-3 px-3 mono text-xs text-right " + (if nerrors > 0 { "text-[#f87171] font-semibold" } else { "text-[#71717a]" }) + "\">" + ("" + (nerrors)) + "</td>" +
            "<td class=\"py-3 px-3 text-xs text-right text-[#a1a1aa]\">" + age_txt + "</td>" +
            "<td class=\"py-3 px-3 text-xs whitespace-nowrap\"><a class=\"text-[#a78bfa] hover:underline\" href=\"/messages?agent=" + raw_label + "\">messages</a> · <a class=\"text-[#a78bfa] hover:underline\" href=\"/calls\">calls</a></td></tr>"
    }
    if rows == "" { rows = "<tr><td colspan=\"8\" class=\"py-10 text-center text-[#52525b] text-sm\">No nodes reporting yet. When HEP traffic arrives, each agent appears here automatically.</td></tr>" }
    "<table class=\"w-full text-left text-sm\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\">" +
    "<th class=\"py-2 px-3\">Node</th><th class=\"py-2 px-3\">Health</th><th class=\"py-2 px-3 text-right\">Traffic</th><th class=\"py-2 px-3 text-right\">Total</th>" +
    "<th class=\"py-2 px-3 text-right\">Calls</th><th class=\"py-2 px-3 text-right\">Errors</th><th class=\"py-2 px-3 text-right\">Last seen</th><th class=\"py-2 px-3\"></th></tr></thead>" +
    "<tbody class=\"divide-y divide-[#1e1e22]/50\">" + rows + "</tbody></table>"
}

fn time_ago(unix_ts) {
    if unix_ts == 0 { return "never" }
    diff := time.unix() - unix_ts
    if diff < 0 { return "just now" }
    if diff < 60 { return ("" + (diff)) + "s ago" }
    if diff < 3600 { return ("" + (diff / 60)) + "m ago" }
    if diff < 86400 { return ("" + (diff / 3600)) + "h ago" }
    ("" + (diff / 86400)) + "d ago"
}

fn n(m, key) {
    v := m[key]
    if v == null { 0 } else { v }
}

fn build_traffic_charts(minutes) {
    cps := fetch_cps(minutes)
    rt := fetch_realtime(minutes)
    crd := "card"

    // Build line chart data from CPS buckets
    mut line_data := {}
    mut area_data := {}
    for bucket in cps {
        ts := bucket["ts"] ?? 0
        total := bucket["total"] ?? 0
        invites := bucket["invites"] ?? 0
        // Label as relative minutes ago
        mins_ago := (time.unix() * 1000 - ts) / 60000
        label := if mins_ago <= 1 { "now" } else { ("" + (mins_ago)) + "m" }
        line_data[label] = total
        area_data[label] = invites
    }

    mut line_html := "<div class=\"text-sm text-[#52525b] py-8 text-center\">No traffic in this window.</div>"
    mut area_html := ""
    if len(line_data) > 0 {
        line_chart := viz.line(line_data, {"title": "Messages / minute", "width": 700, "height": 200, "colors": ["#a78bfa"]})
        line_html = line_chart.html
        if len(area_data) > 0 {
            area_chart := viz.area(area_data, {"title": "INVITEs / minute", "width": 700, "height": 160, "colors": ["#34d399"]})
            area_html = "<div class=\"mt-4\">" + area_chart.html + "</div>"
        }
    }

    // Response breakdown for this window
    r2xx := rt["resp_2xx"] ?? 0
    r4xx := rt["resp_4xx"] ?? 0
    r5xx := rt["resp_5xx"] ?? 0
    total_resp := r2xx + r4xx + r5xx
    mut resp_pie_html := ""
    if total_resp > 0 {
        resp_pie := viz.pie({"2xx": r2xx, "4xx": r4xx, "5xx": r5xx}, {"title": "Responses", "width": 280, "height": 200, "colors": ["#34d399", "#fb923c", "#f87171"]})
        resp_pie_html = resp_pie.html
    }

    // Method mix for this window
    inv := rt["invites"] ?? 0
    bye := rt["byes"] ?? 0
    reg := rt["registers"] ?? 0
    opts := rt["options"] ?? 0
    mut method_bar_html := ""
    if inv + bye + reg + opts > 0 {
        method_bar := viz.bar({"INVITE": inv, "BYE": bye, "REGISTER": reg, "OPTIONS": opts}, {"title": "Methods", "width": 280, "height": 200, "colors": ["#a78bfa", "#f87171", "#f472b6", "#34d399"]})
        method_bar_html = method_bar.html
    }

    // Summary stats
    summary := "<div class=\"grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4\">" +
        "<div class=\"text-center\"><div class=\"text-2xl font-bold mono\">" + ("" + (rt["total"] ?? 0)) + "</div><div class=\"text-[10px] text-[#52525b] uppercase\">messages</div></div>" +
        "<div class=\"text-center\"><div class=\"text-2xl font-bold mono\" style=\"color:" + (if (rt["asr"] ?? 0) >= 70 { "#34d399" } else if (rt["asr"] ?? 0) >= 40 { "#fbbf24" } else { "#f87171" }) + "\">" + ("" + (rt["asr"] ?? 0)) + "%</div><div class=\"text-[10px] text-[#52525b] uppercase\">ASR</div></div>" +
        "<div class=\"text-center\"><div class=\"text-2xl font-bold mono\">" + ("" + (rt["active_calls"] ?? 0)) + "</div><div class=\"text-[10px] text-[#52525b] uppercase\">active calls</div></div>" +
        "<div class=\"text-center\"><div class=\"text-2xl font-bold mono\">" + ("" + (rt["agents_active"] ?? 0)) + "</div><div class=\"text-[10px] text-[#52525b] uppercase\">nodes</div></div>" +
        "</div>"

    summary +
    "<div class=\"grid lg:grid-cols-[1fr_300px] gap-4\">" +
    "<div class=\"" + crd + " p-5 overflow-x-auto\">" + line_html + area_html + "</div>" +
    "<div class=\"space-y-4\">" +
    (if resp_pie_html != "" { "<div class=\"" + crd + " p-4 overflow-x-auto\">" + resp_pie_html + "</div>" } else { "" }) +
    (if method_bar_html != "" { "<div class=\"" + crd + " p-4 overflow-x-auto\">" + method_bar_html + "</div>" } else { "" }) +
    "</div></div>"
}

fn overview_body(user) {
    m := fetch_metrics()
    rt := fetch_realtime(5)
    rt1 := fetch_realtime(1)
    nodes := fetch_nodes()
    anomalies := fetch_anomalies()
    items := fetch_messages(8, "")
    up_s := n(m, "uptime_ms") / 1000

    // ── Alerts (only if problems) ──
    mut alerts := ""
    if len(anomalies) > 0 {
        mut aitems := ""
        for a in anomalies {
            sev := a["severity"] ?? "warning"
            cls := if sev == "critical" { "border-[#f87171]/20 bg-[#f87171]/5 text-[#f87171]" } else { "border-[#fbbf24]/20 bg-[#fbbf24]/5 text-[#fbbf24]" }
            aitems = aitems + "<div class=\"flex items-center gap-2 rounded-lg border " + cls + " px-3 py-2 text-xs\">" +
                "<span>&#x26A0;</span> " + h(a["message"] ?? "") + "</div>"
        }
        alerts = "<div class=\"space-y-1.5 mb-5\" id=\"alert-bar\" hx-get=\"/partials/alerts\" hx-trigger=\"every 30s\" hx-swap=\"innerHTML\">" + aitems + "</div>"
    } else {
        alerts = "<div id=\"alert-bar\" hx-get=\"/partials/alerts\" hx-trigger=\"every 30s\" hx-swap=\"innerHTML\"></div>"
    }

    // ── Hero KPIs: 4 metrics that matter at a glance ──
    win_asr := rt["asr"] ?? 0
    err_rate := rt["err_rate"] ?? 0
    active := rt["active_calls"] ?? 0
    asr_c := if win_asr >= 70 { "#34d399" } else if win_asr >= 40 { "#fbbf24" } else { "#f87171" }
    err_c := if err_rate <= 5 { "#34d399" } else if err_rate <= 15 { "#fbbf24" } else { "#f87171" }
    total_5m := rt["total"] ?? 0

    hero := "<div class=\"grid grid-cols-2 md:grid-cols-4 gap-3 mb-5\">" +
        "<div class=\"card p-4\"><div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold\">Active calls</div>" +
        "<div class=\"text-3xl font-bold mono mt-1 text-[#a78bfa]\">" + ("" + (active)) + "</div></div>" +
        "<div class=\"card p-4\"><div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold\">ASR</div>" +
        "<div class=\"text-3xl font-bold mono mt-1\" style=\"color:" + asr_c + "\">" + ("" + (win_asr)) + "<span class=\"text-lg\">%</span></div></div>" +
        "<div class=\"card p-4\"><div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold\">Errors</div>" +
        "<div class=\"text-3xl font-bold mono mt-1\" style=\"color:" + err_c + "\">" + ("" + (err_rate)) + "<span class=\"text-lg\">%</span></div></div>" +
        "<div class=\"card p-4\"><div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold\">Messages (5m)</div>" +
        "<div class=\"text-3xl font-bold mono mt-1\">" + ("" + (total_5m)) + "</div></div>" +
        "</div>"

    // ── Node status: compact summary bar, not a grid ──
    mut green := 0
    mut yellow := 0
    mut red := 0
    for nd in nodes {
        st := nd["status"] ?? "red"
        if st == "green" { green = green + 1 }
        else if st == "yellow" { yellow = yellow + 1 }
        else { red = red + 1 }
    }
    node_bar := "<div class=\"flex items-center justify-between card px-4 py-2.5 mb-5\">" +
        "<div class=\"flex items-center gap-4 text-xs\">" +
        "<span class=\"flex items-center gap-1.5\"><span class=\"w-2 h-2 rounded-full bg-[#34d399]\"></span><span class=\"mono\">" + ("" + (green)) + "</span> healthy</span>" +
        (if yellow > 0 { "<span class=\"flex items-center gap-1.5\"><span class=\"w-2 h-2 rounded-full bg-[#fbbf24]\"></span><span class=\"mono\">" + ("" + (yellow)) + "</span> degraded</span>" } else { "" }) +
        (if red > 0 { "<span class=\"flex items-center gap-1.5\"><span class=\"w-2 h-2 rounded-full bg-[#f87171]\"></span><span class=\"mono\">" + ("" + (red)) + "</span> offline</span>" } else { "" }) +
        "<span class=\"text-[#3f3f46]\">·</span>" +
        "<span class=\"text-[#52525b]\">" + ("" + (len(nodes))) + " nodes</span></div>" +
        "<a href=\"/noc\" class=\"text-[11px] text-[#a78bfa] hover:underline\">View all →</a></div>"

    // ── Traffic charts ──
    btn := "rounded-md px-2.5 py-1 text-[11px] transition-colors cursor-pointer"
    btn_on := btn + " bg-[#1e1e22] text-[#e4e4e7]"
    btn_off := btn + " text-[#52525b] hover:text-[#a1a1aa]"
    traffic := "<div class=\"section\">" +
        "<div class=\"flex items-center justify-between mb-3\">" +
        "<div class=\"section-title mb-0\">Traffic</div>" +
        "<div class=\"flex items-center gap-0.5 rounded-md border border-[#1e1e22] p-0.5\">" +
        "<button class=\"" + btn_on + "\" hx-get=\"/partials/charts?window=5\" hx-target=\"#traffic-charts\" hx-swap=\"innerHTML\">5m</button>" +
        "<button class=\"" + btn_off + "\" hx-get=\"/partials/charts?window=15\" hx-target=\"#traffic-charts\" hx-swap=\"innerHTML\">15m</button>" +
        "<button class=\"" + btn_off + "\" hx-get=\"/partials/charts?window=60\" hx-target=\"#traffic-charts\" hx-swap=\"innerHTML\">1h</button>" +
        "<button class=\"" + btn_off + "\" hx-get=\"/partials/charts?window=360\" hx-target=\"#traffic-charts\" hx-swap=\"innerHTML\">6h</button>" +
        "<button class=\"" + btn_off + "\" hx-get=\"/partials/charts?window=1440\" hx-target=\"#traffic-charts\" hx-swap=\"innerHTML\">24h</button>" +
        "</div></div>" +
        "<div id=\"traffic-charts\" hx-get=\"/partials/charts?window=5\" hx-trigger=\"every 15s\" hx-swap=\"innerHTML\">" +
        build_traffic_charts(5) + "</div></div>"

    // ── Live feed (compact) ──
    live := "<div class=\"section\">" +
        "<div class=\"flex items-center justify-between mb-3\">" +
        "<div class=\"section-title mb-0\">Live feed</div>" +
        "<span class=\"flex items-center gap-1.5 text-[10px] text-[#34d399]\"><span class=\"w-1.5 h-1.5 rounded-full bg-[#34d399] animate-pulse\"></span>live</span></div>" +
        "<div id=\"live-msgs\" hx-get=\"/partials/messages?limit=8\" hx-trigger=\"every 3s\" hx-swap=\"innerHTML\">" +
        messages_table(items) + "</div></div>"

    // ── Assemble ──
    "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
    "<h1 class=\"text-xl font-semibold\">Overview</h1>" +
    "<div class=\"text-[10px] text-[#3f3f46] mono\">uptime " + ("" + (up_s)) + "s</div></div>" +
    alerts + hero + node_bar + traffic + live
}

fn overview_metric_card(label, value, sub, color) {
    "<div class=\"card p-4 min-h-[92px]\">" +
    "<div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold\">" + h(label) + "</div>" +
    "<div class=\"text-2xl font-bold mono mt-1\" style=\"color:" + color + "\">" + h(value) + "</div>" +
    "<div class=\"text-[10px] text-[#71717a] mt-1 leading-snug\">" + h(sub) + "</div></div>"
}

fn overview_realtime_panel_agent(agent) {
    rt := fetch_realtime_agent(1, agent)
    failures := (rt["resp_4xx"] ?? 0) + (rt["resp_5xx"] ?? 0)
    fail_color := if failures > 0 { "#f87171" } else { "#34d399" }
    scope := if agent == "" { "all servers" } else { "selected server" }
    "<div class=\"grid grid-cols-2 xl:grid-cols-3 gap-3 mb-5\">" +
    overview_metric_card("Concurrent calls", "" + (rt["active_calls"] ?? 0), "open dialogs, " + scope, "#f472b6") +
    overview_metric_card("CPS", per_second_label(rt["invites"] ?? 0, 60), "distinct INVITE Call-IDs per second, " + scope, "#34d399") +
    overview_metric_card("Message rate", per_second_label(rt["total"] ?? 0, 60) + "/s", "all captures per second, " + scope, "#38bdf8") +
    overview_metric_card("Call attempts", "" + (rt["invites"] ?? 0), "distinct INVITEs in the last 1m, " + scope, "#fbbf24") +
    overview_metric_card("Failures", "" + (failures), "4xx/5xx in the last 1m", fail_color) +
    overview_metric_card("ASR", "" + (rt["asr"] ?? 0) + "%", "answer rate, last 1m", if (rt["asr"] ?? 0) >= 70 { "#34d399" } else if (rt["asr"] ?? 0) >= 40 { "#fbbf24" } else { "#f87171" }) +
    "</div>"
}

fn overview_realtime_panel() {
    overview_realtime_panel_agent("")
}

fn overview_body_v2(user) {
    m := fetch_metrics()
    rt := fetch_realtime(5)
    rt1 := fetch_realtime(1)
    nodes := fetch_nodes()
    items := fetch_messages(8, "")
    labels := load_site_labels()
    up_s := n(m, "uptime_ms") / 1000
    methods := m["methods"] ?? {}

    mut green := 0
    mut yellow := 0
    mut red := 0
    mut recent_total := 0
    mut tracked_calls := 0
    mut error_nodes := 0
    mut node_rows := ""
    names := load_node_names()
    for nd in nodes {
        status := nd["status"] ?? "red"
        if status == "green" { green = green + 1 }
        else if status == "yellow" { yellow = yellow + 1 }
        else { red = red + 1 }
        recent := nd["recent"] ?? 0
        calls := nd["calls"] ?? 0
        errs := nd["errors"] ?? 0
        recent_total = recent_total + recent
        tracked_calls = tracked_calls + calls
        if errs > 0 { error_nodes = error_nodes + 1 }
        raw_agent := nd["agent"] ?? ""
        display := h(node_display_name(raw_agent, names))
        dot := if status == "green" { "bg-[#34d399]" } else if status == "yellow" { "bg-[#fbbf24]" } else { "bg-[#f87171]" }
        node_rows = node_rows + "<a href=\"/noc\" class=\"flex items-center justify-between gap-3 px-3 py-2 rounded-md hover:bg-white/[0.03]\">" +
            "<span class=\"flex items-center gap-2 min-w-0\"><span class=\"w-2 h-2 rounded-full " + dot + " shrink-0\"></span><span class=\"text-sm truncate\">" + display + "</span></span>" +
            "<span class=\"flex items-center gap-3 text-[11px] text-[#71717a] shrink-0\"><span><span class=\"mono text-[#e4e4e7]\">" + ("" + (recent)) + "</span> 5m</span><span><span class=\"mono text-[#e4e4e7]\">" + ("" + (calls)) + "</span> calls</span></span></a>"
    }
    if node_rows == "" { node_rows = "<div class=\"px-3 py-6 text-sm text-[#71717a]\">No nodes reporting yet.</div>" }
    mut node_opts := "<option value=\"\">All servers</option>"
    for nd2 in nodes {
        raw_agent2 := nd2["agent"] ?? ""
        if raw_agent2 != "" {
            node_opts = node_opts + "<option value=\"" + h(raw_agent2) + "\">" + h(node_display_name(raw_agent2, names)) + "</option>"
        }
    }

    health_color := if red > 0 { "#f87171" } else if yellow > 0 { "#fbbf24" } else { "#34d399" }
    health_text := if red > 0 { "offline node attention needed" } else if yellow > 0 { "stale nodes present" } else { "all reporting nodes healthy" }
    db_ok := n(m, "db_ok")
    db_err := n(m, "db_err")
    db_drop := n(m, "db_drop")
    db_color := if db_err + db_drop > 0 { "#f87171" } else { "#34d399" }
    parse_err := n(m, "parse_err")
    hep_err := n(m, "hep_err")
    error_color := if parse_err + hep_err > 0 { "#fbbf24" } else { "#34d399" }
    active_calls := rt["active_calls"] ?? 0
    active_now := rt1["active_calls"] ?? active_calls
    cps_1m := per_second_label(rt1["invites"] ?? 0, 60)
    msgps_1m := per_second_label(rt1["total"] ?? 0, 60)
    calls_5m := rt["invites"] ?? 0
    call_attempts_1m := rt1["invites"] ?? 0

    hero := "<div class=\"grid grid-cols-2 xl:grid-cols-4 gap-3 mb-5\">" +
        overview_metric_card("HEP captures", "" + (n(m, "hep_total")), "total HEP messages received", "#a78bfa") +
        overview_metric_card("CPS", cps_1m, "INVITE requests per second, last 1m", "#34d399") +
        overview_metric_card("Concurrent calls", "" + (active_now), "open dialogs in the live window", "#f472b6") +
        overview_metric_card("Message rate", msgps_1m + "/s", "all captures per second, last 1m", "#38bdf8") +
        overview_metric_card("Recent traffic", "" + (recent_total), "messages seen in the last 5 minutes", "#38bdf8") +
        overview_metric_card("Active calls", "" + (active_calls), "INVITEs in the last 5m without BYE", "#f472b6") +
        overview_metric_card("System health", "" + (green) + "/" + (len(nodes)), health_text, health_color) +
        overview_metric_card("Requests", "" + (n(m, "requests")), "parsed SIP requests", "#e4e4e7") +
        overview_metric_card("Responses", "" + (n(m, "responses")), "parsed SIP responses", "#e4e4e7") +
    overview_metric_card("Database writes", "" + (db_ok), "errors " + ("" + (db_err)) + " · dropped " + ("" + (db_drop)), db_color) +
        overview_metric_card("Parser health", "" + (parse_err + hep_err), "parse + HEP errors", error_color) +
        "</div>"

    method_mix := "<div class=\"card p-4\">" +
        "<div class=\"flex items-center justify-between mb-3\"><div class=\"section-title mb-0\">Method Mix</div><a href=\"/report\" class=\"text-[11px] text-[#a78bfa] hover:underline\">Reports</a></div>" +
        "<div class=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">" +
        "<div><div class=\"text-xl mono font-bold\">" + ("" + (methods["INVITE"] ?? 0)) + "</div><div class=\"text-[10px] text-[#71717a] uppercase\">INVITE</div></div>" +
        "<div><div class=\"text-xl mono font-bold\">" + ("" + (methods["OPTIONS"] ?? 0)) + "</div><div class=\"text-[10px] text-[#71717a] uppercase\">OPTIONS</div></div>" +
        "<div><div class=\"text-xl mono font-bold\">" + ("" + (methods["REGISTER"] ?? 0)) + "</div><div class=\"text-[10px] text-[#71717a] uppercase\">REGISTER</div></div>" +
        "<div><div class=\"text-xl mono font-bold\">" + ("" + (methods["BYE"] ?? 0)) + "</div><div class=\"text-[10px] text-[#71717a] uppercase\">BYE</div></div>" +
        "</div></div>"

    nodes_panel := "<div class=\"card p-4\">" +
        "<div class=\"flex items-center justify-between mb-3\"><div class=\"section-title mb-0\">Nodes</div><a href=\"/noc\" class=\"text-[11px] text-[#a78bfa] hover:underline\">Open NOC</a></div>" +
        "<div class=\"grid grid-cols-3 gap-2 mb-3 text-center\">" +
        "<div class=\"rounded-md bg-[#0a0a0c] border border-[#1e1e22] py-2\"><div class=\"mono text-[#34d399]\">" + ("" + (green)) + "</div><div class=\"text-[10px] text-[#71717a]\">healthy</div></div>" +
        "<div class=\"rounded-md bg-[#0a0a0c] border border-[#1e1e22] py-2\"><div class=\"mono text-[#fbbf24]\">" + ("" + (yellow)) + "</div><div class=\"text-[10px] text-[#71717a]\">stale</div></div>" +
        "<div class=\"rounded-md bg-[#0a0a0c] border border-[#1e1e22] py-2\"><div class=\"mono text-[#f87171]\">" + ("" + (red)) + "</div><div class=\"text-[10px] text-[#71717a]\">offline</div></div></div>" +
        "<div class=\"divide-y divide-[#1e1e22]/60\">" + node_rows + "</div></div>"

    mut site_rows := ""
    for mrow in items {
        src := mrow["src"] ?? ""
        dst := mrow["dst"] ?? ""
        if src != "" {
            ip := endpoint_ip(src)
            label := site_label_for(src, labels)
            site_rows = site_rows + "<a href=\"/ip?addr=" + h(ip) + "\" class=\"flex items-center justify-between gap-3 py-1.5 text-xs hover:text-[#e4e4e7]\"><span class=\"truncate\">" + (if label != "" { h(label) } else { h(ip) }) + "</span><span class=\"mono text-[#52525b] shrink-0\">" + h(ip) + "</span></a>"
        }
        if dst != "" {
            ip2 := endpoint_ip(dst)
            label2 := site_label_for(dst, labels)
            site_rows = site_rows + "<a href=\"/ip?addr=" + h(ip2) + "\" class=\"flex items-center justify-between gap-3 py-1.5 text-xs hover:text-[#e4e4e7]\"><span class=\"truncate\">" + (if label2 != "" { h(label2) } else { h(ip2) }) + "</span><span class=\"mono text-[#52525b] shrink-0\">" + h(ip2) + "</span></a>"
        }
    }
    if site_rows == "" { site_rows = "<div class=\"py-4 text-sm text-[#71717a]\">No recent endpoints.</div>" }
    sites_panel := "<div class=\"card p-4\">" +
        "<div class=\"flex items-center justify-between mb-3\"><div class=\"section-title mb-0\">Recent Sites</div><a href=\"/ip\" class=\"text-[11px] text-[#a78bfa] hover:underline\">IP history</a></div>" +
        "<div class=\"divide-y divide-[#1e1e22]/60 text-[#a1a1aa] max-h-[260px] overflow-y-auto\">" + site_rows + "</div></div>"

    quick := "<div class=\"card p-4\">" +
        "<div class=\"section-title\">Quick Actions</div>" +
        "<div class=\"grid sm:grid-cols-2 gap-2\">" +
        "<a href=\"/messages\" class=\"rounded-md border border-[#27272a] px-3 py-2 text-sm hover:border-[#3f3f46]\">Browse message groups</a>" +
        "<a href=\"/ip\" class=\"rounded-md border border-[#27272a] px-3 py-2 text-sm hover:border-[#3f3f46]\">Search by IP address</a>" +
        "<a href=\"/ladder\" class=\"rounded-md border border-[#27272a] px-3 py-2 text-sm hover:border-[#3f3f46]\">Open call ladder</a>" +
        "<a href=\"/alerts\" class=\"rounded-md border border-[#27272a] px-3 py-2 text-sm hover:border-[#3f3f46]\">Alert rules</a>" +
        "</div></div>"

    traffic := "<div class=\"section\">" +
        "<div class=\"flex items-center justify-between mb-3\"><div class=\"section-title mb-0\">Traffic</div><span class=\"text-[10px] text-[#52525b]\">loads after page render</span></div>" +
        "<div id=\"traffic-charts\" hx-get=\"/partials/charts?window=5\" hx-trigger=\"load, every 30s\" hx-swap=\"innerHTML\">" +
        "<div class=\"card p-8 text-center text-sm text-[#71717a]\">Loading traffic charts...</div></div></div>"

    live := "<div class=\"section\">" +
        "<div class=\"flex items-center justify-between mb-3\"><div class=\"section-title mb-0\">Live Feed</div><a href=\"/messages\" class=\"text-[11px] text-[#a78bfa] hover:underline\">Messages</a></div>" +
        "<div id=\"live-msgs\" hx-get=\"/partials/live-feed?method=INVITE\" hx-trigger=\"every 2s\" hx-swap=\"innerHTML\">" +
        dashboard_live_feed_panel("INVITE") + "</div></div>"

    active_overview := "<div class=\"section\">" +
        "<div class=\"flex items-center justify-between mb-3\"><div class=\"section-title mb-0\">Active Calls</div><a href=\"/calls\" class=\"text-[11px] text-[#a78bfa] hover:underline\">Calls</a></div>" +
        "<div id=\"overview-active-calls\" hx-get=\"/partials/active-calls\" hx-include=\"#overview-agent\" hx-trigger=\"every 3s\" hx-swap=\"innerHTML\">" +
        active_calls_panel() + "</div></div>"

    notifications := "<div class=\"section mb-0\">" +
        "<div class=\"flex items-center justify-between mb-3\"><div class=\"section-title mb-0\">Notifications</div><span class=\"text-[10px] text-[#52525b]\">bottom dock</span></div>" +
        "<div id=\"bottom-notifications\" hx-get=\"/partials/notifications\" hx-trigger=\"load, every 20s\" hx-swap=\"innerHTML\">" +
        "<div class=\"card p-4 text-sm text-[#71717a]\">Checking notifications...</div></div></div>"

    "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
    "<div><h1 class=\"text-2xl font-bold\">Overview</h1><p class=\"text-sm text-[#71717a] mt-1\">Live SIP/HEP operations, site history, capture health, and notifications.</p></div>" +
    "<div class=\"flex items-center gap-3\"><select id=\"overview-agent\" name=\"agent\" class=\"rounded-md bg-[#0a0a0c] border border-[#27272a] px-2 py-1 text-xs\" onchange=\"htmx.ajax('GET','/partials/overview-realtime',{target:'#overview-realtime',swap:'innerHTML',values:{agent:this.value}});htmx.ajax('GET','/partials/active-calls',{target:'#overview-active-calls',swap:'innerHTML',values:{agent:this.value}})\">" + node_opts + "</select><div class=\"text-[10px] text-[#3f3f46] mono\">uptime " + ("" + (up_s)) + "s</div></div></div>" +
    "<div id=\"overview-realtime\" hx-get=\"/partials/overview-realtime\" hx-include=\"#overview-agent\" hx-trigger=\"every 5s\" hx-swap=\"innerHTML\">" + overview_realtime_panel() + "</div>" +
    "<div class=\"grid xl:grid-cols-[1.2fr_.8fr] gap-4 mb-5\">" + nodes_panel + "<div class=\"space-y-4\">" + method_mix + quick + "</div></div>" +
    "<div class=\"grid xl:grid-cols-[1fr_360px] gap-4 mb-5\">" + live + sites_panel + "</div>" +
    active_overview +
    traffic + notifications
}

// Collect unique endpoints from messages, return as JSON-encoded list string
fn ladder_endpoints(items) {
    // Gather unique src/dst, preserve order of first appearance
    mut seen := ""
    mut out := "["
    mut first := true
    for m in items {
        src := m["src"] ?? ""
        dst := m["dst"] ?? ""
        if src != "" && !str.contains(seen, "|" + src + "|") {
            seen = seen + "|" + src + "|"
            if !first { out = out + "," }
            out = out + "\"" + src + "\""
            first = false
        }
        if dst != "" && !str.contains(seen, "|" + dst + "|") {
            seen = seen + "|" + dst + "|"
            if !first { out = out + "," }
            out = out + "\"" + dst + "\""
            first = false
        }
    }
    r := json.parse(out + "]")
    if r.ok { r.value } else { [] }
}

fn endpoint_index(endpoints, addr) {
    mut i := 0
    while i < len(endpoints) {
        if endpoints[i] == addr { return i }
        i = i + 1
    }
    0
}

fn call_state_summary(items) {
    mut invite_seen := false
    mut bye_seen := false
    mut cancel_seen := false
    mut last_status := 0
    mut last_method := ""
    mut first_ts := 0
    mut last_ts := 0
    mut requests := 0
    mut responses := 0
    for m in items {
        if !is_call_message(m) { continue }
        kind := m["kind"] ?? ""
        method := m["method"] ?? ""
        status := m["status"] ?? 0
        ts_ms := m["ts_ms"] ?? 0
        if kind == "response" { responses = responses + 1 } else { requests = requests + 1 }
        if method == "INVITE" { invite_seen = true }
        if method == "BYE" { bye_seen = true }
        if method == "CANCEL" { cancel_seen = true }
        if first_ts == 0 || ts_ms < first_ts { first_ts = ts_ms }
        if ts_ms > last_ts {
            last_ts = ts_ms
            last_status = status
            last_method = method
        }
    }
    mut state := "active"
    if bye_seen { state = "ended" }
    else if cancel_seen { state = "canceled" }
    else if invite_seen { state = "ringing" }
    duration := if first_ts > 0 && last_ts > first_ts { (last_ts - first_ts) / 1000 } else { 0 }
    {"state": state, "duration": duration, "requests": requests, "responses": responses, "last_status": last_status, "last_method": last_method, "last_ts": last_ts}
}

fn call_fact(label, value, sub, color) {
    "<div class=\"rounded-md border border-[#1e1e22] bg-[#0a0a0c] p-3 min-h-[82px]\">" +
    "<div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold\">" + h(label) + "</div>" +
    "<div class=\"text-xl font-bold mono mt-1\" style=\"color:" + color + "\">" + h(value) + "</div>" +
    "<div class=\"text-[10px] text-[#71717a] mt-1 leading-snug\">" + h(sub) + "</div></div>"
}

fn per_second_label(count, seconds) {
    if seconds <= 0 { return "0.00" }
    v := count * 100 / seconds
    whole := v / 100
    frac := v % 100
    if frac < 10 {
        return ("" + (whole)) + ".0" + ("" + (frac))
    }
    ("" + (whole)) + "." + ("" + (frac))
}

fn time_filter_fields(prefix, since_ms, until_ms, inp) {
    p := h(prefix)
    "<input type=\"hidden\" name=\"since_ms\" id=\"" + p + "-since-ms\" value=\"" + h(since_ms) + "\"/>" +
    "<input type=\"hidden\" name=\"until_ms\" id=\"" + p + "-until-ms\" value=\"" + h(until_ms) + "\"/>" +
    "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">From date/time</label>" +
    "<input type=\"datetime-local\" id=\"" + p + "-since\" data-ms=\"" + h(since_ms) + "\" class=\"w-full " + inp + "\"/></div>" +
    "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">To date/time</label>" +
    "<input type=\"datetime-local\" id=\"" + p + "-until\" data-ms=\"" + h(until_ms) + "\" class=\"w-full " + inp + "\"/></div>" +
    "<script>(function(){var p='" + p + "';function init(k){var d=document.getElementById(p+'-'+k),h=document.getElementById(p+'-'+k+'-ms');if(!d||!h)return;var ms=parseInt(d.dataset.ms||h.value||'0',10);if(ms>0){var x=new Date(ms);x.setMinutes(x.getMinutes()-x.getTimezoneOffset());d.value=x.toISOString().slice(0,16)}d.form&&d.form.addEventListener('submit',function(){h.value=d.value?String(new Date(d.value).getTime()):''})}init('since');init('until')})();</script>"
}

fn range_since_ms(range) {
    now := time.unix() * 1000
    if range == "5m" { return "" + (now - 5 * 60 * 1000) }
    if range == "1h" { return "" + (now - 60 * 60 * 1000) }
    if range == "24h" { return "" + (now - 24 * 60 * 60 * 1000) }
    if range == "7d" { return "" + (now - 7 * 24 * 60 * 60 * 1000) }
    ""
}

fn range_tabs(base, current) {
    mut out := "<div class=\"flex flex-wrap gap-2\">"
    for r in ["5m", "1h", "24h", "7d"] {
        cls := if current == r { "bg-[#27272a] text-[#e4e4e7]" } else { "text-[#a1a1aa]" }
        out = out + "<a href=\"" + base + (if str.contains(base, "?") { "&" } else { "?" }) + "range=" + r + "\" class=\"rounded-md border border-[#27272a] px-2.5 py-1 text-xs " + cls + "\">" + r + "</a>"
    }
    out + "</div>"
}

fn report_status_rows(items) {
    mut statuses := []
    for m in items {
        st := m["status"] ?? 0
        if st <= 0 { continue }
        key := "" + (st)
        mut seen := false
        for s in statuses {
            if s == key { seen = true }
        }
        if !seen { statuses = list_append(statuses, key) }
    }
    mut rows := ""
    mut used := []
    mut rank := 0
    while rank < len(statuses) {
        mut best := ""
        mut best_count := 0
        for st_key in statuses {
            mut already := false
            for u in used {
                if u == st_key { already = true }
            }
            if already { continue }
            mut count := 0
            for m in items {
                if ("" + (m["status"] ?? 0)) == st_key { count = count + 1 }
            }
            if count > best_count {
                best = st_key
                best_count = count
            }
        }
        if best == "" { break }
        used = list_append(used, best)
        st_i := int.parse(best).unwrap_or(0)
        cls := if st_i == 408 { "text-[#f87171] font-semibold" } else if st_i >= 500 { "text-[#f87171]" } else if st_i >= 400 { "text-[#fb923c]" } else if st_i >= 200 && st_i < 300 { "text-[#34d399]" } else { "text-[#fbbf24]" }
        rows = rows + "<tr><td class=\"py-2 px-3 mono text-sm " + cls + "\"><a class=\"hover:underline\" href=\"/status/" + h(best) + "?range=1h\">" + h(best) + "</a></td>" +
            "<td class=\"py-2 px-3 mono text-sm text-right\">" + ("" + (best_count)) + "</td></tr>"
        rank = rank + 1
    }
    if rows == "" { rows = "<tr><td colspan=\"2\" class=\"py-6 text-center text-[#71717a] text-sm\">No response codes in this result.</td></tr>" }
    rows
}

fn report_endpoint_rows(items, field, max_rows) {
    labels := load_site_labels()
    mut keys := []
    for m in items {
        ep := m[field] ?? ""
        if ep == "" { continue }
        ip := endpoint_ip(ep)
        if ip == "" { continue }
        mut seen := false
        for k in keys {
            if k == ip { seen = true }
        }
        if !seen { keys = list_append(keys, ip) }
    }
    mut rows := ""
    mut used := []
    mut rank := 0
    while rank < max_rows && rank < len(keys) {
        mut best := ""
        mut best_count := 0
        for ip in keys {
            mut already := false
            for u in used {
                if u == ip { already = true }
            }
            if already { continue }
            mut count := 0
            for m in items {
                ep := m[field] ?? ""
                if endpoint_ip(ep) == ip { count = count + 1 }
            }
            if count > best_count {
                best = ip
                best_count = count
            }
        }
        if best == "" { break }
        used = list_append(used, best)
        label := labels[best]
        name := if label != null && label != "" { h(label) } else { h(best) }
        rows = rows + "<tr><td class=\"py-2 px-3 text-sm\"><a class=\"hover:underline text-[#a78bfa]\" href=\"/ip?addr=" + h(best) + "\">" + name + "</a><div class=\"mono text-[10px] text-[#52525b]\">" + h(best) + "</div></td>" +
            "<td class=\"py-2 px-3 mono text-sm text-right\">" + ("" + (best_count)) + "</td></tr>"
        rank = rank + 1
    }
    if rows == "" { rows = "<tr><td colspan=\"2\" class=\"py-6 text-center text-[#71717a] text-sm\">No endpoints in this result.</td></tr>" }
    rows
}

fn report_origin_rows(items, max_rows) {
    labels := load_site_labels()
    mut keys := []
    mut calls := []
    for m in items {
        call_id := m["call_id"] ?? ""
        if call_id == "" { continue }
        ip := call_origin_ip(call_id, items)
        if ip == "" { continue }
        mut seen_ip := false
        for k in keys {
            if k == ip { seen_ip = true }
        }
        if !seen_ip { keys = list_append(keys, ip) }
        call_key := ip + "|" + call_id
        mut seen_call := false
        for c in calls {
            if c == call_key { seen_call = true }
        }
        if !seen_call { calls = list_append(calls, call_key) }
    }
    mut rows := ""
    mut used := []
    mut rank := 0
    while rank < max_rows && rank < len(keys) {
        mut best := ""
        mut best_count := 0
        for ip in keys {
            mut already := false
            for u in used {
                if u == ip { already = true }
            }
            if already { continue }
            mut count := 0
            for c in calls {
                cparts := str.split(c, "|")
                if len(cparts) > 0 && cparts[0] == ip { count = count + 1 }
            }
            if count > best_count {
                best = ip
                best_count = count
            }
        }
        if best == "" { break }
        used = list_append(used, best)
        label := labels[best]
        name := if label != null && label != "" { h(label) } else { h(best) }
        rows = rows + "<tr><td class=\"py-2 px-3 text-sm\"><a class=\"hover:underline text-[#a78bfa]\" href=\"/ip?addr=" + h(best) + "\">" + name + "</a><div class=\"mono text-[10px] text-[#52525b]\">" + h(best) + "</div></td>" +
            "<td class=\"py-2 px-3 mono text-sm text-right\">" + ("" + (best_count)) + "</td></tr>"
        rank = rank + 1
    }
    if rows == "" { rows = "<tr><td colspan=\"2\" class=\"py-6 text-center text-[#71717a] text-sm\">No call origins in this result.</td></tr>" }
    rows
}

fn report_route_rows(items, max_rows) {
    labels := load_site_labels()
    mut routes := []
    for m in items {
        src := endpoint_ip(m["src"] ?? "")
        dst := endpoint_ip(m["dst"] ?? "")
        if src == "" || dst == "" { continue }
        route := src + ">" + dst
        mut seen := false
        for r in routes {
            if r == route { seen = true }
        }
        if !seen { routes = list_append(routes, route) }
    }
    mut rows := ""
    mut used := []
    mut rank := 0
    while rank < max_rows && rank < len(routes) {
        mut best := ""
        mut best_count := 0
        for route in routes {
            mut already := false
            for u in used {
                if u == route { already = true }
            }
            if already { continue }
            mut count := 0
            for m in items {
                src := endpoint_ip(m["src"] ?? "")
                dst := endpoint_ip(m["dst"] ?? "")
                if src + ">" + dst == route { count = count + 1 }
            }
            if count > best_count {
                best = route
                best_count = count
            }
        }
        if best == "" { break }
        used = list_append(used, best)
        parts := str.split(best, ">")
        src_ip := parts[0]
        dst_ip := if len(parts) > 1 { parts[1] } else { "" }
        src_label := labels[src_ip]
        dst_label := labels[dst_ip]
        src_name := if src_label != null && src_label != "" { h(src_label) } else { h(src_ip) }
        dst_name := if dst_label != null && dst_label != "" { h(dst_label) } else { h(dst_ip) }
        rows = rows + "<tr><td class=\"py-2 px-3 text-sm\"><div class=\"flex flex-wrap items-center gap-2\">" +
            "<a class=\"text-[#a78bfa] hover:underline\" href=\"/ip?addr=" + h(src_ip) + "\">" + src_name + "</a>" +
            "<span class=\"text-[#52525b]\">-&gt;</span>" +
            "<a class=\"text-[#a78bfa] hover:underline\" href=\"/ip?addr=" + h(dst_ip) + "\">" + dst_name + "</a></div>" +
            "<div class=\"mono text-[10px] text-[#52525b]\">" + h(src_ip) + " -> " + h(dst_ip) + "</div></td>" +
            "<td class=\"py-2 px-3 mono text-sm text-right\">" + ("" + (best_count)) + "</td></tr>"
        rank = rank + 1
    }
    if rows == "" { rows = "<tr><td colspan=\"2\" class=\"py-6 text-center text-[#71717a] text-sm\">No source-to-destination routes in this result.</td></tr>" }
    rows
}

fn ip_peer_rows(items, addr, max_rows) {
    labels := load_site_labels()
    mut peers := []
    for m in items {
        src := endpoint_ip(m["src"] ?? "")
        dst := endpoint_ip(m["dst"] ?? "")
        mut peer := ""
        if src == addr && dst != "" {
            peer = dst
        } else if dst == addr && src != "" {
            peer = src
        }
        if peer == "" { continue }
        mut seen := false
        for p in peers {
            if p == peer { seen = true }
        }
        if !seen { peers = list_append(peers, peer) }
    }
    mut rows := ""
    mut used := []
    mut rank := 0
    while rank < max_rows && rank < len(peers) {
        mut best := ""
        mut best_total := 0
        mut best_in := 0
        mut best_out := 0
        mut best_errors := 0
        for peer in peers {
            mut already := false
            for u in used {
                if u == peer { already = true }
            }
            if already { continue }
            mut total := 0
            mut inbound := 0
            mut outbound := 0
            mut errors := 0
            for m in items {
                src := endpoint_ip(m["src"] ?? "")
                dst := endpoint_ip(m["dst"] ?? "")
                if src == peer && dst == addr {
                    inbound = inbound + 1
                    total = total + 1
                } else if src == addr && dst == peer {
                    outbound = outbound + 1
                    total = total + 1
                }
                if (src == peer && dst == addr) || (src == addr && dst == peer) {
                    st := m["status"] ?? 0
                    if st >= 400 { errors = errors + 1 }
                }
            }
            if total > best_total {
                best = peer
                best_total = total
                best_in = inbound
                best_out = outbound
                best_errors = errors
            }
        }
        if best == "" { break }
        used = list_append(used, best)
        label := labels[best]
        name := if label != null && label != "" { h(label) } else { h(best) }
        rows = rows + "<tr><td class=\"py-2 px-3\"><a class=\"text-[#a78bfa] hover:underline\" href=\"/ip?addr=" + h(best) + "\">" + name + "</a><div class=\"mono text-[10px] text-[#52525b]\">" + h(best) + "</div></td>" +
            "<td class=\"py-2 px-3 mono text-right\">" + ("" + (best_total)) + "</td>" +
            "<td class=\"py-2 px-3 mono text-right text-[#38bdf8]\">" + ("" + (best_in)) + "</td>" +
            "<td class=\"py-2 px-3 mono text-right text-[#a78bfa]\">" + ("" + (best_out)) + "</td>" +
            "<td class=\"py-2 px-3 mono text-right " + (if best_errors > 0 { "text-[#f87171]" } else { "text-[#71717a]" }) + "\">" + ("" + (best_errors)) + "</td></tr>"
        rank = rank + 1
    }
    if rows == "" { rows = "<tr><td colspan=\"5\" class=\"py-6 text-center text-[#71717a] text-sm\">No peers found for this IP.</td></tr>" }
    rows
}

fn ip_history_panel(addr) {
    ip_history_panel_time(addr, "", "")
}

fn ip_history_panel_time(addr, since_ms, until_ms) {
    addr_h := h(addr)
    since_h := h(since_ms)
    until_h := h(until_ms)
    time_qs := (if since_ms != "" { "&since_ms=" + since_h } else { "" }) + (if until_ms != "" { "&until_ms=" + until_h } else { "" })
    items := fetch_messages_time(300, "", "", "", "", addr, "", "", "", since_ms, until_ms)
    th := "text-[10px] uppercase tracking-wider text-[#52525b] font-semibold"
    mut call_ids := []
    for m in items {
        cid := m["call_id"] ?? ""
        if cid == "" { continue }
        mut seen := false
        for existing in call_ids {
            if existing == cid { seen = true }
        }
        if !seen { call_ids = list_append(call_ids, cid) }
    }
    mut invites := 0
    mut answered := 0
    mut failed := 0
    mut ended := 0
    mut duration_total := 0
    for cid in call_ids {
        mut has_invite := false
        mut has_answer := false
        mut has_fail := false
        mut has_end := false
        mut first_ts := 0
        mut last_ts := 0
        for m in items {
            if (m["call_id"] ?? "") != cid { continue }
            method := call_method_from_cseq(m["method"] ?? "", m["cseq"] ?? "")
            kind := m["kind"] ?? ""
            status := m["status"] ?? 0
            ts_ms := m["ts_ms"] ?? 0
            if first_ts == 0 || (ts_ms > 0 && ts_ms < first_ts) { first_ts = ts_ms }
            if ts_ms > last_ts { last_ts = ts_ms }
            if method == "INVITE" && kind == "request" { has_invite = true }
            if status >= 200 && status < 300 { has_answer = true }
            if status >= 400 { has_fail = true }
            if method == "BYE" || method == "CANCEL" { has_end = true }
        }
        if has_invite { invites = invites + 1 }
        if has_answer { answered = answered + 1 }
        if has_fail { failed = failed + 1 }
        if has_end && first_ts > 0 && last_ts > first_ts {
            ended = ended + 1
            duration_total = duration_total + ((last_ts - first_ts) / 1000)
        }
    }
    asr := if invites > 0 { answered * 100 / invites } else { 0 }
    acd := if ended > 0 { duration_total / ended } else { 0 }
    ip_kpis := "<div class=\"card p-4 mb-5\"><div class=\"flex flex-wrap items-center justify-between gap-3 mb-3\"><div><div class=\"section-title mb-0\">IP Call KPIs</div><div class=\"text-[11px] text-[#71717a] mt-1\">Calculated from the selected IP/time range.</div></div><div class=\"text-[10px] text-[#52525b] mono\">" + ("" + (len(items))) + " messages sampled</div></div>" +
        "<div class=\"grid grid-cols-2 md:grid-cols-5 gap-3\">" +
        call_fact("Call-IDs", "" + (len(call_ids)), "unique dialogs", "#38bdf8") +
        call_fact("INVITEs", "" + (invites), "call attempts", "#fbbf24") +
        call_fact("ASR", "" + (asr) + "%", "answered calls", if asr >= 70 { "#34d399" } else if asr >= 40 { "#fbbf24" } else { "#f87171" }) +
        call_fact("ACD", "" + (acd) + "s", "avg completed duration", "#a78bfa") +
        call_fact("Failed", "" + (failed), "status >= 400", if failed == 0 { "#34d399" } else { "#f87171" }) +
        "</div></div>"
    ip_kpis +
    "<div class=\"grid xl:grid-cols-[1.2fr_.8fr] gap-4 mb-5\">" +
    "<div class=\"card overflow-x-auto\"><div class=\"p-4 border-b border-[#1e1e22]\"><div class=\"section-title mb-0\">Peer IPs</div><div class=\"text-[11px] text-[#71717a] mt-1\">Endpoints exchanging traffic with this IP.</div></div>" +
    "<table class=\"w-full text-left text-sm\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\"><th class=\"py-2 px-3\">Peer</th><th class=\"py-2 px-3 text-right\">Msgs</th><th class=\"py-2 px-3 text-right\">In</th><th class=\"py-2 px-3 text-right\">Out</th><th class=\"py-2 px-3 text-right\">Errors</th></tr></thead><tbody class=\"divide-y divide-[#1e1e22]/50\">" + ip_peer_rows(items, addr, 12) + "</tbody></table></div>" +
    "<div class=\"card overflow-x-auto\"><div class=\"p-4 border-b border-[#1e1e22]\"><div class=\"section-title mb-0\">Response Codes</div><div class=\"text-[11px] text-[#71717a] mt-1\">Status mix involving this IP.</div></div>" +
    "<table class=\"w-full text-left text-sm\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\"><th class=\"py-2 px-3\">Status</th><th class=\"py-2 px-3 text-right\">Count</th></tr></thead><tbody class=\"divide-y divide-[#1e1e22]/50\">" + report_status_rows(items) + "</tbody></table></div></div>" +
    "<div class=\"section\"><div class=\"flex items-center justify-between mb-3\"><div class=\"section-title mb-0\">Observed Paths</div><div class=\"text-[10px] text-[#52525b] mono\">source -&gt; destination</div></div>" +
    "<div class=\"card overflow-x-auto\"><table class=\"w-full text-left text-sm\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\"><th class=\"py-2 px-3\">Path</th><th class=\"py-2 px-3 text-right\">Msgs</th></tr></thead><tbody class=\"divide-y divide-[#1e1e22]/50\">" + report_route_rows(items, 12) + "</tbody></table></div></div>" +
    "<div class=\"section\"><div class=\"flex items-center justify-between mb-3\"><div class=\"section-title mb-0\">Calls Involving This IP</div><a href=\"/messages?ip=" + addr_h + time_qs + "\" class=\"text-[11px] text-[#a78bfa] hover:underline\">Open messages</a></div>" + call_groups_table(items) + "</div>" +
    "<div class=\"section\"><div class=\"flex items-center justify-between mb-3\"><div class=\"section-title mb-0\">Recent Messages</div><a href=\"/report?ip=" + addr_h + "&view=messages" + time_qs + "\" class=\"text-[11px] text-[#a78bfa] hover:underline\">Build report</a></div>" + messages_table(items) + "</div>"
}

fn call_summary_panel(call_id, items) {
    labels := load_site_labels()
    endpoints := ladder_endpoints(items)
    s := call_state_summary(items)
    state := s["state"] ?? "active"
    origin_ip := call_origin_ip(call_id, items)
    origin_label := if origin_ip != "" { origin_ip } else { "unknown" }
    state_cls := if state == "ended" { "text-[#a1a1aa] border-[#27272a] bg-[#18181b]" } else if state == "canceled" { "text-[#f87171] border-[rgba(248,113,113,.25)] bg-[rgba(248,113,113,.08)]" } else if state == "ringing" { "text-[#fbbf24] border-[rgba(251,191,36,.25)] bg-[rgba(251,191,36,.08)]" } else { "text-[#34d399] border-[rgba(52,211,153,.25)] bg-[rgba(52,211,153,.08)]" }
    mut ep_rows := ""
    for ep in endpoints {
        ip := endpoint_ip(ep)
        ep_rows = ep_rows + "<a href=\"/ip?addr=" + h(ip) + "\" class=\"rounded-md border border-[#27272a] bg-[#0a0a0c] px-2 py-1 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">" + endpoint_display(ep, labels) + "</a>"
    }
    if ep_rows == "" { ep_rows = "<span class=\"text-xs text-[#71717a]\">No endpoints found</span>" }
    last_label := if (s["last_status"] ?? 0) > 0 { "" + (s["last_status"]) } else { s["last_method"] ?? "" }
    "<div class=\"card p-4 mb-5\">" +
    "<div class=\"flex flex-wrap items-start justify-between gap-4 mb-4\">" +
    "<div><div class=\"text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Selected Call-ID</div><div class=\"mono text-sm break-all\">" + h(call_id) + "</div></div>" +
    "<span class=\"rounded-full border px-2.5 py-1 text-xs font-semibold " + state_cls + "\">" + h(state) + "</span></div>" +
    "<div class=\"grid grid-cols-2 md:grid-cols-6 gap-3 mb-4\">" +
    call_fact("Messages", "" + (len(items)), "captured packets", "#e4e4e7") +
    call_fact("Origin IP", origin_label, "caller/site source", "#38bdf8") +
    call_fact("Duration", "" + (s["duration"] ?? 0) + "s", "first to last seen", "#38bdf8") +
    call_fact("Requests", "" + (s["requests"] ?? 0), "SIP requests", "#a78bfa") +
    call_fact("Responses", "" + (s["responses"] ?? 0), "SIP responses", "#34d399") +
    call_fact("Last seen", time_ago((s["last_ts"] ?? 0) / 1000), "last event " + last_label, "#fbbf24") +
    "</div>" +
    "<div class=\"flex flex-wrap gap-2 mb-4\">" + ep_rows + "</div>" +
    "<div class=\"flex flex-wrap gap-2\">" +
    "<a href=\"/messages?call_id=" + q(call_id) + "\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">Messages</a>" +
    "<a href=\"/pcap?call_id=" + q(call_id) + "\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">PCAP</a>" +
    "<button onclick=\"navigator.clipboard.writeText(window.location.href).then(()=>this.textContent='Copied')\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">Copy URL</button>" +
    "</div></div>"
}

fn calls_recent_list(tops, selected, compact) {
    mut rows := ""
    for row in tops {
        rc := row["call_id"] ?? ""
        if rc != "" {
            rc_h := h(rc)
            cnt := row["messages"] ?? 0
            t1 := row["last_seen"] ?? row["t1"] ?? 0
            sel := if rc == selected { " border-[#a78bfa]/50 bg-[rgba(167,139,250,.08)]" } else { " border-[#27272a] bg-[#0a0a0c] hover:border-[#3f3f46]" }
            rows = rows + "<a " + ladder_nav_attrs(rc) + " class=\"block rounded-md border " + sel + " p-3 transition-colors\">" +
                "<div class=\"mono text-xs truncate text-[#e4e4e7]\">" + rc_h + "</div>" +
                "<div class=\"mt-2 flex items-center justify-between text-[11px] text-[#71717a]\"><span><span class=\"mono text-[#a1a1aa]\">" + ("" + (cnt)) + "</span> messages</span><span>" + time_ago(t1 / 1000) + "</span></div></a>"
        }
    }
    if rows == "" { rows = "<div class=\"rounded-md border border-[#27272a] bg-[#0a0a0c] p-5 text-sm text-[#71717a]\">No recent calls found.</div>" }
    if compact { "<div class=\"space-y-2\">" + rows + "</div>" } else { "<div class=\"grid md:grid-cols-2 xl:grid-cols-3 gap-3\">" + rows + "</div>" }
}

fn call_messages_only(items) {
    mut out := []
    for m in items {
        if is_call_message(m) { out = list_append(out, m) }
    }
    out
}

fn call_media_panel(call_id, all_items, sip_count) {
    mut rtcp_count := 0
    mut rtp_count := 0
    mut media_sources := ""
    mut raw_media := 0
    for m in all_items {
        proto := m["proto"] ?? ""
        if proto == "rtcp" || proto == "rtcpxr" {
            rtcp_count = rtcp_count + 1
        }
        if proto == "rtp" || proto == "rtpagent" {
            rtp_count = rtp_count + 1
        }
        if proto == "rtcp" || proto == "rtcpxr" || proto == "rtp" || proto == "rtpagent" {
            if (m["raw_b64"] ?? "") != "" { raw_media = raw_media + 1 }
            src := endpoint_ip(m["src"] ?? "")
            dst := endpoint_ip(m["dst"] ?? "")
            if src != "" && !str.contains(media_sources, "|" + src + "|") { media_sources = media_sources + "|" + src + "|" }
            if dst != "" && !str.contains(media_sources, "|" + dst + "|") { media_sources = media_sources + "|" + dst + "|" }
        }
    }
    has_audio := has_recording(call_id)
    media_state := if has_audio { "playable recording" } else if rtcp_count + rtp_count > 0 { "media telemetry found" } else { "signaling only" }
    media_color := if has_audio { "#34d399" } else if rtcp_count + rtp_count > 0 { "#fbbf24" } else { "#71717a" }
    audio_note := if has_audio { "Audio player is available below." } else if rtcp_count + rtp_count > 0 { "HEP contains RTP/RTCP metadata or payload records, but no assembled WAV recording is stored yet." } else { "No RTP/RTCP or uploaded call recording is stored for this Call-ID." }
    "<div class=\"card p-4 mb-5\">" +
    "<div class=\"flex flex-wrap items-start justify-between gap-3 mb-3\">" +
    "<div><div class=\"section-title mb-1\">Media &amp; Exports</div><div class=\"text-xs text-[#71717a]\">SIP PCAP is always built from captured signaling. Audio requires RTP/RTCP capture or an uploaded recording.</div></div>" +
    "<span class=\"rounded-full border border-[#27272a] px-2.5 py-1 text-xs font-semibold\" style=\"color:" + media_color + "\">" + h(media_state) + "</span></div>" +
    "<div class=\"grid grid-cols-2 md:grid-cols-4 gap-3 mb-3\">" +
    call_fact("SIP packets", "" + (sip_count), "included in PCAP", "#a78bfa") +
    call_fact("RTCP records", "" + (rtcp_count), "QoS/media reports", if rtcp_count > 0 { "#fbbf24" } else { "#71717a" }) +
    call_fact("RTP records", "" + (rtp_count), "media payload hints", if rtp_count > 0 { "#fbbf24" } else { "#71717a" }) +
    call_fact("Recording", if has_audio { "yes" } else { "no" }, audio_note, media_color) +
    "</div>" +
    "<div class=\"flex flex-wrap gap-2\">" +
    "<a href=\"/pcap?call_id=" + q(call_id) + "\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">Download SIP PCAP</a>" +
    "<a href=\"/messages?call_id=" + q(call_id) + "\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">All HEP records</a>" +
    (if has_audio { "<a href=\"/recordings/" + h(sanitize_cid(call_id)) + "\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">Download audio</a>" } else { "" }) +
    "</div></div>"
}

fn live_calls_panel() {
    rt := fetch_realtime(1)
    rt5 := fetch_realtime(5)
    items := call_messages_only(fetch_messages_ex(120, "", "", "", "", "", "", "", ""))
    cps := per_second_label(rt["invites"] ?? 0, 60)
    msgps := per_second_label(rt["total"] ?? 0, 60)
    err := (rt5["resp_4xx"] ?? 0) + (rt5["resp_5xx"] ?? 0)
    "<div class=\"card p-4 mb-5\">" +
    "<div class=\"flex flex-wrap items-center justify-between gap-3 mb-3\">" +
    "<div><div class=\"section-title mb-1\">Realtime Calls</div><div class=\"text-xs text-[#71717a]\">Live call attempts, concurrency, failures, and recent dialogs. Refreshes every 5 seconds.</div></div>" +
    "<span class=\"flex items-center gap-1.5 text-[10px] text-[#34d399]\"><span class=\"w-1.5 h-1.5 rounded-full bg-[#34d399] animate-pulse\"></span>live</span></div>" +
    "<div class=\"grid grid-cols-2 md:grid-cols-5 gap-3 mb-4\">" +
    call_fact("CPS", cps, "INVITE/s, last 1m", "#34d399") +
    call_fact("Concurrent", "" + (rt["active_calls"] ?? 0), "open dialogs in the live window", "#f472b6") +
    call_fact("Attempts", "" + (rt5["invites"] ?? 0), "INVITEs, last 5m", "#fbbf24") +
    call_fact("Message rate", msgps + "/s", "all captures, last 1m", "#38bdf8") +
    call_fact("Failures", "" + (err), "4xx/5xx, last 5m", if err > 0 { "#f87171" } else { "#34d399" }) +
    "</div>" + call_groups_table(items) + "</div>"
}

fn live_feed_panel() {
    items := fetch_messages(12, "")
    "<div id=\"sip-ladder\" class=\"card overflow-hidden scroll-mt-6\">" +
    "<div class=\"flex items-center justify-between gap-3 px-4 py-3 border-b border-[#1e1e22]\">" +
    "<div><div class=\"text-sm font-semibold\">Recent SIP/HEP Events</div><div class=\"text-[11px] text-[#71717a]\">Newest messages first, refreshed every 2 seconds.</div></div>" +
    "<span class=\"flex items-center gap-1.5 text-[10px] text-[#34d399]\"><span class=\"w-1.5 h-1.5 rounded-full bg-[#34d399] animate-pulse\"></span>live</span></div>" +
    messages_table(items) + "</div>"
}

fn dashboard_live_feed_row(m, labels) {
    id := m["id"] ?? 0
    method := call_method_from_cseq(m["method"] ?? "", m["cseq"] ?? "")
    status := m["status"] ?? 0
    kind := m["kind"] ?? ""
    call_id := m["call_id"] ?? ""
    src := m["src"] ?? ""
    dst := m["dst"] ?? ""
    ts_ms := m["ts_ms"] ?? 0
    ts_sec := if ts_ms > 0 { ts_ms / 1000 } else { 0 }
    src_ip := endpoint_ip(src)
    dst_ip := endpoint_ip(dst)
    call_href := if call_id != "" { "/ladder?call_id=" + q(call_id) } else { "/messages/" + ("" + (id)) }
    "<tr class=\"hover:bg-white/[0.02]\">" +
    "<td class=\"py-2 px-3\">" + method_badge(method, status, kind) + "</td>" +
    "<td class=\"py-2 px-3 mono text-xs max-w-[22rem] truncate\" title=\"" + h(call_id) + "\"><a class=\"text-[#a78bfa] hover:underline\" href=\"" + call_href + "\">" + h(call_id) + "</a></td>" +
    "<td class=\"py-2 px-3 text-xs text-[#a1a1aa] max-w-[12rem] truncate hide-mobile\" title=\"" + h(src) + "\"><a class=\"hover:text-[#e4e4e7] hover:underline\" href=\"/ip?addr=" + h(src_ip) + "\">" + endpoint_display(src, labels) + "</a></td>" +
    "<td class=\"py-2 px-3 text-xs text-[#a1a1aa] max-w-[12rem] truncate hide-mobile\" title=\"" + h(dst) + "\">" + (if dst != "" { "<a class=\"hover:text-[#e4e4e7] hover:underline\" href=\"/ip?addr=" + h(dst_ip) + "\">" + endpoint_display(dst, labels) + "</a>" } else { "<span class=\"text-[#52525b]\">unknown</span>" }) + "</td>" +
    "<td class=\"py-2 px-3 text-[10px] text-[#52525b] hide-mobile\">" + time_ago(ts_sec) + "</td>" +
    "<td class=\"py-2 px-3 text-xs\"><a class=\"text-[#a78bfa] hover:underline\" href=\"" + call_href + "\">full call</a> · <a class=\"text-[#a78bfa] hover:underline\" href=\"/messages/" + ("" + (id)) + "\">msg</a></td></tr>"
}

fn dashboard_live_feed_table(items) {
    labels := load_site_labels()
    mut rows := ""
    for m in items {
        rows = rows + dashboard_live_feed_row(m, labels)
    }
    if rows == "" {
        rows = "<tr><td colspan=\"6\" class=\"py-8 text-center text-[#a1a1aa] text-sm\">No matching live SIP/HEP events in the current sample.</td></tr>"
    }
    "<div class=\"overflow-x-auto\"><table class=\"w-full text-left text-sm\"><thead><tr class=\"text-[11px] uppercase tracking-wide text-[#a1a1aa] border-b border-[#1e1e22]\">" +
    "<th class=\"py-2 px-3 font-semibold\">Method</th><th class=\"py-2 px-3 font-semibold\">Call-ID</th><th class=\"py-2 px-3 font-semibold hide-mobile\">Source IP</th><th class=\"py-2 px-3 font-semibold hide-mobile\">Destination IP</th><th class=\"py-2 px-3 font-semibold hide-mobile\">Time</th><th class=\"py-2 px-3 font-semibold\"></th></tr></thead>" +
    "<tbody class=\"divide-y divide-[#27272a]\">" + rows + "</tbody></table></div>"
}

fn dashboard_live_feed_panel(method) {
    mut selected := method
    if selected == "" {
        selected = "INVITE"
    }
    items := fetch_messages_ex(12, "", "", "", selected, "", "", "", "")
    invite_cls := if selected == "INVITE" { "bg-[#27272a] text-[#e4e4e7]" } else { "text-[#a1a1aa]" }
    options_checked := if selected == "OPTIONS" { " checked" } else { "" }
    "<div id=\"sip-ladder\" class=\"card overflow-hidden scroll-mt-6\">" +
    "<div class=\"flex flex-wrap items-center justify-between gap-3 px-4 py-3 border-b border-[#1e1e22]\">" +
    "<div><div class=\"text-sm font-semibold\">Recent INVITE Traffic</div><div class=\"text-[11px] text-[#71717a]\">INVITEs are shown by default. Open a row to see the full SIP ladder for that Call-ID.</div></div>" +
    "<div class=\"flex items-center gap-3\">" +
    "<a hx-get=\"/partials/live-feed?method=INVITE\" hx-target=\"#live-msgs\" hx-swap=\"innerHTML\" class=\"cursor-pointer rounded-md border border-[#27272a] px-2.5 py-1 text-[11px] " + invite_cls + "\">INVITEs</a>" +
    "<label class=\"flex items-center gap-1.5 text-[11px] text-[#a1a1aa]\"><input type=\"checkbox\" class=\"accent-[#a78bfa]\" onchange=\"htmx.ajax('GET', this.checked ? '/partials/live-feed?method=OPTIONS' : '/partials/live-feed?method=INVITE', {target:'#live-msgs', swap:'innerHTML'})\"" + options_checked + "/> OPTIONS</label>" +
    "<span class=\"flex items-center gap-1.5 text-[10px] text-[#34d399]\"><span class=\"w-1.5 h-1.5 rounded-full bg-[#34d399] animate-pulse\"></span>live</span></div></div>" +
    dashboard_live_feed_table(items) + "</div>"
}

fn active_calls_panel_agent(agent) {
    active := fetch_active_calls_agent(100, agent)
    if len(active) == 0 {
        return "<div class=\"card p-5 text-sm text-[#71717a]\">No active calls currently detected.</div>"
    }
    call_groups_table(active)
}

fn active_calls_panel() {
    active_calls_panel_agent("")
}

fn ladder_html_from_items(call_id, all_items) {
    items := call_messages_only(all_items)
    // Reverse to chronological
    mut ordered := []
    mut i := len(items) - 1
    while i >= 0 {
        ordered = list_append(ordered, items[i])
        i = i - 1
    }
    if len(ordered) == 0 {
        return "<div class=\"card p-6\">" +
            "<p class=\"text-sm text-[#71717a]\">No messages for this Call-ID.</p></div>"
    }

    endpoints := ladder_endpoints(ordered)
    ncols := len(endpoints)
    if ncols == 0 { return "<p class=\"text-sm text-[#71717a]\">No endpoints found.</p>" }

    // Column width as percentage
    col_pct := if ncols > 0 { 100 / ncols } else { 50 }

    // Header: endpoint columns
    mut hdr := "<div class=\"flex border-b border-[#1e1e22] pb-3 mb-2\">"
    mut ci := 0
    while ci < ncols {
        ep := endpoints[ci]
        // Shorten display: just host or last segment
        hdr = hdr + "<div class=\"flex-1 text-center\">" +
            "<div class=\"inline-block rounded-lg bg-[#27272a] px-3 py-1.5 text-[11px] mono text-[#e4e4e7] font-medium\">" + h(ep) + "</div>" +
            "</div>"
        ci = ci + 1
    }
    hdr = hdr + "</div>"

    // Rows: one per message
    mut rows := ""
    mut table_rows := ""
    for m in ordered {
        id := m["id"] ?? 0
        src := m["src"] ?? ""
        dst := m["dst"] ?? ""
        kind := m["kind"] ?? ""
        method := m["method"] ?? ""
        status := m["status"] ?? 0
        cseq := m["cseq"] ?? ""
        display_method := call_method_from_cseq(method, cseq)
        transport := m["transport"] ?? ""
        msg_ts := m["ts_ms"] ?? 0
        msg_ts_sec := if msg_ts > 0 { msg_ts / 1000 } else { 0 }

        src_i := endpoint_index(endpoints, src)
        // If dst empty (native SIP capture), point to self
        dst_i := if dst != "" { endpoint_index(endpoints, dst) } else { src_i }

        left_i := if src_i < dst_i { src_i } else { dst_i }
        right_i := if src_i < dst_i { dst_i } else { src_i }
        going_right := src_i <= dst_i

        // Arrow label
        mut label := display_method
        if kind == "response" {
            label = ("" + (status)) + " " + display_method
        }

        // Arrow color
        mut arrow_cls := "border-[#a78bfa] text-[#a78bfa]"
        if kind == "response" {
            st := int.parse(status).unwrap_or(0)
            if st >= 200 && st < 300 {
                arrow_cls = "border-[#34d399] text-[#34d399]"
            } else if st >= 400 {
                arrow_cls = "border-[#f87171] text-[#f87171]"
            } else {
                arrow_cls = "border-[#fbbf24] text-[#fbbf24]"
            }
        } else if display_method == "INVITE" {
            arrow_cls = "border-[#c084fc] text-[#c084fc]"
        } else if display_method == "BYE" || display_method == "CANCEL" {
            arrow_cls = "border-[#f87171] text-[#f87171]"
        } else if display_method == "ACK" {
            arrow_cls = "border-[#71717a] text-[#71717a]"
        }

        table_rows = table_rows + "<tr class=\"hover:bg-white/[0.02]\">" +
            "<td class=\"py-2 px-3 mono text-[11px] text-[#71717a]\"><a class=\"text-[#a78bfa] hover:underline\" href=\"/messages/" + ("" + (id)) + "\">#" + ("" + (id)) + "</a></td>" +
            "<td class=\"py-2 px-3 text-xs\">" + method_badge(display_method, status, kind) + "</td>" +
            "<td class=\"py-2 px-3 mono text-xs text-[#a1a1aa] max-w-[14rem] truncate\" title=\"" + h(src) + "\">" + h(src) + "</td>" +
            "<td class=\"py-2 px-2 text-center text-[#71717a]\">&#8594;</td>" +
            "<td class=\"py-2 px-3 mono text-xs text-[#a1a1aa] max-w-[14rem] truncate\" title=\"" + h(dst) + "\">" + h(dst) + "</td>" +
            "<td class=\"py-2 px-3 mono text-[11px] text-[#71717a]\">" + h(cseq) + "</td>" +
            "<td class=\"py-2 px-3 text-[10px] text-[#52525b] text-right\">" + time_ago(msg_ts_sec) + "</td>" +
            "</tr>"

        // Build the row using CSS grid
        // Each column gets a cell; the arrow spans from left_i to right_i
        mut cells := ""
        mut c := 0
        while c < ncols {
            if c == left_i && left_i == right_i {
                // Self-arrow (src == dst or no dst)
                cells = cells + "<div class=\"flex items-center justify-center\">" +
                    "<div class=\"text-[11px] mono font-medium " + arrow_cls + " px-2 py-0.5 rounded border border-current/30 bg-current/5\">" + h(label) + "</div></div>"
            } else if c == left_i {
                // Start of arrow span
                span := right_i - left_i + 1
                if going_right {
                    cells = cells + "<div class=\"flex items-center col-span-" + ("" + (span)) + "\">" +
                        "<div class=\"w-2 h-2 rounded-full bg-current " + arrow_cls + " shrink-0\"></div>" +
                        "<div class=\"flex-1 border-t-2 border-dashed " + arrow_cls + " relative\">" +
                        "<span class=\"absolute -top-5 left-1/2 -translate-x-1/2 text-[11px] mono font-medium " + arrow_cls + " whitespace-nowrap\">" + h(label) + "</span></div>" +
                        "<div class=\"" + arrow_cls + " shrink-0\" style=\"width:0;height:0;border-top:5px solid transparent;border-bottom:5px solid transparent;border-left:8px solid currentColor\"></div></div>"
                } else {
                    cells = cells + "<div class=\"flex items-center col-span-" + ("" + (span)) + "\">" +
                        "<div class=\"" + arrow_cls + " shrink-0\" style=\"width:0;height:0;border-top:5px solid transparent;border-bottom:5px solid transparent;border-right:8px solid currentColor\"></div>" +
                        "<div class=\"flex-1 border-t-2 border-dashed " + arrow_cls + " relative\">" +
                        "<span class=\"absolute -top-5 left-1/2 -translate-x-1/2 text-[11px] mono font-medium " + arrow_cls + " whitespace-nowrap\">" + h(label) + "</span></div>" +
                        "<div class=\"w-2 h-2 rounded-full bg-current " + arrow_cls + " shrink-0\"></div></div>"
                }
                c = right_i // skip spanned columns
            } else {
                cells = cells + "<div></div>"
            }
            c = c + 1
        }

        // Vertical lifeline guides
        mut guides := ""
        mut g := 0
        while g < ncols {
            pct := if ncols > 1 { (g * 100) / (ncols - 1) } else { 50 }
            guides = guides + "<div class=\"absolute top-0 bottom-0 border-l border-[#1e1e22]\" style=\"left:" + ("" + (((g * 2 + 1) * 50) / ncols)) + "%\"></div>"
            g = g + 1
        }

        rows = rows + "<a href=\"/messages/" + ("" + (id)) + "\" class=\"block group relative hover:bg-[#27272a]/30 rounded-lg transition-colors\">" +
            guides +
            "<div class=\"relative grid gap-0 py-4 px-1\" style=\"grid-template-columns:repeat(" + ("" + (ncols)) + ",1fr)\">" + cells + "</div>" +
            "<div class=\"text-[10px] text-[#52525b] group-hover:text-[#71717a] px-3 pb-1 mono flex gap-3\">" +
            "<span>#" + ("" + (id)) + "</span>" +
            "<span>" + h(cseq) + "</span>" +
            "<span>" + h(transport) + "</span>" +
            "<span class=\"ml-auto\">" + time_ago(msg_ts_sec) + "</span>" +
            "</div></a>"
    }

    related_html := "<div id=\"related-calls\" hx-get=\"/partials/related-calls?call_id=" + q(call_id) + "\" hx-trigger=\"load\" hx-swap=\"innerHTML\"></div>"

    // QoS panel — show RTCP data if any exists for this call
    mut qos_html := ""
    mut has_rtcp := false
    for rm in all_items {
        if (rm["proto"] ?? "") == "rtcp" { has_rtcp = true }
    }
    if has_rtcp {
        qos_html = "<div class=\"card p-5 mt-4\">" +
            "<div class=\"flex items-center gap-2 mb-3\">" +
            "<svg class=\"w-4 h-4 text-[#34d399]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z\"/></svg>" +
            "<span class=\"text-sm font-semibold\">QoS / RTCP</span></div>" +
            "<p class=\"text-xs text-[#71717a]\">RTCP data captured for this call. Raw RTCP payloads are available in the message detail view.</p></div>"
    }

    // Recording player + upload
    media_panel := call_media_panel(call_id, all_items, len(items))
    player := recording_player(call_id)
    upload := recording_upload_form(call_id)

    // Assemble
    "<div class=\"card overflow-hidden\">" +
    "<div class=\"p-5 border-b border-[#1e1e22]\">" +
    "<div class=\"flex items-start justify-between gap-4\">" +
    "<div><div class=\"text-[11px] text-[#71717a] uppercase tracking-wider font-medium mb-1\">Call-ID</div>" +
    "<div class=\"mono text-sm break-all text-[#e4e4e7]\">" + h(call_id) + "</div>" +
    "<div class=\"text-[11px] text-[#52525b] mt-1\">" + ("" + (len(ordered))) + " messages · " + ("" + (ncols)) + " endpoints</div></div>" +
    "<div class=\"flex gap-2 shrink-0\">" +
    "<a href=\"/pcap?call_id=" + q(call_id) + "\" class=\"rounded-lg px-3 py-1.5 text-[11px] border border-[#1e1e22] bg-[#131316] text-[#a1a1aa] hover:text-[#e4e4e7] transition-colors\" title=\"Download as Wireshark PCAP\">" +
    "<svg class=\"w-3.5 h-3.5 inline mr-1\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\"/></svg>PCAP</a>" +
    "<button onclick=\"navigator.clipboard.writeText(window.location.href).then(()=>this.textContent='Copied!')\" class=\"rounded-lg px-3 py-1.5 text-[11px] border border-[#1e1e22] bg-[#131316] text-[#a1a1aa] hover:text-[#e4e4e7] transition-colors\">Copy URL</button>" +
    "<form hx-post=\"/share/create\" hx-target=\"#share-result\" hx-swap=\"innerHTML\" class=\"inline\"><input type=\"hidden\" name=\"call_id\" value=\"" + h(call_id) + "\"/>" +
    "<button type=\"submit\" class=\"rounded-lg px-3 py-1.5 text-[11px] border border-[#1e1e22] bg-[#131316] text-[#a1a1aa] hover:text-[#e4e4e7] transition-colors\">Public link</button></form>" +
    "</div></div><div id=\"share-result\"></div></div>" +
    "<div class=\"p-5\">" +
    "<div class=\"mb-5 overflow-x-auto rounded-md border border-[#1e1e22]\">" +
    "<table class=\"w-full text-left text-sm\"><thead><tr class=\"text-[10px] uppercase tracking-wide text-[#71717a] border-b border-[#1e1e22] bg-[#0a0a0c]\">" +
    "<th class=\"py-2 px-3 font-semibold\">Msg</th><th class=\"py-2 px-3 font-semibold\">SIP</th><th class=\"py-2 px-3 font-semibold\">Source</th><th class=\"py-2 px-2\"></th><th class=\"py-2 px-3 font-semibold\">Destination</th><th class=\"py-2 px-3 font-semibold\">CSeq</th><th class=\"py-2 px-3 font-semibold text-right\">Seen</th></tr></thead>" +
    "<tbody class=\"divide-y divide-[#1e1e22]/60\">" + table_rows + "</tbody></table></div>" +
    hdr +
    "<div class=\"divide-y divide-[#27272a]/50\">" + rows + "</div>" +
    "</div></div>" +
    related_html + qos_html + player + upload
}

fn ladder_html(call_id) {
    ladder_html_from_items(call_id, fetch_messages(300, call_id))
}

// ---- recordings ----

fn recordings_dir() {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    dir + "/recordings"
}

fn sanitize_cid(cid) {
    // Replace dangerous path chars
    mut s := str.replace(cid, "/", "_")
    s = str.replace(s, "\\", "_")
    s = str.replace(s, "..", "_")
    s = str.replace(s, "\x00", "")
    s
}

fn recording_path(call_id) {
    recordings_dir() + "/" + sanitize_cid(call_id) + ".wav"
}

fn has_recording(call_id) {
    fs.exists(recording_path(call_id))
}

fn recording_player(call_id) {
    if !has_recording(call_id) { return "" }
    "<div class=\"card p-5 mt-4\">" +
    "<div class=\"flex items-center gap-3 mb-3\">" +
    "<svg class=\"w-5 h-5 text-[#34d399]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z\"/></svg>" +
    "<span class=\"text-sm font-medium\">Call recording</span></div>" +
    "<audio controls preload=\"metadata\" class=\"w-full rounded-lg\" style=\"height:40px\">" +
    "<source src=\"/recordings/" + h(sanitize_cid(call_id)) + "\" type=\"audio/wav\"/>" +
    "Your browser does not support audio playback.</audio></div>"
}

fn recording_upload_form(call_id) {
    "<div class=\"rounded-2xl border border-dashed border-[#3f3f46] bg-[#131316] p-5 mt-4\">" +
    "<form method=\"post\" action=\"/recordings/upload\" enctype=\"multipart/form-data\" class=\"flex flex-wrap items-end gap-3\">" +
    "<input type=\"hidden\" name=\"call_id\" value=\"" + h(call_id) + "\"/>" +
    "<div class=\"flex-1 min-w-[200px]\">" +
    "<label class=\"block text-[11px] text-[#71717a] uppercase tracking-wider font-medium mb-2\">Upload recording</label>" +
    "<input type=\"file\" name=\"file\" accept=\"audio/*,.wav,.mp3,.ogg\" required " +
    "class=\"w-full text-sm text-[#a1a1aa] file:mr-3 file:rounded-lg file:border-0 file:bg-[#27272a] file:px-3 file:py-1.5 file:text-sm file:text-[#e4e4e7] file:cursor-pointer hover:file:bg-[#3f3f46]\"/></div>" +
    "<button type=\"submit\" class=\"rounded-lg px-4 py-2 text-sm bg-[#27272a] text-[#e4e4e7] hover:bg-[#3f3f46] transition-colors\">Upload</button>" +
    "</form></div>"
}

// ---- PCAP generation (pure Weft, no Python) ----

fn pack_le32(v) { binstruct.pack("<I", v).value }
fn pack_le16(v) { binstruct.pack("<H", v).value }
fn pack_be16(v) { binstruct.pack(">H", v).value }
fn pack_be32(v) { binstruct.pack(">I", v).value }
fn pack_u8(v) { binstruct.pack("B", v).value }

fn ip_to_bytes(ip_str) {
    parts := str.split(ip_str, ".")
    if len(parts) != 4 { return pack_u8(0) + pack_u8(0) + pack_u8(0) + pack_u8(0) }
    pack_u8(int.parse(parts[0]).unwrap_or(0)) +
    pack_u8(int.parse(parts[1]).unwrap_or(0)) +
    pack_u8(int.parse(parts[2]).unwrap_or(0)) +
    pack_u8(int.parse(parts[3]).unwrap_or(0))
}

fn parse_endpoint(s) {
    if s == null || s == "" { return {"ip": "0.0.0.0", "port": 5060} }
    // Handle [ipv6]:port
    parts := str.split(s, ":")
    if len(parts) >= 2 {
        port := int.parse(parts[len(parts) - 1]).unwrap_or(5060)
        mut ip := parts[0]
        // Rejoin if more than 2 parts (but skip last which is port)
        if len(parts) > 2 {
            ip = str.slice(s, 0, len(s) - len(parts[len(parts) - 1]) - 1)
        }
        return {"ip": ip, "port": port}
    }
    {"ip": s, "port": 5060}
}

fn build_pcap(messages) {
    // PCAP global header: magic, v2.4, snaplen=65535, LINKTYPE_RAW(101)
    mut pcap := pack_le32(0xa1b2c3d4) + pack_le16(2) + pack_le16(4) +
                pack_le32(0) + pack_le32(0) + pack_le32(65535) + pack_le32(101)

    for m in messages {
        raw_b64 := m["raw_b64"] ?? ""
        if raw_b64 == "" { continue }
        dec := base64.decode(raw_b64)
        if !dec.ok { continue }
        payload := dec.value
        if len(payload) == 0 { continue }

        ts_ms := m["ts_ms"] ?? 0
        src_ep := parse_endpoint(m["src"] ?? "")
        dst_ep := parse_endpoint(m["dst"] ?? m["src"] ?? "")

        udp_len := 8 + len(payload)
        ip_total := 20 + udp_len

        // IPv4 header (20 bytes)
        ip_hdr := pack_u8(0x45) + pack_u8(0) + pack_be16(ip_total) +
                  pack_be16(0) + pack_be16(0x4000) +
                  pack_u8(64) + pack_u8(17) + pack_be16(0) +
                  ip_to_bytes(src_ep["ip"]) + ip_to_bytes(dst_ep["ip"])

        // UDP header (8 bytes)
        udp_hdr := pack_be16(src_ep["port"]) + pack_be16(dst_ep["port"]) +
                   pack_be16(udp_len) + pack_be16(0)

        pkt := ip_hdr + udp_hdr + payload
        pkt_len := len(pkt)

        // PCAP packet header
        ts_sec := ts_ms / 1000
        ts_usec := (ts_ms % 1000) * 1000
        pkt_hdr := pack_le32(ts_sec) + pack_le32(ts_usec) +
                   pack_le32(pkt_len) + pack_le32(pkt_len)

        pcap = pcap + pkt_hdr + pkt
    }
    pcap
}

// ---- saved searches ----

fn searches_path() {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    dir + "/zaman-searches.json"
}

fn load_searches() {
    r := fs.read(searches_path())
    if !r.ok { return [] }
    p := json.parse(r.value)
    if !p.ok { return [] }
    p.value
}

fn save_searches(searches) {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    if !fs.exists(dir) { fs.mkdir(dir) }
    fs.write_atomic(searches_path(), json.stringify(searches))
}

fn create_search(name, username, params) {
    searches := load_searches()
    new_search := {"id": len(searches) + 1, "name": name, "user": username, "params": params}
    save_searches(list_append(searches, new_search))
}

fn delete_search(id) {
    searches := load_searches()
    save_searches(list_remove(searches, "id", id))
}

// ---- admin page ----

fn admin_users_page(user, flash) {
    users := list_users()
    th := "text-[10px] uppercase tracking-wider text-[#52525b] font-semibold"
    inp := "w-full rounded-md bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 text-sm"
    lbl := "block text-[10px] text-[#52525b] uppercase tracking-wider mb-1.5"

    // Flash message
    mut flash_html := ""
    if flash != "" {
        is_err := str.starts_with(flash, "Error")
        cls := if is_err { "border-[#f87171]/20 bg-[#f87171]/5 text-[#f87171]" } else { "border-[#34d399]/20 bg-[#34d399]/5 text-[#34d399]" }
        flash_html = "<div class=\"rounded-lg border " + cls + " px-3 py-2 text-xs mb-4\">" + h(flash) + "</div>"
    }

    // User rows — each user is a card-like row with inline actions
    mut user_list := ""
    for u in users {
        uid := u["id"] ?? 0
        uname := h(u["username"] ?? "")
        urole := u["role"] ?? "viewer"
        is_self := (uid == (user["id"] ?? -1))

        mut actions := ""
        if !is_self {
            // Reset password inline
            actions = "<details class=\"inline\"><summary class=\"text-[11px] text-[#52525b] hover:text-[#a1a1aa] cursor-pointer\">reset pw</summary>" +
                "<form method=\"post\" action=\"/admin/users/password\" class=\"flex gap-2 mt-2\">" +
                "<input type=\"hidden\" name=\"user_id\" value=\"" + ("" + (uid)) + "\"/>" +
                "<input name=\"new_password\" type=\"password\" required placeholder=\"new password\" class=\"flex-1 rounded-md bg-[#0a0a0c] border border-[#1e1e22] px-2 py-1 text-xs mono\"/>" +
                "<button class=\"rounded-md px-2 py-1 text-[11px] bg-[#1e1e22] text-[#a1a1aa] hover:text-[#e4e4e7]\">Set</button></form></details>" +
                " <form method=\"post\" action=\"/admin/users/" + ("" + (uid)) + "/delete\" class=\"inline\" onsubmit=\"return confirm('Delete " + uname + "?')\">" +
                "<button class=\"text-[11px] text-[#52525b] hover:text-[#f87171] ml-2\">delete</button></form>"
        } else {
            actions = "<span class=\"text-[10px] text-[#3f3f46]\">current session</span>"
        }

        user_list = user_list +
            "<div class=\"flex items-center justify-between py-3 px-4 border-b border-[#1e1e22]/50 last:border-0\">" +
            "<div class=\"flex items-center gap-3\">" +
            "<div class=\"w-8 h-8 rounded-full bg-[#1e1e22] flex items-center justify-center text-xs font-semibold text-[#71717a]\">" + str.slice(uname, 0, 1) + "</div>" +
            "<div><div class=\"text-sm font-medium\">" + uname + "</div>" +
            "<div class=\"text-[10px] text-[#3f3f46]\">ID " + ("" + (uid)) + "</div></div>" +
            "<div class=\"ml-4\">" + role_badge(urole) + "</div></div>" +
            "<div class=\"flex items-center gap-1\">" + actions + "</div></div>"
    }

    // Role descriptions
    roles_info := "<div class=\"card p-4 mb-5\">" +
        "<div class=\"grid grid-cols-3 gap-4 text-xs\">" +
        "<div><div class=\"flex items-center gap-1.5 mb-1.5\">" + role_badge("viewer") + "</div>" +
        "<p class=\"text-[#52525b]\">Read-only. View dashboard, messages, calls, reports.</p></div>" +
        "<div><div class=\"flex items-center gap-1.5 mb-1.5\">" + role_badge("operator") + "</div>" +
        "<p class=\"text-[#52525b]\">+ Run probes, manage alerts, configure SLA targets.</p></div>" +
        "<div><div class=\"flex items-center gap-1.5 mb-1.5\">" + role_badge("admin") + "</div>" +
        "<p class=\"text-[#52525b]\">+ Create/delete users, API tokens, audit log, config.</p></div>" +
        "</div></div>"

    flash_html +
    "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
    "<h1 class=\"text-xl font-semibold\">Users</h1>" +
    "<span class=\"text-[10px] text-[#3f3f46] mono\">" + ("" + (len(users))) + " accounts</span></div>" +
    roles_info +
    // User list
    "<div class=\"card overflow-hidden mb-5\">" + user_list + "</div>" +
    // Create form — clean, single row
    "<div class=\"card p-4\">" +
    "<div class=\"section-title\">Add user</div>" +
    "<form method=\"post\" action=\"/admin/users\" class=\"grid grid-cols-4 gap-3 items-end\">" +
    "<div><label class=\"" + lbl + "\">Username</label>" +
    "<input name=\"username\" required placeholder=\"jdoe\" class=\"" + inp + "\"/></div>" +
    "<div><label class=\"" + lbl + "\">Password</label>" +
    "<input name=\"password\" type=\"password\" required placeholder=\"min 8 chars + digit\" class=\"" + inp + "\"/></div>" +
    "<div><label class=\"" + lbl + "\">Role</label>" +
    "<select name=\"role\" class=\"" + inp + "\">" +
    "<option value=\"viewer\">viewer</option>" +
    "<option value=\"operator\">operator</option>" +
    "<option value=\"admin\">admin</option></select></div>" +
    "<button type=\"submit\" class=\"rounded-md px-4 py-2 text-sm bg-[#a78bfa] text-[#0a0a0c] font-medium hover:bg-[#c4b5fd] transition-colors\">Create user</button>" +
    "</form></div>"
}

// ---- audit log ----
// Append-only log: who did what, when. Compliance requirement.

fn audit_path() {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    dir + "/zaman-audit.jsonl"
}

fn audit(user, action, detail) {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    if !fs.exists(dir) { fs.mkdir(dir) }
    now := time.unix()
    entry := json.stringify({"ts": now, "user": user, "action": action, "detail": detail})
    fs.append(audit_path(), entry + "\n")
    if (now % 300) == 0 {
        audit_rotate(10000)
    }
}

fn audit_rotate(max_lines) {
    r := fs.read(audit_path())
    if r.ok {
        lines := str.split(r.value, "\n")
        if len(lines) > max_lines {
            mut kept := ""
            mut i := len(lines) - max_lines
            while i < len(lines) {
                if lines[i] != "" { kept = kept + lines[i] + "\n" }
                i = i + 1
            }
            fs.write_atomic(audit_path(), kept)
        }
    }
}

// Syslog forwarding: if ZAMAN_SYSLOG_HOST is set, also ship audit + alerts there
fn syslog_send(msg) {
    host := env.get("ZAMAN_SYSLOG_HOST") ?? ""
    if host == "" { return }
    port := int.parse(env.get("ZAMAN_SYSLOG_PORT") ?? "514").unwrap_or(514)
    // UDP syslog: <priority>message
    // facility=local0 (16), severity=notice (5) → priority = 16*8+5 = 133
    syslog_msg := "<133>zaman: " + msg
    // Best-effort UDP send via HTTP — Weft doesn't have raw UDP, use audit file as fallback
    audit("syslog", "forward", msg)
}

fn load_audit(limit) {
    mut lim := limit
    if lim <= 0 { lim = 100 }
    if lim > 500 { lim = 500 }
    r := fs.read(audit_path())
    if !r.ok { return [] }
    lines := str.split(r.value, "\n")
    mut entries := []
    // Read from end (most recent first)
    mut i := len(lines) - 1
    mut count := 0
    while i >= 0 && count < lim {
        line := lines[i]
        if line != "" {
            p := json.parse(line)
            if p.ok { entries = list_append(entries, p.value) }
            count = count + 1
        }
        i = i - 1
    }
    entries
}

// ---- SLA targets (configurable) ----

fn sla_targets_path() {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    dir + "/zaman-sla-targets.json"
}

fn load_sla_targets() {
    r := fs.read(sla_targets_path())
    if !r.ok {
        return {
            "asr_target": 45, "asr_warning": 40, "asr_critical": 35,
            "ner_target": 98, "ner_warning": 90, "ner_critical": 80,
            "err_rate_max": 5,
            "reg_fail_max": 3,
            "fivexx_max": 2
        }
    }
    p := json.parse(r.value)
    if p.ok { p.value } else { {"asr_target": 45, "asr_warning": 40, "asr_critical": 35, "ner_target": 98, "err_rate_max": 5} }
}

fn save_sla_targets(targets) {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    if !fs.exists(dir) { fs.mkdir(dir) }
    fs.write_atomic(sla_targets_path(), json.stringify(targets))
}

fn sla_status_for(value, target, warning, critical) {
    if value >= target { return "pass" }
    if value >= warning { return "warning" }
    "fail"
}

fn sla_dot(status) {
    if status == "pass" { "<span class=\"w-2 h-2 rounded-full bg-[#34d399] inline-block\"></span>" }
    else if status == "warning" { "<span class=\"w-2 h-2 rounded-full bg-[#fbbf24] inline-block\"></span>" }
    else { "<span class=\"w-2 h-2 rounded-full bg-[#f87171] inline-block\"></span>" }
}

fn sla_color(status) {
    if status == "pass" { "#34d399" } else if status == "warning" { "#fbbf24" } else { "#f87171" }
}

fn sla_detail_tables(targets) {
    sla_agents := fetch_sla_agents()
    sla_dests := fetch_sla_destinations()
    asr_t := targets["asr_target"] ?? 45
    asr_w := targets["asr_warning"] ?? 40
    asr_cr := targets["asr_critical"] ?? 35
    err_max := targets["err_rate_max"] ?? 5
    th := "text-[10px] uppercase tracking-wider text-[#52525b] font-semibold"

    mut agent_rows := ""
    for a in sla_agents {
        aname := h(a["agent"] ?? "")
        ainv := a["invites"] ?? 0
        a_asr := a["asr"] ?? 0
        aerr := a["err_rate"] ?? 0
        atotal := a["total"] ?? 0
        alast := a["last_seen"] ?? 0
        a_st := if ainv == 0 { "pass" } else { sla_status_for(a_asr, asr_t, asr_w, asr_cr) }
        a_err_st := if aerr <= err_max { "pass" } else { "fail" }
        agent_rows = agent_rows + "<tr>" +
            "<td class=\"py-2 px-3\"><div class=\"flex items-center gap-2\">" + sla_dot(a_st) +
            "<span class=\"text-sm\">" + aname + "</span></div><div class=\"text-[10px] text-[#52525b] mt-0.5\">last " + time_ago(alast / 1000) + "</div></td>" +
            "<td class=\"py-2 px-3 mono text-xs text-right\">" + ("" + (atotal)) + "</td>" +
            "<td class=\"py-2 px-3 mono text-xs text-right\">" + ("" + (ainv)) + "</td>" +
            "<td class=\"py-2 px-3 mono text-xs text-right font-medium\" style=\"color:" + sla_color(a_st) + "\">" + ("" + (a_asr)) + "%</td>" +
            "<td class=\"py-2 px-3 mono text-xs text-right\" style=\"color:" + sla_color(a_err_st) + "\">" + ("" + (aerr)) + "%</td>" +
            "<td class=\"py-2 px-3 text-right\"><a class=\"text-[11px] text-[#a78bfa] hover:underline\" href=\"/messages?agent=" + aname + "\">messages</a> <span class=\"text-[#52525b]\">/</span> <a class=\"text-[11px] text-[#a78bfa] hover:underline\" href=\"/report?agent=" + aname + "&view=messages\">report</a></td></tr>"
    }
    if agent_rows == "" { agent_rows = "<tr><td colspan=\"6\" class=\"py-6 text-center text-[#3f3f46] text-sm\">No agents</td></tr>" }

    agent_section := "<div class=\"section\">" +
        "<div class=\"section-title\">SLA by agent</div>" +
        "<div class=\"card overflow-x-auto\">" +
        "<table class=\"w-full text-left text-sm\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\">" +
        "<th class=\"py-2 px-3\">Agent</th><th class=\"py-2 px-3 text-right\">Msgs</th><th class=\"py-2 px-3 text-right\">INVITEs</th>" +
        "<th class=\"py-2 px-3 text-right\">ASR</th><th class=\"py-2 px-3 text-right\">Err %</th><th class=\"py-2 px-3 text-right\">Drilldown</th></tr></thead>" +
        "<tbody class=\"divide-y divide-[#1e1e22]/50\">" + agent_rows + "</tbody></table></div></div>"

    mut dest_rows := ""
    for d in sla_dests {
        dname := h(d["dst"] ?? "")
        dip := endpoint_ip(d["dst"] ?? "")
        dinv := d["invites"] ?? 0
        d_asr := d["asr"] ?? 0
        derr := d["err_rate"] ?? 0
        dtotal := d["total"] ?? 0
        d_st := if dinv == 0 { "pass" } else { sla_status_for(d_asr, asr_t, asr_w, asr_cr) }
        dest_rows = dest_rows + "<tr>" +
            "<td class=\"py-2 px-3\"><div class=\"flex items-center gap-2\">" + sla_dot(d_st) +
            "<span class=\"mono text-xs\">" + dname + "</span></div></td>" +
            "<td class=\"py-2 px-3 mono text-xs text-right\">" + ("" + (dtotal)) + "</td>" +
            "<td class=\"py-2 px-3 mono text-xs text-right\">" + ("" + (dinv)) + "</td>" +
            "<td class=\"py-2 px-3 mono text-xs text-right font-medium\" style=\"color:" + sla_color(d_st) + "\">" + ("" + (d_asr)) + "%</td>" +
            "<td class=\"py-2 px-3 mono text-xs text-right\">" + ("" + (derr)) + "%</td>" +
            "<td class=\"py-2 px-3 text-right\"><a class=\"text-[11px] text-[#a78bfa] hover:underline\" href=\"/ip?addr=" + h(dip) + "\">ip</a> <span class=\"text-[#52525b]\">/</span> <a class=\"text-[11px] text-[#a78bfa] hover:underline\" href=\"/report?ip=" + h(dip) + "&view=messages\">report</a></td></tr>"
    }
    if dest_rows == "" { dest_rows = "<tr><td colspan=\"6\" class=\"py-6 text-center text-[#3f3f46] text-sm\">No destinations</td></tr>" }

    dest_section := "<div class=\"section\">" +
        "<div class=\"section-title\">SLA by destination</div>" +
        "<div class=\"card overflow-x-auto\">" +
        "<table class=\"w-full text-left text-sm\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\">" +
        "<th class=\"py-2 px-3\">Destination</th><th class=\"py-2 px-3 text-right\">Msgs</th><th class=\"py-2 px-3 text-right\">INVITEs</th>" +
        "<th class=\"py-2 px-3 text-right\">ASR</th><th class=\"py-2 px-3 text-right\">Err %</th><th class=\"py-2 px-3 text-right\">Drilldown</th></tr></thead>" +
        "<tbody class=\"divide-y divide-[#1e1e22]/50\">" + dest_rows + "</tbody></table></div></div>"

    agent_section + dest_section
}

fn sla_overview_panel(targets) {
    kpi := fetch_kpi()
    rt := fetch_realtime(5)
    rt1 := fetch_realtime(1)
    nodes := fetch_nodes()
    recent_408 := fetch_messages_ex(100, "", "", "", "", "", "", "", "408")
    th := "text-[10px] uppercase tracking-wider text-[#52525b] font-semibold"
    asr_t := targets["asr_target"] ?? 45
    asr_w := targets["asr_warning"] ?? 40
    asr_cr := targets["asr_critical"] ?? 35
    ner_t := targets["ner_target"] ?? 98
    err_max := targets["err_rate_max"] ?? 5
    reg_fail_max := targets["reg_fail_max"] ?? 3
    fivexx_max := targets["fivexx_max"] ?? 2

    asr := kpi["asr"] ?? 0
    ner := kpi["ner"] ?? 0
    win_asr := rt["asr"] ?? 0
    win_err := rt["err_rate"] ?? 0
    win_5xx := rt["resp_5xx"] ?? 0
    inv1 := rt1["invites"] ?? 0
    inv5 := rt["invites"] ?? 0
    active_calls := rt["active_calls"] ?? 0
    cps1 := per_second_label(inv1, 60)
    reg_fail := kpi["reg_fail"] ?? 0
    recent_408_count := len(recent_408)

    asr_st := sla_status_for(asr, asr_t, asr_w, asr_cr)
    win_asr_st := sla_status_for(win_asr, asr_t, asr_w, asr_cr)
    ner_st := if ner >= ner_t { "pass" } else if ner >= 80 { "warning" } else { "fail" }
    win_err_st := if win_err <= err_max { "pass" } else if win_err <= 15 { "warning" } else { "fail" }
    reg_st := if reg_fail <= reg_fail_max { "pass" } else if reg_fail <= reg_fail_max * 2 { "warning" } else { "fail" }
    fivexx_st := if win_5xx <= fivexx_max { "pass" } else if win_5xx <= fivexx_max * 2 { "warning" } else { "fail" }
    timeout_st := if recent_408_count == 0 { "pass" } else if recent_408_count < 25 { "warning" } else { "fail" }

    mut node_green := 0
    mut node_yellow := 0
    mut node_red := 0
    for nd in nodes {
        ns := nd["status"] ?? "red"
        if ns == "green" {
            node_green = node_green + 1
        } else if ns == "yellow" {
            node_yellow = node_yellow + 1
        } else {
            node_red = node_red + 1
        }
    }
    node_st := if node_red > 0 { "fail" } else if node_yellow > 0 { "warning" } else { "pass" }
    overall_st := if asr_st == "fail" || win_err_st == "fail" || reg_st == "fail" || fivexx_st == "fail" || node_st == "fail" || timeout_st == "fail" { "fail" } else if asr_st == "warning" || win_err_st == "warning" || reg_st == "warning" || fivexx_st == "warning" || node_st == "warning" || timeout_st == "warning" { "warning" } else { "pass" }
    overall_label := if overall_st == "pass" { "All SLAs met" } else if overall_st == "warning" { "Degraded" } else { "SLA breach" }
    overall_color := sla_color(overall_st)

    hero := "<div class=\"flex items-center gap-4 card p-5 mb-5\">" +
        "<div class=\"w-14 h-14 rounded-full flex items-center justify-center shrink-0\" style=\"background:" + overall_color + "15;border:2px solid " + overall_color + "\">" +
        "<span class=\"text-lg font-black mono\" style=\"color:" + overall_color + "\">" + ("" + (asr)) + "%</span></div>" +
        "<div class=\"flex-1\"><div class=\"text-lg font-semibold\" style=\"color:" + overall_color + "\">" + overall_label + "</div>" +
        "<div class=\"text-xs text-[#52525b] mt-0.5\">ASR " + ("" + (asr)) + "% · NER " + ("" + (ner)) + "% · CPS " + cps1 + " · concurrent " + ("" + (active_calls)) + " · 408s " + ("" + (recent_408_count)) + "</div></div>" +
        "<div class=\"text-right text-xs text-[#3f3f46]\">targets: ASR &ge;" + ("" + (asr_t)) + "% · NER &ge;" + ("" + (ner_t)) + "% · err &le;" + ("" + (err_max)) + "% · 5xx &le;" + ("" + (fivexx_max)) + "</div></div>"

    dimensions := "<div class=\"section\"><div class=\"section-title\">SLA dimensions</div><div class=\"grid grid-cols-2 md:grid-cols-4 xl:grid-cols-7 gap-3\">" +
        call_fact("Call ASR", ("" + (asr)) + "%", "target " + ("" + (asr_t)) + "%", sla_color(asr_st)) +
        call_fact("Live ASR", ("" + (win_asr)) + "%", "last 5 minutes", sla_color(win_asr_st)) +
        call_fact("NER", ("" + (ner)) + "%", "target " + ("" + (ner_t)) + "%", sla_color(ner_st)) +
        call_fact("Live errors", ("" + (win_err)) + "%", "max " + ("" + (err_max)) + "%", sla_color(win_err_st)) +
        call_fact("CPS", cps1, "last 1 minute", "#38bdf8") +
        call_fact("Concurrent", "" + (active_calls), "active dialogs", "#f472b6") +
        call_fact("Attempts", "" + (inv5), "INVITEs in 5m", "#e4e4e7") +
        call_fact("408 pressure", "" + (recent_408_count), "latest 100 timeout rows", sla_color(timeout_st)) +
        call_fact("5xx window", "" + (win_5xx), "max " + ("" + (fivexx_max)), sla_color(fivexx_st)) +
        call_fact("Nodes", ("" + (node_green)) + "/" + (len(nodes)), ("" + (node_yellow)) + " degraded, " + ("" + (node_red)) + " offline", sla_color(node_st)) +
        "</div></div>"

    breach_rows := "<tr><td class=\"py-2 px-3\">" + sla_dot(asr_st) + " <span class=\"ml-2\">All-time ASR</span></td><td class=\"py-2 px-3 mono text-right\">" + ("" + (asr)) + "%</td><td class=\"py-2 px-3 mono text-right\">&ge;" + ("" + (asr_t)) + "%</td><td class=\"py-2 px-3 text-right\"><a class=\"text-[#a78bfa] hover:underline\" href=\"/report?method=INVITE&view=calls\">calls</a></td></tr>" +
        "<tr><td class=\"py-2 px-3\">" + sla_dot(win_asr_st) + " <span class=\"ml-2\">5m ASR</span></td><td class=\"py-2 px-3 mono text-right\">" + ("" + (win_asr)) + "%</td><td class=\"py-2 px-3 mono text-right\">&ge;" + ("" + (asr_t)) + "%</td><td class=\"py-2 px-3 text-right\"><a class=\"text-[#a78bfa] hover:underline\" href=\"/metrics\">metrics</a></td></tr>" +
        "<tr><td class=\"py-2 px-3\">" + sla_dot(win_err_st) + " <span class=\"ml-2\">5m error rate</span></td><td class=\"py-2 px-3 mono text-right\">" + ("" + (win_err)) + "%</td><td class=\"py-2 px-3 mono text-right\">&le;" + ("" + (err_max)) + "%</td><td class=\"py-2 px-3 text-right\"><a class=\"text-[#a78bfa] hover:underline\" href=\"/report?status=408&view=messages\">errors</a></td></tr>" +
        "<tr><td class=\"py-2 px-3\">" + sla_dot(timeout_st) + " <span class=\"ml-2\">408 timeouts</span></td><td class=\"py-2 px-3 mono text-right\">" + ("" + (recent_408_count)) + "</td><td class=\"py-2 px-3 mono text-right\">watch &lt;25</td><td class=\"py-2 px-3 text-right\"><a class=\"text-[#a78bfa] hover:underline\" href=\"/messages?status=408\">messages</a></td></tr>" +
        "<tr><td class=\"py-2 px-3\">" + sla_dot(fivexx_st) + " <span class=\"ml-2\">5xx responses</span></td><td class=\"py-2 px-3 mono text-right\">" + ("" + (win_5xx)) + "</td><td class=\"py-2 px-3 mono text-right\">&le;" + ("" + (fivexx_max)) + "</td><td class=\"py-2 px-3 text-right\"><a class=\"text-[#a78bfa] hover:underline\" href=\"/report?view=messages\">report</a></td></tr>" +
        "<tr><td class=\"py-2 px-3\">" + sla_dot(reg_st) + " <span class=\"ml-2\">Registration failures</span></td><td class=\"py-2 px-3 mono text-right\">" + ("" + (reg_fail)) + "</td><td class=\"py-2 px-3 mono text-right\">&le;" + ("" + (reg_fail_max)) + "</td><td class=\"py-2 px-3 text-right\"><a class=\"text-[#a78bfa] hover:underline\" href=\"/report?method=REGISTER&view=messages\">registers</a></td></tr>" +
        "<tr><td class=\"py-2 px-3\">" + sla_dot(node_st) + " <span class=\"ml-2\">Node health</span></td><td class=\"py-2 px-3 mono text-right\">" + ("" + (node_red)) + " offline</td><td class=\"py-2 px-3 mono text-right\">0 offline</td><td class=\"py-2 px-3 text-right\"><a class=\"text-[#a78bfa] hover:underline\" href=\"/noc\">NOC</a></td></tr>"
    breach := "<div class=\"section\"><div class=\"section-title\">Breach checklist</div><div class=\"card overflow-x-auto\"><table class=\"w-full text-left text-sm\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\"><th class=\"py-2 px-3\">Dimension</th><th class=\"py-2 px-3 text-right\">Current</th><th class=\"py-2 px-3 text-right\">Target</th><th class=\"py-2 px-3 text-right\">Drilldown</th></tr></thead><tbody class=\"divide-y divide-[#1e1e22]/50\">" + breach_rows + "</tbody></table></div></div>"

    gauges := "<div class=\"section\"><div class=\"section-title\">Service indicators</div><div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3\">" +
        "<div class=\"card p-4\">" + sla_dot(asr_st) + " <span class=\"text-[10px] text-[#52525b] uppercase ml-1\">ASR (all)</span><div class=\"text-2xl font-bold mono mt-1\" style=\"color:" + sla_color(asr_st) + "\">" + ("" + (asr)) + "%</div></div>" +
        "<div class=\"card p-4\">" + sla_dot(win_asr_st) + " <span class=\"text-[10px] text-[#52525b] uppercase ml-1\">ASR (5m)</span><div class=\"text-2xl font-bold mono mt-1\" style=\"color:" + sla_color(win_asr_st) + "\">" + ("" + (win_asr)) + "%</div></div>" +
        "<div class=\"card p-4\">" + sla_dot(ner_st) + " <span class=\"text-[10px] text-[#52525b] uppercase ml-1\">NER</span><div class=\"text-2xl font-bold mono mt-1\" style=\"color:" + sla_color(ner_st) + "\">" + ("" + (ner)) + "%</div></div>" +
        "<div class=\"card p-4\">" + sla_dot(win_err_st) + " <span class=\"text-[10px] text-[#52525b] uppercase ml-1\">Error rate</span><div class=\"text-2xl font-bold mono mt-1\" style=\"color:" + sla_color(win_err_st) + "\">" + ("" + (win_err)) + "%</div></div>" +
        stat_card("INVITEs", kpi["total_invites"] ?? 0, "answered " + ("" + (kpi["answered"] ?? 0))) +
        stat_card("Reg failures", kpi["reg_fail"] ?? 0, "of " + ("" + (kpi["total_registers"] ?? 0))) +
        "</div></div>"

    hero + dimensions + breach + gauges
}

// ---- custom branding ----
// ZAMAN_BRAND_NAME: dashboard title (default "Zaman")
// ZAMAN_BRAND_LOGO: URL to logo image (replaces the Z icon)

fn brand_name() {
    env.get("ZAMAN_BRAND_NAME") ?? "Zaman"
}

fn brand_subtitle() {
    env.get("ZAMAN_BRAND_SUBTITLE") ?? "SIP monitoring · echo"
}

// ---- share links ----
// Generates a time-limited HMAC token for read-only call ladder access without login.

fn make_share_token(token_secret, call_id) {
    expires := time.unix() + 86400 * 7
    payload := "share:" + call_id + ":" + ("" + (expires))
    sig := crypto.hmac_sha256(token_secret, payload)
    base64.encode(payload + ":" + sig)
}

fn verify_share_token(token_secret, token) {
    dec := base64.decode(token)
    if !dec.ok { return null }
    raw := dec.value
    if len(raw) < 66 { return null }
    sig_start := len(raw) - 64
    sep := str.slice(raw, sig_start - 1, sig_start)
    if sep != ":" { return null }
    payload := str.slice(raw, 0, sig_start - 1)
    got_sig := str.slice(raw, sig_start, len(raw))
    expected := crypto.hmac_sha256(token_secret, payload)
    if !crypto.equal(got_sig, expected) { return null }
    // Parse: share:call_id:expires
    if !str.starts_with(payload, "share:") { return null }
    rest := str.slice(payload, 6, len(payload))
    // Last segment is expires
    parts := str.split(rest, ":")
    if len(parts) < 2 { return null }
    expires := int.parse(parts[len(parts) - 1]).unwrap_or(0)
    if expires < time.unix() { return null }
    // Rejoin call_id (may contain colons)
    mut cid := parts[0]
    mut i := 1
    while i < len(parts) - 1 {
        cid = cid + ":" + parts[i]
        i = i + 1
    }
    cid
}

// ---- user preferences ----

fn prefs_path() {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    dir + "/zaman-prefs.json"
}

fn load_prefs() {
    r := fs.read(prefs_path())
    if !r.ok { return {} }
    p := json.parse(r.value)
    if p.ok { p.value } else { {} }
}

fn save_prefs(prefs) {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    if !fs.exists(dir) { fs.mkdir(dir) }
    fs.write_atomic(prefs_path(), json.stringify(prefs))
}

fn get_user_pref(username, key, default_val) {
    prefs := load_prefs()
    uprefs := prefs[username]
    if uprefs == null { return default_val }
    uprefs[key] ?? default_val
}

fn set_user_pref(username, key, value) {
    mut prefs := load_prefs()
    if prefs[username] == null {
        prefs[username] = {}
    }
    prefs[username][key] = value
    save_prefs(prefs)
}

// ---- API tokens ----
// Per-user long-lived tokens for automation (separate from session cookies).

fn api_tokens_path() {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    dir + "/zaman-api-tokens.json"
}

fn load_api_tokens() {
    r := fs.read(api_tokens_path())
    if !r.ok { return [] }
    p := json.parse(r.value)
    if p.ok { p.value } else { [] }
}

fn save_api_tokens(tokens) {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    if !fs.exists(dir) { fs.mkdir(dir) }
    fs.write_atomic(api_tokens_path(), json.stringify(tokens))
    fs.chmod(api_tokens_path(), 384)
}

fn create_api_token(username, role, label) {
    tokens := load_api_tokens()
    token := secrets.token_hex(32)
    hash := crypto.sha256(token)
    new_tok := {"hash": hash, "prefix": str.slice(token, 0, 8), "username": username, "role": role, "label": label, "created": time.unix()}
    save_api_tokens(list_append(tokens, new_tok))
    token
}

fn verify_api_token(token) {
    if token == "" { return null }
    hash := crypto.sha256(token)
    tokens := load_api_tokens()
    for t in tokens {
        if (t["hash"] ?? "") == hash {
            return {"username": t["username"], "role": t["role"], "id": 0}
        }
    }
    null
}

fn delete_api_token(prefix) {
    tokens := load_api_tokens()
    mut kept := "["
    mut first := true
    for t in tokens {
        if (t["prefix"] ?? "") != prefix {
            if !first { kept = kept + "," }
            kept = kept + json.stringify(t)
            first = false
        }
    }
    save_api_tokens(json.parse(kept + "]").value)
}

// ---- password policy ----

fn validate_password(pw) {
    if len(pw) < 12 { return "password must be at least 12 characters" }
    mut has_digit := false
    mut has_upper := false
    mut has_special := false
    mut i := 0
    while i < len(pw) {
        c := str.slice(pw, i, i + 1)
        if c >= "0" && c <= "9" { has_digit = true }
        if c >= "A" && c <= "Z" { has_upper = true }
        if !has_special {
            if (c < "0" || c > "9") && (c < "a" || c > "z") && (c < "A" || c > "Z") { has_special = true }
        }
        i = i + 1
    }
    if !has_digit { return "password must contain at least one digit" }
    if !has_upper { return "password must contain at least one uppercase letter" }
    if !has_special { return "password must contain at least one special character" }
    ""
}

// ---- IP allowlisting ----
// ZAMAN_DASHBOARD_ALLOW_IPS: comma-separated IPs/prefixes. Empty = allow all.

fn get_client_ip(req) {
    direct := req.headers["Remote-Addr"] ?? "unknown"
    trusted := env.get("ZAMAN_TRUSTED_PROXY") ?? ""
    // Only trust XFF/X-Real-Ip when TCP peer matches the trusted proxy
    if trusted != "" && direct != trusted {
        return direct
    }
    xff := req.headers["X-Forwarded-For"] ?? ""
    if xff != "" {
        parts := str.split(xff, ",")
        return str.trim(parts[0])
    }
    xri := req.headers["X-Real-Ip"] ?? ""
    if xri != "" { return str.trim(xri) }
    direct
}

fn ip_allowed(req) {
    allow := env.get("ZAMAN_DASHBOARD_ALLOW_IPS") ?? ""
    if allow == "" { return true }
    ip := get_client_ip(req)
    if ip == "unknown" || ip == "" { return true }
    parts := str.split(allow, ",")
    for p in parts {
        prefix := str.trim(p)
        if prefix == "" { continue }
        if ip == prefix { return true }
        if str.starts_with(ip, prefix) { return true }
    }
    false
}

fn ip_denied_page() {
    "<!doctype html><html><head><title>Access Denied</title></head>" +
    "<body style=\"background:#09090b;color:#f87171;font-family:system-ui;display:flex;align-items:center;justify-content:center;min-height:100vh\">" +
    "<div style=\"text-align:center\"><h1>403 Forbidden</h1><p>Your IP is not in the dashboard allowlist.</p></div></body></html>"
}

// ---- CSV export ----

fn messages_to_csv(messages) {
    mut csv := "id,ts_ms,src,dst,transport,proto,agent,kind,method,status,call_id,from,to,cseq,ruri\n"
    for m in messages {
        csv = csv +
            ("" + (m["id"] ?? "")) + "," +
            ("" + (m["ts_ms"] ?? "")) + "," +
            csv_field(m["src"] ?? "") + "," +
            csv_field(m["dst"] ?? "") + "," +
            csv_field(m["transport"] ?? "") + "," +
            csv_field(m["proto"] ?? "") + "," +
            csv_field(m["agent"] ?? "") + "," +
            csv_field(m["kind"] ?? "") + "," +
            csv_field(m["method"] ?? "") + "," +
            ("" + (m["status"] ?? 0)) + "," +
            csv_field(m["call_id"] ?? "") + "," +
            csv_field(m["from"] ?? "") + "," +
            csv_field(m["to"] ?? "") + "," +
            csv_field(m["cseq"] ?? "") + "," +
            csv_field(m["ruri"] ?? "") + "\n"
    }
    csv
}

fn csv_field(s) {
    if str.contains(s, ",") || str.contains(s, "\"") || str.contains(s, "\n") {
        return "\"" + str.replace(s, "\"", "\"\"") + "\""
    }
    s
}

// ---- config backup/restore ----

fn export_config() {
    users := load_users()
    alert_config := load_alert_config()
    searches := load_searches()
    api_tokens := load_api_tokens()
    // Scrub sensitive fields from users
    mut safe_users := "["
    mut first := true
    for u in users {
        if !first { safe_users = safe_users + "," }
        safe_users = safe_users + json.stringify({"id": u["id"], "username": u["username"], "role": u["role"]})
        first = false
    }
    safe_users = safe_users + "]"
    json.stringify({
        "version": "1.0",
        "exported_at": time.unix(),
        "users": json.parse(safe_users).value,
        "alerts": alert_config,
        "searches": searches,
        "api_token_count": len(api_tokens)
    })
}

// ---- SLA reporting ----

fn fetch_sla() {
    // SLA = percentage of time ASR was above threshold (default 45%)
    // Computed from daily rollups: if any INVITE traffic existed that day, check if failed > 55%
    r := http.get(core_base() + "/api/report/kpi", api_headers())
    if !r.ok { return {} }
    p := json.parse(r.value.body)
    if !p.ok { return {} }
    kpi := p.value
    total_inv := kpi["total_invites"] ?? 0
    answered := kpi["answered"] ?? 0
    failed := kpi["failed"] ?? 0
    asr := kpi["asr"] ?? 0
    // Simple SLA: asr-based availability
    mut sla_status := "healthy"
    if asr < 45 { sla_status = "degraded" }
    if asr < 35 { sla_status = "critical" }
    {
        "asr": asr,
        "total_invites": total_inv,
        "answered": answered,
        "failed": failed,
        "status": sla_status,
        "total_messages": kpi["total_messages"] ?? 0
    }
}

// ---- alerting engine ----
// Channels: Slack webhook, generic webhook (PagerDuty/Teams/Opsgenie), email.
// Rules: JSON file with thresholds. Evaluation runs on HTMX poll.
// History: last 100 fired alerts kept in memory (JSON file for persistence).

fn alerts_config_path() {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    dir + "/zaman-alerts.json"
}

fn alerts_history_path() {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    dir + "/zaman-alert-history.json"
}

fn load_alert_config() {
    r := fs.read(alerts_config_path())
    if !r.ok {
        return {
            "channels": [],
            "rules": [
                {"id": 1, "name": "Low ASR", "metric": "asr", "op": "<", "threshold": 40, "severity": "critical", "enabled": true},
                {"id": 2, "name": "High error rate", "metric": "err_rate", "op": ">", "threshold": 15, "severity": "critical", "enabled": true},
                {"id": 3, "name": "5xx spike", "metric": "resp_5xx", "op": ">", "threshold": 5, "severity": "critical", "enabled": true},
                {"id": 4, "name": "Auth failures", "metric": "err_401", "op": ">", "threshold": 10, "severity": "warning", "enabled": true},
                {"id": 5, "name": "Service unavailable", "metric": "err_503", "op": ">", "threshold": 3, "severity": "critical", "enabled": true}
            ]
        }
    }
    p := json.parse(r.value)
    if p.ok { p.value } else { {"channels": [], "rules": []} }
}

fn save_alert_config(config) {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    if !fs.exists(dir) { fs.mkdir(dir) }
    fs.write_atomic(alerts_config_path(), json.stringify(config))
}

fn load_alert_history() {
    r := fs.read(alerts_history_path())
    if !r.ok { return [] }
    p := json.parse(r.value)
    if p.ok { p.value } else { [] }
}

fn save_alert_history(history) {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    if !fs.exists(dir) { fs.mkdir(dir) }
    fs.write_atomic(alerts_history_path(), json.stringify(history))
}

fn add_alert_history(alert) {
    hist := load_alert_history()
    // Keep last 100
    mut trimmed := hist
    if len(trimmed) >= 100 {
        // Drop oldest (first element) — rebuild via JSON
        mut s := "["
        mut i := len(trimmed) - 99
        mut first := true
        while i < len(trimmed) {
            if !first { s = s + "," }
            s = s + json.stringify(trimmed[i])
            first = false
            i = i + 1
        }
        trimmed = json.parse(s + "]").value
    }
    save_alert_history(list_append(trimmed, alert))
}

// Fire alert to all configured channels
// Webhook with retry (3 attempts, 1s backoff)
fn post_with_retry(url, body) {
    mut attempt := 0
    while attempt < 3 {
        r := http.post(url, body, {"headers": {"Content-Type": "application/json"}})
        if r.ok { return }
        attempt = attempt + 1
        if attempt < 3 { time.sleep(1) }
    }
}

fn fire_alert(config, rule_name, severity, message) {
    channels := config["channels"] ?? []
    ts := time.unix()
    payload := {
        "rule": rule_name,
        "severity": severity,
        "message": message,
        "timestamp": ts,
        "source": "zaman"
    }
    // Record history
    add_alert_history(payload)

    for ch in channels {
        ch_type := ch["type"] ?? ""
        if ch_type == "slack" {
            url := ch["webhook_url"] ?? ""
            if url != "" {
                icon := if severity == "critical" { ":rotating_light:" } else { ":warning:" }
                slack_payload := json.stringify({
                    "text": icon + " *Zaman Alert — " + severity + "*\n" + message,
                    "username": "Zaman",
                    "icon_emoji": ":telephone:"
                })
                post_with_retry(url, slack_payload)
            }
        } else if ch_type == "webhook" {
            url := ch["url"] ?? ""
            if url != "" {
                post_with_retry(url, json.stringify(payload))
            }
        } else if ch_type == "email" {
            to_addr := ch["to"] ?? ""
            smtp_host := ch["smtp_host"] ?? "localhost"
            smtp_port := int.parse(ch["smtp_port"] ?? "25").unwrap_or(25)
            from_addr := ch["from"] ?? "zaman@localhost"
            if to_addr != "" {
                email.send({
                    "to": to_addr,
                    "from": from_addr,
                    "subject": "[Zaman " + severity + "] " + rule_name,
                    "body": message + "\n\nTimestamp: " + ("" + (ts)) + "\nSource: zaman-web",
                    "host": smtp_host,
                    "port": smtp_port
                })
            }
        }
    }
}

// Evaluate alert rules against real-time data. Called by HTMX poll.
// Returns HTML for the alerts bar + fires notifications.
fn evaluate_alerts(rt) {
    config := load_alert_config()
    rules := config["rules"] ?? []
    mut fired := []
    for rule in rules {
        enabled := rule["enabled"] ?? false
        if !enabled { continue }
        metric_name := rule["metric"] ?? ""
        op := rule["op"] ?? ">"
        threshold := rule["threshold"] ?? 0
        value := rt[metric_name] ?? 0
        mut triggered := false
        if op == ">" && value > threshold { triggered = true }
        if op == "<" && value < threshold && value > 0 { triggered = true }
        if op == ">=" && value >= threshold { triggered = true }
        if op == "==" && value == threshold { triggered = true }
        if triggered {
            name := rule["name"] ?? metric_name
            sev := rule["severity"] ?? "warning"
            msg := name + ": " + metric_name + "=" + ("" + (value)) + " (threshold " + op + " " + ("" + (threshold)) + ")"
            fire_alert(config, name, sev, msg)
            fired = list_append(fired, {"name": name, "severity": sev, "message": msg, "value": value})
        }
    }
    fired
}

// ---- report helpers ----

fn gauge_card(label, value, unit_label, color, sub) {
    crd := "card"
    "<div class=\"" + crd + " p-5\">" +
    "<div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold mb-3\">" + label + "</div>" +
    "<div class=\"flex items-end gap-1 mb-2\">" +
    "<span class=\"text-3xl font-bold mono\" style=\"color:" + color + "\">" + ("" + (value)) + "</span>" +
    "<span class=\"text-sm text-[#52525b] mb-0.5\">" + unit_label + "</span></div>" +
    "<div class=\"w-full h-1.5 rounded-full bg-[#27272a] overflow-hidden\">" +
    "<div class=\"h-full rounded-full transition-all duration-500\" style=\"width:" + ("" + (value)) + "%;background:" + color + "\"></div></div>" +
    "<div class=\"text-[11px] text-[#52525b] mt-2\">" + sub + "</div></div>"
}

fn rcode_bar(label, count, total, color) {
    pct := if total > 0 { count * 100 / total } else { 0 }
    "<div class=\"flex items-center gap-3 py-1.5\">" +
    "<span class=\"text-xs font-semibold w-8 mono\" style=\"color:" + color + "\">" + label + "</span>" +
    "<div class=\"flex-1 h-2 rounded-full bg-[#27272a] overflow-hidden\">" +
    "<div class=\"h-full rounded-full\" style=\"width:" + ("" + (pct)) + "%;background:" + color + "\"></div></div>" +
    "<span class=\"text-xs mono text-[#a1a1aa] w-12 text-right\">" + ("" + (count)) + "</span>" +
    "<span class=\"text-[10px] text-[#52525b] w-10 text-right\">" + ("" + (pct)) + "%</span></div>"
}

// ---- main ----

fn load_or_create_token_secret() {
    dir := env.get("ZAMAN_DATA_DIR") ?? "data"
    if !fs.exists(dir) { fs.mkdir(dir) }
    path := dir + "/zaman-token-secret"
    r := fs.read(path)
    if r.ok && len(r.value) >= 32 {
        return str.trim(r.value)
    }
    s := secrets.token_hex(32)
    fs.write_atomic(path, s)
    fs.chmod(path, 384)
    s
}

fn main {
    // HMAC secret — persisted to disk so sessions survive restarts.
    token_secret := load_or_create_token_secret()

    if auth_enabled() {
        auth_init(token_secret)
    }

    app := web.app()

    // ---- auth routes ----

    app.get("/favicon.svg", fn(req) {
        svg := "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\">" +
            "<defs><linearGradient id=\"g\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">" +
            "<stop offset=\"0%\" stop-color=\"#a78bfa\"/><stop offset=\"100%\" stop-color=\"#6d28d9\"/>" +
            "</linearGradient></defs>" +
            "<rect width=\"32\" height=\"32\" rx=\"7\" fill=\"url(#g)\"/>" +
            "<text x=\"16\" y=\"23\" text-anchor=\"middle\" font-family=\"system-ui,sans-serif\" font-weight=\"900\" font-size=\"20\" fill=\"#fff\">Z</text></svg>"
        {"status": 200, "headers": {"Content-Type": "image/svg+xml", "Cache-Control": "public, max-age=86400"}, "body": svg}
    })

    app.get("/favicon.ico", fn(req) {
        {"status":302,"headers":{"Location":"/favicon.svg","Cache-Control":"public, max-age=86400"},"body":""}
    })

    app.get("/login", fn(req) {
        if !ip_allowed(req) { return web.html(ip_denied_page()) }
        if !auth_enabled() { return {"status": 302, "headers": {"Location": "/"}, "body": ""} }
        user := get_user(req, token_secret)
        if user != null { return {"status": 302, "headers": {"Location": "/"}, "body": ""} }
        web.html(login_page(""))
    })

    app.post("/login", fn(req) {
        if !auth_enabled() { return {"status": 302, "headers": {"Location": "/"}, "body": ""} }
        client_ip := get_client_ip(req)
        if !check_login_rate(client_ip) {
            return web.html(login_page("Too many login attempts. Please wait 60 seconds."))
        }
        username := web.form_get(req, "username", "")
        password := web.form_get(req, "password", "")
        token := do_login(token_secret, username, password)
        if token == null {
            record_failed_login(client_ip)
            audit(username, "login_failed", "bad credentials")
            return web.html(login_page("Invalid username or password."))
        }
        audit(username, "login", "success")
        set_session_cookie(token)
    })

    app.get("/logout", fn(req) {
        clear_session_cookie()
    })

    // ---- dashboard routes (auth-wrapped) ----

    app.get("/", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        web.html(layout("Overview", overview_body_v2(user), user))
    })

    app.get("/noc", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        nodes := fetch_nodes()
        names := load_node_names()

        mut green := 0
        mut yellow := 0
        mut red := 0
        mut error_nodes := 0
        mut recent_total := 0
        mut active_calls := 0
        for nd in nodes {
            st := nd["status"] ?? "red"
            if st == "green" { green = green + 1 }
            else if st == "yellow" { yellow = yellow + 1 }
            else { red = red + 1 }
            if (nd["errors"] ?? 0) > 0 { error_nodes = error_nodes + 1 }
            recent_total = recent_total + (nd["recent"] ?? 0)
            active_calls = active_calls + (nd["calls"] ?? 0)
        }
        mut alerts := ""
        if red > 0 {
            alerts = "<div class=\"space-y-1.5 mb-5\"><div class=\"flex items-center gap-2 rounded-lg border border-[#f87171]/20 bg-[#f87171]/5 px-3 py-2 text-xs text-[#f87171]\"><span>&#x26A0;</span><span class=\"mono font-semibold\">" + ("" + (red)) + "</span> node(s) have not reported in over 5 minutes.</div></div>"
        } else if yellow > 0 {
            alerts = "<div class=\"space-y-1.5 mb-5\"><div class=\"flex items-center gap-2 rounded-lg border border-[#fbbf24]/20 bg-[#fbbf24]/5 px-3 py-2 text-xs text-[#fbbf24]\"><span>&#x26A0;</span><span class=\"mono font-semibold\">" + ("" + (yellow)) + "</span> node(s) are stale by more than 60 seconds.</div></div>"
        }
        health_word := if red > 0 { "Offline nodes need attention" } else if yellow > 0 { "Some nodes are stale" } else { "All reporting nodes are healthy" }
        summary := "<div class=\"grid grid-cols-2 lg:grid-cols-6 gap-3 mb-5\">" +
            "<div class=\"card p-4\"><div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold\">Healthy</div><div class=\"text-2xl font-bold mono mt-1 text-[#34d399]\">" + ("" + (green)) + "</div></div>" +
            "<div class=\"card p-4\"><div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold\">Degraded</div><div class=\"text-2xl font-bold mono mt-1 text-[#fbbf24]\">" + ("" + (yellow)) + "</div></div>" +
            "<div class=\"card p-4\"><div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold\">Offline</div><div class=\"text-2xl font-bold mono mt-1 text-[#f87171]\">" + ("" + (red)) + "</div></div>" +
            "<div class=\"card p-4\"><div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold\">Tracked calls</div><div class=\"text-2xl font-bold mono mt-1 text-[#a78bfa]\">" + ("" + (active_calls)) + "</div></div>" +
            "<div class=\"card p-4\"><div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold\">Messages 5m</div><div class=\"text-2xl font-bold mono mt-1\">" + ("" + (recent_total)) + "</div></div>" +
            "<div class=\"card p-4\"><div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold\">Error nodes</div><div class=\"text-2xl font-bold mono mt-1 " + (if error_nodes > 0 { "text-[#f87171]" } else { "text-[#34d399]" }) + "\">" + ("" + (error_nodes)) + "</div></div></div>"

        body := "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
            "<div><h1 class=\"text-xl font-semibold\">Network Operations</h1>" +
            "<p class=\"text-sm text-[#52525b] mt-0.5\">" + health_word + " · table refreshes every 5 seconds</p></div>" +
            "<a href=\"/messages\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7] hover:border-[#3f3f46]\">Message groups</a></div>" +
            alerts + summary +
            "<div class=\"card overflow-x-auto\" hx-get=\"/partials/noc-table\" hx-trigger=\"every 5s\" hx-swap=\"innerHTML\">" +
            noc_nodes_table(nodes, names, user, req, token_secret) + "</div>"
        web.html(layout("NOC", body, user))
    })

    app.post("/noc/node-name", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "operator") { return {"status":403,"body":"Forbidden"} }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        agent := str.trim(web.form_get(req, "agent", ""))
        display_name := str.trim(web.form_get(req, "display_name", ""))
        if agent == "" { return {"status":302,"headers":{"Location":"/noc"},"body":""} }
        mut names := load_node_names()
        if display_name == "" || display_name == agent {
            names[agent] = null
        } else {
            names[agent] = display_name
        }
        save_node_names(names)
        {"status":302,"headers":{"Location":"/noc"},"body":""}
    })

    app.get("/partials/status", fn(req) {
        m := fetch_health()
        if m["ok"] == true {
            web.htmx("<span class=\"text-[#34d399]\">● core up</span>")
        } else {
            web.htmx("<span class=\"text-[#f87171]\">● core down</span>")
        }
    })

    app.get("/partials/noc-table", fn(req) {
        user := get_user(req, token_secret)
        if auth_enabled() && user == null { return web.htmx("") }
        nodes := fetch_nodes()
        names := load_node_names()
        web.htmx(noc_nodes_table(nodes, names, user, req, token_secret))
    })

    app.get("/partials/charts", fn(req) {
        if auth_enabled() && get_user(req, token_secret) == null { return web.htmx("") }
        win := int.parse(req.query_map["window"] ?? "5").unwrap_or(5)
        web.htmx(build_traffic_charts(win))
    })

    app.get("/partials/metrics-rankings", fn(req) {
        if auth_enabled() && get_user(req, token_secret) == null { return web.htmx("") }
        agents := fetch_agents()
        talkers := fetch_top_talkers()
        th := "text-[10px] uppercase tracking-wider text-[#52525b] font-semibold"
        mut agent_rows := ""
        mut rank := 1
        for a in agents {
            aname := h(a["agent"] ?? "")
            amsg := a["messages"] ?? 0
            acall := a["calls"] ?? 0
            agent_rows = agent_rows + "<tr><td class=\"py-2 px-3 mono text-[11px] text-[#52525b]\">" + ("" + (rank)) + "</td><td class=\"py-2 px-3\"><a class=\"text-sm hover:text-[#e4e4e7] hover:underline\" href=\"/messages?agent=" + aname + "\">" + aname + "</a></td><td class=\"py-2 px-3 mono text-right\">" + ("" + (amsg)) + "</td><td class=\"py-2 px-3 mono text-right\">" + ("" + (acall)) + "</td></tr>"
            rank = rank + 1
        }
        if agent_rows == "" { agent_rows = "<tr><td colspan=\"4\" class=\"py-6 text-center text-sm text-[#71717a]\">No HEP agents reporting.</td></tr>" }

        mut talker_rows := ""
        rank = 1
        for t in talkers {
            tsrc := h(t["src"] ?? "")
            tip := endpoint_ip(t["src"] ?? "")
            tmsg := t["messages"] ?? 0
            tcall := t["calls"] ?? 0
            talker_rows = talker_rows + "<tr><td class=\"py-2 px-3 mono text-[11px] text-[#52525b]\">" + ("" + (rank)) + "</td><td class=\"py-2 px-3\"><a class=\"mono text-xs hover:text-[#e4e4e7] hover:underline\" href=\"/ip?addr=" + h(tip) + "\">" + tsrc + "</a></td><td class=\"py-2 px-3 mono text-right\">" + ("" + (tmsg)) + "</td><td class=\"py-2 px-3 mono text-right\">" + ("" + (tcall)) + "</td></tr>"
            rank = rank + 1
        }
        if talker_rows == "" { talker_rows = "<tr><td colspan=\"4\" class=\"py-6 text-center text-sm text-[#71717a]\">No talkers captured.</td></tr>" }

        web.htmx("<div class=\"grid xl:grid-cols-2 gap-4\">" +
            "<div class=\"card overflow-x-auto\"><div class=\"px-4 pt-4 section-title\">Agents</div><table class=\"w-full text-left text-sm mt-3\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\"><th class=\"py-2 px-3\">#</th><th class=\"py-2 px-3\">Agent</th><th class=\"py-2 px-3 text-right\">Msgs</th><th class=\"py-2 px-3 text-right\">Calls</th></tr></thead><tbody class=\"divide-y divide-[#1e1e22]/50\">" + agent_rows + "</tbody></table></div>" +
            "<div class=\"card overflow-x-auto\"><div class=\"px-4 pt-4 section-title\">Top Talkers</div><table class=\"w-full text-left text-sm mt-3\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\"><th class=\"py-2 px-3\">#</th><th class=\"py-2 px-3\">Endpoint</th><th class=\"py-2 px-3 text-right\">Msgs</th><th class=\"py-2 px-3 text-right\">Calls</th></tr></thead><tbody class=\"divide-y divide-[#1e1e22]/50\">" + talker_rows + "</tbody></table></div></div>")
    })

    app.get("/partials/metrics-endpoints", fn(req) {
        if auth_enabled() && get_user(req, token_secret) == null { return web.htmx("") }
        endpoint_items := fetch_messages_ex(90, "", "", "", "", "", "", "", "")
        th := "text-[10px] uppercase tracking-wider text-[#52525b] font-semibold"
        web.htmx(
            "<div class=\"mb-3 text-[10px] text-[#52525b] mono\">last " + ("" + (len(endpoint_items))) + " messages</div>" +
            "<div class=\"grid xl:grid-cols-3 gap-4\">" +
            "<div class=\"card overflow-x-auto\"><div class=\"p-4 border-b border-[#1e1e22]\"><div class=\"section-title mb-0\">Top Source IPs</div><div class=\"text-[11px] text-[#71717a] mt-1\">Where captured messages are coming from.</div></div>" +
            "<table class=\"w-full text-left\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\"><th class=\"py-2 px-3\">Source</th><th class=\"py-2 px-3 text-right\">Msgs</th></tr></thead><tbody class=\"divide-y divide-[#1e1e22]/50\">" + report_endpoint_rows(endpoint_items, "src", 10) + "</tbody></table></div>" +
            "<div class=\"card overflow-x-auto\"><div class=\"p-4 border-b border-[#1e1e22]\"><div class=\"section-title mb-0\">Top Destination IPs</div><div class=\"text-[11px] text-[#71717a] mt-1\">Where captured messages are being sent.</div></div>" +
            "<table class=\"w-full text-left\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\"><th class=\"py-2 px-3\">Destination</th><th class=\"py-2 px-3 text-right\">Msgs</th></tr></thead><tbody class=\"divide-y divide-[#1e1e22]/50\">" + report_endpoint_rows(endpoint_items, "dst", 10) + "</tbody></table></div>" +
            "<div class=\"card overflow-x-auto\"><div class=\"p-4 border-b border-[#1e1e22]\"><div class=\"section-title mb-0\">Source to Destination Paths</div><div class=\"text-[11px] text-[#71717a] mt-1\">Most common observed traffic directions.</div></div>" +
            "<table class=\"w-full text-left\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\"><th class=\"py-2 px-3\">Path</th><th class=\"py-2 px-3 text-right\">Msgs</th></tr></thead><tbody class=\"divide-y divide-[#1e1e22]/50\">" + report_route_rows(endpoint_items, 10) + "</tbody></table></div>" +
            "</div>"
        )
    })

    app.get("/partials/metrics-capacity", fn(req) {
        if auth_enabled() && get_user(req, token_secret) == null { return web.htmx("") }
        rt5 := fetch_realtime(5)
        invite_items := fetch_messages_ex(90, "", "", "", "INVITE", "", "", "", "")
        th := "text-[10px] uppercase tracking-wider text-[#52525b] font-semibold"
        inv5 := rt5["invites"] ?? 0
        active := rt5["active_calls"] ?? 0
        byes := rt5["byes"] ?? 0
        registers := rt5["registers"] ?? 0
        options := rt5["options"] ?? 0
        cps5 := per_second_label(inv5, 300)
        cpm5 := inv5 / 5
        mut answered := 0
        mut failed := 0
        for m in invite_items {
            st := m["status"] ?? 0
            if st >= 200 && st < 300 { answered = answered + 1 }
            if st >= 400 { failed = failed + 1 }
        }
        web.htmx(
            "<div class=\"grid grid-cols-2 md:grid-cols-4 xl:grid-cols-8 gap-3 mb-4\">" +
            call_fact("CPS 5m", cps5, "INVITEs / second", "#38bdf8") +
            call_fact("Invite rows", "" + (len(invite_items)), "sample used below", "#a78bfa") +
            call_fact("Calls / min", "" + (cpm5), "5m average", "#fbbf24") +
    call_fact("Concurrent calls", "" + (active), "open dialogs in the live window", "#f472b6") +
            call_fact("Attempts", "" + (inv5), "INVITEs in 5m", "#e4e4e7") +
            call_fact("Completions", "" + (byes), "BYE in 5m", "#34d399") +
            call_fact("Registers", "" + (registers), "separate from calls", "#22d3ee") +
            call_fact("OPTIONS", "" + (options), "keepalive/probe", "#71717a") +
            "</div>" +
            "<div class=\"grid xl:grid-cols-3 gap-4\">" +
            "<div class=\"card overflow-x-auto\"><div class=\"p-4 border-b border-[#1e1e22]\"><div class=\"section-title mb-0\">Who Is Sending Calls</div><div class=\"text-[11px] text-[#71717a] mt-1\">Top caller origin IPs by distinct Call-ID.</div></div>" +
            "<table class=\"w-full text-left\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\"><th class=\"py-2 px-3\">Origin</th><th class=\"py-2 px-3 text-right\">Calls</th></tr></thead><tbody class=\"divide-y divide-[#1e1e22]/50\">" + report_origin_rows(invite_items, 10) + "</tbody></table></div>" +
            "<div class=\"card overflow-x-auto\"><div class=\"p-4 border-b border-[#1e1e22]\"><div class=\"section-title mb-0\">Where Calls Are Going</div><div class=\"text-[11px] text-[#71717a] mt-1\">Top INVITE destination IPs.</div></div>" +
            "<table class=\"w-full text-left\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\"><th class=\"py-2 px-3\">Destination</th><th class=\"py-2 px-3 text-right\">INVITEs</th></tr></thead><tbody class=\"divide-y divide-[#1e1e22]/50\">" + report_endpoint_rows(invite_items, "dst", 10) + "</tbody></table></div>" +
            "<div class=\"card overflow-x-auto\"><div class=\"p-4 border-b border-[#1e1e22]\"><div class=\"section-title mb-0\">Call Paths</div><div class=\"text-[11px] text-[#71717a] mt-1\">Most common INVITE source-to-destination paths.</div></div>" +
            "<table class=\"w-full text-left\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\"><th class=\"py-2 px-3\">Path</th><th class=\"py-2 px-3 text-right\">INVITEs</th></tr></thead><tbody class=\"divide-y divide-[#1e1e22]/50\">" + report_route_rows(invite_items, 10) + "</tbody></table></div>" +
            "</div><div class=\"mt-3 text-[10px] text-[#52525b] mono\">sampled " + ("" + (len(invite_items))) + " recent INVITE rows · answered " + ("" + (answered)) + " · failed " + ("" + (failed)) + "</div>"
        )
    })

    app.get("/partials/metrics-nodes", fn(req) {
        user := get_user(req, token_secret)
        if auth_enabled() && user == null { return web.htmx("") }
        nodes := fetch_nodes()
        names := load_node_names()
        mut green := 0
        mut yellow := 0
        mut red := 0
        for node in nodes {
            st := node["status"] ?? "red"
            if st == "green" { green = green + 1 }
            else if st == "yellow" { yellow = yellow + 1 }
            else { red = red + 1 }
        }
        web.htmx("<div class=\"grid grid-cols-3 gap-3 mb-3\">" +
            call_fact("Healthy", "" + (green), "reporting now", "#34d399") +
            call_fact("Degraded", "" + (yellow), "stale heartbeat", "#fbbf24") +
            call_fact("Offline", "" + (red), "not reporting", "#f87171") +
            "</div><div class=\"card overflow-x-auto\">" + noc_nodes_table(nodes, names, user, req, token_secret) + "</div>")
    })

    app.get("/partials/ip-history", fn(req) {
        if auth_enabled() && get_user(req, token_secret) == null { return web.htmx("") }
        raw_addr := str.trim(req.query_map["addr"] ?? req.query_map["src"] ?? "")
        addr := if raw_addr != "" { endpoint_ip(raw_addr) } else { "" }
        since_ms := req.query_map["since_ms"] ?? ""
        until_ms := req.query_map["until_ms"] ?? ""
        if addr == "" { return web.htmx("") }
        web.htmx(ip_history_panel_time(addr, since_ms, until_ms))
    })

    app.get("/partials/sla-details", fn(req) {
        if auth_enabled() && get_user(req, token_secret) == null { return web.htmx("") }
        web.htmx(sla_detail_tables(load_sla_targets()))
    })

    app.get("/partials/related-calls", fn(req) {
        if auth_enabled() && get_user(req, token_secret) == null { return web.htmx("") }
        cid := req.query_map["call_id"] ?? ""
        if cid == "" { return web.htmx("") }
        web.htmx(related_calls_panel(cid))
    })

    app.get("/partials/report-telecom-kpis", fn(req) {
        if auth_enabled() && get_user(req, token_secret) == null { return web.htmx("") }
        kpi := fetch_kpi()
        all_asr := kpi["asr"] ?? 0
        all_ner := kpi["ner"] ?? 0
        all_asr_c := if all_asr >= 70 { "#34d399" } else if all_asr >= 40 { "#fbbf24" } else { "#f87171" }
        all_ner_c := if all_ner >= 80 { "#34d399" } else if all_ner >= 50 { "#fbbf24" } else { "#f87171" }
        web.htmx("<div class=\"grid grid-cols-2 gap-3\">" +
            call_fact("ASR", "" + (all_asr) + "%", "answered / INVITEs", all_asr_c) +
            call_fact("NER", "" + (all_ner) + "%", "effective / INVITEs", all_ner_c) +
            call_fact("INVITEs", "" + (kpi["total_invites"] ?? 0), "answered " + ("" + (kpi["answered"] ?? 0)), "#38bdf8") +
            call_fact("Failed", "" + (kpi["failed"] ?? 0), "4xx+ on INVITE", "#f87171") +
            call_fact("Registers", "" + (kpi["total_registers"] ?? 0), "ok " + ("" + (kpi["reg_ok"] ?? 0)), "#a78bfa") +
            call_fact("Reg failures", "" + (kpi["reg_fail"] ?? 0), "auth/denied", "#fbbf24") +
            "</div>")
    })

    app.get("/partials/nodes", fn(req) {
        if auth_enabled() && get_user(req, token_secret) == null { return web.htmx("") }
        nodes := fetch_nodes()
        crd := "card"
        mut ncards := ""
        for nd in nodes {
            nname := h(nd["agent"] ?? "")
            nstatus := nd["status"] ?? "red"
            nrecent := nd["recent"] ?? 0
            nerrors := nd["errors"] ?? 0
            ncalls := nd["calls"] ?? 0
            nage := nd["age_sec"] ?? 9999
            dot := if nstatus == "green" { "bg-[#34d399]" } else if nstatus == "yellow" { "bg-[#fbbf24]" } else { "bg-[#f87171]" }
            age_txt := if nage < 60 { ("" + (nage)) + "s ago" } else if nage < 3600 { ("" + (nage / 60)) + "m ago" } else { ("" + (nage / 3600)) + "h ago" }
            ncards = ncards +
                "<a href=\"/messages?agent=" + nname + "\" class=\"" + crd + " p-4 hover:border-[#3f3f46] transition-colors block\">" +
                "<div class=\"flex items-center gap-2 mb-2\">" +
                "<div class=\"w-2 h-2 rounded-full " + dot + " shrink-0\"></div>" +
                "<span class=\"text-sm font-medium truncate\">" + nname + "</span></div>" +
                "<div class=\"grid grid-cols-3 gap-2 text-[11px]\">" +
                "<div><span class=\"text-[#52525b]\">5m</span> <span class=\"mono\">" + ("" + (nrecent)) + "</span></div>" +
                "<div><span class=\"text-[#52525b]\">calls</span> <span class=\"mono\">" + ("" + (ncalls)) + "</span></div>" +
                "<div><span class=\"text-[#52525b]\">errs</span> <span class=\"mono " + (if nerrors > 0 { "text-[#f87171]" } else { "" }) + "\">" + ("" + (nerrors)) + "</span></div></div>" +
                "<div class=\"text-[10px] text-[#52525b] mt-1.5\">" + age_txt + "</div></a>"
        }
        if ncards == "" { ncards = "<div class=\"text-sm text-[#52525b] py-4\">No nodes reporting.</div>" }
        web.htmx("<div class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3\">" + ncards + "</div>")
    })

    app.get("/partials/messages", fn(req) {
        if auth_enabled() && get_user(req, token_secret) == null { return web.htmx("") }
        mut lim := int.parse(req.query_map["limit"] ?? "300").unwrap_or(0)
        if lim <= 0 { lim = 300 }
        if lim > 500 { lim = 500 }
        cid := req.query_map["call_id"] ?? ""
        agent := req.query_map["agent"] ?? ""
        method := req.query_map["method"] ?? ""
        transport := req.query_map["transport"] ?? ""
        src := req.query_map["ip"] ?? req.query_map["src"] ?? ""
        from_number := req.query_map["from_number"] ?? ""
        to_number := req.query_map["to_number"] ?? ""
        status := req.query_map["status"] ?? ""
        since_ms := req.query_map["since_ms"] ?? ""
        until_ms := req.query_map["until_ms"] ?? ""
        items := fetch_messages_time(lim, cid, transport, agent, method, src, from_number, to_number, status, since_ms, until_ms)
        if cid != "" || method == "OPTIONS" {
            web.htmx(messages_table(items))
        } else {
            web.htmx(call_groups_table(items))
        }
    })

    app.get("/partials/live-calls", fn(req) {
        if auth_enabled() && get_user(req, token_secret) == null { return web.htmx("") }
        web.htmx(live_calls_panel())
    })

    app.get("/partials/overview-realtime", fn(req) {
        if auth_enabled() && get_user(req, token_secret) == null { return web.htmx("") }
        agent := req.query_map["agent"] ?? ""
        web.htmx(overview_realtime_panel_agent(agent))
    })

    app.get("/partials/live-feed", fn(req) {
        if auth_enabled() && get_user(req, token_secret) == null { return web.htmx("") }
        method := req.query_map["method"] ?? "INVITE"
        web.htmx(dashboard_live_feed_panel(method))
    })

    app.get("/partials/active-calls", fn(req) {
        if auth_enabled() && get_user(req, token_secret) == null { return web.htmx("") }
        agent := req.query_map["agent"] ?? ""
        web.htmx(active_calls_panel_agent(agent))
    })

    app.get("/messages", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        cid := req.query_map["call_id"] ?? ""
        agent := req.query_map["agent"] ?? ""
        method := req.query_map["method"] ?? ""
        transport := req.query_map["transport"] ?? ""
        src := req.query_map["ip"] ?? req.query_map["src"] ?? ""
        from_number := req.query_map["from_number"] ?? ""
        to_number := req.query_map["to_number"] ?? ""
        status := req.query_map["status"] ?? ""
        since_ms := req.query_map["since_ms"] ?? ""
        until_ms := req.query_map["until_ms"] ?? ""
        list_limit := if cid != "" { 300 } else { 300 }
        items := fetch_messages_time(list_limit, cid, transport, agent, method, src, from_number, to_number, status, since_ms, until_ms)
        cid_h := h(cid)
        agent_h := h(agent)
        nodes := fetch_nodes()
        names := load_node_names()
        node_opts := node_select_options(nodes, names, agent)
        method_h := h(method)
        transport_h := h(transport)
        src_h := h(src)
        from_h := h(from_number)
        to_h := h(to_number)
        status_h := h(status)
        since_h := h(since_ms)
        until_h := h(until_ms)
        // Active filter summary
        mut active := ""
        if cid != "" || agent != "" || method != "" || transport != "" || src != "" || from_number != "" || to_number != "" || status != "" || since_ms != "" || until_ms != "" {
            mut tags := ""
            if cid != "" { tags = tags + "<span class=\"inline-flex items-center gap-1 rounded-md bg-[#27272a] px-2 py-1 text-xs mono\">call-id: " + cid_h + "</span>" }
            if agent != "" { tags = tags + "<span class=\"inline-flex items-center gap-1 rounded-md bg-[#27272a] px-2 py-1 text-xs mono\">agent: " + agent_h + "</span>" }
            if method != "" { tags = tags + "<span class=\"inline-flex items-center gap-1 rounded-md bg-[#27272a] px-2 py-1 text-xs mono\">method: " + method_h + "</span>" }
            if transport != "" { tags = tags + "<span class=\"inline-flex items-center gap-1 rounded-md bg-[#27272a] px-2 py-1 text-xs mono\">transport: " + transport_h + "</span>" }
            if src != "" { tags = tags + "<span class=\"inline-flex items-center gap-1 rounded-md bg-[#27272a] px-2 py-1 text-xs mono\">ip: " + src_h + "</span>" }
            if from_number != "" { tags = tags + "<span class=\"inline-flex items-center gap-1 rounded-md bg-[#27272a] px-2 py-1 text-xs mono\">from: " + from_h + "</span>" }
            if to_number != "" { tags = tags + "<span class=\"inline-flex items-center gap-1 rounded-md bg-[#27272a] px-2 py-1 text-xs mono\">to: " + to_h + "</span>" }
            if status != "" { tags = tags + "<span class=\"inline-flex items-center gap-1 rounded-md bg-[#27272a] px-2 py-1 text-xs mono\">status: " + status_h + "</span>" }
            if since_ms != "" { tags = tags + "<span class=\"inline-flex items-center gap-1 rounded-md bg-[#27272a] px-2 py-1 text-xs mono\">from ts: " + since_h + "</span>" }
            if until_ms != "" { tags = tags + "<span class=\"inline-flex items-center gap-1 rounded-md bg-[#27272a] px-2 py-1 text-xs mono\">to ts: " + until_h + "</span>" }
            active = "<div class=\"flex flex-wrap items-center gap-2 mb-4\">" +
                "<span class=\"text-xs text-[#71717a]\">Filtering:</span>" + tags +
                "<a href=\"/messages\" class=\"text-xs text-[#a78bfa] hover:underline\">clear all</a></div>"
        }
        // Build query string for HTMX polling
        mut qs := "limit=" + ("" + (list_limit))
        if cid != "" { qs = qs + "&call_id=" + q(cid) }
        if agent != "" { qs = qs + "&agent=" + q(agent) }
        if method != "" { qs = qs + "&method=" + q(method) }
        if transport != "" { qs = qs + "&transport=" + q(transport) }
        if src != "" { qs = qs + "&ip=" + q(src) }
        if from_number != "" { qs = qs + "&from_number=" + q(from_number) }
        if to_number != "" { qs = qs + "&to_number=" + q(to_number) }
        if status != "" { qs = qs + "&status=" + q(status) }
        if since_ms != "" { qs = qs + "&since_ms=" + q(since_ms) }
        if until_ms != "" { qs = qs + "&until_ms=" + q(until_ms) }
        // Saved searches sidebar
        searches := load_searches()
        mut saved_html := ""
        if len(searches) > 0 {
            mut slinks := ""
            for ss in searches {
                sid := ss["id"] ?? 0
                sname := h(ss["name"] ?? "")
                sp := ss["params"] ?? {}
                mut sq := ""
                if (sp["call_id"] ?? "") != "" { sq = sq + "&call_id=" + q(sp["call_id"]) }
                if (sp["agent"] ?? "") != "" { sq = sq + "&agent=" + q(sp["agent"]) }
                if (sp["method"] ?? "") != "" { sq = sq + "&method=" + q(sp["method"]) }
                if (sp["transport"] ?? "") != "" { sq = sq + "&transport=" + q(sp["transport"]) }
                if (sp["ip"] ?? "") != "" { sq = sq + "&ip=" + q(sp["ip"]) }
                else if (sp["src"] ?? "") != "" { sq = sq + "&ip=" + q(sp["src"]) }
                if (sp["from_number"] ?? "") != "" { sq = sq + "&from_number=" + q(sp["from_number"]) }
                if (sp["to_number"] ?? "") != "" { sq = sq + "&to_number=" + q(sp["to_number"]) }
                if (sp["status"] ?? "") != "" { sq = sq + "&status=" + q(sp["status"]) }
                if (sp["since_ms"] ?? "") != "" { sq = sq + "&since_ms=" + q(sp["since_ms"]) }
                if (sp["until_ms"] ?? "") != "" { sq = sq + "&until_ms=" + q(sp["until_ms"]) }
                slinks = slinks + "<div class=\"flex items-center justify-between gap-2 py-1.5\">" +
                    "<a href=\"/messages?" + str.slice(sq, 1, len(sq)) + "\" class=\"text-xs text-[#a1a1aa] hover:text-[#e4e4e7] truncate\">" + sname + "</a>" +
                    "<form method=\"post\" action=\"/searches/" + ("" + (sid)) + "/delete\" class=\"shrink-0\">" +
                    "<button class=\"text-[10px] text-[#52525b] hover:text-[#f87171]\">&times;</button></form></div>"
            }
            saved_html = "<div class=\"card p-4 mb-4\">" +
                "<div class=\"text-[11px] text-[#71717a] uppercase tracking-wider font-medium mb-2\">Saved searches</div>" +
                slinks + "</div>"
        }
        // Save current search form (only show if filtering)
        mut save_form := ""
        if cid != "" || agent != "" || method != "" || transport != "" || src != "" || from_number != "" || to_number != "" || status != "" || since_ms != "" || until_ms != "" {
            save_form = "<form method=\"post\" action=\"/searches/save\" class=\"flex gap-2 items-center mt-3\">" +
                "<input type=\"hidden\" name=\"call_id\" value=\"" + cid_h + "\"/>" +
                "<input type=\"hidden\" name=\"agent\" value=\"" + agent_h + "\"/>" +
                "<input type=\"hidden\" name=\"method\" value=\"" + method_h + "\"/>" +
                "<input type=\"hidden\" name=\"transport\" value=\"" + transport_h + "\"/>" +
                "<input type=\"hidden\" name=\"ip\" value=\"" + src_h + "\"/>" +
                "<input type=\"hidden\" name=\"from_number\" value=\"" + from_h + "\"/>" +
                "<input type=\"hidden\" name=\"to_number\" value=\"" + to_h + "\"/>" +
                "<input type=\"hidden\" name=\"status\" value=\"" + status_h + "\"/>" +
                "<input type=\"hidden\" name=\"since_ms\" value=\"" + since_h + "\"/>" +
                "<input type=\"hidden\" name=\"until_ms\" value=\"" + until_h + "\"/>" +
                "<input name=\"name\" placeholder=\"Save this search as…\" required class=\"flex-1 rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-1.5 text-xs mono\"/>" +
                "<button class=\"rounded-lg px-3 py-1.5 text-xs border border-[#1e1e22] text-[#a1a1aa] hover:text-[#e4e4e7]\">Save</button></form>"
        }
        // Export buttons
        mut export_parts := []
        if cid != "" { export_parts = list_append(export_parts, "call_id=" + q(cid)) }
        if agent != "" { export_parts = list_append(export_parts, "agent=" + q(agent)) }
        if method != "" { export_parts = list_append(export_parts, "method=" + q(method)) }
        if transport != "" { export_parts = list_append(export_parts, "transport=" + q(transport)) }
        if src != "" { export_parts = list_append(export_parts, "ip=" + q(src)) }
        if from_number != "" { export_parts = list_append(export_parts, "from_number=" + q(from_number)) }
        if to_number != "" { export_parts = list_append(export_parts, "to_number=" + q(to_number)) }
        if status != "" { export_parts = list_append(export_parts, "status=" + q(status)) }
        if since_ms != "" { export_parts = list_append(export_parts, "since_ms=" + q(since_ms)) }
        if until_ms != "" { export_parts = list_append(export_parts, "until_ms=" + q(until_ms)) }
        mut export_qs := ""
        mut epi := 0
        while epi < len(export_parts) {
            if epi > 0 { export_qs = export_qs + "&" }
            export_qs = export_qs + export_parts[epi]
            epi = epi + 1
        }
        export_btns := "<div class=\"flex gap-2\">" +
            "<a href=\"/export/json" + (if export_qs != "" { "?" + export_qs } else { "" }) + "\" class=\"rounded-lg px-2.5 py-1.5 text-[11px] border border-[#1e1e22] text-[#71717a] hover:text-[#e4e4e7] transition-colors\">JSON</a>" +
            "<a href=\"/export/csv" + (if export_qs != "" { "?" + export_qs } else { "" }) + "\" class=\"rounded-lg px-2.5 py-1.5 text-[11px] border border-[#1e1e22] text-[#71717a] hover:text-[#e4e4e7] transition-colors\">CSV</a>" +
            (if cid != "" { "<a href=\"/pcap?call_id=" + q(cid) + "\" class=\"rounded-lg px-2.5 py-1.5 text-[11px] border border-[#1e1e22] text-[#71717a] hover:text-[#e4e4e7] transition-colors\">PCAP</a>" } else { "" }) +
            "</div>"
        live_qs := if agent != "" { "?agent=" + q(agent) } else { "" }
        live_calls := "<div class=\"section mb-5\">" +
            "<div class=\"flex items-center justify-between mb-3\"><div class=\"section-title mb-0\">Live Calls</div><span class=\"text-[10px] text-[#34d399]\">live</span></div>" +
            "<div id=\"messages-live-calls\" hx-get=\"/partials/active-calls" + live_qs + "\" hx-trigger=\"every 3s\" hx-swap=\"innerHTML\">" +
            active_calls_panel_agent(agent) + "</div></div>"

        inp := "rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 text-sm mono"
        body := "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
            "<div><h1 class=\"text-2xl font-bold\">Messages</h1>" +
            "<p class=\"text-sm text-[#71717a] mt-1\">" + (if cid != "" { "All SIP/HEP messages for the selected Call-ID." } else { "SIP/HEP captures grouped by Call-ID." }) + "</p></div>" +
            export_btns + "</div>" +
            saved_html +
            "<form class=\"card p-4 mb-5\" method=\"get\" action=\"/messages\">" +
            "<div class=\"grid grid-cols-2 md:grid-cols-4 xl:grid-cols-10 gap-3\">" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Call-ID</label>" +
            "<input name=\"call_id\" value=\"" + cid_h + "\" placeholder=\"any\" class=\"w-full " + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Server</label>" +
            "<select name=\"agent\" class=\"w-full " + inp + "\">" + node_opts + "</select></div>" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Method</label>" +
            "<input name=\"method\" value=\"" + method_h + "\" placeholder=\"INVITE\" class=\"w-full " + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Transport</label>" +
            "<input name=\"transport\" value=\"" + transport_h + "\" placeholder=\"UDP\" class=\"w-full " + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">IP Address</label>" +
            "<input name=\"ip\" value=\"" + src_h + "\" placeholder=\"source or destination\" class=\"w-full " + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">From Number</label>" +
            "<input name=\"from_number\" value=\"" + from_h + "\" placeholder=\"caller\" class=\"w-full " + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">To Number</label>" +
            "<input name=\"to_number\" value=\"" + to_h + "\" placeholder=\"callee\" class=\"w-full " + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Status</label>" +
            "<input name=\"status\" value=\"" + status_h + "\" placeholder=\"408\" class=\"w-full " + inp + "\"/></div>" +
            time_filter_fields("messages-time", since_h, until_h, inp) +
            "<div class=\"flex items-end gap-2\">" +
            "<button class=\"flex-1 rounded-lg px-3 py-2 text-sm bg-[#27272a] text-[#e4e4e7] hover:bg-[#3f3f46] transition-colors\">Search</button></div>" +
            "</div>" + save_form + "</form>" +
            active +
            live_calls +
            "<div id=\"msg-table\" hx-get=\"/partials/messages?" + qs + "\" hx-trigger=\"every 4s\" hx-swap=\"innerHTML\">" +
            (if cid != "" || method == "OPTIONS" { messages_table(items) } else { call_groups_table(items) }) + "</div>"
        web.html(layout("Messages", body, user))
    })

    app.get("/ip", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        raw_addr := str.trim(req.query_map["addr"] ?? req.query_map["src"] ?? "")
        addr := if raw_addr != "" { endpoint_ip(raw_addr) } else { "" }
        labels := load_site_labels()
        label := labels[addr] ?? ""
        addr_h := h(addr)
        label_h := h(label)
        since_ms := req.query_map["since_ms"] ?? ""
        until_ms := req.query_map["until_ms"] ?? ""
        since_h := h(since_ms)
        until_h := h(until_ms)
        time_qs := (if since_ms != "" { "&since_ms=" + since_h } else { "" }) + (if until_ms != "" { "&until_ms=" + until_h } else { "" })
        items := if addr != "" { fetch_messages_time(300, "", "", "", "", addr, "", "", "", since_ms, until_ms) } else { [] }

        mut src_count := 0
        mut dst_count := 0
        mut requests := 0
        mut responses := 0
        mut errors := 0
        mut timeout_408 := 0
        mut invites := 0
        mut registers := 0
        mut first_ts := 0
        mut last_ts := 0
        mut seen_calls := ""
        mut unique_calls := 0
        for m in items {
            src_ip := endpoint_ip(m["src"] ?? "")
            dst_ip := endpoint_ip(m["dst"] ?? "")
            if src_ip == addr { src_count = src_count + 1 }
            if dst_ip == addr { dst_count = dst_count + 1 }
            kind := m["kind"] ?? ""
            if kind == "response" { responses = responses + 1 } else { requests = requests + 1 }
            method := m["method"] ?? ""
            if method == "INVITE" { invites = invites + 1 }
            if method == "REGISTER" { registers = registers + 1 }
            st := m["status"] ?? 0
            if st >= 400 { errors = errors + 1 }
            if st == 408 { timeout_408 = timeout_408 + 1 }
            ts_ms := m["ts_ms"] ?? 0
            if first_ts == 0 || (ts_ms > 0 && ts_ms < first_ts) { first_ts = ts_ms }
            if ts_ms > last_ts { last_ts = ts_ms }
            cid := m["call_id"] ?? ""
            if cid != "" && !str.contains(seen_calls, "|" + cid + "|") {
                seen_calls = seen_calls + "|" + cid + "|"
                unique_calls = unique_calls + 1
            }
        }
        err_rate := if responses > 0 { errors * 100 / responses } else { 0 }
        timeout_rate := if responses > 0 { timeout_408 * 100 / responses } else { 0 }
        err_c := if errors == 0 { "#34d399" } else if err_rate < 10 { "#fbbf24" } else { "#f87171" }
        timeout_c := if timeout_408 == 0 { "#34d399" } else if timeout_rate < 10 { "#fbbf24" } else { "#f87171" }
        first_seen := if first_ts > 0 { time_ago(first_ts / 1000) } else { "never" }
        last_seen := if last_ts > 0 { time_ago(last_ts / 1000) } else { "never" }

        mut label_form := ""
        if addr != "" && has_role(user, "operator") {
            label_form = "<form method=\"post\" action=\"/ip/label\" class=\"card p-4 mb-5\">" +
                csrf_field(req, token_secret) +
                "<input type=\"hidden\" name=\"addr\" value=\"" + addr_h + "\"/>" +
                "<div class=\"grid md:grid-cols-[1fr_1fr_auto] gap-3 items-end\">" +
                "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">IP address</label>" +
                "<input name=\"addr_display\" value=\"" + addr_h + "\" disabled class=\"w-full rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 text-sm mono text-[#71717a]\"/></div>" +
                "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Site label</label>" +
                "<input name=\"label\" value=\"" + label_h + "\" placeholder=\"Customer / carrier / office name\" class=\"w-full rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 text-sm\"/></div>" +
                "<button class=\"rounded-lg px-4 py-2 text-sm bg-[#27272a] text-[#e4e4e7] hover:bg-[#3f3f46] transition-colors\">Save label</button></div></form>"
        }

        search := "<form class=\"card p-4 mb-5\" action=\"/ip\">" +
            "<div class=\"grid md:grid-cols-[1fr_220px_220px_auto] gap-3 items-end\">" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">IP address</label>" +
        "<input name=\"addr\" value=\"" + addr_h + "\" placeholder=\"IP address\" class=\"w-full rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 text-sm mono\"/></div>" +
            time_filter_fields("ip-time", since_h, until_h, "rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 text-sm mono") +
            "<button class=\"rounded-lg px-4 py-2 text-sm bg-[#27272a] text-[#e4e4e7] hover:bg-[#3f3f46] transition-colors\">Search history</button></div></form>"

        mut selected := ""
        if addr != "" {
            selected = "<div class=\"card p-5 mb-5\">" +
                "<div class=\"flex flex-wrap items-start justify-between gap-4 mb-4\"><div><div class=\"text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Selected IP</div>" +
                "<div class=\"text-2xl font-bold mono\">" + addr_h + "</div>" +
                (if label != "" { "<div class=\"text-sm text-[#a1a1aa] mt-1\">" + label_h + "</div>" } else { "<div class=\"text-sm text-[#71717a] mt-1\">No site label yet</div>" }) + "</div>" +
                "<div class=\"flex flex-wrap gap-2\">" +
            "<a href=\"/messages?ip=" + addr_h + time_qs + "\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">Messages</a>" +
            "<a href=\"/report?ip=" + addr_h + "&view=messages" + time_qs + "\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">Report</a>" +
            "<a href=\"/report?ip=" + addr_h + "&status=408&view=messages" + time_qs + "\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">408s</a>" +
            "<a href=\"/export/csv?ip=" + addr_h + time_qs + "\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">CSV</a></div></div>" +
                "<div class=\"grid grid-cols-2 md:grid-cols-4 xl:grid-cols-8 gap-3\">" +
                call_fact("Messages", "" + (len(items)), "latest matching rows", "#e4e4e7") +
                call_fact("As Source", "" + (src_count), "messages from this IP", "#38bdf8") +
                call_fact("As Destination", "" + (dst_count), "messages to this IP", "#a78bfa") +
                call_fact("Calls", "" + (unique_calls), "unique Call-IDs", "#fbbf24") +
                call_fact("Requests", "" + (requests), "SIP requests", "#34d399") +
                call_fact("Responses", "" + (responses), "SIP responses", "#f472b6") +
                call_fact("Errors", "" + (errors), ("" + (err_rate)) + "% of responses", err_c) +
                call_fact("408s", "" + (timeout_408), ("" + (timeout_rate)) + "% timeout rate", timeout_c) +
                "</div><div class=\"mt-4 grid md:grid-cols-2 gap-3 text-xs text-[#71717a]\">" +
                "<div class=\"rounded-md border border-[#27272a] bg-[#0a0a0c] p-3\"><span class=\"text-[#e4e4e7] font-semibold\">First seen in sample:</span> " + first_seen + "</div>" +
                "<div class=\"rounded-md border border-[#27272a] bg-[#0a0a0c] p-3\"><span class=\"text-[#e4e4e7] font-semibold\">Last seen:</span> " + last_seen + "</div></div></div>"
        }

        mut history := ""
        if addr != "" {
            history = "<div id=\"ip-history-detail\" hx-get=\"/partials/ip-history?addr=" + addr_h + time_qs + "\" hx-trigger=\"load\" hx-swap=\"innerHTML\">" +
                "<div class=\"card p-6 text-sm text-[#71717a]\">Loading IP history details...</div></div>"
        }

        body := "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
            "<div><h1 class=\"text-2xl font-bold\">IP History</h1>" +
            "<p class=\"text-sm text-[#71717a] mt-1\">Search SIP/HEP history by source or destination IP address, then drill into calls, peers, paths, and timeout failures.</p></div></div>" +
            search + selected + label_form + history
        web.html(layout("IP History", body, user))
    })

    app.post("/ip/label", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "operator") { return {"status":403,"body":"Forbidden"} }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        addr := str.trim(web.form_get(req, "addr", ""))
        label := str.trim(web.form_get(req, "label", ""))
        if addr == "" { return {"status":302,"headers":{"Location":"/ip"},"body":""} }
        mut labels := load_site_labels()
        if label == "" {
            labels[addr] = null
        } else {
            labels[addr] = label
        }
        save_site_labels(labels)
        {"status":302,"headers":{"Location":"/ip?addr=" + h(addr)},"body":""}
    })

    app.get("/status/:code", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        code := req.params["code"] ?? req.query_map["code"] ?? ""
        range := req.query_map["range"] ?? "1h"
        mut since_ms := req.query_map["since_ms"] ?? ""
        mut until_ms := req.query_map["until_ms"] ?? ""
        if since_ms == "" && until_ms == "" {
            since_ms = range_since_ms(range)
        }
        code_h := h(code)
        since_h := h(since_ms)
        until_h := h(until_ms)
        qs_time := (if since_ms != "" { "&since_ms=" + since_h } else { "" }) + (if until_ms != "" { "&until_ms=" + until_h } else { "" })
        items := fetch_messages_time(500, "", "", "", "", "", "", "", code, since_ms, until_ms)
        summary := call_state_summary(items)
        endpoints := ladder_endpoints(items)
        responses := summary["responses"] ?? 0
        mut unique_calls := 0
        mut seen_calls := ""
        for m in items {
            cid := m["call_id"] ?? ""
            if cid != "" && !str.contains(seen_calls, "|" + cid + "|") {
                seen_calls = seen_calls + "|" + cid + "|"
                unique_calls = unique_calls + 1
            }
        }
        inp := "rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 text-sm mono"
        base := "/status/" + code_h
        custom := "<form class=\"card p-4 mb-5\" method=\"get\" action=\"" + base + "\"><div class=\"grid md:grid-cols-[220px_220px_auto] gap-3 items-end\">" +
            time_filter_fields("status-time", since_h, until_h, inp) +
            "<button class=\"rounded-lg px-4 py-2 text-sm bg-[#27272a] text-[#e4e4e7] hover:bg-[#3f3f46] transition-colors\">Apply custom range</button></div></form>"
        actions := "<div class=\"flex flex-wrap gap-2\">" +
            "<a href=\"/messages?status=" + code_h + qs_time + "\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">Messages</a>" +
            "<a href=\"/report?status=" + code_h + "&view=messages" + qs_time + "\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">Report</a>" +
            "<a href=\"/export/csv?status=" + code_h + qs_time + "\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">CSV</a></div>"
        body := "<div class=\"flex flex-wrap items-end justify-between gap-3 mb-5\"><div><h1 class=\"text-2xl font-bold\">Status " + code_h + "</h1><p class=\"text-sm text-[#71717a] mt-1\">Full failure view for the selected response code and time range.</p></div>" + actions + "</div>" +
            "<div class=\"card p-4 mb-5\"><div class=\"flex flex-wrap items-center justify-between gap-3 mb-3\">" + range_tabs(base, range) + "<div class=\"text-[10px] text-[#52525b] mono\">" + (if since_ms != "" { "from " + since_h } else { "all recent" }) + (if until_ms != "" { " to " + until_h } else { "" }) + "</div></div>" +
            "<div class=\"grid grid-cols-2 md:grid-cols-5 gap-3\">" +
            call_fact("Messages", "" + (len(items)), "matching rows", "#e4e4e7") +
            call_fact("Call-IDs", "" + (unique_calls), "affected calls", "#38bdf8") +
            call_fact("Responses", "" + (responses), "SIP responses", "#fbbf24") +
            call_fact("Endpoints", "" + (len(endpoints)), "source/destination IPs", "#a78bfa") +
            call_fact("Last seen", time_ago((summary["last_ts"] ?? 0) / 1000), "latest matching event", "#f87171") +
            "</div></div>" + custom +
            "<div class=\"grid xl:grid-cols-2 gap-4 mb-5\">" +
            "<div class=\"card overflow-x-auto\"><div class=\"p-4 border-b border-[#1e1e22]\"><div class=\"section-title mb-0\">Source IPs</div></div><table class=\"w-full text-left\"><thead><tr class=\"text-[10px] uppercase tracking-wider text-[#52525b] border-b border-[#1e1e22]\"><th class=\"py-2 px-3\">Source</th><th class=\"py-2 px-3 text-right\">Msgs</th></tr></thead><tbody class=\"divide-y divide-[#1e1e22]/50\">" + report_endpoint_rows(items, "src", 15) + "</tbody></table></div>" +
            "<div class=\"card overflow-x-auto\"><div class=\"p-4 border-b border-[#1e1e22]\"><div class=\"section-title mb-0\">Destination IPs</div></div><table class=\"w-full text-left\"><thead><tr class=\"text-[10px] uppercase tracking-wider text-[#52525b] border-b border-[#1e1e22]\"><th class=\"py-2 px-3\">Destination</th><th class=\"py-2 px-3 text-right\">Msgs</th></tr></thead><tbody class=\"divide-y divide-[#1e1e22]/50\">" + report_endpoint_rows(items, "dst", 15) + "</tbody></table></div></div>" +
            "<div class=\"section\"><div class=\"section-title\">Calls and Messages</div>" + call_groups_table(items) + "<div class=\"mt-4\">" + messages_table(items) + "</div></div>"
        web.html(layout("Status " + code_h, body, user))
    })

    app.get("/messages/:id", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        id := req.params["id"]
        m := fetch_message(id)
        if m == null {
            web.html(layout("Not found", "<h1 class=\"text-xl font-bold\">Message not found</h1><p class=\"text-[#a1a1aa] mt-2\">id=" + h(id) + "</p>", user))
        } else {
            badge := method_badge(m["method"] ?? "", m["status"] ?? 0, m["kind"] ?? "")
            mut raw_txt := ""
            dec := base64.decode(m["raw_b64"] ?? "")
            if dec.ok {
                raw_txt = h(dec.value)
            } else {
                raw_txt = h(m["raw_b64"] ?? "")
            }
            cid_h := h(m["call_id"] ?? "")
            body := "<a href=\"/messages\" class=\"text-sm text-[#a78bfa] hover:underline\">← messages</a>" +
                "<div class=\"flex items-center gap-3 mt-3 mb-6\"><h1 class=\"text-2xl font-bold\">Message #" + h(id) + "</h1>" + badge + "</div>" +
                "<div class=\"grid md:grid-cols-2 gap-3 mb-4 text-sm\">" +
                "<div class=\"rounded-xl border border-[#1e1e22] bg-[#131316] p-4 space-y-1\">" +
                "<div><span class=\"text-[#a1a1aa]\">Call-ID</span> <span class=\"mono\">" + cid_h + "</span></div>" +
                "<div><span class=\"text-[#a1a1aa]\">Src</span> <span class=\"mono\">" + h(m["src"] ?? "") + "</span></div>" +
                "<div><span class=\"text-[#a1a1aa]\">Dst</span> <span class=\"mono\">" + h(m["dst"] ?? "") + "</span></div>" +
                "<div><span class=\"text-[#a1a1aa]\">Transport</span> " + h(m["transport"] ?? "") +
                " · " + h(m["proto"] ?? "sip") + "</div>" +
                "<div><span class=\"text-[#a1a1aa]\">Agent</span> " + h(m["agent"] ?? "") +
                " <span class=\"mono text-[10px] text-[#a1a1aa]\">#" + ("" + (m["hep_node_id"] ?? 0)) + "</span></div></div>" +
                "<div class=\"rounded-xl border border-[#1e1e22] bg-[#131316] p-4 space-y-1\">" +
                "<div><span class=\"text-[#a1a1aa]\">From</span> <span class=\"mono text-xs\">" + h(m["from"] ?? "") + "</span></div>" +
                "<div><span class=\"text-[#a1a1aa]\">To</span> <span class=\"mono text-xs\">" + h(m["to"] ?? "") + "</span></div>" +
                "<div><span class=\"text-[#a1a1aa]\">CSeq</span> <span class=\"mono\">" + h(m["cseq"] ?? "") + "</span></div>" +
                "<div><span class=\"text-[#a1a1aa]\">R-URI</span> <span class=\"mono text-xs\">" + h(m["ruri"] ?? "") + "</span></div></div></div>" +
                "<div class=\"rounded-2xl border border-[#1e1e22] bg-[#111114] p-4\">" +
                "<div class=\"text-xs text-[#a1a1aa] mb-2\">Raw SIP</div>" +
                "<pre class=\"mono text-xs whitespace-pre-wrap break-all text-[#d4d4d8]\">" + raw_txt + "</pre></div>" +
            "<div class=\"mt-4\"><a class=\"text-[#a78bfa] text-sm hover:underline\" " + ladder_nav_attrs(m["call_id"] ?? "") + ">Open call ladder →</a></div>"
            web.html(layout("Message " + ("" + (id)), body, user))
        }
    })

    app.get("/ladder", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        cid := req.query_map["call_id"] ?? ""
        cid_h := h(cid)
        mut content := ""
        if cid != "" {
            all_call_items := fetch_messages(200, cid)
            call_items := call_messages_only(all_call_items)
            content = call_summary_panel(cid, call_items) + call_media_panel(cid, all_call_items, len(call_items)) + ladder_html_from_items(cid, all_call_items)
        } else {
            content = "<div class=\"card p-6 mb-5\">" +
                "<div class=\"text-sm font-medium mb-1\">Paste a Call-ID to open the SIP ladder.</div>" +
                "<div class=\"text-xs text-[#71717a]\">Ladder links from messages, reports, and active calls open this page directly.</div></div>" +
                calls_recent_list(fetch_top_calls(), cid, false)
        }
        body := "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
            "<div><h1 class=\"text-2xl font-bold\">SIP Ladder</h1><p class=\"text-sm text-[#71717a] mt-1\">Chronological SIP signaling for one Call-ID.</p></div>" +
            "<div class=\"flex gap-2\"><a href=\"/calls\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7] hover:border-[#3f3f46]\">Calls</a>" +
            "<a href=\"/messages\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7] hover:border-[#3f3f46]\">Messages</a></div></div>" +
            "<form class=\"card p-4 mb-5\" action=\"/ladder\" method=\"get\" hx-boost=\"true\" hx-target=\"main\" hx-select=\"main\" hx-push-url=\"true\">" +
            "<div class=\"grid md:grid-cols-[1fr_auto_auto] gap-3 items-end\">" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Call-ID</label>" +
            "<input name=\"call_id\" value=\"" + cid_h + "\" placeholder=\"Paste or enter Call-ID\" class=\"w-full rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 text-sm mono\"/></div>" +
            "<button class=\"rounded-lg px-4 py-2 text-sm bg-[#27272a] text-[#e4e4e7] hover:bg-[#3f3f46] transition-colors\">Show ladder</button>" +
            "<a href=\"/ladder\" class=\"rounded-lg px-4 py-2 text-sm border border-[#27272a] text-[#a1a1aa] hover:text-[#e4e4e7] text-center\">Recent</a></div></form>" +
            content
        web.html(layout("SIP Ladder", body, user))
    })

    app.get("/calls", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        cid := req.query_map["call_id"] ?? ""
        agent := req.query_map["agent"] ?? ""
        tops := fetch_top_calls()
        cid_h := h(cid)
        agent_h := h(agent)
        nodes := fetch_nodes()
        names := load_node_names()
        node_opts := node_select_options(nodes, names, agent)
        calls_agent_qs := if agent != "" { "?agent=" + q(agent) } else { "" }
        rt1 := fetch_realtime_agent(1, agent)
        rt5 := fetch_realtime_agent(5, agent)
        failures_5m := (rt5["resp_4xx"] ?? 0) + (rt5["resp_5xx"] ?? 0)
        call_kpis := "<div class=\"grid grid-cols-2 md:grid-cols-5 gap-3 mb-5\">" +
            call_fact("Concurrent calls", "" + (rt1["active_calls"] ?? rt5["active_calls"] ?? 0), "open dialogs in the live window", "#f472b6") +
            call_fact("CPS", per_second_label(rt1["invites"] ?? 0, 60), "INVITE requests per second", "#34d399") +
            call_fact("Message rate", per_second_label(rt1["total"] ?? 0, 60) + "/s", "all captures, last 1m", "#38bdf8") +
            call_fact("Attempts", "" + (rt5["invites"] ?? 0), "INVITEs, last 5m", "#fbbf24") +
            call_fact("Failures", "" + (failures_5m), "4xx/5xx, last 5m", if failures_5m > 0 { "#f87171" } else { "#34d399" }) +
            "</div>"
        mut selected := ""
        if cid != "" {
            all_call_items := fetch_messages(200, cid)
            call_items := call_messages_only(all_call_items)
            selected = call_summary_panel(cid, call_items) + call_media_panel(cid, all_call_items, len(call_items)) + ladder_html_from_items(cid, all_call_items)
        } else {
            selected = "<div class=\"card p-6 mb-5\">" +
                "<div class=\"text-sm font-medium mb-1\">Pick a recent call or search by Call-ID.</div>" +
                "<div class=\"text-xs text-[#71717a]\">The detail view shows state, duration, endpoints, message count, PCAP export, and the full SIP ladder.</div></div>" +
                calls_recent_list(tops, cid, false)
        }
        recent_sidebar := "<div class=\"card p-4\">" +
            "<div class=\"flex items-center justify-between mb-3\"><div class=\"section-title mb-0\">Recent Calls</div><a href=\"/messages\" class=\"text-[11px] text-[#a78bfa] hover:underline\">Messages</a></div>" +
            calls_recent_list(tops, cid, true) + "</div>"
        body := "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
            "<div><h1 class=\"text-2xl font-bold\">Calls</h1><p class=\"text-sm text-[#71717a] mt-1\">Investigate SIP dialogs by Call-ID, endpoint, status, and message flow.</p></div>" +
            "<div class=\"flex items-center gap-2\"><form method=\"get\" action=\"/calls\"><select name=\"agent\" class=\"rounded-md bg-[#0a0a0c] border border-[#27272a] px-2 py-1.5 text-xs\" onchange=\"this.form.submit()\">" + node_opts + "</select></form><a href=\"/messages?method=OPTIONS\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7] hover:border-[#3f3f46]\">SIP OPTIONS</a>" +
            "<a href=\"/ip\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7] hover:border-[#3f3f46]\">IP history</a></div></div>" +
            call_kpis +
            "<form class=\"card p-4 mb-5\" action=\"/ladder\" method=\"get\" hx-boost=\"true\" hx-target=\"main\" hx-select=\"main\" hx-push-url=\"true\">" +
            "<div class=\"grid md:grid-cols-[1fr_auto_auto] gap-3 items-end\">" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Call-ID</label>" +
            "<input name=\"call_id\" value=\"" + cid_h + "\" placeholder=\"Paste or enter Call-ID\" class=\"w-full rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 text-sm mono\"/></div>" +
            (if agent != "" { "<input type=\"hidden\" name=\"agent\" value=\"" + agent_h + "\"/>" } else { "" }) +
            "<button class=\"rounded-lg px-4 py-2 text-sm bg-[#27272a] text-[#e4e4e7] hover:bg-[#3f3f46] transition-colors\">Show ladder</button>" +
            "<a href=\"/calls\" class=\"rounded-lg px-4 py-2 text-sm border border-[#27272a] text-[#a1a1aa] hover:text-[#e4e4e7] text-center\">Recent</a></div></form>" +
            "<div id=\"live-calls\" hx-get=\"/partials/live-calls\" hx-trigger=\"load, every 5s\" hx-swap=\"innerHTML\"><div class=\"card p-5 mb-5 text-sm text-[#71717a]\">Loading realtime calls...</div></div>" +
            "<div class=\"section\"><div class=\"flex items-center justify-between mb-3\"><div class=\"section-title mb-0\">Active Calls</div><span class=\"text-[10px] text-[#52525b]\">live sample, refreshes every 3s</span></div>" +
            "<div id=\"active-calls\" hx-get=\"/partials/active-calls" + calls_agent_qs + "\" hx-trigger=\"load, every 3s\" hx-swap=\"innerHTML\"><div class=\"card p-5 text-sm text-[#71717a]\">Loading active calls...</div></div></div>" +
            "<div class=\"grid xl:grid-cols-[360px_1fr] gap-5\">" +
            "<div>" + recent_sidebar + "</div><div>" + selected + "</div></div>"
        web.html(layout("Calls", body, user))
    })

    app.get("/probe", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "operator") {
            body := "<h1 class=\"text-2xl font-bold mb-2\">Echo probe</h1>" +
                "<div class=\"rounded-2xl border border-[rgba(251,191,36,.35)] bg-[rgba(251,191,36,.08)] p-4 text-sm text-[#fbbf24]\">" +
                "Probe requires <strong>operator</strong> or <strong>admin</strong> role. Your role: " + role_badge(user["role"] ?? "viewer") + "</div>"
            return web.html(layout("Probe", body, user))
        }
        body := "<h1 class=\"text-2xl font-bold mb-1\">Echo probe</h1>" +
            "<p class=\"text-sm text-[#a1a1aa] mb-6\">Active OPTIONS RTT. Core must set <code class=\"mono\">ZAMAN_PROBE=1</code> (off by default).</p>" +
            "<form hx-post=\"/probe\" hx-target=\"#probe-result\" hx-swap=\"innerHTML\" class=\"card p-5 grid md:grid-cols-3 gap-3 max-w-3xl\">" +
            "<label class=\"text-sm block\"><span class=\"text-[#a1a1aa] text-xs\">Host</span>" +
            "<input name=\"host\" value=\"127.0.0.1\" class=\"mt-1 w-full rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 mono text-sm\"/></label>" +
            "<label class=\"text-sm block\"><span class=\"text-[#a1a1aa] text-xs\">Port</span>" +
            "<input name=\"port\" value=\"5060\" class=\"mt-1 w-full rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 mono text-sm\"/></label>" +
            "<label class=\"text-sm block\"><span class=\"text-[#a1a1aa] text-xs\">Timeout (ms)</span>" +
            "<input name=\"timeout_ms\" value=\"2000\" class=\"mt-1 w-full rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 mono text-sm\"/></label>" +
            "<div class=\"md:col-span-3\"><button type=\"submit\" class=\"rounded-lg px-4 py-2 text-sm bg-gradient-to-br from-[#a78bfa] to-[#7c3aed] text-white\">Probe OPTIONS</button></div></form>" +
            "<div id=\"probe-result\" class=\"mt-4 max-w-3xl\"></div>"
        web.html(layout("Probe", body, user))
    })

    app.post("/probe", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return web.htmx("<div class=\"text-[#f87171]\">Unauthorized</div>") }
        if !has_role(user, "operator") { return web.htmx("<div class=\"text-[#f87171]\">Requires operator role</div>") }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        host := web.form_get(req, "host", "127.0.0.1")
        port := int.parse(web.form_get(req, "port", "5060")).unwrap_or(0)
        wait_ms := int.parse(web.form_get(req, "timeout_ms", "2000")).unwrap_or(0)
        payload := json.stringify({"host": host, "port": port, "timeout_ms": wait_ms})
        mut hdrs := {"Content-Type": "application/json"}
        key := env.get("ZAMAN_API_KEY") ?? ""
        if key != "" { hdrs["X-API-Key"] = key }
        resp := http.post(core_base() + "/api/probe", payload, {"headers": hdrs})
        mut data := {"ok": false, "error": "request failed"}
        if resp.ok {
            parsed := json.parse(resp.value.body)
            if parsed.ok { data = parsed.value } else { data = {"ok": false, "error": ("" + (resp.value.body))} }
        } else {
            data = {"ok": false, "error": ("" + (resp.err.message ?? resp.err))}
        }
        if data["ok"] == true {
            st := data["status"] ?? 0
            rtt := data["rtt_ms"] ?? 0
            hp := h(("" + (data["host"] ?? host)))
            prt := data["port"] ?? port
            cid := h(("" + (data["call_id"] ?? "")))
            web.htmx(
                "<div class=\"rounded-2xl border border-[rgba(52,211,153,.35)] bg-[rgba(52,211,153,.08)] p-4\">" +
                "<div class=\"text-[#34d399] font-semibold mb-2\">Probe OK</div>" +
                "<div class=\"grid grid-cols-2 gap-2 text-sm mono\">" +
                "<div>status <span class=\"text-[#e4e4e7]\">" + ("" + (st)) + "</span></div>" +
                "<div>rtt <span class=\"text-[#e4e4e7]\">" + ("" + (rtt)) + " ms</span></div>" +
                "<div class=\"col-span-2 text-xs text-[#a1a1aa]\">" + hp + ":" + ("" + (prt)) + "</div>" +
                "<div class=\"col-span-2 text-xs break-all text-[#a1a1aa]\">" + cid + "</div></div></div>"
            )
        } else {
            err := h(("" + (data["error"] ?? "probe failed")))
            web.htmx(
                "<div class=\"rounded-2xl border border-[rgba(248,113,113,.35)] bg-[rgba(248,113,113,.08)] p-4\">" +
                "<div class=\"text-[#f87171] font-semibold mb-1\">Probe failed</div>" +
                "<div class=\"text-sm mono\">" + err + "</div></div>"
            )
        }
    })

    app.get("/metrics", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }

        m := fetch_metrics()
        rt := fetch_realtime(5)
        anomalies := fetch_anomalies()

        mut methods := m["methods"]
        if methods == null { methods = {} }
        mut transports := {"UDP": 0, "HEP3": n(m, "hep_udp"), "HEP3/TCP": n(m, "hep_tcp"), "HEP3/TLS": n(m, "hep_tls")}

        up_ms := n(m, "uptime_ms")
        up_h := up_ms / 3600000
        up_m := (up_ms % 3600000) / 60000
        total_msgs := n(m, "msgs_total")
        total_hep := n(m, "hep_total")
        db_err := n(m, "db_err")
        db_drop := n(m, "db_drop")
        parse_err := n(m, "parse_err")
        hep_err := n(m, "hep_err")
        hep_deny := n(m, "hep_deny")
        rt_total := rt["total"] ?? 0
        active_calls := rt["active_calls"] ?? 0
        asr := rt["asr"] ?? 0
        err_window := (rt["resp_4xx"] ?? 0) + (rt["resp_5xx"] ?? 0)
        ingest_issue_count := db_err + db_drop + parse_err + hep_err + hep_deny
        asr_color := if asr >= 70 { "#34d399" } else if asr >= 40 { "#fbbf24" } else { "#f87171" }
        health_label := if ingest_issue_count == 0 { "clean" } else if ingest_issue_count < 10 { "watch" } else { "attention" }
        health_cls := if ingest_issue_count == 0 { "text-[#34d399] border-[rgba(52,211,153,.28)] bg-[rgba(52,211,153,.08)]" } else if ingest_issue_count < 10 { "text-[#fbbf24] border-[rgba(251,191,36,.28)] bg-[rgba(251,191,36,.08)]" } else { "text-[#f87171] border-[rgba(248,113,113,.28)] bg-[rgba(248,113,113,.08)]" }

        hero := "<div class=\"card p-5 mb-5\">" +
            "<div class=\"flex flex-wrap items-start justify-between gap-4 mb-4\">" +
            "<div><div class=\"text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">System Metrics</div>" +
            "<div class=\"text-2xl font-bold\">Live capture, ingest, and telecom health</div>" +
            "<div class=\"text-xs text-[#71717a] mt-1\">5-minute operational window with all-time counters for capacity and trend context.</div></div>" +
            "<span class=\"rounded-full border px-2.5 py-1 text-xs font-semibold " + health_cls + "\">" + health_label + "</span></div>" +
            "<div class=\"grid grid-cols-2 md:grid-cols-4 xl:grid-cols-6 gap-3\">" +
            call_fact("5m messages", "" + (rt_total), "recent captures", "#e4e4e7") +
            call_fact("Active calls", "" + (active_calls), "current dialogs", "#38bdf8") +
            call_fact("ASR", "" + (asr) + "%", "answer seizure", asr_color) +
            call_fact("Errors", "" + (err_window), "4xx/5xx in window", if err_window == 0 { "#34d399" } else { "#f87171" }) +
            call_fact("HEP total", "" + (total_hep), "accepted packets", "#a78bfa") +
            call_fact("Uptime", ("" + (up_h)) + "h " + ("" + (up_m)) + "m", "zaman-core", "#fbbf24") +
            "</div></div>"

        live := "<div class=\"section\">" +
            "<div class=\"flex items-center justify-between mb-3\"><div class=\"section-title mb-0\">Live Window</div><span class=\"text-[10px] text-[#52525b]\">last 5 minutes</span></div>" +
            "<div class=\"grid grid-cols-2 md:grid-cols-4 xl:grid-cols-7 gap-3\">" +
            stat_card("Messages", rt_total, "all SIP/HEP") +
            stat_card("INVITEs", rt["invites"] ?? 0, "call attempts") +
            stat_card("Active calls", active_calls, "in progress") +
            stat_card("ASR", ("" + (rt["asr"] ?? 0)) + "%", "recent answer rate") +
            stat_card("2xx", rt["resp_2xx"] ?? 0, "success") +
            stat_card("4xx", rt["resp_4xx"] ?? 0, "client errors") +
            stat_card("5xx", rt["resp_5xx"] ?? 0, "server errors") +
            "</div></div>"

        capacity := "<div class=\"section\">" +
            "<div class=\"flex flex-wrap items-center justify-between gap-3 mb-3\"><div class=\"section-title mb-0\">Call Rate &amp; Capacity</div>" +
            "<div class=\"flex gap-2 text-[11px]\"><a href=\"/calls\" class=\"text-[#a78bfa] hover:underline\">Calls</a><a href=\"/report?method=INVITE&view=messages\" class=\"text-[#a78bfa] hover:underline\">INVITE report</a></div></div>" +
            "<div id=\"metrics-capacity\" hx-get=\"/partials/metrics-capacity\" hx-trigger=\"load\" hx-swap=\"innerHTML\">" +
            "<div class=\"card p-6 text-sm text-[#71717a]\">Loading call rate, concurrency, and call paths...</div></div></div>"

        ingest := "<div class=\"section\">" +
            "<div class=\"section-title\">Ingest Quality</div>" +
            "<div class=\"grid grid-cols-2 md:grid-cols-4 xl:grid-cols-8 gap-3\">" +
            stat_card("Total messages", total_msgs, "stored") +
            stat_card("Requests", n(m, "requests"), "SIP requests") +
            stat_card("Responses", n(m, "responses"), "SIP responses") +
            stat_card("DB writes", n(m, "db_ok"), "errors " + ("" + (db_err)) + " · dropped " + ("" + (db_drop))) +
            stat_card("Parse errors", parse_err, "malformed SIP") +
            stat_card("HEP errors", hep_err, "decode failures") +
            stat_card("HEP denied", hep_deny, "ACL blocked") +
            stat_card("Rate limited", n(m, "rate_limited"), "429 responses") +
            "</div></div>"

        mut transport_total := (transports["UDP"] ?? 0) + (transports["HEP3"] ?? 0) + (transports["HEP3/TCP"] ?? 0) + (transports["HEP3/TLS"] ?? 0)
        if transport_total == 0 { transport_total = 1 }
        mut transport_rows := ""
        for pair in [["UDP", transports["UDP"] ?? 0], ["HEP3", transports["HEP3"] ?? 0], ["HEP3/TCP", transports["HEP3/TCP"] ?? 0], ["HEP3/TLS", transports["HEP3/TLS"] ?? 0]] {
            tname := pair[0]
            tcnt := pair[1]
            pct := tcnt * 100 / transport_total
            transport_rows = transport_rows + "<div class=\"py-2 border-b border-[#1e1e22]/60 last:border-0\">" +
                "<div class=\"flex items-center justify-between text-xs\"><span class=\"font-medium\">" + h(tname) + "</span><span class=\"mono text-[#a1a1aa]\">" + ("" + (tcnt)) + "</span></div>" +
                "<div class=\"mt-1.5 h-1.5 rounded-full bg-[#1e1e22] overflow-hidden\"><div class=\"h-full rounded-full bg-[#38bdf8]\" style=\"width:" + ("" + (pct)) + "%\"></div></div></div>"
        }

        mut method_total := 0
        for pair in [["INVITE", methods["INVITE"] ?? 0], ["OPTIONS", methods["OPTIONS"] ?? 0], ["REGISTER", methods["REGISTER"] ?? 0], ["BYE", methods["BYE"] ?? 0], ["ACK", methods["ACK"] ?? 0], ["INFO", methods["INFO"] ?? 0], ["MESSAGE", methods["MESSAGE"] ?? 0], ["UNKNOWN", methods["UNKNOWN"] ?? 0]] {
            method_total = method_total + pair[1]
        }
        if method_total == 0 { method_total = 1 }
        mut method_rows := ""
        for pair in [["INVITE", methods["INVITE"] ?? 0], ["OPTIONS", methods["OPTIONS"] ?? 0], ["REGISTER", methods["REGISTER"] ?? 0], ["BYE", methods["BYE"] ?? 0], ["ACK", methods["ACK"] ?? 0], ["INFO", methods["INFO"] ?? 0], ["MESSAGE", methods["MESSAGE"] ?? 0], ["UNKNOWN", methods["UNKNOWN"] ?? 0]] {
            mname := pair[0]
            mcnt := pair[1]
            pct := mcnt * 100 / method_total
            if mcnt > 0 {
                method_rows = method_rows + "<tr><td class=\"py-2 px-3 font-medium\">" + h(mname) + "</td><td class=\"py-2 px-3 mono text-right\">" + ("" + (mcnt)) + "</td>" +
                    "<td class=\"py-2 px-3\"><div class=\"flex items-center gap-2 justify-end\"><span class=\"text-[10px] text-[#52525b]\">" + ("" + (pct)) + "%</span><div class=\"w-20 h-1.5 rounded-full bg-[#1e1e22] overflow-hidden\"><div class=\"h-full rounded-full bg-[#a78bfa]\" style=\"width:" + ("" + (pct)) + "%\"></div></div></div></td></tr>"
            }
        }
        if method_rows == "" { method_rows = "<tr><td colspan=\"3\" class=\"py-6 text-center text-sm text-[#71717a]\">No SIP methods captured.</td></tr>" }

        mut rcode_rows := ""
        if (rt["resp_2xx"] ?? 0) > 0 {
            rcode_rows = rcode_rows + "<tr><td class=\"py-2 px-3 mono font-semibold text-[#34d399]\">2xx</td><td class=\"py-2 px-3 mono text-right\">" + ("" + (rt["resp_2xx"] ?? 0)) + "</td></tr>"
        }
        if (rt["resp_4xx"] ?? 0) > 0 {
            rcode_rows = rcode_rows + "<tr><td class=\"py-2 px-3 mono font-semibold text-[#f87171]\">4xx</td><td class=\"py-2 px-3 mono text-right\">" + ("" + (rt["resp_4xx"] ?? 0)) + "</td></tr>"
        }
        if (rt["resp_5xx"] ?? 0) > 0 {
            rcode_rows = rcode_rows + "<tr><td class=\"py-2 px-3 mono font-semibold text-[#f87171]\">5xx</td><td class=\"py-2 px-3 mono text-right\">" + ("" + (rt["resp_5xx"] ?? 0)) + "</td></tr>"
        }
        if rcode_rows == "" { rcode_rows = "<tr><td colspan=\"2\" class=\"py-6 text-center text-sm text-[#71717a]\">No responses in the live window.</td></tr>" }
        th := "text-[10px] uppercase tracking-wider text-[#52525b] font-semibold"
        breakdown := "<div class=\"grid xl:grid-cols-[1.2fr_.8fr] gap-4 mb-5\">" +
            "<div class=\"card p-4 overflow-x-auto\"><div class=\"section-title\">Traffic Charts</div><div id=\"metrics-traffic-charts\" hx-get=\"/partials/charts?window=5\" hx-trigger=\"load\" hx-swap=\"innerHTML\"><div class=\"p-6 text-sm text-[#71717a]\">Loading traffic charts...</div></div></div>" +
            "<div class=\"space-y-4\">" +
            "<div class=\"card p-4\"><div class=\"section-title\">Capture Transport</div>" + transport_rows + "</div>" +
            "<div class=\"card overflow-x-auto\"><div class=\"px-4 pt-4 section-title\">Response Codes</div><table class=\"w-full text-left text-sm\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\"><th class=\"py-2 px-3\">Status</th><th class=\"py-2 px-3 text-right\">Count</th></tr></thead><tbody class=\"divide-y divide-[#1e1e22]/50\">" + rcode_rows + "</tbody></table></div>" +
            "</div></div>"

        methods_panel := "<div class=\"card overflow-x-auto\">" +
            "<div class=\"px-4 pt-4 flex items-center justify-between\"><div class=\"section-title mb-0\">SIP Method Mix</div><a href=\"/messages\" class=\"text-[11px] text-[#a78bfa] hover:underline\">Messages</a></div>" +
            "<table class=\"w-full text-left text-sm mt-3\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\"><th class=\"py-2 px-3\">Method</th><th class=\"py-2 px-3 text-right\">Count</th><th class=\"py-2 px-3 text-right\">Share</th></tr></thead><tbody class=\"divide-y divide-[#1e1e22]/50\">" + method_rows + "</tbody></table></div>"

        agents := []
        talkers := []
        mut agent_rows := ""
        mut rank := 1
        for a in agents {
            aname := h(a["agent"] ?? "")
            amsg := a["messages"] ?? 0
            acall := a["calls"] ?? 0
            agent_rows = agent_rows + "<tr><td class=\"py-2 px-3 mono text-[11px] text-[#52525b]\">" + ("" + (rank)) + "</td><td class=\"py-2 px-3\"><a class=\"text-sm hover:text-[#e4e4e7] hover:underline\" href=\"/messages?agent=" + aname + "\">" + aname + "</a></td><td class=\"py-2 px-3 mono text-right\">" + ("" + (amsg)) + "</td><td class=\"py-2 px-3 mono text-right\">" + ("" + (acall)) + "</td></tr>"
            rank = rank + 1
        }
        if agent_rows == "" { agent_rows = "<tr><td colspan=\"4\" class=\"py-6 text-center text-sm text-[#71717a]\">No HEP agents reporting.</td></tr>" }

        mut talker_rows := ""
        rank = 1
        for t in talkers {
            tsrc := h(t["src"] ?? "")
            tip := endpoint_ip(t["src"] ?? "")
            tmsg := t["messages"] ?? 0
            tcall := t["calls"] ?? 0
            talker_rows = talker_rows + "<tr><td class=\"py-2 px-3 mono text-[11px] text-[#52525b]\">" + ("" + (rank)) + "</td><td class=\"py-2 px-3\"><a class=\"mono text-xs hover:text-[#e4e4e7] hover:underline\" href=\"/ip?addr=" + h(tip) + "\">" + tsrc + "</a></td><td class=\"py-2 px-3 mono text-right\">" + ("" + (tmsg)) + "</td><td class=\"py-2 px-3 mono text-right\">" + ("" + (tcall)) + "</td></tr>"
            rank = rank + 1
        }
        if talker_rows == "" { talker_rows = "<tr><td colspan=\"4\" class=\"py-6 text-center text-sm text-[#71717a]\">No talkers captured.</td></tr>" }

        rankings := "<div class=\"mb-5\"><div class=\"grid xl:grid-cols-[.7fr_1.3fr] gap-4\">" +
            methods_panel +
            "<div id=\"metrics-rankings\" hx-get=\"/partials/metrics-rankings\" hx-trigger=\"load\" hx-swap=\"innerHTML\">" +
            "<div class=\"card p-6 text-sm text-[#71717a]\">Loading agents and top talkers...</div></div></div></div>"

        endpoint_breakdown := "<div class=\"section\">" +
            "<div class=\"flex flex-wrap items-center justify-between gap-3 mb-3\"><div class=\"section-title mb-0\">Source &amp; Destination IPs</div>" +
            "<div class=\"text-[10px] text-[#52525b] mono\">recent captures</div></div>" +
            "<div id=\"metrics-endpoints\" hx-get=\"/partials/metrics-endpoints\" hx-trigger=\"load\" hx-swap=\"innerHTML\">" +
            "<div class=\"card p-6 text-sm text-[#71717a]\">Loading source and destination IPs...</div></div></div>"

        nodes_panel := "<div class=\"section\">" +
            "<div class=\"flex items-center justify-between mb-3\"><div class=\"section-title mb-0\">Node Health</div><a href=\"/noc\" class=\"text-[11px] text-[#a78bfa] hover:underline\">Open NOC</a></div>" +
            "<div id=\"metrics-nodes\" hx-get=\"/partials/metrics-nodes\" hx-trigger=\"load\" hx-swap=\"innerHTML\">" +
            "<div class=\"card p-6 text-sm text-[#71717a]\">Loading node health...</div></div></div>"

        mut anomaly_rows := ""
        for a in anomalies {
            sev := h(a["severity"] ?? "info")
            title := h(a["title"] ?? a["message"] ?? "Anomaly")
            detail := h(a["detail"] ?? "")
            anomaly_rows = anomaly_rows + "<div class=\"rounded-md border border-[#27272a] bg-[#0a0a0c] p-3\"><div class=\"flex items-center justify-between gap-3\"><span class=\"text-sm font-medium\">" + title + "</span><span class=\"text-[10px] uppercase text-[#71717a]\">" + sev + "</span></div><div class=\"text-xs text-[#71717a] mt-1\">" + detail + "</div></div>"
        }
        if anomaly_rows == "" { anomaly_rows = "<div class=\"rounded-md border border-[#27272a] bg-[#0a0a0c] p-4 text-sm text-[#71717a]\">No current anomalies from the core.</div>" }
        prom_url := h(core_base() + "/metrics")
        raw_url := h(core_base() + "/api/metrics")
        footer := "<div class=\"grid xl:grid-cols-[1fr_360px] gap-4\">" +
            "<div class=\"card p-4\"><div class=\"section-title\">Operational Notes</div><div class=\"grid md:grid-cols-3 gap-3 text-xs text-[#a1a1aa]\">" +
            "<a href=\"/ladder\" class=\"rounded-md border border-[#27272a] p-3 hover:text-[#e4e4e7]\"><div class=\"font-semibold text-[#e4e4e7] mb-1\">Investigate calls</div>Open call ladders grouped by Call-ID.</a>" +
            "<a href=\"/ip\" class=\"rounded-md border border-[#27272a] p-3 hover:text-[#e4e4e7]\"><div class=\"font-semibold text-[#e4e4e7] mb-1\">Trace endpoints</div>Review history and site labels by IP.</a>" +
            "<a href=\"/report\" class=\"rounded-md border border-[#27272a] p-3 hover:text-[#e4e4e7]\"><div class=\"font-semibold text-[#e4e4e7] mb-1\">Trend reports</div>Open KPI and distribution reports.</a></div>" +
            "<div class=\"mt-4 grid md:grid-cols-2 gap-3\"><code class=\"block mono text-[11px] bg-[#0a0a0c] border border-[#1e1e22] rounded-lg p-3 break-all\">" + prom_url + "</code><code class=\"block mono text-[11px] bg-[#0a0a0c] border border-[#1e1e22] rounded-lg p-3 break-all\">" + raw_url + "</code></div></div>" +
            "<div class=\"card p-4\"><div class=\"section-title\">Anomalies</div><div class=\"space-y-2\">" + anomaly_rows + "</div></div></div>"

        body := "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
            "<div><h1 class=\"text-2xl font-bold\">Metrics</h1><p class=\"text-sm text-[#71717a] mt-1\">Fast operational view of capture volume, call health, ingest quality, and node status.</p></div>" +
            "<div class=\"flex gap-2\"><a href=\"" + prom_url + "\" target=\"_blank\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">Prometheus</a><a href=\"" + raw_url + "\" target=\"_blank\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">JSON</a></div></div>" +
            hero + live + capacity + ingest + breakdown + rankings + endpoint_breakdown + nodes_panel + footer
        web.html(layout("Metrics", body, user))
    })

    app.get("/metrics-old", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        m := fetch_metrics()
        rt := fetch_realtime(5)
        kpi := fetch_kpi()
        rcodes := fetch_response_codes()
        crd := "card"

        mut methods := m["methods"]
        if methods == null { methods = {} }

        up_ms := n(m, "uptime_ms")
        up_h := up_ms / 3600000
        up_m := (up_ms % 3600000) / 60000

        // ── Core health ──
        health := "<div class=\"section\">" +
            "<div class=\"section-title\">Core health</div>" +
            "<div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3\">" +
            stat_card("Uptime", ("" + (up_h)) + "h " + ("" + (up_m)) + "m", "process") +
            stat_card("DB writes", n(m, "db_ok"), "errors " + ("" + (n(m, "db_err")))) +
            stat_card("Ring", ("" + (n(m, "ring_idx"))) + " / " + ("" + (n(m, "ring_size"))), "capture buffer") +
            stat_card("Parse errors", n(m, "parse_err"), "malformed SIP") +
            stat_card("Rate limited", n(m, "rate_limited"), "429 responses") +
            stat_card("Probe RTT", ("" + (n(m, "probe_rtt_ms"))) + "ms", "ok " + ("" + (n(m, "probes_ok"))) + " fail " + ("" + (n(m, "probes_fail")))) +
            "</div></div>"

        // ── Capture counters ──
        captures := "<div class=\"section\">" +
            "<div class=\"section-title\">Capture counters</div>" +
            "<div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-3\">" +
            stat_card("Total messages", n(m, "msgs_total"), "all protocols") +
            stat_card("SIP requests", n(m, "requests"), "inbound") +
            stat_card("SIP responses", n(m, "responses"), "received") +
            stat_card("Echoes sent", n(m, "echoes"), "auto-reply") +
            stat_card("2xx", n(m, "status_2xx"), "success responses") +
            "</div></div>"

        // ── HEP counters ──
        hep := "<div class=\"section\">" +
            "<div class=\"section-title\">HEP ingest</div>" +
            "<div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3\">" +
            stat_card("HEP total", n(m, "hep_total"), "accepted packets") +
            stat_card("HEP/UDP", n(m, "hep_udp"), "standard") +
            stat_card("HEP/TCP", n(m, "hep_tcp"), "stream") +
            stat_card("HEP/TLS", n(m, "hep_tls"), "encrypted") +
            stat_card("HEP errors", n(m, "hep_err"), "decode failures") +
            stat_card("HEP denied", n(m, "hep_deny"), "ACL blocked") +
            "</div>" +
            "<div class=\"grid grid-cols-3 gap-3 mt-3\">" +
            stat_card("HEP auth fail", n(m, "hep_auth_fail"), "password mismatch") +
            stat_card("HEP SIP", n(m, "hep_sip"), "proto_type=1") +
            stat_card("HEP RTCP", n(m, "hep_rtcp"), "proto_type=5") +
            "</div></div>"

        // ── Method breakdown ──
        inv := methods["INVITE"] ?? 0
        opts := methods["OPTIONS"] ?? 0
        reg := methods["REGISTER"] ?? 0
        bye := methods["BYE"] ?? 0
        ack := methods["ACK"] ?? 0
        info := methods["INFO"] ?? 0
        msg := methods["MESSAGE"] ?? 0
        unk := methods["UNKNOWN"] ?? 0

        method_bar := viz.bar({
            "INVITE": inv, "OPTIONS": opts, "REGISTER": reg, "BYE": bye,
            "ACK": ack, "INFO": info, "MESSAGE": msg,
        }, {"title": "SIP methods (all time)", "width": 560, "height": 200, "colors": ["#a78bfa", "#34d399", "#f472b6", "#fb923c", "#facc15", "#94a3b8", "#22d3ee"]})

        // Method table
        mut method_rows := ""
        mut total_methods := inv + opts + reg + bye + ack + info + msg + unk
        if total_methods == 0 { total_methods = 1 }
        for pair in [["INVITE", inv], ["OPTIONS", opts], ["REGISTER", reg], ["BYE", bye], ["ACK", ack], ["INFO", info], ["MESSAGE", msg], ["UNKNOWN", unk]] {
            mname := pair[0]
            mcount := pair[1]
            pct := mcount * 100 / total_methods
            if mcount > 0 {
                method_rows = method_rows + "<tr><td class=\"py-1.5 px-3 text-sm\">" + ("" + (mname)) + "</td>" +
                    "<td class=\"py-1.5 px-3 mono text-sm text-right\">" + ("" + (mcount)) + "</td>" +
                    "<td class=\"py-1.5 px-3 text-right\">" +
                    "<div class=\"flex items-center gap-2 justify-end\"><span class=\"text-xs text-[#52525b]\">" + ("" + (pct)) + "%</span>" +
                    "<div class=\"w-16 h-1.5 rounded-full bg-[#1e1e22] overflow-hidden\"><div class=\"h-full rounded-full bg-[#a78bfa]\" style=\"width:" + ("" + (pct)) + "%\"></div></div></div></td></tr>"
            }
        }

        // Response code breakdown
        mut rcode_rows := ""
        for rc in rcodes {
            st := rc["status"] ?? 0
            cnt := rc["count"] ?? 0
            cls := if st >= 200 && st < 300 { "text-[#34d399]" } else if st >= 400 { "text-[#f87171]" } else { "text-[#fbbf24]" }
            rcode_rows = rcode_rows + "<tr><td class=\"py-1.5 px-3 mono text-sm " + cls + " font-medium\">" + ("" + (st)) + "</td>" +
                "<td class=\"py-1.5 px-3 mono text-sm text-right\">" + ("" + (cnt)) + "</td></tr>"
        }
        if rcode_rows == "" { rcode_rows = "<tr><td colspan=\"2\" class=\"py-4 text-center text-[#3f3f46] text-sm\">No responses</td></tr>" }

        th := "text-[10px] uppercase tracking-wider text-[#52525b] font-semibold"
        method_section := "<div class=\"section\">" +
            "<div class=\"section-title\">SIP methods &amp; response codes</div>" +
            "<div class=\"grid lg:grid-cols-3 gap-4\">" +
            "<div class=\"" + crd + " p-4 overflow-x-auto\">" + method_bar.html + "</div>" +
            "<div class=\"" + crd + " overflow-x-auto\">" +
            "<table class=\"w-full text-left\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\">" +
            "<th class=\"py-1.5 px-3\">Method</th><th class=\"py-1.5 px-3 text-right\">Count</th><th class=\"py-1.5 px-3 text-right\">Share</th></tr></thead>" +
            "<tbody class=\"divide-y divide-[#1e1e22]/50\">" + method_rows + "</tbody></table></div>" +
            "<div class=\"" + crd + " overflow-x-auto\">" +
            "<table class=\"w-full text-left\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\">" +
            "<th class=\"py-1.5 px-3\">Status</th><th class=\"py-1.5 px-3 text-right\">Count</th></tr></thead>" +
            "<tbody class=\"divide-y divide-[#1e1e22]/50\">" + rcode_rows + "</tbody></table></div>" +
            "</div></div>"

        // ── Real-time window ──
        realtime := "<div class=\"section\">" +
            "<div class=\"section-title\">Real-time (5 min window)</div>" +
            "<div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3\">" +
            stat_card("Messages", rt["total"] ?? 0, "5-min window") +
            stat_card("INVITEs", rt["invites"] ?? 0, "call attempts") +
            stat_card("Active calls", rt["active_calls"] ?? 0, "in progress") +
            stat_card("ASR", ("" + (rt["asr"] ?? 0)) + "%", "answer-seizure") +
            stat_card("4xx errors", rt["resp_4xx"] ?? 0, "client errors") +
            stat_card("5xx errors", rt["resp_5xx"] ?? 0, "server errors") +
            "</div></div>"

        // ── KPI section ──
        asr := kpi["asr"] ?? 0
        ner := kpi["ner"] ?? 0
        asr_c := if asr >= 70 { "#34d399" } else if asr >= 40 { "#fbbf24" } else { "#f87171" }
        ner_c := if ner >= 80 { "#34d399" } else if ner >= 50 { "#fbbf24" } else { "#f87171" }
        kpi_section := "<div class=\"section\">" +
            "<div class=\"section-title\">Telecom KPIs (all time)</div>" +
            "<div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3\">" +
            gauge_card("ASR", asr, "%", asr_c, "answer-seizure ratio") +
            gauge_card("NER", ner, "%", ner_c, "network effectiveness") +
            stat_card("INVITEs", kpi["total_invites"] ?? 0, "answered " + ("" + (kpi["answered"] ?? 0))) +
            stat_card("Failed", kpi["failed"] ?? 0, "4xx+ on INVITE") +
            stat_card("Registrations", kpi["total_registers"] ?? 0, "ok " + ("" + (kpi["reg_ok"] ?? 0))) +
            stat_card("Reg failures", kpi["reg_fail"] ?? 0, "auth/denied") +
            "</div></div>"

        // ── Prometheus ──
        prom_url := h(core_base() + "/metrics")
        grafana_url := h(core_base() + "/api/grafana/")
        prom := "<div class=\"section\">" +
            "<div class=\"section-title\">Integration</div>" +
            "<div class=\"grid lg:grid-cols-2 gap-4\">" +
            "<div class=\"" + crd + " p-4 text-sm space-y-3\">" +
            "<div class=\"font-semibold\">Prometheus</div>" +
            "<p class=\"text-[#71717a] text-xs\">Scrape the core's <code class=\"mono\">/metrics</code> endpoint for standard text exposition.</p>" +
            "<code class=\"block mono text-xs bg-[#0a0a0c] border border-[#1e1e22] rounded-lg p-3 break-all\">" + prom_url + "</code>" +
            "<pre class=\"mono text-[11px] text-[#52525b] bg-[#0a0a0c] border border-[#1e1e22] rounded-lg p-3 overflow-x-auto\">scrape_configs:\n  - job_name: zaman\n    static_configs:\n      - targets: ['" + h(core_base()) + "']</pre></div>" +
            "<div class=\"" + crd + " p-4 text-sm space-y-3\">" +
            "<div class=\"font-semibold\">Grafana</div>" +
            "<p class=\"text-[#71717a] text-xs\">Use the SimpleJSON datasource plugin. Point at the Grafana API endpoint.</p>" +
            "<code class=\"block mono text-xs bg-[#0a0a0c] border border-[#1e1e22] rounded-lg p-3 break-all\">" + grafana_url + "</code>" +
            "<div class=\"text-[11px] text-[#52525b]\">Available metrics: messages_total, requests, responses, echoes, hep_total, asr, ner, active_calls, err_rate</div></div>" +
            "</div></div>"

        body := "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
            "<h1 class=\"text-xl font-semibold\">Metrics</h1>" +
            "<div class=\"flex gap-2\">" +
            "<a href=\"" + prom_url + "\" target=\"_blank\" class=\"text-[11px] text-[#52525b] hover:text-[#a1a1aa] transition-colors\">Prometheus →</a>" +
            "<a href=\"" + h(core_base() + "/api/metrics") + "\" target=\"_blank\" class=\"text-[11px] text-[#52525b] hover:text-[#a1a1aa] transition-colors\">JSON →</a></div></div>" +
            health + captures + hep + realtime + kpi_section + method_section + prom
        web.html(layout("Metrics", body, user))
    })

    app.get("/report", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }

        cid := req.query_map["call_id"] ?? ""
        agent := req.query_map["agent"] ?? ""
        method := req.query_map["method"] ?? ""
        transport := req.query_map["transport"] ?? ""
        src := req.query_map["ip"] ?? req.query_map["src"] ?? ""
        from_number := req.query_map["from_number"] ?? ""
        to_number := req.query_map["to_number"] ?? ""
        since_ms := req.query_map["since_ms"] ?? ""
        until_ms := req.query_map["until_ms"] ?? ""
        view := req.query_map["view"] ?? "calls"
        limit := int.parse(req.query_map["limit"] ?? "120").unwrap_or(120)
        mut safe_limit := limit
        if safe_limit <= 0 { safe_limit = 120 }
        if safe_limit > 500 { safe_limit = 500 }

        cid_h := h(cid)
        agent_h := h(agent)
        nodes := fetch_nodes()
        names := load_node_names()
        node_opts := node_select_options(nodes, names, agent)
        method_h := h(method)
        transport_h := h(transport)
        src_h := h(src)
        from_h := h(from_number)
        to_h := h(to_number)
        since_h := h(since_ms)
        until_h := h(until_ms)
        status := req.query_map["status"] ?? ""
        status_h := h(status)
        view_h := h(view)
        limit_h := h("" + (safe_limit))

        mut parts := []
        if cid != "" { parts = list_append(parts, "call_id=" + q(cid)) }
        if agent != "" { parts = list_append(parts, "agent=" + q(agent)) }
        if method != "" { parts = list_append(parts, "method=" + q(method)) }
        if transport != "" { parts = list_append(parts, "transport=" + q(transport)) }
        if src != "" { parts = list_append(parts, "ip=" + q(src)) }
        if from_number != "" { parts = list_append(parts, "from_number=" + q(from_number)) }
        if to_number != "" { parts = list_append(parts, "to_number=" + q(to_number)) }
        if status != "" { parts = list_append(parts, "status=" + q(status)) }
        if since_ms != "" { parts = list_append(parts, "since_ms=" + q(since_ms)) }
        if until_ms != "" { parts = list_append(parts, "until_ms=" + q(until_ms)) }
        mut qs := ""
        mut pi := 0
        while pi < len(parts) {
            if pi > 0 { qs = qs + "&" }
            qs = qs + parts[pi]
            pi = pi + 1
        }
        mut table_qs := qs
        if table_qs != "" { table_qs = table_qs + "&" }
        table_qs = table_qs + "limit=" + limit_h

        items := fetch_messages_time(safe_limit, cid, transport, agent, method, src, from_number, to_number, status, since_ms, until_ms)
        summary := call_state_summary(items)
        endpoints := ladder_endpoints(items)
        mut unique_calls := 0
        mut seen_calls := ""
        mut response_errors := 0
        mut invites := 0
        mut answered_2xx := 0
        mut failed_4xx5xx := 0
        mut registers := 0
        mut reg_ok := 0
        mut reg_fail := 0
        mut byes := 0
        mut cancels := 0
        mut options := 0
        mut timeout_408 := 0
        mut resp_1xx := 0
        mut resp_2xx := 0
        mut resp_3xx := 0
        mut resp_4xx := 0
        mut resp_5xx := 0
        for m in items {
            mcid := m["call_id"] ?? ""
            if mcid != "" && !str.contains(seen_calls, "|" + mcid + "|") {
                seen_calls = seen_calls + "|" + mcid + "|"
                unique_calls = unique_calls + 1
            }
            mmethod := m["method"] ?? ""
            if mmethod == "INVITE" { invites = invites + 1 }
            if mmethod == "REGISTER" { registers = registers + 1 }
            if mmethod == "BYE" { byes = byes + 1 }
            if mmethod == "CANCEL" { cancels = cancels + 1 }
            if mmethod == "OPTIONS" { options = options + 1 }
            st := m["status"] ?? 0
            if st == 408 { timeout_408 = timeout_408 + 1 }
            if st >= 100 && st < 200 { resp_1xx = resp_1xx + 1 }
            if st >= 200 && st < 300 { resp_2xx = resp_2xx + 1 }
            if st >= 300 && st < 400 { resp_3xx = resp_3xx + 1 }
            if st >= 400 && st < 500 { resp_4xx = resp_4xx + 1 }
            if st >= 500 { resp_5xx = resp_5xx + 1 }
            if st >= 400 { response_errors = response_errors + 1 }
            if st >= 200 && st < 300 {
                answered_2xx = answered_2xx + 1
                if mmethod == "REGISTER" { reg_ok = reg_ok + 1 }
            }
            if st >= 400 {
                failed_4xx5xx = failed_4xx5xx + 1
                if mmethod == "REGISTER" { reg_fail = reg_fail + 1 }
            }
        }
        filtered_asr := if invites > 0 { answered_2xx * 100 / invites } else { 0 }
        filtered_ner := if invites > 0 { (invites - failed_4xx5xx) * 100 / invites } else { 0 }
        filtered_err_rate := if (summary["responses"] ?? 0) > 0 { response_errors * 100 / (summary["responses"] ?? 1) } else { 0 }
        timeout_rate := if (summary["responses"] ?? 0) > 0 { timeout_408 * 100 / (summary["responses"] ?? 1) } else { 0 }
        filt_asr_c := if filtered_asr >= 70 { "#34d399" } else if filtered_asr >= 40 { "#fbbf24" } else { "#f87171" }
        filt_ner_c := if filtered_ner >= 80 { "#34d399" } else if filtered_ner >= 50 { "#fbbf24" } else { "#f87171" }
        err_c := if filtered_err_rate == 0 { "#34d399" } else if filtered_err_rate < 10 { "#fbbf24" } else { "#f87171" }
        timeout_c := if timeout_408 == 0 { "#34d399" } else if timeout_rate < 10 { "#fbbf24" } else { "#f87171" }

        export_path := if qs != "" { "?" + qs } else { "" }
        open_messages := "/messages" + export_path
        json_export := "/export/json" + export_path
        csv_export := "/export/csv" + export_path
        preview := if view == "messages" || cid != "" { messages_table(items) } else { call_groups_table(items) }

        inp := "rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 text-sm mono"
        selected_calls := if view == "calls" { " selected" } else { "" }
        selected_messages := if view == "messages" { " selected" } else { "" }
        builder := "<form class=\"card p-4 mb-5\" method=\"get\" action=\"/report\">" +
            "<div class=\"flex flex-wrap items-center justify-between gap-3 mb-4\">" +
            "<div><div class=\"section-title mb-1\">Report Builder</div><div class=\"text-sm text-[#71717a]\">Filter stored SIP/HEP history, preview the result, then export JSON or CSV.</div></div>" +
            "<div class=\"flex gap-2\"><a href=\"" + json_export + "\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">Export JSON</a>" +
            "<a href=\"" + csv_export + "\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">Export CSV</a></div></div>" +
            "<div class=\"grid grid-cols-2 md:grid-cols-4 xl:grid-cols-8 gap-3\">" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">View</label><select name=\"view\" class=\"w-full " + inp + "\"><option value=\"calls\"" + selected_calls + ">Calls</option><option value=\"messages\"" + selected_messages + ">Messages</option></select></div>" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Call-ID</label><input name=\"call_id\" value=\"" + cid_h + "\" placeholder=\"any\" class=\"w-full " + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">From Number</label><input name=\"from_number\" value=\"" + from_h + "\" placeholder=\"caller\" class=\"w-full " + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">To Number</label><input name=\"to_number\" value=\"" + to_h + "\" placeholder=\"callee\" class=\"w-full " + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">IP Address</label><input name=\"ip\" value=\"" + src_h + "\" placeholder=\"source or destination\" class=\"w-full " + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Server</label><select name=\"agent\" class=\"w-full " + inp + "\">" + node_opts + "</select></div>" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Method</label><input name=\"method\" value=\"" + method_h + "\" placeholder=\"INVITE\" class=\"w-full " + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Transport</label><input name=\"transport\" value=\"" + transport_h + "\" placeholder=\"HEP3\" class=\"w-full " + inp + "\"/></div>" +
            "</div><div class=\"mt-3 flex flex-wrap items-end gap-3\">" +
            "<div class=\"w-28\"><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Limit</label><input name=\"limit\" value=\"" + limit_h + "\" class=\"w-full " + inp + "\"/></div>" +
            "<div class=\"w-28\"><label class=\"block text-[10px] text-[#71717a] uppercase tracking-wider mb-1\">Status</label><input name=\"status\" value=\"" + status_h + "\" placeholder=\"408\" class=\"w-full " + inp + "\"/></div>" +
            time_filter_fields("report-time", since_h, until_h, inp) +
            "<button class=\"rounded-lg px-4 py-2 text-sm bg-[#27272a] text-[#e4e4e7] hover:bg-[#3f3f46] transition-colors\">Build report</button>" +
            "<a href=\"/report\" class=\"rounded-lg px-4 py-2 text-sm border border-[#27272a] text-[#a1a1aa] hover:text-[#e4e4e7]\">Clear</a>" +
            "<a href=\"" + open_messages + "\" class=\"rounded-lg px-4 py-2 text-sm border border-[#27272a] text-[#a1a1aa] hover:text-[#e4e4e7]\">Open in Messages</a>" +
            (if cid != "" { "<a " + ladder_nav_attrs(cid) + " class=\"rounded-lg px-4 py-2 text-sm border border-[#27272a] text-[#a1a1aa] hover:text-[#e4e4e7]\">Call ladder</a>" } else { "" }) +
            "</div></form>"

        quick := "<div class=\"grid md:grid-cols-2 xl:grid-cols-4 gap-3 mb-5\">" +
            "<a href=\"/report?method=INVITE&view=calls\" class=\"rounded-md border border-[#27272a] bg-[#0a0a0c] p-3 text-sm hover:border-[#3f3f46]\"><div class=\"font-semibold\">Call attempts</div><div class=\"text-xs text-[#71717a] mt-1\">INVITE traffic grouped by Call-ID</div></a>" +
            "<a href=\"/report?method=REGISTER&view=messages\" class=\"rounded-md border border-[#27272a] bg-[#0a0a0c] p-3 text-sm hover:border-[#3f3f46]\"><div class=\"font-semibold\">Registrations</div><div class=\"text-xs text-[#71717a] mt-1\">REGISTER messages and failures</div></a>" +
            "<a href=\"/report?transport=HEP3&view=calls\" class=\"rounded-md border border-[#27272a] bg-[#0a0a0c] p-3 text-sm hover:border-[#3f3f46]\"><div class=\"font-semibold\">HEP captures</div><div class=\"text-xs text-[#71717a] mt-1\">Traffic received from OpenSIPS nodes</div></a>" +
            "<a href=\"/report?status=408&view=messages\" class=\"rounded-md border border-[#27272a] bg-[#0a0a0c] p-3 text-sm hover:border-[#3f3f46]\"><div class=\"font-semibold\">408 timeouts</div><div class=\"text-xs text-[#71717a] mt-1\">Source and destination IPs for timeout troubleshooting</div></a>" +
            "<a href=\"/ip\" class=\"rounded-md border border-[#27272a] bg-[#0a0a0c] p-3 text-sm hover:border-[#3f3f46]\"><div class=\"font-semibold\">IP history</div><div class=\"text-xs text-[#71717a] mt-1\">Search any labeled SIP peer or OpenSIPS node</div></a>" +
            "</div>"

        telecom_kpis := "<div class=\"section\">" +
            "<div class=\"flex items-center justify-between mb-3\"><div class=\"section-title mb-0\">Telecom KPIs</div><span class=\"text-[10px] text-[#52525b]\">all-time + filtered preview</span></div>" +
            "<div class=\"grid xl:grid-cols-[.75fr_1.25fr] gap-4\">" +
            "<div class=\"card p-4\"><div class=\"text-sm font-semibold mb-3\">All-time network health</div>" +
            "<div id=\"report-telecom-kpis\" hx-get=\"/partials/report-telecom-kpis\" hx-trigger=\"load\" hx-swap=\"innerHTML\">" +
            "<div class=\"rounded-md border border-[#27272a] bg-[#0a0a0c] p-5 text-sm text-[#71717a]\">Loading telecom KPIs...</div></div></div>" +
            "<div class=\"card p-4\"><div class=\"text-sm font-semibold mb-3\">Filtered report KPIs</div>" +
            "<div class=\"grid grid-cols-2 md:grid-cols-4 gap-3\">" +
            call_fact("Filtered ASR", "" + (filtered_asr) + "%", "2xx / INVITEs in result", filt_asr_c) +
            call_fact("Filtered NER", "" + (filtered_ner) + "%", "INVITEs minus failures", filt_ner_c) +
            call_fact("Error rate", "" + (filtered_err_rate) + "%", "4xx/5xx responses", err_c) +
            call_fact("408 timeout rate", "" + (timeout_rate) + "%", "408 / responses", timeout_c) +
            call_fact("Call attempts", "" + (invites), "INVITE messages", "#38bdf8") +
            call_fact("Answered", "" + (answered_2xx), "2xx responses", "#34d399") +
            call_fact("Failed", "" + (failed_4xx5xx), "4xx/5xx responses", "#f87171") +
            call_fact("Registers", "" + (registers), "ok " + ("" + (reg_ok)) + " fail " + ("" + (reg_fail)), "#a78bfa") +
            call_fact("Teardowns", "" + (byes + cancels), "BYE/CANCEL", "#fbbf24") +
            "</div><div class=\"mt-3 grid md:grid-cols-3 gap-3 text-xs text-[#71717a]\">" +
            "<div class=\"rounded-md border border-[#27272a] bg-[#0a0a0c] p-3\"><span class=\"text-[#e4e4e7] font-semibold\">OPTIONS:</span> <span class=\"mono\">" + ("" + (options)) + "</span></div>" +
            "<div class=\"rounded-md border border-[#27272a] bg-[#0a0a0c] p-3\"><span class=\"text-[#e4e4e7] font-semibold\">Unique calls:</span> <span class=\"mono\">" + ("" + (unique_calls)) + "</span></div>" +
            "<div class=\"rounded-md border border-[#27272a] bg-[#0a0a0c] p-3\"><span class=\"text-[#e4e4e7] font-semibold\">Preview rows:</span> <span class=\"mono\">" + ("" + (len(items))) + "</span></div>" +
            "</div></div></div></div>"

        stats := "<div class=\"grid grid-cols-2 md:grid-cols-4 xl:grid-cols-7 gap-3 mb-5\">" +
            call_fact("Rows", "" + (len(items)), "preview rows", "#e4e4e7") +
            call_fact("Calls", "" + (unique_calls), "unique Call-IDs", "#38bdf8") +
            call_fact("Endpoints", "" + (len(endpoints)), "src/dst seen", "#a78bfa") +
            call_fact("INVITEs", "" + (invites), "call attempts", "#fbbf24") +
            call_fact("Errors", "" + (response_errors), "status >= 400", if response_errors == 0 { "#34d399" } else { "#f87171" }) +
            call_fact("408s", "" + (timeout_408), "request timeout responses", timeout_c) +
            call_fact("Requests", "" + (summary["requests"] ?? 0), "SIP requests", "#34d399") +
            call_fact("Responses", "" + (summary["responses"] ?? 0), "SIP responses", "#f472b6") +
            "</div>"

        timeout_panel := "<div class=\"section\">" +
            "<div class=\"flex flex-wrap items-center justify-between gap-3 mb-3\"><div class=\"section-title mb-0\">Timeout &amp; Failure Analysis</div>" +
            "<div class=\"flex gap-2 text-[11px]\"><a class=\"rounded-md border border-[#27272a] px-2 py-1 text-[#a1a1aa] hover:text-[#e4e4e7]\" href=\"/report?status=408&view=messages\">All 408s</a>" +
            "<a class=\"rounded-md border border-[#27272a] px-2 py-1 text-[#a1a1aa] hover:text-[#e4e4e7]\" href=\"/messages?status=408\">Open 408 messages</a></div></div>" +
            "<div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3\">" +
            call_fact("408 responses", "" + (timeout_408), "timeouts in this report", timeout_c) +
            call_fact("4xx responses", "" + (resp_4xx), "client-side failures", if resp_4xx == 0 { "#34d399" } else { "#fb923c" }) +
            call_fact("5xx responses", "" + (resp_5xx), "server-side failures", if resp_5xx == 0 { "#34d399" } else { "#f87171" }) +
            call_fact("2xx responses", "" + (resp_2xx), "successful responses", "#34d399") +
            call_fact("1xx responses", "" + (resp_1xx), "provisional signaling", "#fbbf24") +
            call_fact("3xx responses", "" + (resp_3xx), "redirect responses", "#38bdf8") +
            "</div></div>"

        breakdowns := "<div class=\"grid xl:grid-cols-3 gap-4 mb-5\">" +
            "<div class=\"card overflow-x-auto\"><div class=\"p-4 border-b border-[#1e1e22]\"><div class=\"section-title mb-0\">Filtered Response Codes</div></div>" +
            "<table class=\"w-full text-left\"><thead><tr class=\"text-[10px] uppercase tracking-wider text-[#52525b] border-b border-[#1e1e22]\"><th class=\"py-2 px-3\">Status</th><th class=\"py-2 px-3 text-right\">Count</th></tr></thead><tbody class=\"divide-y divide-[#1e1e22]/50\">" + report_status_rows(items) + "</tbody></table></div>" +
            "<div class=\"card overflow-x-auto\"><div class=\"p-4 border-b border-[#1e1e22]\"><div class=\"section-title mb-0\">Top Source IPs</div></div>" +
            "<table class=\"w-full text-left\"><thead><tr class=\"text-[10px] uppercase tracking-wider text-[#52525b] border-b border-[#1e1e22]\"><th class=\"py-2 px-3\">Source</th><th class=\"py-2 px-3 text-right\">Msgs</th></tr></thead><tbody class=\"divide-y divide-[#1e1e22]/50\">" + report_endpoint_rows(items, "src", 8) + "</tbody></table></div>" +
            "<div class=\"card overflow-x-auto\"><div class=\"p-4 border-b border-[#1e1e22]\"><div class=\"section-title mb-0\">Top Destination IPs</div></div>" +
            "<table class=\"w-full text-left\"><thead><tr class=\"text-[10px] uppercase tracking-wider text-[#52525b] border-b border-[#1e1e22]\"><th class=\"py-2 px-3\">Destination</th><th class=\"py-2 px-3 text-right\">Msgs</th></tr></thead><tbody class=\"divide-y divide-[#1e1e22]/50\">" + report_endpoint_rows(items, "dst", 8) + "</tbody></table></div>" +
            "</div>"

        routes_panel := "<div class=\"section\">" +
            "<div class=\"flex items-center justify-between mb-3\"><div class=\"section-title mb-0\">Source to Destination Paths</div><div class=\"text-[10px] text-[#52525b] mono\">" + ("" + (len(items))) + " sampled rows</div></div>" +
            "<div class=\"card overflow-x-auto\"><table class=\"w-full text-left\"><thead><tr class=\"text-[10px] uppercase tracking-wider text-[#52525b] border-b border-[#1e1e22]\"><th class=\"py-2 px-3\">Path</th><th class=\"py-2 px-3 text-right\">Msgs</th></tr></thead><tbody class=\"divide-y divide-[#1e1e22]/50\">" + report_route_rows(items, 12) + "</tbody></table></div></div>"

        preview_panel := "<div class=\"section\">" +
            "<div class=\"flex items-center justify-between mb-3\"><div class=\"section-title mb-0\">Report Preview</div><div class=\"text-[10px] text-[#52525b] mono\">" + (if qs != "" { h(qs) } else { "all recent records" }) + "</div></div>" +
            preview + "</div>"

        explain := "<div class=\"grid lg:grid-cols-3 gap-4 mb-5\">" +
            "<div class=\"card p-4\"><div class=\"section-title\">Build On Anything</div><div class=\"text-sm text-[#a1a1aa] space-y-2\"><div>Use Call-ID for one dialog, From/To for caller/callee, Endpoint IP for a site, Agent for a server, and Method/Transport for protocol slices.</div><div>Searches run against stored history and the same filters can be opened in the live Messages page.</div></div></div>" +
            "<div class=\"card p-4\"><div class=\"section-title\">Export</div><div class=\"text-sm text-[#a1a1aa] space-y-2\"><div>JSON keeps full message objects for automation.</div><div>CSV is better for spreadsheet review and customer-facing extracts.</div></div></div>" +
            "<div class=\"card p-4\"><div class=\"section-title\">Next Drilldown</div><div class=\"grid gap-2 text-sm\"><a href=\"/ladder\" class=\"rounded-md border border-[#27272a] px-3 py-2 hover:text-[#e4e4e7]\">Call ladders</a><a href=\"/ip\" class=\"rounded-md border border-[#27272a] px-3 py-2 hover:text-[#e4e4e7]\">IP history and labels</a><a href=\"/metrics\" class=\"rounded-md border border-[#27272a] px-3 py-2 hover:text-[#e4e4e7]\">Operational metrics</a></div></div>" +
            "</div>"

        body := "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
            "<div><h1 class=\"text-2xl font-bold\">Reports</h1><p class=\"text-sm text-[#71717a] mt-1\">Build filtered reports from SIP/HEP history and export the exact result set.</p></div>" +
            "<a href=\"/report-old\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">Legacy report</a></div>" +
            builder + quick + telecom_kpis + stats + timeout_panel + breakdowns + routes_panel + preview_panel + explain
        web.html(layout("Reports", body, user))
    })

    app.get("/report-old", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        rep := fetch_report()
        kpi := fetch_kpi()
        tops := fetch_top_calls()
        talkers := fetch_top_talkers()
        agents := fetch_agents()
        rcodes := fetch_response_codes()
        daily := fetch_daily()
        crd := "card"
        th := "text-[10px] uppercase tracking-wider text-[#52525b] font-semibold"

        // ── Section 1: Telecom KPIs with visual gauges ──
        asr := kpi["asr"] ?? 0
        ner := kpi["ner"] ?? 0
        asr_color := if asr >= 70 { "#34d399" } else if asr >= 40 { "#fbbf24" } else { "#f87171" }
        ner_color := if ner >= 80 { "#34d399" } else if ner >= 50 { "#fbbf24" } else { "#f87171" }
        total_inv := kpi["total_invites"] ?? 0
        answered := kpi["answered"] ?? 0
        failed := kpi["failed"] ?? 0
        reg_ok := kpi["reg_ok"] ?? 0
        reg_fail := kpi["reg_fail"] ?? 0
        total_reg := kpi["total_registers"] ?? 0

        sec_kpi := "<div class=\"mb-8\">" +
            "<div class=\"flex items-center gap-2 mb-4\"><h2 class=\"text-lg font-semibold\">Telecom KPIs</h2>" +
            "<span class=\"text-[10px] text-[#52525b] bg-[#27272a] rounded px-1.5 py-0.5\">REAL-TIME</span></div>" +
            "<div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3\">" +
            gauge_card("ASR", asr, "%", asr_color, "Answer-seizure ratio") +
            gauge_card("NER", ner, "%", ner_color, "Network effectiveness") +
            "<div class=\"" + crd + " p-5\">" +
            "<div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold mb-3\">INVITEs</div>" +
            "<div class=\"text-3xl font-bold mono text-[#e4e4e7] mb-2\">" + ("" + (total_inv)) + "</div>" +
            "<div class=\"flex gap-3 text-[11px]\">" +
            "<span class=\"text-[#34d399]\">&#x2713; " + ("" + (answered)) + " answered</span>" +
            "<span class=\"text-[#f87171]\">&#x2717; " + ("" + (failed)) + " failed</span></div></div>" +
            "<div class=\"" + crd + " p-5\">" +
            "<div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold mb-3\">Registrations</div>" +
            "<div class=\"text-3xl font-bold mono text-[#e4e4e7] mb-2\">" + ("" + (total_reg)) + "</div>" +
            "<div class=\"flex gap-3 text-[11px]\">" +
            "<span class=\"text-[#34d399]\">&#x2713; " + ("" + (reg_ok)) + " ok</span>" +
            "<span class=\"text-[#f87171]\">&#x2717; " + ("" + (reg_fail)) + " failed</span></div></div>" +
            stat_card("Messages", kpi["total_messages"] ?? 0, "total captures") +
            stat_card("Unique calls", kpi["total_calls"] ?? 0, "distinct Call-IDs") +
            "</div></div>"

        // ── Section 2: Traffic Distribution ──
        mut methods := rep["methods"]
        if methods == null { methods = {} }
        bar := viz.bar({
            "INVITE": methods["INVITE"] ?? 0,
            "OPTIONS": methods["OPTIONS"] ?? 0,
            "REGISTER": methods["REGISTER"] ?? 0,
            "BYE": methods["BYE"] ?? 0,
            "ACK": methods["ACK"] ?? 0,
        }, {"title": "SIP methods", "width": 520, "height": 220, "colors": ["#a78bfa", "#34d399", "#f472b6", "#fb923c", "#facc15"]})
        mut trs := rep["transports"]
        if trs == null { trs = {} }
        pie := viz.pie({
            "UDP": trs["UDP"] ?? 0,
            "HEP3": trs["HEP3"] ?? 0,
            "HEP3/TCP": trs["HEP3/TCP"] ?? 0,
            "HEP3/TLS": trs["HEP3/TLS"] ?? 0,
        }, {"title": "Capture transport", "width": 400, "height": 240})

        // Response code groups with color bars
        mut total_responses := 0
        mut rcode_1xx := 0
        mut rcode_2xx := 0
        mut rcode_3xx := 0
        mut rcode_4xx := 0
        mut rcode_5xx := 0
        for rc in rcodes {
            st := rc["status"] ?? 0
            cnt := rc["count"] ?? 0
            total_responses = total_responses + cnt
            if st >= 100 && st < 200 { rcode_1xx = rcode_1xx + cnt }
            else if st >= 200 && st < 300 { rcode_2xx = rcode_2xx + cnt }
            else if st >= 300 && st < 400 { rcode_3xx = rcode_3xx + cnt }
            else if st >= 400 && st < 500 { rcode_4xx = rcode_4xx + cnt }
            else if st >= 500 { rcode_5xx = rcode_5xx + cnt }
        }
        mut rcode_bars := "<div class=\"" + crd + " p-5\">" +
            "<div class=\"text-[10px] text-[#52525b] uppercase tracking-wider font-semibold mb-4\">Response codes</div>" +
            rcode_bar("1xx", rcode_1xx, total_responses, "#a78bfa") +
            rcode_bar("2xx", rcode_2xx, total_responses, "#34d399") +
            rcode_bar("3xx", rcode_3xx, total_responses, "#22d3ee") +
            rcode_bar("4xx", rcode_4xx, total_responses, "#fb923c") +
            rcode_bar("5xx", rcode_5xx, total_responses, "#f87171") +
            "<div class=\"border-t border-[#1e1e22] mt-3 pt-3\">"
        // Individual status codes
        for rc in rcodes {
            st := rc["status"] ?? 0
            cnt := rc["count"] ?? 0
            sc := if st >= 200 && st < 300 { "text-[#34d399]" } else if st >= 400 { "text-[#f87171]" } else if st >= 300 { "text-[#22d3ee]" } else if st >= 500 { "text-[#f87171]" } else { "text-[#a78bfa]" }
            rcode_bars = rcode_bars + "<div class=\"flex justify-between py-0.5\">" +
                "<span class=\"mono text-xs font-medium " + sc + "\">" + ("" + (st)) + "</span>" +
                "<span class=\"mono text-xs text-[#71717a]\">" + ("" + (cnt)) + "</span></div>"
        }
        rcode_bars = rcode_bars + "</div></div>"

        sec_traffic := "<div class=\"mb-8\">" +
            "<h2 class=\"text-lg font-semibold mb-4\">Traffic distribution</h2>" +
            "<div class=\"grid lg:grid-cols-3 gap-4\">" +
            "<div class=\"" + crd + " p-5 overflow-x-auto\">" + bar.html + "</div>" +
            "<div class=\"" + crd + " p-5 overflow-x-auto\">" + pie.html + "</div>" +
            rcode_bars +
            "</div></div>"

        // ── Section 3: Network topology — agents + top talkers side by side ──
        mut agent_rows := ""
        mut rank := 1
        for a in agents {
            aname := h(a["agent"] ?? "")
            amsg := a["messages"] ?? 0
            acall := a["calls"] ?? 0
            // Bar relative to max
            max_msg := if len(agents) > 0 { (agents[0]["messages"] ?? 1) } else { 1 }
            bar_w := if max_msg > 0 { amsg * 100 / max_msg } else { 0 }
            agent_rows = agent_rows + "<tr>" +
                "<td class=\"py-2.5 px-4 text-[11px] text-[#52525b] mono\">" + ("" + (rank)) + "</td>" +
                "<td class=\"py-2.5 px-4\"><div class=\"text-sm font-medium\">" + aname + "</div>" +
                "<div class=\"w-full h-1 rounded-full bg-[#27272a] mt-1.5\"><div class=\"h-full rounded-full bg-[#a78bfa]/60\" style=\"width:" + ("" + (bar_w)) + "%\"></div></div></td>" +
                "<td class=\"py-2.5 px-4 mono text-sm text-right\">" + ("" + (amsg)) + "</td>" +
                "<td class=\"py-2.5 px-4 mono text-sm text-right text-[#71717a]\">" + ("" + (acall)) + "</td>" +
                "<td class=\"py-2.5 px-4\"><a class=\"text-[11px] text-[#a78bfa] hover:underline\" href=\"/messages?agent=" + aname + "\">view</a></td></tr>"
            rank = rank + 1
        }
        if agent_rows == "" { agent_rows = "<tr><td colspan=\"5\" class=\"py-8 text-center text-[#52525b] text-sm\">No HEP agents reporting yet.</td></tr>" }

        mut talker_rows := ""
        rank = 1
        for t in talkers {
            tsrc := h(t["src"] ?? "")
            tmsg := t["messages"] ?? 0
            tcall := t["calls"] ?? 0
            max_t := if len(talkers) > 0 { (talkers[0]["messages"] ?? 1) } else { 1 }
            tw := if max_t > 0 { tmsg * 100 / max_t } else { 0 }
            talker_rows = talker_rows + "<tr>" +
                "<td class=\"py-2.5 px-4 text-[11px] text-[#52525b] mono\">" + ("" + (rank)) + "</td>" +
                "<td class=\"py-2.5 px-4\"><div class=\"mono text-xs\">" + tsrc + "</div>" +
                "<div class=\"w-full h-1 rounded-full bg-[#27272a] mt-1.5\"><div class=\"h-full rounded-full bg-[#34d399]/60\" style=\"width:" + ("" + (tw)) + "%\"></div></div></td>" +
                "<td class=\"py-2.5 px-4 mono text-sm text-right\">" + ("" + (tmsg)) + "</td>" +
                "<td class=\"py-2.5 px-4 mono text-sm text-right text-[#71717a]\">" + ("" + (tcall)) + "</td>" +
                "<td class=\"py-2.5 px-4\"><a class=\"text-[11px] text-[#a78bfa] hover:underline\" href=\"/messages?src=" + tsrc + "\">view</a></td></tr>"
            rank = rank + 1
        }
        if talker_rows == "" { talker_rows = "<tr><td colspan=\"5\" class=\"py-8 text-center text-[#52525b] text-sm\">No endpoints seen yet.</td></tr>" }

        hdr5 := "<tr class=\"" + th + " border-b border-[#1e1e22]\"><th class=\"py-2 px-4 w-8\">#</th><th class=\"py-2 px-4\">Name</th><th class=\"py-2 px-4 text-right\">Msgs</th><th class=\"py-2 px-4 text-right\">Calls</th><th class=\"py-2 px-4 w-12\"></th></tr>"

        sec_network := "<div class=\"mb-8\">" +
            "<h2 class=\"text-lg font-semibold mb-4\">Network topology</h2>" +
            "<div class=\"grid lg:grid-cols-2 gap-4\">" +
            "<div class=\"" + crd + " overflow-x-auto\">" +
            "<div class=\"px-5 py-3 border-b border-[#1e1e22] flex items-center justify-between\">" +
            "<span class=\"text-sm font-semibold\">HEP agents</span>" +
            "<span class=\"text-[10px] text-[#52525b] mono\">" + ("" + (len(agents))) + " nodes</span></div>" +
            "<table class=\"w-full text-left\"><thead>" + hdr5 + "</thead>" +
            "<tbody class=\"divide-y divide-[#27272a]/40\">" + agent_rows + "</tbody></table></div>" +
            "<div class=\"" + crd + " overflow-x-auto\">" +
            "<div class=\"px-5 py-3 border-b border-[#1e1e22] flex items-center justify-between\">" +
            "<span class=\"text-sm font-semibold\">Top endpoints</span>" +
            "<span class=\"text-[10px] text-[#52525b] mono\">" + ("" + (len(talkers))) + " sources</span></div>" +
            "<table class=\"w-full text-left\"><thead>" + hdr5 + "</thead>" +
            "<tbody class=\"divide-y divide-[#27272a]/40\">" + talker_rows + "</tbody></table></div>" +
            "</div></div>"

        // ── Section 4: Call activity ──
    mut top_rows := ""
    for row in tops {
        raw_cid := row["call_id"] ?? ""
        cid := h(raw_cid)
        msgs := row["messages"] ?? 0
        top_rows = top_rows + "<tr>" +
            "<td class=\"py-2 px-4 mono text-xs max-w-[22rem] truncate\" title=\"" + cid + "\">" + cid + "</td>" +
            "<td class=\"py-2 px-4 mono text-sm text-right\">" + ("" + (msgs)) + "</td>" +
            "<td class=\"py-2 px-4 text-right\">" +
                    "<a class=\"text-[11px] text-[#a78bfa] hover:underline\" " + ladder_nav_attrs(raw_cid) + ">ladder</a>" +
            " <a class=\"text-[11px] text-[#52525b] hover:text-[#a1a1aa]\" href=\"/pcap?call_id=" + q(raw_cid) + "\">pcap</a></td></tr>"
    }
        if top_rows == "" { top_rows = "<tr><td colspan=\"3\" class=\"py-8 text-center text-[#52525b] text-sm\">No calls captured yet.</td></tr>" }

        mut day_rows := ""
        for row in daily {
            day_rows = day_rows + "<tr>" +
                "<td class=\"py-1.5 px-4 mono text-xs\">" + h(row["day"] ?? "") + "</td>" +
                "<td class=\"py-1.5 px-4 text-xs\">" + h(row["method"] ?? "") + "</td>" +
                "<td class=\"py-1.5 px-4 text-xs text-[#71717a]\">" + h(row["transport"] ?? "") + "</td>" +
                "<td class=\"py-1.5 px-4 mono text-sm text-right\">" + ("" + (row["count"] ?? 0)) + "</td></tr>"
        }
        if day_rows == "" { day_rows = "<tr><td colspan=\"4\" class=\"py-6 text-center text-[#52525b] text-sm\">No daily rollups yet.</td></tr>" }

        sec_calls := "<div class=\"mb-8\">" +
            "<h2 class=\"text-lg font-semibold mb-4\">Call activity</h2>" +
            "<div class=\"grid lg:grid-cols-2 gap-4\">" +
            "<div class=\"" + crd + " overflow-x-auto\">" +
            "<div class=\"px-5 py-3 border-b border-[#1e1e22] flex items-center justify-between\">" +
            "<span class=\"text-sm font-semibold\">Busiest Call-IDs</span>" +
            "<span class=\"text-[10px] text-[#52525b] mono\">" + ("" + (len(tops))) + " calls</span></div>" +
            "<table class=\"w-full text-left text-sm\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\">" +
            "<th class=\"py-2 px-4\">Call-ID</th><th class=\"py-2 px-4 text-right\">Msgs</th><th class=\"py-2 px-4 text-right\"></th></tr></thead>" +
            "<tbody class=\"divide-y divide-[#27272a]/40\">" + top_rows + "</tbody></table></div>" +
            "<div class=\"" + crd + " overflow-x-auto\">" +
            "<div class=\"px-5 py-3 border-b border-[#1e1e22] flex items-center justify-between\">" +
            "<span class=\"text-sm font-semibold\">Daily rollup</span>" +
            "<span class=\"text-[10px] text-[#52525b]\">method × transport per day</span></div>" +
            "<table class=\"w-full text-left text-sm\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\">" +
            "<th class=\"py-2 px-4\">Day</th><th class=\"py-2 px-4\">Method</th><th class=\"py-2 px-4\">Transport</th><th class=\"py-2 px-4 text-right\">Count</th></tr></thead>" +
            "<tbody class=\"divide-y divide-[#27272a]/40\">" + day_rows + "</tbody></table></div>" +
            "</div></div>"

        // ── Section 5: Database info ──
        ts_min := rep["ts_min"] ?? 0
        ts_max := rep["ts_max"] ?? 0
        span_h := if ts_max > ts_min { (ts_max - ts_min) / 3600000 } else { 0 }
        db_info := "<div class=\"" + crd + " p-5\">" +
            "<div class=\"flex items-center justify-between\">" +
            "<div class=\"text-sm\">" +
            "<span class=\"text-[#71717a]\">Storage:</span> <span class=\"mono text-xs\">" + h(rep["db"] ?? "data/zaman.db") + "</span>" +
            " · <span class=\"text-[#71717a]\">Span:</span> <span class=\"mono text-xs\">" + ("" + (span_h)) + "h</span>" +
            " · <span class=\"text-[#71717a]\">SIP/UDP:</span> <span class=\"mono text-xs\">" + ("" + (rep["sip_udp"] ?? 0)) + "</span>" +
            " · <span class=\"text-[#71717a]\">HEP:</span> <span class=\"mono text-xs\">" + ("" + (rep["hep"] ?? 0)) + "</span></div>" +
            "<a href=\"/export/json\" class=\"rounded-lg px-3 py-1.5 text-[11px] border border-[#1e1e22] text-[#71717a] hover:text-[#e4e4e7] transition-colors\">Export all JSON</a>" +
            "</div></div>"

        // Assemble
        body := "<div class=\"flex items-end justify-between gap-3 mb-6\">" +
            "<div><h1 class=\"text-2xl font-bold\">Reports</h1>" +
            "<p class=\"text-sm text-[#71717a] mt-1\">Telecom KPIs, traffic analysis, network topology, and capture history.</p></div></div>" +
            sec_kpi + sec_traffic + sec_network + sec_calls + db_info
        web.html(layout("Reports", body, user))
    })

    // ---- share link (public read-only ladder) ----

    app.get("/share", fn(req) {
        tok := req.query_map["token"] ?? ""
        if tok == "" { return web.status(400) }
        call_id := verify_share_token(token_secret, tok)
        if call_id == null { return web.html("<!doctype html><html><body style='background:#09090b;color:#f87171;font-family:system-ui;display:flex;align-items:center;justify-content:center;min-height:100vh'><div><h1>Link expired or invalid</h1><p>Share links are valid for 7 days.</p></div></body></html>") }
        // Render ladder without auth (read-only)
        anon := {"id": 0, "username": "shared", "role": "viewer"}
        web.html(layout("Shared: " + call_id, ladder_html(call_id), anon))
    })

    // Generate share link (requires login)
    app.post("/share/create", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        cid := web.form_get(req, "call_id", "")
        if cid == "" { return web.status(400) }
        tok := make_share_token(token_secret, cid)
        audit(user["username"] ?? "", "share_create", "call_id=" + cid)
        // Return the share URL as HTMX partial
        share_url := "/share?token=" + tok
        web.htmx("<div class=\"rounded-xl border border-[#34d399]/30 bg-[#34d399]/5 p-3 mt-3\">" +
            "<div class=\"text-xs text-[#34d399] font-semibold mb-1\">Share link created (valid 7 days)</div>" +
            "<input class=\"w-full mono text-xs bg-[#0a0a0c] border border-[#1e1e22] rounded-lg px-3 py-2 select-all\" value=\"" + h(share_url) + "\" readonly onclick=\"this.select()\"/></div>")
    })

    // ---- user preferences ----

    app.post("/preferences", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        uname := user["username"] ?? ""
        default_window := web.form_get(req, "default_window", "5")
        set_user_pref(uname, "default_window", default_window)
        {"status": 302, "headers": {"Location": "/"}, "body": ""}
    })

    // ---- PCAP export route ----

    app.get("/pcap", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        cid := req.query_map["call_id"] ?? ""
        if cid == "" { return web.status(400) }
        messages := fetch_messages(500, cid)
        // Sort chronological
        mut ordered := []
        mut i := len(messages) - 1
        while i >= 0 {
            ordered = list_append(ordered, messages[i])
            i = i - 1
        }
        if len(ordered) == 0 { return web.status(404) }
        pcap := build_pcap(ordered)
        fname := sanitize_cid(cid) + ".pcap"
        {"status": 200, "headers": {"Content-Type": "application/vnd.tcpdump.pcap", "Content-Disposition": "attachment; filename=\"" + fname + "\""}, "body": pcap}
    })

    // ---- JSON export route ----

    app.get("/export/json", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        cid := req.query_map["call_id"] ?? ""
        agent := req.query_map["agent"] ?? ""
    method := req.query_map["method"] ?? ""
    transport := req.query_map["transport"] ?? ""
    src := req.query_map["ip"] ?? req.query_map["src"] ?? ""
        from_number := req.query_map["from_number"] ?? ""
        to_number := req.query_map["to_number"] ?? ""
        status := req.query_map["status"] ?? ""
        since_ms := req.query_map["since_ms"] ?? ""
        until_ms := req.query_map["until_ms"] ?? ""
        messages := fetch_messages_time(500, cid, transport, agent, method, src, from_number, to_number, status, since_ms, until_ms)
        body := json.stringify(messages)
        {"status": 200, "headers": {"Content-Type": "application/json", "Content-Disposition": "attachment; filename=\"zaman-export.json\""}, "body": body}
    })

    // ---- saved search routes ----

    app.post("/searches/save", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        name := web.form_get(req, "name", "")
        if name == "" { return {"status": 302, "headers": {"Location": "/messages"}, "body": ""} }
        params := {
            "call_id": web.form_get(req, "call_id", ""),
            "agent": web.form_get(req, "agent", ""),
        "method": web.form_get(req, "method", ""),
        "transport": web.form_get(req, "transport", ""),
            "ip": web.form_get(req, "ip", ""),
            "src": web.form_get(req, "src", ""),
            "from_number": web.form_get(req, "from_number", ""),
            "to_number": web.form_get(req, "to_number", ""),
            "status": web.form_get(req, "status", ""),
            "since_ms": web.form_get(req, "since_ms", ""),
            "until_ms": web.form_get(req, "until_ms", "")
        }
        create_search(name, user["username"] ?? "", params)
        {"status": 302, "headers": {"Location": "/messages"}, "body": ""}
    })

    app.post("/searches/:id/delete", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        id := int.parse(req.params["id"]).unwrap_or(0)
        if id > 0 { delete_search(id) }
        {"status": 302, "headers": {"Location": "/messages"}, "body": ""}
    })

    // ---- recording routes ----

    app.get("/recordings/:cid", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return web.status(401) }
        cid := req.params["cid"]
        path := recording_path(cid)
        if !fs.exists(path) { return web.status(404) }
        data := fs.read_bytes(path)
        if !data.ok { return web.status(500) }
        {"status": 200, "headers": {"Content-Type": "audio/wav", "Cache-Control": "public, max-age=3600"}, "body": data.value}
    })

    app.post("/recordings/upload", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "operator") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        cid := web.form_get(req, "call_id", "")
        if cid == "" { return web.html(layout("Error", "<p class=\"text-[#f87171]\">Missing call_id</p>", user)) }
        f := req.files["file"]
        if f == null { return web.html(layout("Error", "<p class=\"text-[#f87171]\">No file uploaded</p>", user)) }
        // F4: file size limit (50 MB)
        fsize := f["size"] ?? 0
        if fsize > 52428800 { return web.html(layout("Error", "<p class=\"text-[#f87171]\">File too large (max 50 MB)</p>", user)) }
        dir := recordings_dir()
        if !fs.exists(dir) { fs.mkdir(dir) }
        path := recording_path(cid)
        fs.write_bytes(path, f["body"])
        // Redirect back to ladder
                {"status": 302, "headers": {"Location": "/ladder?call_id=" + q(cid)}, "body": ""}
    })

    // ---- alert evaluation partial (HTMX polls this) ----

    app.get("/partials/alerts", fn(req) {
        if auth_enabled() && get_user(req, token_secret) == null { return web.htmx("") }
        rt := fetch_realtime(5)
        fired := evaluate_alerts(rt)
        if len(fired) == 0 {
            return web.htmx("")
        }
        mut html := ""
        for a in fired {
            sev := a["severity"] ?? "warning"
            msg := h(a["message"] ?? "")
            bg := if sev == "critical" { "border-[#f87171]/20 bg-[#f87171]/5" } else { "border-[#fbbf24]/20 bg-[#fbbf24]/5" }
            ic := if sev == "critical" { "text-[#f87171]" } else { "text-[#fbbf24]" }
            html = html + "<div class=\"flex items-center gap-2 rounded-lg border " + bg + " px-3 py-2 text-sm\">" +
                "<span class=\"" + ic + "\">&#x26A0;</span>" +
                "<span class=\"" + ic + " font-medium\">" + msg + "</span></div>"
        }
        web.htmx("<div class=\"space-y-2\">" + html + "</div>")
    })

    app.get("/partials/notifications", fn(req) {
        if auth_enabled() && get_user(req, token_secret) == null { return web.htmx("") }
        anomalies := fetch_anomalies()
        if len(anomalies) == 0 {
            return web.htmx("<div class=\"card p-4\"><div class=\"flex items-center justify-between gap-3\"><div><div class=\"text-sm font-medium text-[#e4e4e7]\">No active notifications</div><div class=\"text-xs text-[#71717a] mt-1\">Alerts, 5xx spikes, auth failures, and scan warnings will appear here.</div></div><span class=\"rounded-full border border-[rgba(52,211,153,.25)] bg-[rgba(52,211,153,.08)] px-2 py-0.5 text-[11px] text-[#34d399]\">clear</span></div></div>")
        }
        mut rows := ""
        for a in anomalies {
            sev := a["severity"] ?? "warning"
            msg := h(a["message"] ?? "")
            typ := h(a["type"] ?? "event")
            cls := if sev == "critical" { "border-[#f87171]/25 bg-[#f87171]/5 text-[#f87171]" } else { "border-[#fbbf24]/25 bg-[#fbbf24]/5 text-[#fbbf24]" }
            rows = rows + "<div class=\"rounded-md border " + cls + " px-3 py-2\">" +
                "<div class=\"flex items-center justify-between gap-3\"><span class=\"text-sm font-medium\">" + msg + "</span><span class=\"text-[10px] uppercase tracking-wider\">" + h(sev) + "</span></div>" +
                "<div class=\"text-[10px] text-[#71717a] mt-1\">" + typ + " · refreshed every 20s</div></div>"
        }
        web.htmx("<div class=\"card p-4\"><div class=\"space-y-2\">" + rows + "</div></div>")
    })

    // ---- alerts config page ----

app.get("/alerts", fn(req) {
    user := get_user(req, token_secret)
    if user == null { return login_redirect() }
    if !has_role(user, "operator") {
        return {"status": 403, "headers": {"Content-Type": "text/html; charset=utf-8"}, "body": layout("Forbidden", "<p class=\"text-[#71717a]\">Operator role required for alerts.</p>", user)}
    }
        config := load_alert_config()
        history := load_alert_history()
        channels := config["channels"] ?? []
        rules := config["rules"] ?? []
        crd := "card"
        inp := "w-full rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 text-sm mono"

        // Channels list
        mut ch_rows := ""
        for ch in channels {
            ct := ch["type"] ?? ""
            label := if ct == "slack" { "Slack: " + h(ch["webhook_url"] ?? "") } else if ct == "webhook" { "Webhook: " + h(ch["url"] ?? "") } else if ct == "email" { "Email: " + h(ch["to"] ?? "") } else { h(ct) }
            ch_rows = ch_rows + "<div class=\"flex items-center justify-between py-2 border-b border-[#1e1e22]/50\">" +
                "<div class=\"flex items-center gap-2\">" +
                "<span class=\"px-1.5 py-0.5 rounded text-[10px] font-semibold uppercase bg-[#27272a] text-[#a1a1aa]\">" + h(ct) + "</span>" +
                "<span class=\"text-sm truncate max-w-[300px]\">" + label + "</span></div>" +
                "<form method=\"post\" action=\"/alerts/channel/delete\" class=\"shrink-0\">" +
                "<input type=\"hidden\" name=\"type\" value=\"" + h(ct) + "\"/>" +
                "<input type=\"hidden\" name=\"url\" value=\"" + h(ch["webhook_url"] ?? ch["url"] ?? ch["to"] ?? "") + "\"/>" +
                "<button class=\"text-[11px] text-[#52525b] hover:text-[#f87171]\">remove</button></form></div>"
        }
        if ch_rows == "" { ch_rows = "<p class=\"text-sm text-[#52525b] py-3\">No channels configured. Alerts will only show in the dashboard.</p>" }

        // Rules list
        mut rule_rows := ""
        for rule in rules {
            rid := rule["id"] ?? 0
            rname := h(rule["name"] ?? "")
            rmetric := h(rule["metric"] ?? "")
            rop := h(rule["op"] ?? ">")
            rthresh := rule["threshold"] ?? 0
            rsev := rule["severity"] ?? "warning"
            renabled := rule["enabled"] ?? false
            sev_cls := if rsev == "critical" { "text-[#f87171]" } else { "text-[#fbbf24]" }
            en_cls := if renabled { "text-[#34d399]" } else { "text-[#52525b]" }
            rule_rows = rule_rows + "<tr>" +
                "<td class=\"py-2 px-4 text-sm font-medium\">" + rname + "</td>" +
                "<td class=\"py-2 px-4 mono text-xs\">" + rmetric + " " + rop + " " + ("" + (rthresh)) + "</td>" +
                "<td class=\"py-2 px-4 text-xs " + sev_cls + "\">" + rsev + "</td>" +
                "<td class=\"py-2 px-4 text-xs " + en_cls + "\">" + (if renabled { "active" } else { "disabled" }) + "</td>" +
                "<td class=\"py-2 px-4 text-xs\">" +
                "<form method=\"post\" action=\"/alerts/rule/delete\" class=\"inline\">" +
                "<input type=\"hidden\" name=\"id\" value=\"" + ("" + (rid)) + "\"/>" +
                "<button class=\"text-[#52525b] hover:text-[#f87171]\">delete</button></form></td></tr>"
        }
        if rule_rows == "" { rule_rows = "<tr><td colspan=\"5\" class=\"py-6 text-center text-[#52525b] text-sm\">No rules configured.</td></tr>" }

        // Recent alert history
        mut hist_rows := ""
        mut hi := len(history) - 1
        mut hcount := 0
        while hi >= 0 && hcount < 20 {
            ha := history[hi]
            hsev := ha["severity"] ?? "warning"
            hmsg := h(ha["message"] ?? "")
            hname := h(ha["rule"] ?? "")
            hcls := if hsev == "critical" { "text-[#f87171]" } else { "text-[#fbbf24]" }
            hist_rows = hist_rows + "<tr>" +
                "<td class=\"py-1.5 px-4 text-xs " + hcls + "\">" + hsev + "</td>" +
                "<td class=\"py-1.5 px-4 text-sm\">" + hname + "</td>" +
                "<td class=\"py-1.5 px-4 text-xs text-[#71717a] truncate max-w-[24rem]\">" + hmsg + "</td></tr>"
            hi = hi - 1
            hcount = hcount + 1
        }
        if hist_rows == "" { hist_rows = "<tr><td colspan=\"3\" class=\"py-6 text-center text-[#52525b] text-sm\">No alerts fired yet.</td></tr>" }

        th := "text-[10px] uppercase tracking-wider text-[#52525b] font-semibold border-b border-[#1e1e22]"

        body := "<h1 class=\"text-2xl font-bold mb-1\">Alerts</h1>" +
            "<p class=\"text-sm text-[#71717a] mb-6\">Configure notification channels and threshold rules. Alerts evaluate every 30 seconds against the 5-minute traffic window.</p>" +
            // Channels
            "<div class=\"grid lg:grid-cols-2 gap-4 mb-6\">" +
            "<div class=\"" + crd + " p-5\">" +
            "<h2 class=\"text-sm font-semibold mb-4\">Notification channels</h2>" +
            ch_rows +
            "<h3 class=\"text-xs font-semibold text-[#71717a] mt-5 mb-3\">Add channel</h3>" +
            "<form method=\"post\" action=\"/alerts/channel\" class=\"space-y-3\">" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase tracking-wider mb-1\">Type</label>" +
            "<select name=\"type\" class=\"" + inp + "\">" +
            "<option value=\"slack\">Slack webhook</option>" +
            "<option value=\"webhook\">Generic webhook (PagerDuty/Teams/Opsgenie)</option>" +
            "<option value=\"email\">Email (SMTP)</option></select></div>" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase tracking-wider mb-1\">Slack webhook URL / Webhook URL / Email address</label>" +
            "<input name=\"url\" required placeholder=\"https://hooks.slack.com/...\" class=\"" + inp + "\"/></div>" +
            "<div class=\"grid grid-cols-2 gap-3\">" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase tracking-wider mb-1\">SMTP host (email only)</label>" +
            "<input name=\"smtp_host\" value=\"localhost\" class=\"" + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase tracking-wider mb-1\">SMTP port</label>" +
            "<input name=\"smtp_port\" value=\"25\" class=\"" + inp + "\"/></div></div>" +
            "<button class=\"rounded-lg px-4 py-2 text-sm bg-[#27272a] text-[#e4e4e7] hover:bg-[#3f3f46]\">Add channel</button></form></div>" +
            // Rules
            "<div class=\"" + crd + " overflow-x-auto\">" +
            "<div class=\"px-5 py-3 border-b border-[#1e1e22] text-sm font-semibold\">Alert rules</div>" +
            "<table class=\"w-full text-left\"><thead><tr class=\"" + th + "\">" +
            "<th class=\"py-2 px-4\">Name</th><th class=\"py-2 px-4\">Condition</th><th class=\"py-2 px-4\">Severity</th><th class=\"py-2 px-4\">Status</th><th class=\"py-2 px-4\"></th></tr></thead>" +
            "<tbody class=\"divide-y divide-[#27272a]/40\">" + rule_rows + "</tbody></table>" +
            "<div class=\"p-4 border-t border-[#1e1e22]\">" +
            "<h3 class=\"text-xs font-semibold text-[#71717a] mb-3\">Add rule</h3>" +
            "<form method=\"post\" action=\"/alerts/rule\" class=\"grid grid-cols-5 gap-2 items-end\">" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase mb-1\">Name</label>" +
            "<input name=\"name\" required placeholder=\"Low ASR\" class=\"" + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase mb-1\">Metric</label>" +
            "<select name=\"metric\" class=\"" + inp + "\">" +
            "<option value=\"asr\">ASR %</option>" +
            "<option value=\"err_rate\">Error rate %</option>" +
            "<option value=\"resp_5xx\">5xx count</option>" +
            "<option value=\"resp_4xx\">4xx count</option>" +
            "<option value=\"err_401\">401 Unauthorized</option>" +
            "<option value=\"err_403\">403 Forbidden</option>" +
            "<option value=\"err_503\">503 Unavailable</option>" +
            "<option value=\"invites\">INVITEs (5m)</option>" +
            "<option value=\"registers\">REGISTERs (5m)</option>" +
            "<option value=\"active_calls\">Active calls</option>" +
            "</select></div>" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase mb-1\">Condition</label>" +
            "<div class=\"flex gap-1\">" +
            "<select name=\"op\" class=\"rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-2 py-2 text-sm mono w-16\">" +
            "<option value=\">\">></option><option value=\"<\"><</option><option value=\">=\">>=</option></select>" +
            "<input name=\"threshold\" type=\"number\" required value=\"10\" class=\"flex-1 rounded-lg bg-[#0a0a0c] border border-[#1e1e22] px-2 py-2 text-sm mono\"/></div></div>" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase mb-1\">Severity</label>" +
            "<select name=\"severity\" class=\"" + inp + "\">" +
            "<option value=\"warning\">warning</option><option value=\"critical\">critical</option></select></div>" +
            "<button class=\"rounded-lg px-3 py-2 text-sm bg-[#27272a] text-[#e4e4e7] hover:bg-[#3f3f46]\">Add</button></form></div></div>" +
            "</div>" +
            // History
            "<div class=\"" + crd + " overflow-x-auto mt-6\">" +
            "<div class=\"px-5 py-3 border-b border-[#1e1e22] flex items-center justify-between\">" +
            "<span class=\"text-sm font-semibold\">Recent alerts</span>" +
            "<span class=\"text-[10px] text-[#52525b]\">last 20</span></div>" +
            "<table class=\"w-full text-left\"><thead><tr class=\"" + th + "\">" +
            "<th class=\"py-2 px-4\">Severity</th><th class=\"py-2 px-4\">Rule</th><th class=\"py-2 px-4\">Detail</th></tr></thead>" +
            "<tbody class=\"divide-y divide-[#27272a]/40\">" + hist_rows + "</tbody></table></div>"
        web.html(layout_with_csrf("Alerts", body, user, csrf_token(req, token_secret)))
    })

    // Alert channel CRUD
    app.post("/alerts/channel", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "operator") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        ch_type := web.form_get(req, "type", "webhook")
        url := web.form_get(req, "url", "")
        smtp_host := web.form_get(req, "smtp_host", "localhost")
        smtp_port := web.form_get(req, "smtp_port", "25")
        config := load_alert_config()
        channels := config["channels"] ?? []
        mut new_ch := {}
        if ch_type == "slack" {
            new_ch = {"type": "slack", "webhook_url": url}
        } else if ch_type == "email" {
            new_ch = {"type": "email", "to": url, "from": "zaman@localhost", "smtp_host": smtp_host, "smtp_port": smtp_port}
        } else {
            new_ch = {"type": "webhook", "url": url}
        }
        config["channels"] = list_append(channels, new_ch)
        save_alert_config(config)
        {"status": 302, "headers": {"Location": "/alerts"}, "body": ""}
    })

    app.post("/alerts/channel/delete", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "operator") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        del_type := web.form_get(req, "type", "")
        del_url := web.form_get(req, "url", "")
        config := load_alert_config()
        channels := config["channels"] ?? []
        // Remove matching channel
        mut kept := "["
        mut first := true
        for ch in channels {
            ct := ch["type"] ?? ""
            cu := ch["webhook_url"] ?? ch["url"] ?? ch["to"] ?? ""
            if ct == del_type && cu == del_url { continue }
            if !first { kept = kept + "," }
            kept = kept + json.stringify(ch)
            first = false
        }
        config["channels"] = json.parse(kept + "]").value
        save_alert_config(config)
        {"status": 302, "headers": {"Location": "/alerts"}, "body": ""}
    })

    // Alert rule CRUD
    app.post("/alerts/rule", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "operator") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        config := load_alert_config()
        rules := config["rules"] ?? []
        // Next ID
        mut max_id := 0
        for r in rules {
            rid := r["id"] ?? 0
            if rid > max_id { max_id = rid }
        }
        new_rule := {
            "id": max_id + 1,
            "name": web.form_get(req, "name", ""),
            "metric": web.form_get(req, "metric", "asr"),
            "op": web.form_get(req, "op", ">"),
            "threshold": int.parse(web.form_get(req, "threshold", "10")).unwrap_or(10),
            "severity": web.form_get(req, "severity", "warning"),
            "enabled": true
        }
        config["rules"] = list_append(rules, new_rule)
        save_alert_config(config)
        {"status": 302, "headers": {"Location": "/alerts"}, "body": ""}
    })

    app.post("/alerts/rule/delete", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "operator") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        del_id := int.parse(web.form_get(req, "id", "0")).unwrap_or(0)
        config := load_alert_config()
        config["rules"] = list_remove(config["rules"] ?? [], "id", del_id)
        save_alert_config(config)
        {"status": 302, "headers": {"Location": "/alerts"}, "body": ""}
    })

    // ---- CSV export ----

    app.get("/export/csv", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        cid := req.query_map["call_id"] ?? ""
        agent := req.query_map["agent"] ?? ""
    method := req.query_map["method"] ?? ""
    transport := req.query_map["transport"] ?? ""
    src := req.query_map["ip"] ?? req.query_map["src"] ?? ""
        from_number := req.query_map["from_number"] ?? ""
        to_number := req.query_map["to_number"] ?? ""
        status := req.query_map["status"] ?? ""
        since_ms := req.query_map["since_ms"] ?? ""
        until_ms := req.query_map["until_ms"] ?? ""
        messages := fetch_messages_time(500, cid, transport, agent, method, src, from_number, to_number, status, since_ms, until_ms)
        audit(user["username"] ?? "", "export_csv", ("" + (len(messages))) + " messages")
        csv := messages_to_csv(messages)
        {"status": 200, "headers": {"Content-Type": "text/csv", "Content-Disposition": "attachment; filename=\"zaman-export.csv\""}, "body": csv}
    })

    // ---- config backup/restore ----

    app.get("/admin/backup", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "admin") { return web.status(403) }
        audit(user["username"] ?? "", "config_export", "backup")
        cfg := export_config()
        {"status": 200, "headers": {"Content-Type": "application/json", "Content-Disposition": "attachment; filename=\"zaman-config-backup.json\""}, "body": cfg}
    })

    // ---- API tokens management ----

    app.get("/admin/tokens", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "admin") { return web.status(403) }
        tokens := load_api_tokens()
        inp := "w-full rounded-md bg-[#0a0a0c] border border-[#1e1e22] px-3 py-2 text-sm"
        lbl := "block text-[10px] text-[#52525b] uppercase tracking-wider mb-1.5"

        mut flash := ""

        // Token list as rows
        mut token_list := ""
        for t in tokens {
            tprefix := h(t["prefix"] ?? "")
            tlabel := h(t["label"] ?? "")
            tuser := h(t["username"] ?? "")
            trole := t["role"] ?? "viewer"
            tcreated := t["created"] ?? 0
            token_list = token_list +
                "<div class=\"flex items-center justify-between py-3 px-4 border-b border-[#1e1e22]/50 last:border-0\">" +
                "<div class=\"flex items-center gap-3\">" +
                "<div class=\"w-8 h-8 rounded-full bg-[#1e1e22] flex items-center justify-center\">" +
                "<svg class=\"w-3.5 h-3.5 text-[#52525b]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z\"/></svg></div>" +
                "<div><div class=\"text-sm font-medium\">" + tlabel + "</div>" +
                "<div class=\"text-[10px] text-[#3f3f46] mono\">" + tprefix + "… · " + tuser + " · " + time_ago(tcreated) + "</div></div>" +
                "<div class=\"ml-3\">" + role_badge(trole) + "</div></div>" +
                "<form method=\"post\" action=\"/admin/tokens/delete\">" +
                "<input type=\"hidden\" name=\"prefix\" value=\"" + tprefix + "\"/>" +
                "<button class=\"text-[11px] text-[#52525b] hover:text-[#f87171]\">revoke</button></form></div>"
        }
        if token_list == "" {
            token_list = "<div class=\"py-8 text-center text-[#3f3f46] text-sm\">No API tokens created yet.</div>"
        }

        // Usage hint
        usage := "<div class=\"card p-4 mb-5\">" +
            "<div class=\"text-xs text-[#52525b] space-y-1\">" +
            "<div>Use tokens as HTTP headers:</div>" +
            "<code class=\"block mono text-[11px] text-[#71717a] bg-[#0a0a0c] rounded-md p-2 mt-1\">curl -H \"Authorization: Bearer &lt;token&gt;\" " + h(core_base()) + "/api/messages</code></div></div>"

        body := "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
            "<h1 class=\"text-xl font-semibold\">API Tokens</h1>" +
            "<span class=\"text-[10px] text-[#3f3f46] mono\">" + ("" + (len(tokens))) + " active</span></div>" +
            flash + usage +
            // Token list
            "<div class=\"card overflow-hidden mb-5\">" + token_list + "</div>" +
            // Create form — single row
            "<div class=\"card p-4\">" +
            "<div class=\"section-title\">Generate token</div>" +
            "<form method=\"post\" action=\"/admin/tokens\" class=\"grid grid-cols-3 gap-3 items-end\">" +
            "<div><label class=\"" + lbl + "\">Label</label>" +
            "<input name=\"label\" required placeholder=\"CI pipeline\" class=\"" + inp + "\"/></div>" +
            "<div><label class=\"" + lbl + "\">Role</label>" +
            "<select name=\"role\" class=\"" + inp + "\">" +
            "<option value=\"viewer\">viewer</option><option value=\"operator\">operator</option><option value=\"admin\">admin</option></select></div>" +
            "<button type=\"submit\" class=\"rounded-md px-4 py-2 text-sm bg-[#a78bfa] text-[#0a0a0c] font-medium hover:bg-[#c4b5fd] transition-colors\">Generate</button>" +
            "</form></div>"
        web.html(layout_with_csrf("API Tokens", body, user, csrf_token(req, token_secret)))
    })

    app.post("/admin/tokens", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "admin") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        label := web.form_get(req, "label", "")
        role := web.form_get(req, "role", "viewer")
        uname := user["username"] ?? "admin"
        token := create_api_token(uname, role, label)
        audit(uname, "api_token_create", "label=" + label + " role=" + role)
        // Render inline instead of redirect — never put tokens in URLs (browser history, referrer, logs)
        flash := "<div class=\"card border-[#34d399]/20 bg-[#34d399]/5 p-4 mb-5\">" +
            "<div class=\"text-xs text-[#34d399] font-semibold mb-2\">Token created — copy it now, it won't be shown again</div>" +
            "<div class=\"flex gap-2\">" +
            "<code class=\"flex-1 mono text-xs bg-[#0a0a0c] rounded-md p-2.5 break-all select-all border border-[#1e1e22]\">" + h(token) + "</code>" +
            "<button onclick=\"navigator.clipboard.writeText(this.dataset.v).then(()=>this.textContent='Copied')\" data-v=\"" + h(token) + "\" class=\"shrink-0 rounded-md px-3 py-1.5 text-xs bg-[#1e1e22] text-[#a1a1aa] hover:text-[#e4e4e7]\">Copy</button></div></div>" +
            "<p class=\"text-xs text-[#52525b]\"><a href=\"/admin/tokens\" class=\"text-[#a78bfa] hover:underline\">Back to tokens</a></p>"
        web.html(layout("API Token Created", flash, user))
    })

    app.post("/admin/tokens/delete", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "admin") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        prefix := web.form_get(req, "prefix", "")
        delete_api_token(prefix)
        audit(user["username"] ?? "", "api_token_revoke", "prefix=" + prefix)
        {"status": 302, "headers": {"Location": "/admin/tokens"}, "body": ""}
    })

    // ---- audit log page ----

    app.get("/admin/audit", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "admin") { return web.status(403) }
        limit := int.parse(req.query_map["limit"] ?? "100").unwrap_or(100)
        entries := load_audit(limit)
        th := "text-[10px] uppercase tracking-wider text-[#52525b] font-semibold"

        // Group by action type for summary
        mut login_ok := 0
        mut login_fail := 0
        mut creates := 0
        mut other := 0
        for e in entries {
            action := e["action"] ?? ""
            if action == "login" { login_ok = login_ok + 1 }
            else if str.contains(action, "fail") { login_fail = login_fail + 1 }
            else if str.contains(action, "create") { creates = creates + 1 }
            else { other = other + 1 }
        }

        summary := "<div class=\"flex items-center gap-6 text-xs mb-5\">" +
            "<span class=\"text-[#34d399] mono\">" + ("" + (login_ok)) + " logins</span>" +
            "<span class=\"text-[#f87171] mono\">" + ("" + (login_fail)) + " failed</span>" +
            "<span class=\"text-[#a78bfa] mono\">" + ("" + (creates)) + " creates</span>" +
            "<span class=\"text-[#52525b] mono\">" + ("" + (other)) + " other</span>" +
            "<span class=\"text-[#3f3f46]\">·</span>" +
            "<span class=\"text-[#3f3f46]\">" + ("" + (len(entries))) + " entries</span></div>"

        mut rows := ""
        for e in entries {
            action := e["action"] ?? ""
            ets := e["ts"] ?? 0
            acls := if str.contains(action, "fail") || str.contains(action, "revoke") || str.contains(action, "delete") { "text-[#f87171]" } else if action == "login" || str.contains(action, "create") { "text-[#34d399]" } else { "text-[#71717a]" }
            rows = rows + "<tr>" +
                "<td class=\"py-2 px-3 text-xs text-[#52525b]\">" + time_ago(ets) + "</td>" +
                "<td class=\"py-2 px-3 text-sm\">" + h(e["user"] ?? "") + "</td>" +
                "<td class=\"py-2 px-3 text-xs " + acls + " font-medium\">" + h(action) + "</td>" +
                "<td class=\"py-2 px-3 text-xs text-[#3f3f46] truncate max-w-[30rem]\">" + h(e["detail"] ?? "") + "</td></tr>"
        }
        if rows == "" { rows = "<tr><td colspan=\"4\" class=\"py-8 text-center text-[#3f3f46] text-sm\">No audit entries yet.</td></tr>" }
        body := "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
            "<h1 class=\"text-xl font-semibold\">Audit Log</h1></div>" +
            summary +
            "<div class=\"card overflow-x-auto\">" +
            "<table class=\"w-full text-left\"><thead><tr class=\"" + th + " border-b border-[#1e1e22]\">" +
            "<th class=\"py-2 px-3\">When</th><th class=\"py-2 px-3\">User</th><th class=\"py-2 px-3\">Action</th><th class=\"py-2 px-3\">Detail</th></tr></thead>" +
            "<tbody class=\"divide-y divide-[#1e1e22]/50\">" + rows + "</tbody></table></div>"
        web.html(layout("Audit Log", body, user))
    })

    // ---- SLA report page ----

    app.get("/sla", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        targets := load_sla_targets()
        inp := "w-full rounded-md bg-[#0a0a0c] border border-[#1e1e22] px-2 py-1.5 text-xs mono text-center"
        asr_t := targets["asr_target"] ?? 45
        asr_w := targets["asr_warning"] ?? 40
        asr_cr := targets["asr_critical"] ?? 35
        ner_t := targets["ner_target"] ?? 98
        err_max := targets["err_rate_max"] ?? 5
        reg_fail_max := targets["reg_fail_max"] ?? 3
        fivexx_max := targets["fivexx_max"] ?? 2

        overview := "<div id=\"sla-overview\" hx-get=\"/partials/sla-overview\" hx-trigger=\"load, every 10s\" hx-swap=\"innerHTML\">" +
            "<div class=\"card p-6 mb-5 text-sm text-[#71717a]\">Loading SLA overview...</div></div>"
        sla_details := "<div id=\"sla-details\" hx-get=\"/partials/sla-details\" hx-trigger=\"load, every 30s\" hx-swap=\"innerHTML\">" +
            "<div class=\"card p-6 text-sm text-[#71717a]\">Loading agent and destination SLA...</div></div>"
        targets_form := "<div class=\"section\">" +
            "<div class=\"section-title\">SLA targets</div>" +
            "<form method=\"post\" action=\"/sla/targets\" class=\"card p-4\">" +
            "<div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-7 gap-3 mb-3\">" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase mb-1\">ASR target %</label><input name=\"asr_target\" type=\"number\" value=\"" + ("" + (asr_t)) + "\" class=\"" + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase mb-1\">ASR warning %</label><input name=\"asr_warning\" type=\"number\" value=\"" + ("" + (asr_w)) + "\" class=\"" + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase mb-1\">ASR critical %</label><input name=\"asr_critical\" type=\"number\" value=\"" + ("" + (asr_cr)) + "\" class=\"" + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase mb-1\">NER target %</label><input name=\"ner_target\" type=\"number\" value=\"" + ("" + (ner_t)) + "\" class=\"" + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase mb-1\">Max error rate %</label><input name=\"err_rate_max\" type=\"number\" value=\"" + ("" + (err_max)) + "\" class=\"" + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase mb-1\">Max reg fails</label><input name=\"reg_fail_max\" type=\"number\" value=\"" + ("" + (reg_fail_max)) + "\" class=\"" + inp + "\"/></div>" +
            "<div><label class=\"block text-[10px] text-[#52525b] uppercase mb-1\">Max 5xx / 5m</label><input name=\"fivexx_max\" type=\"number\" value=\"" + ("" + (fivexx_max)) + "\" class=\"" + inp + "\"/></div>" +
            "</div><button type=\"submit\" class=\"rounded-md px-3 py-1.5 text-xs bg-[#1e1e22] text-[#a1a1aa] hover:text-[#e4e4e7] transition-colors\">Save targets</button></form></div>"
        body := "<div class=\"flex items-end justify-between gap-3 mb-5\">" +
            "<div><h1 class=\"text-2xl font-bold\">SLA</h1><p class=\"text-sm text-[#71717a] mt-1\">Service-level view for call completion, network effectiveness, registration health, node availability, and timeout failures.</p></div>" +
            "<div class=\"flex gap-2\"><a href=\"/report\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">Reports</a><a href=\"/alerts\" class=\"rounded-md border border-[#27272a] px-3 py-1.5 text-xs text-[#a1a1aa] hover:text-[#e4e4e7]\">Alerts</a></div></div>" +
            overview + sla_details + targets_form
        web.html(layout("SLA", body, user))
    })

    app.get("/partials/sla-overview", fn(req) {
        if auth_enabled() && get_user(req, token_secret) == null { return web.htmx("") }
        web.htmx(sla_overview_panel(load_sla_targets()))
    })

    // SLA targets save
    app.post("/sla/targets", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "operator") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        targets := {
            "asr_target": int.parse(web.form_get(req, "asr_target", "45")).unwrap_or(45),
            "asr_warning": int.parse(web.form_get(req, "asr_warning", "40")).unwrap_or(40),
            "asr_critical": int.parse(web.form_get(req, "asr_critical", "35")).unwrap_or(35),
            "ner_target": int.parse(web.form_get(req, "ner_target", "98")).unwrap_or(98),
            "err_rate_max": int.parse(web.form_get(req, "err_rate_max", "5")).unwrap_or(5),
            "reg_fail_max": int.parse(web.form_get(req, "reg_fail_max", "3")).unwrap_or(3),
            "fivexx_max": int.parse(web.form_get(req, "fivexx_max", "2")).unwrap_or(2)
        }
        save_sla_targets(targets)
        audit(user["username"] ?? "", "sla_targets", "updated")
        {"status": 302, "headers": {"Location": "/sla"}, "body": ""}
    })

    // ---- admin routes ----

    app.get("/admin/users", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "admin") {
            return {"status": 403, "headers": {"Content-Type": "text/html; charset=utf-8"}, "body": layout("Forbidden", "<h1 class=\"text-xl font-bold\">Forbidden</h1><p class=\"text-[#a1a1aa] mt-2\">Admin role required.</p>", user)}
        }
        web.html(layout_with_csrf("Users", admin_users_page(user, ""), user, csrf_token(req, token_secret)))
    })

    app.post("/admin/users", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "admin") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        username := web.form_get(req, "username", "")
        password := web.form_get(req, "password", "")
        role := web.form_get(req, "role", "viewer")
        err := create_user(username, password, role)
        if err != "" {
            return web.html(layout_with_csrf("Users", admin_users_page(user, "Error: " + err), user, csrf_token(req, token_secret)))
        }
        web.html(layout_with_csrf("Users", admin_users_page(user, "User " + username + " created."), user, csrf_token(req, token_secret)))
    })

    app.post("/admin/users/password", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "admin") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        uid := web.form_get(req, "user_id", "")
        pw := web.form_get(req, "new_password", "")
        uid_int := int.parse(uid).unwrap_or(0)
        if uid_int <= 0 {
            return web.html(layout_with_csrf("Users", admin_users_page(user, "Error: invalid user ID"), user, csrf_token(req, token_secret)))
        }
        err := change_password(uid_int, pw)
        if err != "" {
            return web.html(layout_with_csrf("Users", admin_users_page(user, "Error: " + err), user, csrf_token(req, token_secret)))
        }
        web.html(layout_with_csrf("Users", admin_users_page(user, "Password updated for user #" + uid + "."), user, csrf_token(req, token_secret)))
    })

    app.post("/admin/users/:id/delete", fn(req) {
        user := get_user(req, token_secret)
        if user == null { return login_redirect() }
        if !has_role(user, "admin") { return web.status(403) }
        if !csrf_valid(req, token_secret) { return csrf_reject() }
        id := int.parse(req.params["id"]).unwrap_or(0)
        if id == (user["id"] ?? -1) {
            return web.html(layout_with_csrf("Users", admin_users_page(user, "Error: cannot delete yourself"), user, csrf_token(req, token_secret)))
        }
        if id > 0 { delete_user_by_id(id) }
        web.html(layout_with_csrf("Users", admin_users_page(user, "User deleted."), user, csrf_token(req, token_secret)))
    })

    say("zaman-web → http://127.0.0.1:3000  (core " + core_base() + ", auth " + (if auth_enabled() { "on" } else { "off (ZAMAN_AUTH=0)" }) + ")")
    app.listen(":3000")
}
